{
  "module": "logic",
  "nodes": [
    { "id": "logic.when", "kind": "event", "category": "Связи", "icon": "bolt", "hidden": true,
      "title": { "ru": "Когда", "en": "When" },
      "help": { "ru": "Связь сработала: с этого всё начинается. Первая и вторая вещь связи, и герой." },
      "outputs": [
        { "id": "a", "type": "entity", "title": { "ru": "Первая вещь", "en": "First" } },
        { "id": "b", "type": "entity", "title": { "ru": "Вторая вещь", "en": "Second" } },
        { "id": "hero", "type": "entity", "title": { "ru": "Герой", "en": "Hero" } } ] },

    { "id": "logic.hero", "kind": "pure", "category": "Связи", "icon": "person",
      "title": { "ru": "Герой", "en": "Hero" },
      "outputs": [ { "id": "hero", "type": "entity", "title": { "ru": "Герой", "en": "Hero" } } ],
      "lua": "hero" },
    { "id": "logic.has", "kind": "pure", "category": "Связи", "icon": "backpack",
      "title": { "ru": "Есть с собой", "en": "Carries" },
      "help": { "ru": "Несёт ли герой (или другой) вещь этого вида." },
      "inputs": [
        { "id": "who", "type": "entity", "required": true, "title": { "ru": "Кто", "en": "Who" } },
        { "id": "thing", "type": "string", "enum_type": "thing", "constant": true, "required": true, "title": { "ru": "Вещь", "en": "Thing" } } ],
      "outputs": [ { "id": "yes", "type": "bool", "title": { "ru": "Да", "en": "Yes" } } ],
      "lua": "logic.has({in:who}, {in:thing})" },
    { "id": "logic.night", "kind": "pure", "category": "Связи", "icon": "dark_mode",
      "title": { "ru": "Сейчас ночь", "en": "Is night" },
      "outputs": [ { "id": "yes", "type": "bool", "title": { "ru": "Да", "en": "Yes" } } ],
      "lua": "logic.night()" },
    { "id": "logic.nearest", "kind": "pure", "category": "Связи", "icon": "my_location",
      "title": { "ru": "Ближайшая вещь", "en": "Nearest thing" },
      "help": { "ru": "Ближайшая копия вещи этого вида. Пусто, если в радиусе нет." },
      "inputs": [
        { "id": "thing", "type": "string", "enum_type": "thing", "constant": true, "required": true, "title": { "ru": "Вещь", "en": "Thing" } },
        { "id": "radius", "type": "number", "value": "32", "title": { "ru": "Радиус", "en": "Radius" }, "has_range": true, "min": 0, "max": 4096 } ],
      "outputs": [ { "id": "actor", "type": "entity", "title": { "ru": "Вещь", "en": "Thing" } } ],
      "lua": "logic.nearest({in:thing}, self, {in:radius})" },
    { "id": "logic.once", "kind": "flow", "category": "Связи", "icon": "looks_one",
      "title": { "ru": "Только в первый раз", "en": "Only the first time" },
      "help": { "ru": "Для каждой копии вещи: что внутри, случится один раз." },
      "inputs": [ { "id": "_link", "type": "integer", "constant": true, "value": "0" } ],
      "slots": [ { "id": "first", "title": { "ru": "Первый раз", "en": "First time" } } ],
      "lua": "if logic.first(self, {in:_link}) then\n    {slot:first}\nend" },
    { "id": "logic.act", "kind": "action", "category": "Связи", "icon": "play_arrow",
      "title": { "ru": "Сделать", "en": "Do" },
      "help": { "ru": "Действие игры над вещью: открыть, ранить, собрать… «Вид» — какая это вещь." },
      "inputs": [
        { "id": "action", "type": "string", "enum_type": "action", "constant": true, "required": true, "title": { "ru": "Что", "en": "Action" } },
        { "id": "target", "type": "entity", "required": true, "title": { "ru": "С чем", "en": "Target" } },
        { "id": "thing", "type": "string", "enum_type": "thing", "constant": true, "required": true, "title": { "ru": "Вид", "en": "Kind" } },
        { "id": "other", "type": "entity", "title": { "ru": "Кто делает", "en": "By" } } ],
      "lua": "logic.act({in:action}, {in:target}, {in:thing}, {in:other}, hero)" },
    { "id": "logic.sound", "kind": "action", "category": "Связи", "icon": "volume_up",
      "title": { "ru": "Звук", "en": "Sound" },
      "inputs": [ { "id": "cue", "type": "string", "enum_type": "cue", "constant": true, "required": true, "title": { "ru": "Какой", "en": "Cue" } } ],
      "lua": "logic.sound(self, {in:cue})" },
    { "id": "logic.hint", "kind": "action", "category": "Связи", "icon": "chat_bubble",
      "title": { "ru": "Подсказка герою", "en": "Hint" },
      "inputs": [ { "id": "text", "type": "string", "required": true, "title": { "ru": "Текст", "en": "Text" } } ],
      "lua": "logic.hint(hero, {in:text})" }
  ]
}
