#version 450

// Spawns this frame's particles: one thread per new particle. Every emitter
// requested this frame is in one list, so all of them cost one dispatch.

layout(local_size_x = 256) in;

struct Emitter {
    vec2 pos;
    float radius;
    float speed_min;
    float speed_max;
    float angle;
    float spread;
    float life_min;
    float life_max;
    float size_start;
    float size_end;
    float spin;
    uint color;
    uint frame;
    uint first; // index of its first particle among this frame's new ones
    uint count;
};

struct Particle {
    vec2 pos;
    vec2 vel;
    float age;
    float life;
    float size_start;
    float size_end;
    uint color;
    uint frame;
    float angle;
    float spin;
};

layout(std430, set = 0, binding = 0) readonly buffer Emitters {
    Emitter emitters[];
};

layout(std430, set = 1, binding = 0) buffer Particles {
    Particle particles[];
};

layout(set = 2, binding = 0) uniform Params {
    uint total;         // new particles this frame
    uint emitter_count;
    uint first_slot;    // where they go in the ring
    uint capacity;
    uint seed;
} params;

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float rand(inout uint state) {
    state = hash(state);
    return float(state & 0xffffffu) / 16777216.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.total) return;

    // Which emitter: the last one whose first particle is at or before i.
    uint lo = 0u, hi = params.emitter_count - 1u;
    while (lo < hi) {
        uint mid = (lo + hi + 1u) / 2u;
        if (emitters[mid].first <= i) lo = mid;
        else hi = mid - 1u;
    }
    Emitter e = emitters[lo];

    uint state = hash(i * 1664525u + params.seed);
    float r = e.radius * sqrt(rand(state));
    float a = rand(state) * 6.2831853;
    float dir = e.angle + (rand(state) - 0.5) * e.spread;
    float speed = mix(e.speed_min, e.speed_max, rand(state));

    Particle p;
    p.pos = e.pos + vec2(cos(a), sin(a)) * r;
    p.vel = vec2(cos(dir), sin(dir)) * speed;
    p.age = 0.0;
    p.life = mix(e.life_min, e.life_max, rand(state));
    p.size_start = e.size_start;
    p.size_end = e.size_end;
    p.color = e.color;
    p.frame = e.frame;
    p.angle = rand(state) * 6.2831853;
    p.spin = (rand(state) * 2.0 - 1.0) * e.spin;
    particles[(params.first_slot + i) % params.capacity] = p;
}
