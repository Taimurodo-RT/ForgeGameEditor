{
  "module": "std",
  "nodes": [
    { "id": "std.event.start", "kind": "event", "event": "on_start", "category": "События", "icon": "flag",
      "title": { "ru": "При старте", "en": "On start" },
      "help": { "ru": "Один раз, когда объект впервые оживает в мире." } },
    { "id": "std.event.tick", "kind": "event", "event": "on_tick", "category": "События", "icon": "update",
      "title": { "ru": "Каждый шаг", "en": "On tick" },
      "help": { "ru": "60 раз в секунду, пока объект рядом с игроком. dt — прошедшее время объекта." },
      "outputs": [ { "id": "dt", "type": "number", "title": { "ru": "Прошло секунд", "en": "dt" } } ] },
    { "id": "std.event.enter", "kind": "event", "event": "on_enter", "category": "События", "icon": "login",
      "title": { "ru": "При входе в зону", "en": "On enter" },
      "help": { "ru": "Кто-то вошёл в зону триггера этого объекта." },
      "outputs": [ { "id": "other", "type": "entity", "title": { "ru": "Кто вошёл", "en": "Other" } } ] },
    { "id": "std.event.leave", "kind": "event", "event": "on_leave", "category": "События", "icon": "logout",
      "title": { "ru": "При выходе из зоны", "en": "On leave" },
      "outputs": [ { "id": "other", "type": "entity", "title": { "ru": "Кто вышел", "en": "Other" } } ] },
    { "id": "std.event.hit", "kind": "event", "event": "on_hit", "category": "События", "icon": "crisis_alert",
      "title": { "ru": "При ударе", "en": "On hit" },
      "help": { "ru": "Тело объекта столкнулось с другим (0 — со стеной)." },
      "outputs": [ { "id": "other", "type": "entity", "title": { "ru": "С кем", "en": "Other" } } ] },
    { "id": "std.event.message", "kind": "event", "event": "on_message", "category": "События", "icon": "mail",
      "title": { "ru": "При сообщении", "en": "On message" },
      "help": { "ru": "Пришло сообщение от «Отправить сообщение». Пустое имя — любые сообщения." },
      "inputs": [ { "id": "filter", "type": "string", "constant": true, "title": { "ru": "Сообщение", "en": "Message" } } ],
      "outputs": [
        { "id": "name", "type": "string", "title": { "ru": "Имя", "en": "Name" } },
        { "id": "value", "type": "number", "title": { "ru": "Значение", "en": "Value" } },
        { "id": "from", "type": "entity", "title": { "ru": "От кого", "en": "From" } } ],
      "lua": "if {in:filter} == \"\" or {out:name} == {in:filter} then\n    {body}\nend" },

    { "id": "std.flow.if", "kind": "flow", "category": "Поток", "icon": "call_split",
      "title": { "ru": "Если", "en": "If" },
      "inputs": [ { "id": "cond", "type": "bool", "required": true, "title": { "ru": "Условие", "en": "Condition" } } ],
      "slots": [ { "id": "then", "title": { "ru": "Тогда", "en": "Then" } }, { "id": "else", "title": { "ru": "Иначе", "en": "Else" } } ],
      "lua": "if {in:cond} then\n    {slot:then}\nelse\n    {slot:else}\nend" },
    { "id": "std.flow.repeat", "kind": "flow", "category": "Поток", "icon": "repeat",
      "title": { "ru": "Повторить", "en": "Repeat" },
      "inputs": [ { "id": "count", "type": "integer", "value": "3", "title": { "ru": "Раз", "en": "Times" }, "has_range": true, "min": 0, "max": 100000 } ],
      "outputs": [ { "id": "index", "type": "integer", "title": { "ru": "Номер", "en": "Index" } } ],
      "slots": [ { "id": "body", "title": { "ru": "Тело цикла", "en": "Body" } }, { "id": "after", "title": { "ru": "После цикла", "en": "After" } } ],
      "lua": "for {out:index} = 1, {in:count} do\n    {slot:body}\nend\n{slot:after}" },
    { "id": "std.flow.for_each", "kind": "flow", "category": "Поток", "icon": "format_list_bulleted",
      "title": { "ru": "Для каждого", "en": "For each" },
      "inputs": [ { "id": "list", "type": "table", "required": true, "title": { "ru": "Список", "en": "List" } } ],
      "outputs": [
        { "id": "item", "type": "any", "title": { "ru": "Элемент", "en": "Item" } },
        { "id": "index", "type": "integer", "title": { "ru": "Номер", "en": "Index" } } ],
      "slots": [ { "id": "body", "title": { "ru": "Тело цикла", "en": "Body" } }, { "id": "after", "title": { "ru": "После цикла", "en": "After" } } ],
      "lua": "for {out:index}, {out:item} in ipairs({in:list}) do\n    {slot:body}\nend\n{slot:after}" },
    { "id": "std.flow.while", "kind": "flow", "category": "Поток", "icon": "all_inclusive",
      "title": { "ru": "Пока", "en": "While" },
      "help": { "ru": "Повторяет, пока условие верно. Внутри обычно есть «Ждать», иначе цикл займёт весь шаг." },
      "inputs": [ { "id": "cond", "type": "bool", "required": true, "title": { "ru": "Условие", "en": "Condition" } } ],
      "slots": [ { "id": "body", "title": { "ru": "Тело цикла", "en": "Body" } }, { "id": "after", "title": { "ru": "После цикла", "en": "After" } } ],
      "lua": "while true do\n    {pure}\n    if not ({in:cond}) then break end\n    {slot:body}\nend\n{slot:after}" },
    { "id": "std.flow.once", "kind": "flow", "category": "Поток", "icon": "looks_one",
      "title": { "ru": "Один раз", "en": "Do once" },
      "help": { "ru": "Блоки внутри выполнятся только в первый раз за всю жизнь объекта (запоминается в сохранении)." },
      "slots": [ { "id": "body", "title": { "ru": "Один раз", "en": "Once" } } ],
      "lua": "if not forge.var(self, \"__once_{uid}\", false) then\n    forge.set_var(self, \"__once_{uid}\", true)\n    {slot:body}\nend" },
    { "id": "std.flow.sequence", "kind": "flow", "category": "Поток", "icon": "fork_right",
      "title": { "ru": "Последовательность", "en": "Sequence" },
      "slots": [
        { "id": "step1", "title": { "ru": "Шаг 1", "en": "Step 1" } },
        { "id": "step2", "title": { "ru": "Шаг 2", "en": "Step 2" } },
        { "id": "step3", "title": { "ru": "Шаг 3", "en": "Step 3" } } ],
      "lua": "{slot:step1}\n{slot:step2}\n{slot:step3}" },
    { "id": "std.flow.break", "kind": "action", "category": "Поток", "icon": "block",
      "title": { "ru": "Прервать цикл", "en": "Break" },
      "lua": "break" },

    { "id": "std.self", "kind": "pure", "category": "Объекты", "icon": "person",
      "title": { "ru": "Этот объект", "en": "Self" },
      "outputs": [ { "id": "actor", "type": "entity", "title": { "ru": "Объект", "en": "Actor" } } ],
      "lua": "self" },
    { "id": "std.is_valid", "kind": "pure", "category": "Объекты", "icon": "check_circle",
      "title": { "ru": "Объект задан", "en": "Is set" },
      "inputs": [ { "id": "actor", "type": "entity", "title": { "ru": "Объект", "en": "Actor" } } ],
      "outputs": [ { "id": "ok", "type": "bool", "title": { "ru": "Да", "en": "Yes" } } ],
      "lua": "({in:actor} ~= nil and {in:actor} ~= 0 and forge.entity.alive({in:actor}))" },
    { "id": "std.same", "kind": "pure", "category": "Объекты", "icon": "join_inner",
      "title": { "ru": "Тот же объект", "en": "Same actor" },
      "inputs": [
        { "id": "a", "type": "entity", "required": true, "title": { "ru": "A", "en": "A" } },
        { "id": "b", "type": "entity", "value": "self", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "same", "type": "bool", "title": { "ru": "Да", "en": "Yes" } } ],
      "lua": "({in:a} == {in:b})" },

    { "id": "std.var.get", "kind": "pure", "category": "Переменные", "icon": "database",
      "title": { "ru": "Переменная", "en": "Variable" },
      "inputs": [ { "id": "name", "type": "string", "constant": true, "required": true, "title": { "ru": "Имя", "en": "Name" } } ],
      "outputs": [ { "id": "value", "type": "any", "title": { "ru": "Значение", "en": "Value" } } ],
      "lua": "forge.var(self, {in:name}, {vardefault})" },
    { "id": "std.var.set", "kind": "action", "category": "Переменные", "icon": "edit",
      "title": { "ru": "Задать переменную", "en": "Set variable" },
      "inputs": [
        { "id": "name", "type": "string", "constant": true, "required": true, "title": { "ru": "Имя", "en": "Name" } },
        { "id": "value", "type": "any", "title": { "ru": "Значение", "en": "Value" } } ],
      "lua": "forge.set_var(self, {in:name}, {in:value})" },
    { "id": "std.var.add", "kind": "action", "category": "Переменные", "icon": "exposure_plus_1",
      "title": { "ru": "Прибавить к переменной", "en": "Add to variable" },
      "inputs": [
        { "id": "name", "type": "string", "constant": true, "required": true, "title": { "ru": "Имя", "en": "Name" } },
        { "id": "amount", "type": "number", "value": "1", "title": { "ru": "Сколько", "en": "Amount" } } ],
      "lua": "forge.set_var(self, {in:name}, (forge.var(self, {in:name}, {vardefault}) or 0) + {in:amount})" },

    { "id": "std.logic.and", "kind": "pure", "category": "Логика", "icon": "join_inner",
      "title": { "ru": "И", "en": "And" },
      "inputs": [ { "id": "a", "type": "bool", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "bool", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "bool", "title": { "ru": "Да", "en": "Result" } } ],
      "lua": "({in:a} and {in:b})" },
    { "id": "std.logic.or", "kind": "pure", "category": "Логика", "icon": "join_full",
      "title": { "ru": "Или", "en": "Or" },
      "inputs": [ { "id": "a", "type": "bool", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "bool", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "bool", "title": { "ru": "Да", "en": "Result" } } ],
      "lua": "({in:a} or {in:b})" },
    { "id": "std.logic.not", "kind": "pure", "category": "Логика", "icon": "block",
      "title": { "ru": "Не", "en": "Not" },
      "inputs": [ { "id": "a", "type": "bool", "title": { "ru": "A", "en": "A" } } ],
      "outputs": [ { "id": "result", "type": "bool", "title": { "ru": "Да", "en": "Result" } } ],
      "lua": "(not {in:a})" },
    { "id": "std.compare", "kind": "pure", "category": "Логика", "icon": "calculate",
      "title": { "ru": "Сравнить", "en": "Compare" },
      "help": { "ru": "Операции: =, ≠, <, ≤, >, ≥." },
      "inputs": [
        { "id": "a", "type": "any", "title": { "ru": "A", "en": "A" } },
        { "id": "op", "type": "string", "constant": true, "value": ">=", "title": { "ru": "Как", "en": "Op" } },
        { "id": "b", "type": "any", "value": "0", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "bool", "title": { "ru": "Да", "en": "Result" } } ],
      "lua": "forge.compare({in:a}, {in:op}, {in:b})" },
    { "id": "std.select", "kind": "pure", "category": "Логика", "icon": "alt_route",
      "title": { "ru": "Выбрать", "en": "Select" },
      "inputs": [
        { "id": "cond", "type": "bool", "title": { "ru": "Если", "en": "If" } },
        { "id": "yes", "type": "any", "title": { "ru": "То", "en": "Then" } },
        { "id": "no", "type": "any", "title": { "ru": "Иначе", "en": "Else" } } ],
      "outputs": [ { "id": "value", "type": "any", "title": { "ru": "Значение", "en": "Value" } } ],
      "lua": "(if {in:cond} then {in:yes} else {in:no})" },

    { "id": "std.math.add", "kind": "pure", "category": "Математика", "icon": "add",
      "title": { "ru": "Сложить", "en": "Add" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "value": "1", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Сумма", "en": "Sum" } } ],
      "lua": "({in:a} + {in:b})" },
    { "id": "std.math.sub", "kind": "pure", "category": "Математика", "icon": "remove",
      "title": { "ru": "Вычесть", "en": "Subtract" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "value": "1", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Разность", "en": "Difference" } } ],
      "lua": "({in:a} - {in:b})" },
    { "id": "std.math.mul", "kind": "pure", "category": "Математика", "icon": "close",
      "title": { "ru": "Умножить", "en": "Multiply" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "value": "2", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Произведение", "en": "Product" } } ],
      "lua": "({in:a} * {in:b})" },
    { "id": "std.math.div", "kind": "pure", "category": "Математика", "icon": "percent",
      "title": { "ru": "Разделить", "en": "Divide" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "value": "2", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Частное", "en": "Quotient" } } ],
      "lua": "(if {in:b} == 0 then 0 else {in:a} / {in:b})" },
    { "id": "std.math.mod", "kind": "pure", "category": "Математика", "icon": "percent",
      "title": { "ru": "Остаток", "en": "Modulo" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "value": "2", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Остаток", "en": "Remainder" } } ],
      "lua": "(if {in:b} == 0 then 0 else {in:a} % {in:b})" },
    { "id": "std.math.min", "kind": "pure", "category": "Математика", "icon": "south",
      "title": { "ru": "Меньшее", "en": "Min" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Меньшее", "en": "Min" } } ],
      "lua": "math.min({in:a}, {in:b})" },
    { "id": "std.math.max", "kind": "pure", "category": "Математика", "icon": "north",
      "title": { "ru": "Большее", "en": "Max" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "number", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Большее", "en": "Max" } } ],
      "lua": "math.max({in:a}, {in:b})" },
    { "id": "std.math.clamp", "kind": "pure", "category": "Математика", "icon": "compress",
      "title": { "ru": "Ограничить", "en": "Clamp" },
      "inputs": [
        { "id": "value", "type": "number", "title": { "ru": "Число", "en": "Value" } },
        { "id": "min", "type": "number", "value": "0", "title": { "ru": "От", "en": "Min" } },
        { "id": "max", "type": "number", "value": "1", "title": { "ru": "До", "en": "Max" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Число", "en": "Result" } } ],
      "lua": "math.clamp({in:value}, math.min({in:min}, {in:max}), math.max({in:min}, {in:max}))" },
    { "id": "std.math.abs", "kind": "pure", "category": "Математика", "icon": "unfold_less",
      "title": { "ru": "Модуль", "en": "Abs" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "Число", "en": "Value" } } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Модуль", "en": "Abs" } } ],
      "lua": "math.abs({in:a})" },
    { "id": "std.math.floor", "kind": "pure", "category": "Математика", "icon": "vertical_align_bottom",
      "title": { "ru": "Округлить вниз", "en": "Floor" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "Число", "en": "Value" } } ],
      "outputs": [ { "id": "result", "type": "integer", "title": { "ru": "Целое", "en": "Integer" } } ],
      "lua": "math.floor({in:a})" },
    { "id": "std.math.round", "kind": "pure", "category": "Математика", "icon": "exposure",
      "title": { "ru": "Округлить", "en": "Round" },
      "inputs": [ { "id": "a", "type": "number", "title": { "ru": "Число", "en": "Value" } } ],
      "outputs": [ { "id": "result", "type": "integer", "title": { "ru": "Целое", "en": "Integer" } } ],
      "lua": "math.round({in:a})" },
    { "id": "std.math.lerp", "kind": "pure", "category": "Математика", "icon": "linear_scale",
      "title": { "ru": "Смешать", "en": "Lerp" },
      "inputs": [
        { "id": "a", "type": "number", "value": "0", "title": { "ru": "От", "en": "From" } },
        { "id": "b", "type": "number", "value": "1", "title": { "ru": "До", "en": "To" } },
        { "id": "t", "type": "number", "value": "0.5", "title": { "ru": "Доля", "en": "T" }, "has_range": true, "min": 0, "max": 1 } ],
      "outputs": [ { "id": "result", "type": "number", "title": { "ru": "Число", "en": "Result" } } ],
      "lua": "math.lerp({in:a}, {in:b}, {in:t})" },
    { "id": "std.math.vec2", "kind": "pure", "category": "Математика", "icon": "open_with",
      "title": { "ru": "Вектор", "en": "Make vector" },
      "inputs": [ { "id": "x", "type": "number", "title": { "ru": "X", "en": "X" } }, { "id": "y", "type": "number", "title": { "ru": "Y", "en": "Y" } } ],
      "outputs": [ { "id": "v", "type": "vec2", "title": { "ru": "Вектор", "en": "Vector" } } ],
      "lua": "vector.create({in:x}, {in:y}, 0)" },
    { "id": "std.math.split_vec2", "kind": "pure", "category": "Математика", "icon": "call_split",
      "title": { "ru": "Разобрать вектор", "en": "Break vector" },
      "inputs": [ { "id": "v", "type": "vec2", "required": true, "title": { "ru": "Вектор", "en": "Vector" } } ],
      "outputs": [ { "id": "x", "type": "number", "title": { "ru": "X", "en": "X" } }, { "id": "y", "type": "number", "title": { "ru": "Y", "en": "Y" } } ],
      "lua": "{out:x}, {out:y} = {in:v}.x, {in:v}.y" },
    { "id": "std.math.length", "kind": "pure", "category": "Математика", "icon": "straighten",
      "title": { "ru": "Длина вектора", "en": "Length" },
      "inputs": [ { "id": "v", "type": "vec2", "required": true, "title": { "ru": "Вектор", "en": "Vector" } } ],
      "outputs": [ { "id": "length", "type": "number", "title": { "ru": "Длина", "en": "Length" } } ],
      "lua": "vector.magnitude({in:v})" },

    { "id": "std.text.join", "kind": "pure", "category": "Текст", "icon": "text_fields",
      "title": { "ru": "Соединить текст", "en": "Join text" },
      "inputs": [ { "id": "a", "type": "any", "title": { "ru": "A", "en": "A" } }, { "id": "b", "type": "any", "title": { "ru": "B", "en": "B" } } ],
      "outputs": [ { "id": "text", "type": "string", "title": { "ru": "Текст", "en": "Text" } } ],
      "lua": "(tostring({in:a}) .. tostring({in:b}))" },

    { "id": "std.graph.entry", "kind": "event", "category": "Нода-граф", "icon": "input", "hidden": true,
      "title": { "ru": "Вход", "en": "Entry" },
      "help": { "ru": "Начало графа, который используется как нода. Его выходы — входы ноды." } },
    { "id": "std.graph.return", "kind": "action", "category": "Нода-граф", "icon": "output", "hidden": true,
      "title": { "ru": "Результат", "en": "Return" },
