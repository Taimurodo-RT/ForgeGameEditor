{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job",
  "description": "A job template for the job board.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/Ref"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Material"
      }
    },
    "meta": {
      "description": "Free data for your own needs; the runtime never reads it.",
      "default": null
    },
    "min_skill": {
      "anyOf": [
        {
          "$ref": "#/$defs/Int_0_20"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "$ref": "#/$defs/LocKey"
    },
    "schema": {
      "description": "`<kind>/<version>`, for example `action/1`.",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      }
    },
    "urgency": {
      "anyOf": [
        {
          "$ref": "#/$defs/Num_0_10000"
        },
        {
          "type": "null"
        }
      ]
    },
    "work": {
      "$ref": "#/$defs/Tag"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "name",
    "tags",
    "action",
    "work"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Int_0_20": {
      "type": "integer",
      "maximum": 20,
      "minimum": 0
    },
    "Int_1_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 1
    },
    "LocKey": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    },
    "Material": {
      "type": "object",
      "properties": {
        "count": {
          "$ref": "#/$defs/Int_1_2147483647"
        },
        "tag": {
          "$ref": "#/$defs/Tag"
        }
      },
      "additionalProperties": false,
      "required": [
        "tag",
        "count"
      ]
    },
    "Num_0_10000": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
