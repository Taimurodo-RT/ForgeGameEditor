{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Object",
  "description": "A smart object: slots, stock, advertised actions.",
  "type": "object",
  "properties": {
    "advertises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Advert"
      }
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "meta": {
      "description": "Free data for your own needs; the runtime never reads it.",
      "default": null
    },
    "name": {
      "$ref": "#/$defs/LocKey"
    },
    "perception_radius": {
      "anyOf": [
        {
          "$ref": "#/$defs/Num_0_327670000"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "description": "`<kind>/<version>`, for example `action/1`.",
      "type": "string"
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Slot"
      }
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Stock"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "name",
    "tags",
    "slots",
    "advertises"
  ],
  "$defs": {
    "Advert": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Ref"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocalId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "slots"
      ]
    },
    "Facing": {
      "type": "string",
      "enum": [
        "n",
        "e",
        "s",
        "w",
        "any"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Int_m2147483648_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -2147483648
    },
    "LocKey": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    },
    "LocalId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Num_0_327670000": {
      "type": "number",
      "maximum": 32767.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Num_m327680000_327670000": {
      "type": "number",
      "maximum": 32767.0,
      "minimum": -32768.0,
      "multipleOf": 0.0001
    },
    "Ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Slot": {
      "type": "object",
      "properties": {
        "facing": {
          "$ref": "#/$defs/Facing"
        },
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "offset": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Num_m327680000_327670000"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "offset",
        "facing"
      ]
    },
    "Stock": {
      "type": "object",
      "properties": {
        "max": {
          "$ref": "#/$defs/Int_m2147483648_2147483647"
        },
        "start": {
          "$ref": "#/$defs/Int_m2147483648_2147483647"
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "max"
      ]
    },
    "Tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
