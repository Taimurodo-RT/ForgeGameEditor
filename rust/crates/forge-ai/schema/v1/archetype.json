{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archetype",
  "description": "A villager template (level 3) or a choice-mode creature (level 2).",
  "type": "object",
  "properties": {
    "category_weights": {
      "type": "object",
      "properties": {
        "eat": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "event": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "idle": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "leisure": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "sleep": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "social": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "survival": {
          "$ref": "#/$defs/Num_0_40000"
        },
        "work": {
          "$ref": "#/$defs/Num_0_40000"
        }
      },
      "additionalProperties": false
    },
    "curves": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$": {
          "$ref": "#/$defs/Ref"
        }
      }
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "meta": {
      "description": "Free data for your own needs; the runtime never reads it.",
      "default": null
    },
    "mode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Mode"
        },
        {
          "type": "null"
        }
      ]
    },
    "move_speed": {
      "description": "Tiles per second of world time; without it `project.json` decides.",
      "anyOf": [
        {
          "$ref": "#/$defs/Num_1_327670000"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "$ref": "#/$defs/LocKey"
    },
    "schedule": {
      "description": "Required for `life`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "description": "`<kind>/<version>`, for example `action/1`.",
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      }
    },
    "think_ticks": {
      "description": "Only for `choice`: think every N core ticks.",
      "anyOf": [
        {
          "$ref": "#/$defs/Int_1_2147483647"
        },
        {
          "type": "null"
        }
      ]
    },
    "traits": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "name",
    "tags"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Int_1_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 1
    },
    "LocKey": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    },
    "Mode": {
      "type": "string",
      "enum": [
        "life",
        "choice"
      ]
    },
    "Num_0_40000": {
      "type": "number",
      "maximum": 4.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Num_1_327670000": {
      "type": "number",
      "maximum": 32767.0,
      "minimum": 0.0001,
      "multipleOf": 0.0001
    },
    "Ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
