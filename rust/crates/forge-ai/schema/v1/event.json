{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "A long event with phases (festival, siege, epidemic).",
  "type": "object",
  "properties": {
    "admission": {
      "anyOf": [
        {
          "$ref": "#/$defs/Admission"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "incompatible": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Incompatible"
      }
    },
    "meta": {
      "description": "Free data for your own needs; the runtime never reads it.",
      "default": null
    },
    "name": {
      "$ref": "#/$defs/LocKey"
    },
    "on_cancel": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Effect"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Phase"
      }
    },
    "priority": {
      "$ref": "#/$defs/Int_0_100"
    },
    "schema": {
      "description": "`<kind>/<version>`, for example `action/1`.",
      "type": "string"
    },
    "start": {
      "$ref": "#/$defs/EventStart"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "name",
    "tags",
    "priority",
    "start",
    "phases"
  ],
  "$defs": {
    "Admission": {
      "type": "object",
      "properties": {
        "curve": {
          "$ref": "#/$defs/Ref"
        },
        "input": {
          "description": "Input from the manifest.",
          "$ref": "#/$defs/LocalId"
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "curve"
      ]
    },
    "Cond": {
      "description": "A condition. JSON form: an object with one key, the operation name.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "stock_gte": {
              "type": "object",
              "properties": {
                "tag": {
                  "$ref": "#/$defs/Tag"
                },
                "value": {
                  "$ref": "#/$defs/Num_m327680000_327670000"
                }
              },
              "additionalProperties": false,
              "required": [
                "tag",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "stock_gte"
          ]
        },
        {
          "type": "object",
          "properties": {
            "has_tag": {
              "type": "object",
              "properties": {
                "tag": {
                  "$ref": "#/$defs/Tag"
                }
              },
              "additionalProperties": false,
              "required": [
                "tag"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "has_tag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "flag_is": {
              "type": "object",
              "properties": {
                "flag": {
                  "$ref": "#/$defs/LocalId"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "flag",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "flag_is"
          ]
        },
        {
          "type": "object",
          "properties": {
            "time_between": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/$defs/TimeOfDay"
                },
                "to": {
                  "$ref": "#/$defs/TimeOfDay"
                }
              },
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "time_between"
          ]
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Cond"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Cond"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Cond"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        },
        {
          "type": "object",
          "properties": {
            "need_below": {
              "type": "object",
              "properties": {
                "need": {
                  "$ref": "#/$defs/Ref"
                },
                "value": {
                  "$ref": "#/$defs/Num_0_1000000"
                }
              },
              "additionalProperties": false,
              "required": [
                "need",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "need_below"
          ]
        },
        {
          "type": "object",
          "properties": {
            "need_above": {
              "type": "object",
              "properties": {
                "need": {
                  "$ref": "#/$defs/Ref"
                },
                "value": {
                  "$ref": "#/$defs/Num_0_1000000"
                }
              },
              "additionalProperties": false,
              "required": [
                "need",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "need_above"
          ]
        },
        {
          "type": "object",
          "properties": {
            "has_trait": {
              "type": "object",
              "properties": {
                "trait": {
                  "$ref": "#/$defs/Ref"
                }
              },
              "additionalProperties": false,
              "required": [
                "trait"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "has_trait"
          ]
        },
        {
          "type": "object",
          "properties": {
            "day_part_is": {
              "type": "object",
              "properties": {
                "part": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "additionalProperties": false,
              "required": [
                "part"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "day_part_is"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_phase_is": {
              "type": "object",
              "properties": {
                "event": {
                  "$ref": "#/$defs/Ref"
                },
                "phase": {
                  "$ref": "#/$defs/LocalId"
                }
              },
              "additionalProperties": false,
              "required": [
                "event",
                "phase"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "event_phase_is"
          ]
        }
      ]
    },
    "Effect": {
      "description": "An effect. JSON form: an object with one key, the operation name.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "stock_add": {
              "type": "object",
              "properties": {
                "tag": {
                  "$ref": "#/$defs/Tag"
                },
                "value": {
                  "$ref": "#/$defs/Num_m327680000_327670000"
                }
              },
              "additionalProperties": false,
              "required": [
                "tag",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "stock_add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "set_flag": {
              "type": "object",
              "properties": {
                "flag": {
                  "$ref": "#/$defs/LocalId"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "flag",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "set_flag"
          ]
        },
        {
          "type": "object",
          "properties": {
            "emit_stimulus": {
              "type": "object",
              "properties": {
                "stimulus": {
                  "$ref": "#/$defs/Ref"
                }
              },
              "additionalProperties": false,
              "required": [
                "stimulus"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "emit_stimulus"
          ]
        },
        {
          "type": "object",
          "properties": {
            "need_add": {
              "type": "object",
              "properties": {
                "need": {
                  "$ref": "#/$defs/Ref"
                },
                "value": {
                  "$ref": "#/$defs/Num_m327680000_327670000"
                }
              },
              "additionalProperties": false,
              "required": [
                "need",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "need_add"
          ]
        },
        {
          "type": "object",
          "properties": {
            "emotion_add": {
              "type": "object",
              "properties": {
                "emotion": {
                  "$ref": "#/$defs/Ref"
                },
                "value": {
                  "$ref": "#/$defs/Num_m327680000_327670000"
                }
              },
              "additionalProperties": false,
              "required": [
                "emotion",
                "value"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "emotion_add"
          ]
        }
      ]
    },
    "EventStart": {
      "description": "When an event starts: by the calendar (`season` + `day` or `every_days` + `offset`)\nor by a world condition (`trigger`). Exactly one form.",
      "type": "object",
      "properties": {
        "day": {
          "anyOf": [
            {
              "$ref": "#/$defs/Int_1_2147483647"
            },
            {
              "type": "null"
            }
          ]
        },
        "every_days": {
          "anyOf": [
            {
              "$ref": "#/$defs/Int_1_2147483647"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Int_0_2147483647"
            },
            {
              "type": "null"
            }
          ]
        },
        "season": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cond"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Incompatible": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/Ref"
        },
        "rule": {
          "$ref": "#/$defs/OverlapRule"
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "rule"
      ]
    },
    "Int_0_100": {
      "type": "integer",
      "maximum": 100,
      "minimum": 0
    },
    "Int_0_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 0
    },
    "Int_1_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 1
    },
    "LocKey": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    },
    "LocalId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Num_0_1000000": {
      "type": "number",
      "maximum": 100.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Num_m327680000_327670000": {
      "type": "number",
      "maximum": 32767.0,
      "minimum": -32768.0,
      "multipleOf": 0.0001
    },
    "OverlapRule": {
      "type": "string",
      "enum": [
        "pause",
        "cancel"
      ]
    },
    "Phase": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhaseAction"
          }
        },
        "duration": {
          "$ref": "#/$defs/PhaseDuration"
        },
        "id": {
          "$ref": "#/$defs/LocalId"
        },
        "jobs": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          }
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weights": {
          "type": "object",
          "properties": {
            "eat": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "event": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "idle": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "leisure": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "sleep": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "social": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "survival": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            },
            "work": {
              "$ref": "#/$defs/Num_m327680000_327670000"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "duration"
      ]
    },
    "PhaseAction": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Ref"
        },
        "bucket": {
          "$ref": "#/$defs/LocalId"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "bucket"
      ]
    },
    "PhaseDuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Int_0_2147483647"
        },
        {
          "$ref": "#/$defs/Until"
        }
      ]
    },
    "Ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "TimeOfDay": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "Until": {
      "type": "object",
      "properties": {
        "until": {
          "$ref": "#/$defs/TimeOfDay"
        }
      },
      "additionalProperties": false,
      "required": [
        "until"
      ]
    }
  }
}
