{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stimulus",
  "description": "A kind of stimulus and its channels.",
  "type": "object",
  "properties": {
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LocalId"
      }
    },
    "duration": {
      "$ref": "#/$defs/Int_0_2147483647"
    },
    "id": {
      "$ref": "#/$defs/Id"
    },
    "interrupts": {
      "type": "boolean"
    },
    "meta": {
      "description": "Free data for your own needs; the runtime never reads it.",
      "default": null
    },
    "name": {
      "$ref": "#/$defs/LocKey"
    },
    "radius": {
      "$ref": "#/$defs/Num_0_327670000"
    },
    "schema": {
      "description": "`<kind>/<version>`, for example `action/1`.",
      "type": "string"
    },
    "strength": {
      "$ref": "#/$defs/Num_0_10000"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tag"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "name",
    "tags",
    "channels",
    "radius",
    "duration",
    "interrupts",
    "strength"
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z]+\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "Int_0_2147483647": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 0
    },
    "LocKey": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^loc(\\.[a-z0-9_]+)+$"
    },
    "LocalId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Num_0_10000": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Num_0_327670000": {
      "type": "number",
      "maximum": 32767.0,
      "minimum": 0.0,
      "multipleOf": 0.0001
    },
    "Tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
