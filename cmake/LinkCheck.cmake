# forge_check_not_linked(<library> <target>...): stops the configure when any of the targets links the library, directly
# or through the libraries it links. ThorVG draws «Пиксельные» in the editor only (docs/models/вектор-модель.md, step
# 2): a game, its package and the modules get the baked pictures, never the library.
function(_forge_links_of target out)
  set(found)
  foreach(prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(libs ${target} ${prop})
    if(libs)
      foreach(lib IN LISTS libs)
        # $<LINK_ONLY:x> and the like: the name inside.
        string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" lib "${lib}")
        if(lib MATCHES "^\\$<" OR lib MATCHES "^-")
          continue()
        endif()
        if(TARGET ${lib})
          get_target_property(real ${lib} ALIASED_TARGET)
          if(real)
            set(lib ${real})
          endif()
          list(APPEND found ${lib})
        endif()
      endforeach()
    endif()
  endforeach()
  set(${out} ${found} PARENT_SCOPE)
endfunction()

function(forge_check_not_linked library)
  foreach(target IN LISTS ARGN)
    set(seen)
    set(queue ${target})
    set(path_${target} ${target})
    while(queue)
      list(POP_FRONT queue t)
      if(t IN_LIST seen)
        continue()
      endif()
      list(APPEND seen ${t})
      _forge_links_of(${t} libs)
      foreach(lib IN LISTS libs)
        if(NOT DEFINED path_${lib})
          set(path_${lib} "${path_${t}} -> ${lib}")
        endif()
        if(lib STREQUAL library)
          message(FATAL_ERROR "${target} links ${library} (${path_${lib}}): only the editor may (cmake/LinkCheck.cmake)")
        endif()
        list(APPEND queue ${lib})
      endforeach()
    endwhile()
  endforeach()
endfunction()
