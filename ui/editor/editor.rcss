/* Layout of the editor window (ui/editor/editor.rml). The world is drawn
   under #viewport, so the body and the viewport have no background. */

body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

#topbar {
    height: 52px;
    padding: 0px var(--space-3);
    background-color: var(--surface-container-low);
    border-bottom-width: var(--border-hairline);
    border-bottom-color: var(--outline-variant);
}
.brand {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--primary);
    padding-right: var(--space-2);
}
.scene-name { margin-left: var(--space-2); white-space: nowrap; }
.dirty-dot { width: 8px; height: 8px; border-radius: var(--radius-full); background-color: var(--warning); margin-left: var(--space-1); }
#topbar .hint { margin-left: var(--space-3); font-size: 12px; white-space: nowrap; }

/* The game that is open, its menu, and the windows «Новая игра из шаблона», unsaved changes and notes. */
.pj-game.selected { background-color: var(--state-hover-layer); }
.as-menu.pj-menu { top: 40px; width: 320px; z-index: 90; }
.pj-backdrop { z-index: 85; }
.pj-where { padding: var(--space-1) var(--space-2); font-size: 12px; color: var(--on-surface-variant); }
.pj-scrim {
    position: absolute;
    left: 0px; top: 0px; right: 0px; bottom: 0px;
    z-index: 90;
    background-color: rgba(0, 0, 0, 0.45);
}
.pj-window {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 64px;
    bottom: 64px;
    z-index: 95;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 10px;
    background-color: var(--surface-container-high);
    border-width: var(--border-hairline);
    border-color: var(--outline-variant);
}
.pj-window.pj-small { left: 30%; right: 30%; top: 30%; bottom: auto; }
.pj-head { align-items: center; gap: var(--space-2); }
.pj-title { font-size: 16px; font-weight: bold; }
.pj-lead { font-size: 13px; color: var(--on-surface-variant); }
.pj-body { gap: var(--space-4); min-height: 0px; align-items: stretch; }
.pj-list { flex: 3 1 0px; min-width: 0px; gap: var(--space-2); overflow-y: auto; padding-right: 6px; justify-content: flex-start; }
.pj-form { flex: 2 1 0px; min-width: 0px; gap: var(--space-1); justify-content: flex-start; }
.pj-card {
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: 8px;
    cursor: pointer;
    border-width: var(--border-hairline);
    border-color: var(--outline-variant);
    background-color: var(--surface-container);
}
.pj-card:hover { background-color: var(--state-hover-layer); }
.pj-card.selected { border-color: var(--primary); background-color: var(--secondary-container); color: var(--on-secondary-container); }
.pj-pic { width: 160px; height: 90px; flex: 0 0 160px; border-radius: 6px; overflow: hidden; background-color: var(--surface-container-low); }
.pj-pic img { width: 160px; height: 90px; }
.pj-text { gap: 3px; min-width: 0px; }
.pj-name { font-size: 15px; font-weight: bold; }
.pj-about { font-size: 13px; }
.pj-module { font-size: 12px; color: var(--on-surface-variant); }
.pj-blocked { font-size: 12px; color: var(--error); }
.pj-where-row { gap: var(--space-2); align-items: center; }
.pj-folder { font-size: 13px; padding: 4px 0px; color: var(--on-surface-variant); }
.pj-folder.ok { color: var(--on-surface); }
.pj-problem { font-size: 13px; padding: 6px var(--space-2); border-radius: 6px; background-color: var(--error-container); color: var(--on-error-container); }
.pj-unsaved-line { font-size: 13px; padding-left: var(--space-3); }
.pj-foot { gap: var(--space-2); align-items: center; }
#pj-create.disabled { opacity: 0.4; cursor: default; }

#editor-tabs {
    height: 40px;
    padding: 0px var(--space-2);
    gap: var(--space-1);
    background-color: var(--surface-container-low);
    border-bottom-width: var(--border-hairline);
    border-bottom-color: var(--outline-variant);
}
.editor-tab {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    height: 40px;
    padding: 0px var(--space-3);
    color: var(--on-surface-variant);
    font-size: 13px;
    border-bottom-width: var(--border-strong);
    border-bottom-color: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: color background-color border-bottom-color var(--duration-short) var(--ease-standard);
}
.editor-tab icon { font-size: var(--icon-s); line-height: var(--icon-s); }
.editor-tab:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.editor-tab.selected { color: var(--primary); border-bottom-color: var(--primary); }

#placeholder {
    flex: 1 1 0px;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background-color: var(--surface);
}
#placeholder icon.big { font-size: 64px; line-height: 64px; color: var(--primary); }
#placeholder .muted { max-width: 480px; text-align: center; }

#main {
    flex: 1 1 0px;
    align-items: stretch;
    gap: var(--space-2);
    padding: var(--space-2);
    min-height: 0px;
}
#hierarchy-panel { width: 300px; }
#inspector-panel { width: 340px; }
#center { gap: var(--space-2); min-width: 0px; }

#hierarchy { margin: var(--space-1); }
.panel-footer {
    padding: var(--space-1) var(--space-4) var(--space-2) var(--space-4);
    font-size: 12px;
}
.tree-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-1);
    height: 26px;
    padding-right: var(--space-3);
    border-radius: var(--radius-xs);
    color: var(--on-surface);
    cursor: pointer;
}
.tree-row icon { color: var(--on-surface-variant); }
.tree-row .arrow { width: 16px; }
.tree-row .name { flex: 1 1 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-left: var(--space-1); }
.tree-row .kind { color: var(--on-surface-variant); font-family: var(--font-mono); font-size: 11px; }
.tree-row:hover { background-color: var(--state-hover-layer); }
.tree-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.tree-row.selected icon { color: var(--on-secondary-container); }

#viewport {
    flex: 1 1 0px;
    position: relative;
    border-radius: var(--radius-sm);
    border-width: var(--border-hairline);
    border-color: var(--outline-variant);
}
#viewport.playing { border-width: 2px; border-color: var(--primary); }
.viewport-label {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--inverse-surface);
    color: var(--inverse-on-surface);
    font-size: 12px;
}
.viewport-label.playing { background-color: var(--primary); color: var(--on-primary); }

#bottom-panel { height: 200px; }
.bottom-body {
    overflow-y: auto;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 18px;
}
.log-line { white-space: pre-wrap; color: var(--on-surface-variant); }
.log-line.warn { color: var(--warning); }
.log-line.error { color: var(--error); }
.history-line {
    padding: 0px var(--space-2);
    border-radius: var(--radius-xs);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 22px;
}
.history-line:hover { background-color: var(--state-hover-layer); }
.history-line.current { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.history-line.future { color: var(--on-surface-variant); opacity: 0.6; }

#inspector { overflow-y: auto; padding: var(--space-3) var(--space-2) var(--space-3) var(--space-3); }
#inspector .empty { padding: var(--space-4); text-align: center; }
.name-row { margin-bottom: var(--space-2); }
.selection-note { margin-bottom: var(--space-2); }
.component-header {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-2);
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: var(--surface-container-high);
    font-family: var(--title-small-family);
    font-size: var(--title-small-size);
    font-weight: var(--title-small-weight);
}
.prop { min-height: 36px; padding-right: var(--space-1); }
.prop-label {
    width: 96px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--on-surface-variant);
    font-size: 13px;
}
.prop-value { flex: 1 1 0px; min-width: 0px; }
.prop-value .number { width: 76px; }
.prop-value input.range { min-width: 40px; }
.swatch {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-xs);
    border-width: 1px;
    border-color: var(--outline);
}
.add-component { margin-top: var(--space-4); }
.add-component .label-small { margin-bottom: var(--space-2); }

#statusbar {
    height: 26px;
    padding: 0px var(--space-3);
    font-size: 12px;
    background-color: var(--surface-container-low);
    border-top-width: var(--border-hairline);
    border-top-color: var(--outline-variant);
}
