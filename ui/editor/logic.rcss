/* The «Логика» tab (the #logic part of editor.rml): the game's things on the
   left, the board with links in the middle, the logic in words on the right. */

#logic {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}
#logic .command { margin-top: var(--space-3); }

.lg-bar { height: 52px; gap: var(--space-2); align-items: center; }
.lg-modes {
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--surface-container-high);
}
.lg-mode {
    display: flex;
    flex-direction: row;
    height: 32px;
    gap: var(--space-2);
    align-items: center;
    padding: 0px var(--space-3);
    border-radius: 6px;
    font-size: 14px;
    color: var(--on-surface-variant);
}
.lg-mode icon { color: var(--on-surface-variant); }
.lg-mode.selected { background-color: var(--surface-container-lowest, var(--surface)); color: var(--on-surface); font-weight: 600; }
.lg-mode.selected icon { color: var(--primary); }
.lg-mode.soon { opacity: 0.55; }

.lg-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

/* The game's things */
.lg-nav {
    width: 230px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.lg-nav-title {
    margin: var(--space-3) var(--space-2) var(--space-1) var(--space-2);
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
}
.lg-nav-row {
    height: 36px;
    align-items: center;
    gap: var(--space-2);
    padding: 0px var(--space-2);
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
}
.lg-nav-row img { width: 28px; height: 28px; }
.lg-nav-row:hover { background-color: var(--state-hover-layer); }
.lg-nav-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-nav-row .count { font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); }
.lg-nav-row.add { color: var(--on-surface-variant); }
.lg-nav-row.add icon { color: var(--primary); }
.lg-nav-empty { padding: var(--space-2); line-height: 1.4; }

/* The board: dots on the background, things as cards, links as arrows */
.lg-board {
    flex: 1 1 0px;
    min-width: 0px;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background-color: var(--surface-container);
    cursor: move;
}
.lg-line {
    position: absolute;
    height: 3px;
    margin-top: -1px;
    transform-origin: 0px 1px;
    background-color: var(--primary);
}
.lg-head {
    position: absolute;
    width: 24px;
    height: 24px;
    font-size: 24px;
    color: var(--primary);
}
.lg-line.selected { background-color: var(--tertiary); height: 5px; margin-top: -2px; }
.lg-head.selected { color: var(--tertiary); }
.lg-line.broken { background-color: var(--error); }
.lg-head.broken { color: var(--error); }

.lg-thing {
    position: absolute;
    box-sizing: border-box;
    width: 112px;
    height: 112px;
    align-items: center;
    gap: 4px;
    padding: 10px 6px 6px 6px;
    border-radius: 10px;
    border: 2px var(--outline-variant);
    background-color: var(--surface-container-highest);
    cursor: pointer;
}
.lg-thing:hover { border-color: var(--outline); }
.lg-thing.selected { border-color: var(--tertiary); background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-thing.broken { border-color: var(--error); }
.lg-pic { width: 64px; height: 64px; }
.lg-pic img { width: 64px; height: 64px; }
.lg-thing .name {
    width: 100%;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lg-chip {
    position: absolute;
    height: 26px;
    gap: 4px;
    align-items: center;
    padding: 0px 10px;
    border-radius: 13px;
    transform: translate(-50%, -50%);
    background-color: var(--primary);
    color: var(--on-primary);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
}
.lg-chip icon { color: var(--on-primary); }
.lg-chip.selected { background-color: var(--tertiary); }
.lg-chip.broken { background-color: var(--error); }
.lg-refined {
    padding: 0px 5px;
    border-radius: 8px;
    font-size: 11px;
    background-color: var(--on-primary);
    color: var(--primary);
}

.lg-first {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 340px;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 8px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    font-size: 14px;
    line-height: 1.4;
    cursor: default;
}
.lg-first .title { font-weight: 600; }
.lg-first .button { align-self: flex-start; }

.lg-picker {
    position: absolute;
    box-sizing: border-box;
    width: 340px;
    max-height: 460px;
    overflow-y: auto;
    padding: var(--space-2);
    gap: 2px;
    border-radius: 8px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: default;
}
.lg-picker-head { align-items: center; padding: 0px 0px var(--space-1) var(--space-1); font-weight: 600; font-size: 14px; }
.lg-option { padding: var(--space-2); border-radius: 6px; gap: 2px; cursor: pointer; }
.lg-option:hover { background-color: var(--state-hover-layer); }
.lg-option icon { color: var(--primary); }
.lg-option .phrase { font-size: 14px; font-weight: 600; }
.lg-option .about { font-size: 12px; color: var(--on-surface-variant); padding-left: 24px; }
.lg-option.reversed .phrase { font-weight: normal; }

/* In words */
.lg-side {
    width: 340px;
    padding: var(--space-3);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.lg-side .section-title {
    margin: var(--space-3) 0px var(--space-1) 0px;
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
}
.lg-title { font-size: 18px; font-weight: 600; margin-bottom: var(--space-2); }
.lg-meaning { font-size: 14px; line-height: 1.45; }
.lg-problem { gap: var(--space-2); margin-bottom: var(--space-2); color: var(--error); font-size: 13px; }
.lg-problem icon { color: var(--error); }
.lg-preview {
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-3);
    border-radius: 6px;
    background-color: var(--surface-container-highest);
}
.lg-preview img { width: 112px; height: 112px; }
.lg-refine { gap: var(--space-2); padding: var(--space-1) 0px; cursor: pointer; font-size: 14px; }
.lg-refine icon { color: var(--primary); }
.lg-word {
    gap: 2px;
    margin-bottom: var(--space-2);
    padding: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-high);
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
}
.lg-word:hover { background-color: var(--state-hover-layer); }
.lg-word .phrase { font-weight: 600; }
.lg-word .problem { color: var(--error); }

/* «Шаги»: a card per link, its steps under «Когда / Если / Тогда / Иначе» */
.lg-steps {
    min-width: 0px;
    overflow-y: auto;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: 6px;
    background-color: var(--surface-container);
}
.lg-empty { padding: var(--space-3); }
.lg-card {
    max-width: 760px;
    gap: 2px;
    padding: var(--space-2) var(--space-3) var(--space-3) var(--space-3);
    border-radius: 10px;
    border: 2px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: pointer;
}
.lg-card.selected { border-color: var(--tertiary); }
.lg-card-head { height: 36px; align-items: center; font-size: 16px; font-weight: 600; }
.lg-step { align-items: stretch; min-height: 36px; }
.lg-part {
    width: 72px;
    padding-top: 9px;
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
}
.lg-step-body {
    align-items: center;
    gap: var(--space-2);
    margin: 2px 0px;
    padding: 4px var(--space-2) 4px var(--space-3);
    border-radius: 6px;
    border-left: 3px var(--primary);
    background-color: var(--surface-container-highest);
    font-size: 14px;
}
.lg-step.when .lg-step-body { border-left-color: var(--tertiary); }
.lg-step.when icon { color: var(--tertiary); }
.lg-step.if .lg-step-body { border-left-color: var(--secondary); }
.lg-step.if icon { color: var(--secondary); }
.lg-step.then icon { color: var(--primary); }
.lg-step.else .lg-step-body { border-left-color: var(--outline); }
.lg-step.else icon { color: var(--on-surface-variant); }
.lg-step-body .icon-button icon { color: var(--on-surface-variant); }
.lg-adds { align-items: center; gap: var(--space-2); margin: var(--space-2) 0px 0px 72px; }
.lg-add-list { gap: var(--space-1); flex-wrap: wrap; }
.lg-add-chip {
    padding: 4px 10px;
    border-radius: 13px;
    border: 1px var(--outline-variant);
    font-size: 13px;
    cursor: pointer;
}
.lg-add-chip:hover { background-color: var(--state-hover-layer); }

/* «Код» */
.lg-code-pane {
    min-width: 0px;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 6px;
    background-color: var(--surface-container);
}
.lg-code-note { gap: var(--space-2); align-items: center; font-size: 13px; color: var(--on-surface-variant); }
.lg-code-note icon { color: var(--primary); }
.lg-code {
    flex: 1 1 0px;
    min-height: 0px;
    overflow: auto;
    padding: var(--space-2) 0px;
    border-radius: 6px;
    background-color: var(--surface-container-lowest, var(--surface));
    font-family: var(--font-mono);
    font-size: 13px;
}
.lg-line-row { height: 21px; align-items: center; cursor: pointer; }
.lg-line-row:hover { background-color: var(--state-hover-layer); }
.lg-line-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-line-row .n { width: 44px; padding-right: 14px; text-align: right; color: var(--outline); }
.lg-line-row .t { white-space: pre; }
.lg-line-row.comment .t { color: var(--on-surface-variant); }

/* «Идеи»: a card per link, its things as fields */
.lg-ideas {
    position: relative;
    min-width: 0px;
    overflow-y: auto;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: 6px;
    background-color: var(--surface-container);
}
.lg-ideas-bar { align-items: center; gap: var(--space-3); }
.lg-gallery { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--space-2); }
.lg-idea {
    width: 260px;
    gap: 4px;
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: pointer;
}
.lg-idea:hover { border-color: var(--primary); }
.lg-idea icon { color: var(--primary); }
.lg-idea .name { font-weight: 600; font-size: 14px; }
.lg-idea .group { font-size: 11px; color: var(--on-surface-variant); }
.lg-idea .about { font-size: 12px; line-height: 1.35; color: var(--on-surface-variant); }
.lg-idea.off { opacity: 0.45; }
.lg-idea-cards { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--space-3); align-items: flex-start; }
.lg-recipe {
    width: 380px;
    padding-bottom: var(--space-2);
    border-radius: 12px;
    border: 2px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: pointer;
}
.lg-recipe.selected { border-color: var(--tertiary); }
.lg-recipe-head {
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: 10px 10px 0px 0px;
    background-color: var(--primary-container);
    color: var(--on-primary-container);
}
.lg-recipe-head icon { color: var(--on-primary-container); font-size: 28px; width: 28px; height: 28px; }
.lg-recipe-head .name { font-size: 16px; font-weight: 600; }
.lg-recipe-head .phrase { font-size: 12px; }
.lg-recipe .lg-problem { margin: var(--space-2) var(--space-3) 0px var(--space-3); }
.lg-field { align-items: center; gap: var(--space-2); padding: 6px var(--space-3); }
.lg-field .label { width: 150px; font-size: 14px; color: var(--on-surface-variant); }
.lg-thing-chip {
    align-items: center;
    gap: var(--space-2);
    height: 34px;
    padding: 0px var(--space-2) 0px 4px;
    border-radius: 6px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-highest);
    font-size: 14px;
    font-weight: 600;
}
.lg-thing-chip:hover { border-color: var(--primary); }
.lg-thing-chip img { width: 28px; height: 28px; }
.lg-recipe .lg-refine { padding: 3px var(--space-3); }
.lg-recipe .command { margin: var(--space-1) var(--space-2) 0px var(--space-2); }
.lg-chooser {
    position: absolute;
    top: 64px;
    right: 16px;
    width: 300px;
    max-height: 440px;
    overflow-y: auto;
    gap: 2px;
    padding: var(--space-2);
    border-radius: 8px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: default;
}
.lg-choice { align-items: center; gap: var(--space-2); height: 40px; padding: 0px var(--space-2); border-radius: 6px; cursor: pointer; font-size: 14px; }
.lg-choice:hover { background-color: var(--state-hover-layer); }
.lg-choice.current { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-choice img { width: 30px; height: 30px; }

/* What just happened in the running game */
.lg-line.lit { background-color: var(--success); height: 6px; margin-top: -2px; }
.lg-head.lit { color: var(--success); }
.lg-chip.lit { background-color: var(--success); }
.lg-card.lit, .lg-recipe.lit { border-color: var(--success); }
.lg-word.lit { border-left: 4px var(--success); }
.lg-line-row.lit { background-color: var(--primary-container); color: var(--on-primary-container); }

/* «Схема»: like Unreal's Blueprints, always dark: a grid, comment-like frames
   (one per link), nodes as wide as their rows (scheme_view.cpp has the sizes),
   curved wires drawn by <lines> */
.lg-scheme {
    flex: 1 1 0px;
    min-width: 0px;
    position: relative;
    overflow: hidden;
    clip: always; /* the world inside is moved by a transform: its overflow is not measured */
    background-color: #1d1e22;
    color: #e4e6eb;
    cursor: move;
}
.sc-lines { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; pointer-events: none; }
/* The world under the view: frames, wires and nodes, moved as one when panned */
.sc-world { position: absolute; left: 0px; top: 0px; width: 1px; height: 1px; }
.sc-world .sc-lines { width: 1px; height: 1px; }
.sc-node.hidden { display: none; }
.lg-scheme .lg-empty { color: #a9adb6; }

/* A frame: a comment box with a coloured title bar */
.sc-frame {
    position: absolute;
    box-sizing: border-box;
    border-radius: 6px;
    border: 1px #ffffff1c;
    background-color: #ffffff08;
}
.sc-frame.selected { border-color: #f0a33a; }
.sc-frame.lit { border-color: #66d17a; }
.sc-frame-head {
    height: 36px;
    align-items: center;
    gap: var(--space-2);
    padding: 0px var(--space-1) 0px var(--space-3);
    border-radius: 5px 5px 0px 0px;
    font-size: 14px;
    font-weight: 600;
    color: #e9ecf2;
    background-color: #3a4a63c0;
}
.sc-frame.custom .sc-frame-head { background-color: #5a3f6ec0; }
.sc-frame.own .sc-frame-head { background-color: #2f5a4ac0; }
.sc-frame-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-frame-head icon { color: #c7d0de; }
.sc-frame-head icon.err { color: #ff8a80; }
.sc-badge { font-size: 11px; font-weight: 600; padding: 1px 8px; border-radius: 8px; background-color: #ffffff22; color: #f0f2f6; }
.sc-head-button { align-items: center; gap: 4px; height: 26px; padding: 0px 8px; border-radius: 4px; font-size: 12px; font-weight: 500; color: #dfe4ec; cursor: pointer; }
.sc-head-button:hover { background-color: #ffffff1f; color: #ffffff; }
.sc-tools { position: absolute; right: 12px; top: 12px; z-index: 5; }
.sc-note { padding: var(--space-2) var(--space-3); font-size: 13px; color: #b8bdc7; }

/* A node: a dark glassy body, a header shaded with its kind's colour */
.sc-node {
    position: absolute;
    box-sizing: border-box;
    padding-bottom: 8px;
    border-radius: 8px;
    border: 1px #000000d0;
    background-color: #17181ce8;
    cursor: move;
}
.sc-node:hover { border-color: #ffffff40; }
.sc-node.selected { border: 2px #f0a33a; }
.sc-node.lit { border: 2px #66d17a; }
.sc-node.bad { border: 2px #e5534b; }
.sc-node.warn { border: 2px #c9a227; }
.sc-node-head {
    height: 30px;
    align-items: center;
    gap: var(--space-2);
    padding: 0px var(--space-1) 0px var(--space-2);
    border-radius: 7px 7px 0px 0px;
    font-size: 13px;
    font-weight: 600;
    color: #f4f6fa;
    decorator: linear-gradient(90deg, #5a6070 0%, #5a607000 100%);
}
.sc-node-head span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-node.event .sc-node-head { decorator: linear-gradient(90deg, #a82f2f 0%, #a82f2f00 100%); }
.sc-node.flow .sc-node-head { decorator: linear-gradient(90deg, #5d6475 0%, #5d647500 100%); }
.sc-node.action .sc-node-head { decorator: linear-gradient(90deg, #2c64a8 0%, #2c64a800 100%); }
.sc-node.pure .sc-node-head { decorator: linear-gradient(90deg, #3d7a4a 0%, #3d7a4a00 100%); }
.sc-node.links .sc-node-head { decorator: linear-gradient(90deg, #237f86 0%, #237f8600 100%); }
.sc-node.links-pure .sc-node-head { decorator: linear-gradient(90deg, #3b7a5c 0%, #3b7a5c00 100%); }
.sc-node.missing .sc-node-head { decorator: linear-gradient(90deg, #7a3434 0%, #7a343400 100%); }
.sc-node-head .sc-flag { color: #ffb4a9; }
.sc-row { height: 24px; align-items: center; gap: var(--space-2); font-size: 12px; color: #e4e6eb; }
.sc-in { align-items: center; gap: 6px; min-width: 0px; padding-left: 4px; }
.sc-out { align-items: center; gap: 6px; justify-content: flex-end; padding-right: 4px; }
.sc-label { white-space: nowrap; color: #c3c7cf; }

/* Pins: arrows for what happens, circles for values; full when wired */
.sc-pin { width: 16px; height: 16px; align-items: center; justify-content: center; display: flex; cursor: crosshair; color: #9aa3b5; }
.sc-pin shape { width: 12px; height: 14px; }
.sc-dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    box-sizing: border-box;
    border: 2px #9aa3b5;
}
.sc-pin.flow { color: #f2f2f2; }
.sc-pin.bool { color: #c2302f; }
.sc-pin.number { color: #9ee24b; }
.sc-pin.string { color: #f04fd2; }
.sc-pin.entity { color: #2f9df2; }
.sc-pin.vec2 { color: #f2c22f; }
.sc-pin.bool .sc-dot { border-color: #c2302f; }
.sc-pin.number .sc-dot { border-color: #9ee24b; }
.sc-pin.string .sc-dot { border-color: #f04fd2; }
.sc-pin.entity .sc-dot { border-color: #2f9df2; }
.sc-pin.vec2 .sc-dot { border-color: #f2c22f; }
.sc-pin.wired .sc-dot { background-color: #9aa3b5; }
.sc-pin.bool.wired .sc-dot { background-color: #c2302f; }
.sc-pin.number.wired .sc-dot { background-color: #9ee24b; }
.sc-pin.string.wired .sc-dot { background-color: #f04fd2; }
.sc-pin.entity.wired .sc-dot { background-color: #2f9df2; }
.sc-pin.vec2.wired .sc-dot { background-color: #f2c22f; }
.sc-pin.pending { color: #f0a33a; }
.sc-pin.pending .sc-dot { border-color: #f0a33a; background-color: #f0a33a; }
.sc-pin:hover { color: #ffffff; }
.sc-pin:hover .sc-dot { border-color: #ffffff; }
.sc-pin-gap { width: 16px; }

/* Values typed in: small dark fields, as in Unreal */
.sc-field {
    height: 18px;
    padding: 0px 6px;
    font-size: 12px;
    border-radius: 3px;
    border: 1px #ffffff26;
    background-color: #0d0e10;
    color: #f0f2f6;
    cursor: text;
}
.sc-field:focus { border-color: #f0a33a; }
.sc-field.sc-txt { width: 110px; }
.sc-field.sc-num { width: 52px; }
.sc-check { color: #e4e6eb; cursor: pointer; }
.sc-pick {
    flex: 0 1 auto;
    max-width: 150px;
    min-width: 0px;
    height: 18px;
    align-items: center;
    padding: 0px 2px 0px 6px;
    border-radius: 3px;
    border: 1px #ffffff26;
    background-color: #0d0e10;
    color: #f0f2f6;
    cursor: pointer;
}
.sc-pick:hover { border-color: #ffffff60; }
.sc-pick span { flex: 0 1 auto; min-width: 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-choose, .sc-palette {
    position: absolute;
    border-radius: 8px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-highest);
    padding: var(--space-1);
}
.sc-choose { min-width: 160px; max-height: 260px; overflow-y: auto; }
.sc-choice { padding: 4px var(--space-2); border-radius: 4px; font-size: 13px; cursor: pointer; }
.sc-choice:hover, .sc-pal-item:hover { background-color: var(--surface-container-high); }
.sc-palette { width: 280px; height: 380px; }
.sc-pal-head { align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-1) var(--space-2) var(--space-2); }
.sc-pal-list { flex: 1 1 0px; min-height: 0px; overflow-y: auto; }
.sc-pal-group { padding: var(--space-2) var(--space-2) 2px var(--space-2); font-size: 11px; font-weight: 600; color: var(--on-surface-variant); }
.sc-pal-item { align-items: center; gap: var(--space-2); padding: 4px var(--space-2); border-radius: 4px; font-size: 13px; cursor: pointer; }
.sc-pal-item icon { color: var(--on-surface-variant); }
.sc-pal-item.links icon, .sc-pal-item.links-pure icon { color: #4fc3c8; }
.sc-pal-item.action icon { color: #79aef0; }
.sc-pal-item.pure icon { color: #78cf8a; }
.sc-pal-item.event icon { color: #e57373; }
.sc-pal-none { padding: var(--space-2); }
.sc-tip {
    position: absolute;
    left: 12px;
    bottom: 12px;
    align-items: center;
    gap: var(--space-2);
    padding: 6px var(--space-3);
    border-radius: 8px;
    font-size: 13px;
    background-color: var(--tertiary-container);
    color: var(--on-tertiary-container);
}

/* «Код» block: a link's own code */
.lg-code-editor { gap: var(--space-2); padding: var(--space-3); min-height: 0px; }
.lg-code-head { align-items: center; gap: var(--space-2); font-weight: 600; }
.lg-code-head icon { color: var(--primary); }
.lg-code-help { font-size: 12px; color: var(--on-surface-variant); }
.lg-code-help b { color: var(--on-surface); font-weight: normal; font-family: var(--font-mono); }
.lg-code-text {
    min-height: 200px;
    padding: var(--space-2);
    border-radius: 6px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-lowest);
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: pre;
}
.lg-code-text:focus { border-color: var(--primary); }
