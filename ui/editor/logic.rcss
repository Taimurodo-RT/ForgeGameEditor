/* The «Логика» tab (the #logic part of editor.rml): the game's things on the
   left, the board with links in the middle, the logic in words on the right. */

#logic {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}
#logic .command { margin-top: var(--space-3); }

.lg-bar { height: 52px; gap: var(--space-2); align-items: center; }
.lg-modes {
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--surface-container-high);
}
.lg-mode {
    display: flex;
    flex-direction: row;
    height: 32px;
    gap: var(--space-2);
    align-items: center;
    padding: 0px var(--space-3);
    border-radius: 6px;
    font-size: 14px;
    color: var(--on-surface-variant);
}
.lg-mode icon { color: var(--on-surface-variant); }
.lg-mode.selected { background-color: var(--surface-container-lowest, var(--surface)); color: var(--on-surface); font-weight: 600; }
.lg-mode.selected icon { color: var(--primary); }
.lg-mode.soon { opacity: 0.55; }

.lg-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

/* The game's things */
.lg-nav {
    width: 230px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.lg-nav-title {
    margin: var(--space-3) var(--space-2) var(--space-1) var(--space-2);
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
}
.lg-nav-row {
    height: 36px;
    align-items: center;
    gap: var(--space-2);
    padding: 0px var(--space-2);
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
}
.lg-nav-row img { width: 28px; height: 28px; }
.lg-nav-row:hover { background-color: var(--state-hover-layer); }
.lg-nav-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-nav-row .count { font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); }
.lg-nav-row.add { color: var(--on-surface-variant); }
.lg-nav-row.add icon { color: var(--primary); }
.lg-nav-empty { padding: var(--space-2); line-height: 1.4; }

/* The board: dots on the background, things as cards, links as arrows */
.lg-board {
    flex: 1 1 0px;
    min-width: 0px;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background-color: var(--surface-container);
    cursor: move;
}
.lg-line {
    position: absolute;
    height: 3px;
    margin-top: -1px;
    transform-origin: 0px 1px;
    background-color: var(--primary);
}
.lg-head {
    position: absolute;
    width: 24px;
    height: 24px;
    font-size: 24px;
    color: var(--primary);
}
.lg-line.selected { background-color: var(--tertiary); height: 5px; margin-top: -2px; }
.lg-head.selected { color: var(--tertiary); }
.lg-line.broken { background-color: var(--error); }
.lg-head.broken { color: var(--error); }

.lg-thing {
    position: absolute;
    box-sizing: border-box;
    width: 112px;
    height: 112px;
    align-items: center;
    gap: 4px;
    padding: 10px 6px 6px 6px;
    border-radius: 10px;
    border: 2px var(--outline-variant);
    background-color: var(--surface-container-highest);
    cursor: pointer;
}
.lg-thing:hover { border-color: var(--outline); }
.lg-thing.selected { border-color: var(--tertiary); background-color: var(--secondary-container); color: var(--on-secondary-container); }
.lg-thing.broken { border-color: var(--error); }
.lg-pic { width: 64px; height: 64px; }
.lg-pic img { width: 64px; height: 64px; }
.lg-thing .name {
    width: 100%;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lg-chip {
    position: absolute;
    height: 26px;
    gap: 4px;
    align-items: center;
    padding: 0px 10px;
    border-radius: 13px;
    transform: translate(-50%, -50%);
    background-color: var(--primary);
    color: var(--on-primary);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
}
.lg-chip icon { color: var(--on-primary); }
.lg-chip.selected { background-color: var(--tertiary); }
.lg-chip.broken { background-color: var(--error); }
.lg-refined {
    padding: 0px 5px;
    border-radius: 8px;
    font-size: 11px;
    background-color: var(--on-primary);
    color: var(--primary);
}

.lg-first {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 340px;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 8px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    font-size: 14px;
    line-height: 1.4;
    cursor: default;
}
.lg-first .title { font-weight: 600; }
.lg-first .button { align-self: flex-start; }

.lg-picker {
    position: absolute;
    box-sizing: border-box;
    width: 340px;
    max-height: 460px;
    overflow-y: auto;
    padding: var(--space-2);
    gap: 2px;
    border-radius: 8px;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container-high);
    cursor: default;
}
.lg-picker-head { align-items: center; padding: 0px 0px var(--space-1) var(--space-1); font-weight: 600; font-size: 14px; }
.lg-option { padding: var(--space-2); border-radius: 6px; gap: 2px; cursor: pointer; }
.lg-option:hover { background-color: var(--state-hover-layer); }
.lg-option icon { color: var(--primary); }
.lg-option .phrase { font-size: 14px; font-weight: 600; }
.lg-option .about { font-size: 12px; color: var(--on-surface-variant); padding-left: 24px; }
.lg-option.reversed .phrase { font-weight: normal; }

/* In words */
.lg-side {
    width: 340px;
    padding: var(--space-3);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.lg-side .section-title {
    margin: var(--space-3) 0px var(--space-1) 0px;
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface-variant);
}
.lg-title { font-size: 18px; font-weight: 600; margin-bottom: var(--space-2); }
.lg-meaning { font-size: 14px; line-height: 1.45; }
.lg-problem { gap: var(--space-2); margin-bottom: var(--space-2); color: var(--error); font-size: 13px; }
.lg-problem icon { color: var(--error); }
.lg-preview {
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--space-3);
    border-radius: 6px;
    background-color: var(--surface-container-highest);
}
.lg-preview img { width: 112px; height: 112px; }
.lg-refine { gap: var(--space-2); padding: var(--space-1) 0px; cursor: pointer; font-size: 14px; }
.lg-refine icon { color: var(--primary); }
.lg-word {
    gap: 2px;
    margin-bottom: var(--space-2);
    padding: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-high);
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
}
.lg-word:hover { background-color: var(--state-hover-layer); }
.lg-word .phrase { font-weight: 600; }
.lg-word .problem { color: var(--error); }
