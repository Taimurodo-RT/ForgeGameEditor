/* The «Сюжет» tab (the #story part of editor.rml): conversations on the
   left, the script in the middle (a sheet in a book face), the test on the
   right. Marks: blue — when a line is spoken, violet — what it changes,
   grey — where the talk goes on. */

#story {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}

.st-bar { height: 52px; gap: var(--space-3); align-items: center; }
.st-crumb { gap: var(--space-1); align-items: center; color: var(--on-surface-variant); font-size: 14px; }
.st-crumb b { color: var(--on-surface); font-weight: 600; }

.st-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

/* Conversations and speakers */
.st-nav {
    width: 236px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.st-nav-row {
    min-height: 40px;
    align-items: center;
    gap: var(--space-2);
    padding: 0px var(--space-2);
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
}
.st-nav-row:hover { background-color: var(--state-hover-layer); }
.st-nav-row.selected { background-color: var(--surface-container-highest); font-weight: 600; }
.st-nav-row.add { color: var(--primary); font-weight: 600; }
.st-nav-row.add icon { color: var(--primary); }
.st-nav-row.muted { cursor: default; color: var(--on-surface-variant); }
.st-nav-row.muted:hover { background-color: transparent; }
.st-nav-row .count { font-size: 11.5px; font-weight: 600; color: var(--on-surface-variant); }
.st-nav-row.story { font-weight: 600; gap: var(--space-1); }
.st-nav-row.sub { padding-left: var(--space-5); min-height: 32px; font-size: 13.5px; }
.st-nav-row.scene { padding-left: 44px; min-height: 26px; font-size: 13px; color: var(--on-surface-variant); }
.st-nav-row.scene:hover { color: var(--on-surface); }
.st-nav-row.add.busy { opacity: 0.5; cursor: default; }
.st-import-text { padding: var(--space-1) var(--space-2); font-size: 12.5px; color: var(--on-surface-variant); }
.st-ava {
    display: block;
    width: 26px;
    height: 26px;
    line-height: 26px;
    border-radius: 13px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    color: #1b1408;
}
.st-hero-ava { background-color: var(--info); }

/* The script */
.st-script {
    flex: 1 1 0px;
    min-width: 0px;
    overflow-y: auto;
    padding: var(--space-4) var(--space-5);
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.st-hint {
    gap: var(--space-2);
    max-width: 1120px;
    margin: 0px auto var(--space-3) auto;
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    font-size: 13px;
    color: var(--on-surface-variant);
    background-color: var(--surface-container);
    border: 1px var(--outline-variant);
}
.st-hint icon { color: var(--primary); }
.st-sheet {
    max-width: 1120px;
    margin: 0px auto;
    padding: var(--space-5) var(--space-6) var(--space-6) var(--space-6);
    border-radius: 12px;
    background-color: var(--surface-container-lowest, var(--surface));
    border: 1px var(--outline-variant);
}
.st-label {
    gap: var(--space-1);
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--on-surface-variant);
}
.st-start {
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: 8px;
    background-color: var(--surface-container);
}
.st-rule { flex-wrap: wrap; gap: var(--space-2); align-items: center; padding: 2px var(--space-1); border-radius: 6px; }
.st-rule.lit { background-color: var(--primary-container); }

.st-part { gap: var(--space-1); }
.st-scene {
    gap: var(--space-2);
    margin: var(--space-5) -8px var(--space-1) -8px;
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    border-left: 4px var(--tertiary);
    background-color: var(--surface-container);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--on-surface);
    cursor: text;
}
.st-scene icon { color: var(--tertiary); }
.st-scene:hover { background-color: var(--surface-container-high); }
.st-line {
    gap: var(--space-1);
    padding: 6px var(--space-2) 0px var(--space-2);
    margin: 0px -8px;
    border-radius: 8px;
    border-left: 3px transparent;
}
.st-line:hover { background-color: var(--state-hover-layer); }
.st-line.lit { background-color: var(--primary-container); border-left-color: var(--primary); }
.st-line.flash { background-color: var(--tertiary-container); }
.st-note {
    font-family: Lora;
    font-style: italic;
    font-size: 15px;
    padding-left: 136px;
    color: var(--on-surface-variant);
    cursor: text;
}
.st-say-row { gap: var(--space-4); align-items: flex-start; }
.st-say-col { gap: var(--space-1); min-width: 0px; }
.st-who {
    width: 120px;
    gap: 2px;
    padding-top: 3px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-align: right;
    cursor: pointer;
}
.st-line.junction .st-who { color: var(--on-surface-variant); cursor: default; }
.st-pose { font-family: var(--font-sans); font-size: 11.5px; font-weight: 400; letter-spacing: 0px; color: var(--on-surface-variant); }
/* A line with nothing to say: a jump, a call, staging */
.st-line.silent { padding-top: 0px; padding-bottom: 0px; }
.st-line.silent .st-who { visibility: hidden; }
.st-line.silent .st-adds { display: none; }
.st-say {
    font-family: Lora;
    font-size: 17px;
    line-height: 1.55em;
    color: var(--on-surface);
    cursor: text;
}
.st-say.small { font-size: 15px; }
.st-say.empty, .st-answer.empty { color: var(--on-surface-variant); font-style: italic; }
.st-field {
    font-family: Lora;
    font-size: 16px;
    line-height: 1.6em;
    color: var(--on-surface);
    padding: 2px var(--space-2);
    border-radius: 4px;
    background-color: var(--surface-container-high);
    border: 2px var(--primary);
}
.st-nav .st-field { font-family: var(--font-sans); font-size: 14px; }
.st-scene-field { font-family: var(--font-display); font-size: 15px; margin-top: var(--space-5); }
.st-note-field { font-style: italic; font-size: 14.5px; }
.st-code { font-family: var(--font-mono); font-size: 13px; }

/* Marks */
.st-chips { flex-wrap: wrap; gap: var(--space-1); align-items: center; }
.st-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3px;
    height: 24px;
    padding: 0px 10px 0px 7px;
    border-radius: 12px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    border: 1px var(--outline-variant);
    background-color: var(--surface-container);
}
.st-chip:hover { background-color: var(--surface-container-high); }
.st-chip icon.s { font-size: 15px; }
.st-chip.cond { color: var(--info); border-color: var(--info); }
.st-chip.eff { color: var(--rarity-epic, var(--tertiary)); border-color: var(--rarity-epic, var(--tertiary)); }
.st-chip.go { color: var(--on-surface-variant); }
.st-chip.else { color: var(--info); cursor: default; }
.st-chip.code { color: var(--warning, #e0a050); border-color: var(--warning, #e0a050); }
.st-chip.stage { font-weight: 400; color: var(--on-surface-variant); border-color: transparent; background-color: var(--surface-container); }
.st-chip.stage.code { color: var(--warning, #e0a050); }
.st-stage { margin-left: 136px; margin-bottom: 2px; }
.st-stage-item { display: flex; }
/* Going on to the line just below: a mark only on the lit line («Дальше…»
   in the adding row otherwise). Hover never changes the layout: with a big
   talk a layout pass is the cost of a frame. */
.st-chip .more { margin-left: 2px; border-radius: 8px; }
.st-chip .more:hover { background-color: var(--state-hover-layer); }
.st-add-mark { width: 24px; height: 24px; line-height: 24px; text-align: center; border-radius: 12px; color: var(--on-surface-variant); cursor: pointer; }
.st-add-mark:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }

/* Questions in words */
.st-topics { gap: var(--space-2); margin-top: var(--space-1); }
.st-topic { gap: var(--space-3); align-items: flex-start; padding: var(--space-1) var(--space-2); border-radius: 8px; background-color: var(--surface-container); }
.st-topic.lit { background-color: var(--primary-container); }
.st-words { width: 190px; }
.st-word {
    display: block;
    padding: 2px var(--space-2);
    border-radius: 10px;
    font-size: 12.5px;
    color: var(--currency-gold, var(--tertiary));
    border: 1px var(--currency-gold, var(--tertiary));
    cursor: text;
}
.st-word.other { color: var(--on-surface-variant); border-color: var(--outline-variant); cursor: default; }
.st-x { width: 26px; height: 26px; line-height: 26px; text-align: center; border-radius: 13px; color: var(--on-surface-variant); cursor: pointer; }
.st-x:hover { background-color: var(--state-hover-layer); color: var(--error); }

/* The hero's answers */
.st-choices { gap: var(--space-1); margin-top: var(--space-1); }
.st-choice { gap: var(--space-2); align-items: flex-start; padding: 4px var(--space-2) 4px var(--space-2); border-left: 3px var(--info); border-radius: 0px 6px 6px 0px; background-color: var(--surface-container-low); }
.st-choice.lit { background-color: var(--primary-container); }
.st-hero { width: 22px; color: var(--info); }
.st-answer { font-family: Lora; font-size: 16px; line-height: 1.5em; color: var(--info); cursor: text; }

/* Adding */
/* Shown on the line under the mouse (opacity only: no layout) */
.st-adds { gap: 2px; height: 20px; opacity: 0; }
.st-line:hover .st-adds, .st-line.lit .st-adds { opacity: 1; }
.st-add {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2px;
    height: 20px;
    padding: 0px 6px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary);
    cursor: pointer;
}
.st-add:hover { background-color: var(--state-hover-layer); }
.st-add.danger, .st-add.quiet { color: var(--on-surface-variant); }
.st-add.quiet:hover { color: var(--on-surface); }
.st-add.danger:hover { color: var(--error); }
.st-add.big { align-self: flex-start; margin-top: var(--space-3); height: 32px; font-size: 13.5px; }

/* A big talk's pages */
.st-pages { align-items: center; gap: var(--space-2); }
.st-page-text { text-align: center; font-size: 13px; font-weight: 600; color: var(--on-surface-variant); }
.st-pages .button.disabled { opacity: 0.35; cursor: default; }

/* The test */
.st-test {
    width: 320px;
    padding: var(--space-2);
    gap: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-low);
    overflow-y: auto;
}
.st-screen {
    gap: var(--space-2);
    padding: var(--space-3);
    min-height: 220px;
    justify-content: flex-end;
    border-radius: 10px;
    background-color: var(--surface-container-lowest, var(--surface));
    border: 1px var(--outline-variant);
}
.st-bubble { gap: var(--space-1); padding: var(--space-2) var(--space-3); border-radius: 10px; background-color: var(--surface-container); border: 1px var(--outline-variant); }
.st-bubble-who { font-family: var(--font-display); font-weight: 700; font-size: 13px; }
.st-bubble-text { font-family: Lora; font-size: 15px; line-height: 1.55em; }
.st-ask { gap: var(--space-1); align-items: center; }
.st-ask .st-field { font-family: var(--font-sans); font-size: 14px; border-width: 1px; border-color: var(--outline-variant); }
.st-opt {
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    font-family: Lora;
    font-size: 14px;
    color: var(--info);
    background-color: var(--surface-container-high);
    cursor: pointer;
}
.st-opt:hover { background-color: var(--surface-container-highest); }
.st-opt.plain { font-family: var(--font-sans); font-style: normal; color: var(--on-surface); }
.st-ended { gap: var(--space-2); font-family: Lora; font-style: italic; font-size: 14px; color: var(--on-surface-variant); text-align: center; }
.st-state { gap: 2px; padding: var(--space-2); border-radius: 8px; background-color: var(--surface-container); }
.st-state-row { gap: var(--space-1); align-items: center; font-size: 13px; min-height: 30px; }
.st-state-row img { width: 22px; height: 22px; }
.st-value { min-width: 76px; text-align: center; font-weight: 600; font-size: 12.5px; }
.st-log { gap: 3px; min-height: 80px; padding: var(--space-2); border-radius: 8px; background-color: var(--surface-container); overflow-y: auto; font-size: 12.5px; color: var(--on-surface-variant); }
.st-log-row { gap: var(--space-1); align-items: flex-start; }
.st-log-row.eff { color: var(--rarity-epic, var(--tertiary)); }

/* A mark's list */
.st-menu {
    position: absolute;
    width: 360px;
    max-height: 430px;
    padding: var(--space-2);
    gap: var(--space-2);
    border-radius: 10px;
    background-color: var(--surface-container-high);
    border: 1px var(--outline-variant);
    box-shadow: 0px 6px 18px #00000066;
    z-index: 20;
}
.st-menu-list { gap: 1px; overflow-y: auto; max-height: 370px; }
.st-menu-item { gap: var(--space-2); align-items: center; min-height: 32px; padding: 0px var(--space-2); border-radius: 6px; font-size: 13.5px; cursor: pointer; }
.st-menu-item:hover { background-color: var(--state-hover-layer); }
.st-menu-item.current { color: var(--primary); font-weight: 600; }

/* The script is blocks, not nested flex columns: a flex column measures its
   children before placing them, so each level nested doubles the layout
   work (ten levels deep a big talk took seconds to lay out). */
.st-sheet, .st-part, .st-line, .st-say-col, .st-choices, .st-topics, .st-start,
.st-choice > .column, .st-topic > .column { display: block; }
.st-sheet > .st-pages, .st-sheet > .st-start, .st-sheet > .st-add { margin-top: var(--space-3); }
.st-sheet > .st-part { margin-top: 2px; }
.st-sheet > .st-pages:first-child { margin-top: 0px; }
.st-part > .st-line, .st-start > .st-rule { margin-top: 2px; }
.st-line > .st-note, .st-line > .st-say-row, .st-line > textarea { margin-top: var(--space-1); }
.st-line > .st-stage + .st-say-row, .st-line > .st-note + .st-say-row { margin-top: var(--space-1); }
.st-line > .st-stage:first-child, .st-line > .st-say-row:first-child, .st-line > .st-note:first-child { margin-top: 0px; }
.st-say-col > .st-chips, .st-say-col > .st-choices, .st-say-col > .st-topics { margin-top: var(--space-1); }
.st-say-col > .st-adds { margin-top: 2px; }
.st-choices > .st-choice + .st-choice, .st-topics > .st-topic + .st-topic, .st-topics > .st-topic { margin-top: var(--space-1); }
.st-choice > .column > .st-chips, .st-topic > .column > .st-chips { margin-top: 2px; }
.st-say, .st-answer { display: block; }

/* An imported story's cast and settings */
.st-nav-row.extra { color: var(--on-surface-variant); }
/* A talk without lines (code only: a poem game, the credits) */
.st-nav-row.empty { color: var(--on-surface-variant); }
.st-nav-row.extra icon { color: var(--tertiary); }
.st-nav-row.extra.selected { color: var(--on-surface); }
.st-page { display: block; max-width: 1120px; margin: 0px auto; }
.st-page-head { gap: var(--space-2); margin-bottom: var(--space-4); font-family: var(--font-display); font-size: 22px; font-weight: 700; }
.st-page-head icon { color: var(--tertiary); }
.st-page-sub { font-size: 13px; font-weight: 600; color: var(--on-surface-variant); font-family: var(--font-sans); }
.st-cards { flex-wrap: wrap; align-items: flex-start; gap: var(--space-3); }
.st-card {
    display: block;
    flex: 1 1 290px;
    max-width: 520px;
    padding: var(--space-3) var(--space-4);
    border-radius: 12px;
    background-color: var(--surface-container-lowest, var(--surface));
    border: 1px var(--outline-variant);
}
.st-card-head { gap: var(--space-3); margin-bottom: var(--space-2); }
.st-ava.big { width: 44px; height: 44px; line-height: 44px; border-radius: 22px; font-size: 20px; }
.st-card-names { display: block; min-width: 0px; }
.st-card-name { font-family: var(--font-display); font-size: 18px; font-weight: 700; }
.st-card-sub { font-size: 12px; color: var(--on-surface-variant); }
.st-card-count { display: block; text-align: right; }
.st-card-count b { display: block; font-family: var(--font-display); font-size: 20px; }
.st-card-count span { font-size: 11.5px; color: var(--on-surface-variant); }
.st-card-row { display: block; margin-top: var(--space-2); }
.st-card-label { font-size: 11.5px; font-weight: 600; letter-spacing: 0.3px; color: var(--on-surface-variant); }
.st-card-text { font-size: 13px; line-height: 1.45em; }
.st-card-text.code { font-family: var(--font-mono); font-size: 11.5px; color: var(--on-surface-variant); }
.st-novel-title { font-family: Lora; font-size: 24px; margin-bottom: 2px; }
.st-novel-info { font-size: 13px; font-weight: 600; color: var(--on-surface-variant); margin-bottom: var(--space-3); }
.st-page .st-hint { margin: 0px 0px var(--space-4) 0px; }
.st-set-group { display: block; margin-bottom: var(--space-4); padding: var(--space-2) var(--space-3); border-radius: 10px; background-color: var(--surface-container-lowest, var(--surface)); border: 1px var(--outline-variant); }
.st-set-title { gap: var(--space-2); padding: var(--space-1) 0px var(--space-2) 0px; font-family: var(--font-display); font-size: 15px; font-weight: 700; }
.st-set-title .count { font-size: 12px; color: var(--on-surface-variant); font-family: var(--font-sans); }
.st-set-row { gap: var(--space-3); align-items: flex-start; padding: 3px 0px; border-top: 1px var(--outline-variant); font-size: 13px; }
.st-set-name { flex: 0 0 300px; font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); }
.st-set-value { font-family: var(--font-mono); font-size: 12px; }
