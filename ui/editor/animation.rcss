/* The «Анимация» tab (the #animation part of editor.rml): templates with a picture on the left, the one selected
   playing in the middle over the frames of its picture, the states the game plays it in on the right. */

#animation {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}
.an-bar { height: 52px; gap: var(--space-3); align-items: center; }
.an-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

.an-nav {
    width: 250px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.an-row {
    min-height: 48px;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
}
.an-row:hover { background-color: var(--state-hover-layer); }
.an-row.selected { background-color: var(--surface-container-highest); font-weight: 600; }
.an-row img { width: 40px; height: 40px; }
.an-row .sub, .an-state .sub { font-size: 12px; font-weight: normal; color: var(--on-surface-variant); }
.an-empty, .an-hint, .an-sel-note { padding: var(--space-2); font-size: 13px; color: var(--on-surface-variant); }

.an-stage {
    padding: var(--space-2);
    gap: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-low);
    min-width: 0px;
}
.an-preview {
    flex: 1 1 0px;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--surface-container-highest);
}
.an-controls { gap: var(--space-1); align-items: center; justify-content: center; }
.an-strip-head { gap: var(--space-1); align-items: center; }
.an-label { font-size: 12px; font-weight: 600; color: var(--on-surface-variant); }
.an-count { min-width: 20px; text-align: center; font-weight: 600; }
.an-strip, .an-seq { flex-wrap: wrap; gap: var(--space-1); }
.an-frame {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px var(--outline-variant);
    border-radius: 6px;
    background-color: var(--surface-container);
    cursor: pointer;
}
.an-frame:hover { border-color: var(--outline); }
.an-frame.used { border-color: var(--tertiary); }
.an-frame.shown { border-color: var(--primary); background-color: var(--primary-container); }
.an-frame.small { width: 44px; height: 44px; cursor: default; }
.an-frame.small img { width: 36px; height: 36px; }
.an-num { position: absolute; left: 4px; top: 2px; font-size: 11px; font-weight: 600; color: var(--on-surface-variant); }

.an-side {
    width: 300px;
    padding: var(--space-1);
    gap: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.an-state {
    padding: var(--space-2);
    gap: 2px;
    border: 1px var(--outline-variant);
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
}
.an-state:hover { border-color: var(--outline); }
.an-state.selected { border-color: var(--tertiary); background-color: var(--secondary-container); color: var(--on-secondary-container); }
.an-tag { font-size: 11px; font-weight: 600; padding: 0px 6px; border-radius: 4px; color: var(--on-surface-variant); background-color: var(--surface-container-highest); }
.an-tag.own { color: var(--on-primary); background-color: var(--primary); }
.an-problem { font-size: 12px; color: var(--error); }
.an-actions { gap: var(--space-1); flex-wrap: wrap; }
.an-fps { flex-wrap: wrap; gap: 4px; padding: 0px var(--space-1); }
.an-chip {
    min-width: 32px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    padding: 0px 6px;
    border: 1px var(--outline-variant);
    border-radius: 14px;
    font-size: 13px;
    cursor: pointer;
}
.an-chip:hover { border-color: var(--outline); }
.an-chip.selected { border-color: var(--primary); background-color: var(--primary-container); color: var(--on-primary-container); font-weight: 600; }
.an-check { gap: var(--space-1); align-items: center; padding: var(--space-1) var(--space-2); font-size: 14px; cursor: pointer; }

.an-bar .lg-modes { margin-left: var(--space-3); }
.an-soon { font-size: 11px; color: var(--on-surface-variant); }

/* «Векторная»: the characters and the parts' tree, the code panel with its console, the views and the settings in a
   row; the player and the timeline along the bottom. */
.px-body { gap: var(--space-2); }
.px-top { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }
.px-nav { width: 220px; }
.px-stage { flex: 0 0 auto; overflow-y: auto; }
.px-views { gap: var(--space-2); flex-wrap: wrap; justify-content: center; }
.px-view { gap: var(--space-1); align-items: center; }
.px-canvas {
    width: 288px;
    height: 288px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--surface-container-highest);
}
#px-vector { cursor: crosshair; }
.px-one { gap: var(--space-1); align-items: center; }
.px-problem { white-space: pre-line; padding: var(--space-1) var(--space-2); }
.px-part {
    min-height: 28px;
    align-items: center;
    gap: var(--space-1);
    padding-right: var(--space-2);
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
}
.px-part:hover { background-color: var(--state-hover-layer); }
.px-part.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); font-weight: 600; }
.px-part .sub { font-size: 11px; color: var(--on-surface-variant); font-weight: normal; }
.px-field { gap: var(--space-1); align-items: center; padding: 2px var(--space-2); font-size: 13px; }
.px-field input { width: 64px; }
#px-outline-color { width: 84px; }
.px-clip { gap: var(--space-1); }
.an-chip.off { opacity: 0.6; }
.px-warn { gap: var(--space-1); padding: var(--space-2); border-radius: 6px; font-size: 13px; background-color: var(--error-container); color: var(--on-error-container); align-items: center; }
.px-give { gap: 2px; }
.px-inspector { gap: var(--space-1); padding: var(--space-1) var(--space-2); font-size: 13px; }
.px-inspector-text { white-space: pre-line; }
.px-call { font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); }
.px-inspector .px-field { padding: 2px 0px; }
#px-block-value { width: 84px; }
.px-timing-chip { gap: 4px; align-items: center; }
.px-timing-chip img, .px-timing-row img { width: 32px; height: 20px; }
.px-timings { max-height: 220px; overflow-y: auto; gap: 1px; border-radius: 6px; background-color: var(--surface-container-lowest); }
.px-timing-row { gap: var(--space-1); align-items: center; padding: 1px var(--space-2); font-size: 12px; cursor: pointer; }
.px-timing-row:hover { background-color: var(--state-hover-layer); }
.px-timing-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.px-why { white-space: pre-line; }
.px-value { gap: var(--space-1); align-items: center; min-height: 20px; }

/* The code panel: line numbers beside the text, the console under it. */
.px-code {
    flex: 1 1 0px;
    min-width: 260px;
    gap: var(--space-1);
    padding: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.px-code-head { gap: var(--space-1); align-items: center; font-size: 13px; font-weight: 600; min-height: 28px; }
.px-code-head icon { color: var(--primary); }
.px-code-box {
    flex: 1 1 0px;
    align-items: stretch; /* the text and its numbers as tall as the box, not centred in it as a .row */
    min-height: 120px;
    border: 1px var(--outline-variant);
    border-radius: 6px;
    background-color: var(--surface-container-lowest);
}
.px-gutter { position: relative; width: 36px; overflow: hidden; clip: always; border-right: 1px var(--outline-variant); }
/* clip: always, since RmlUi clips only a box whose scrolled content outgrows it, and the numbers are moved by their top */
.px-gutter-in { position: absolute; left: 0px; right: 0px; top: 0px; padding-top: 6px; }
.px-ln { height: 18px; line-height: 18px; padding-right: 6px; text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--outline); }
.px-ln.lit { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.px-ln.error { background-color: var(--error-container); color: var(--on-error-container); }
.px-code-text {
    padding: 6px var(--space-2);
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    white-space: pre;
}
.px-console-head { align-items: center; padding-top: var(--space-1); }
.px-console {
    height: 110px;
    overflow-y: auto;
    padding: 2px 0px;
    border-radius: 6px;
    background-color: var(--surface-container-lowest);
    font-family: var(--font-mono);
    font-size: 12px;
}
.px-con { padding: 1px var(--space-2); white-space: pre-line; }
.px-con.error { color: var(--error); }
.px-con.warn { color: var(--tertiary); }
.px-con.link { cursor: pointer; }
.px-con.link:hover { background-color: var(--state-hover-layer); }

/* The player and the timeline: a name column on the left, the time to the right of it on every row. */
.px-tl-panel { flex: 0 0 auto; gap: 2px; padding: var(--space-1) var(--space-2); border-radius: 6px; background-color: var(--surface-container-low); }
.px-player { gap: var(--space-1); align-items: center; min-height: 32px; }
.px-num { font-family: var(--font-mono); font-size: 12px; min-width: 80px; }
#px-time, #px-shown-fps { margin-left: var(--space-2); } /* the time and the frames shown each a word of its own */
.px-clips { gap: 4px; align-items: center; min-height: 32px; }
.px-tl { position: relative; gap: 2px; }
.px-tl-row { align-items: stretch; }
.px-tl-name { flex: 0 0 120px; width: 120px; font-size: 12px; color: var(--on-surface-variant); padding-right: var(--space-2); text-align: right; }
.px-tl-row > .px-tl-name { line-height: 22px; }
.px-tl-time { position: relative; flex: 1 1 0px; height: 22px; overflow: hidden; border-radius: 4px; background-color: var(--surface-container); }
.px-ruler-row .px-tl-time { height: 34px; cursor: pointer; }
.px-cell {
    position: absolute;
    top: 2px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    font-size: 10px;
    border-radius: 3px;
    background-color: var(--surface-container-highest);
    color: var(--on-surface-variant);
}
.px-cell.selected { background-color: var(--primary); color: var(--on-primary); font-weight: 600; }
.px-tick { position: absolute; top: 19px; height: 15px; padding-left: 3px; border-left: 1px var(--outline); font-size: 10px; line-height: 15px; color: var(--on-surface-variant); }
.px-range { position: absolute; top: 0px; bottom: 0px; background-color: var(--primary-container); opacity: 0.55; }
.px-edge { position: absolute; top: 0px; bottom: 0px; background-color: var(--primary); cursor: ew-resize; }
.px-trail { position: absolute; top: 4px; height: 14px; background-color: var(--surface-container-highest); }
.px-flag {
    position: absolute;
    top: 0px;
    height: 22px;
    width: 160px;
    border-left: 3px var(--tertiary);
    cursor: ew-resize;
}
.px-flag span { padding-left: 4px; font-size: 11px; line-height: 22px; color: var(--tertiary); }
.px-mark { position: absolute; top: 6px; height: 10px; border-radius: 5px; background-color: var(--secondary); }
.px-mark.span { border-radius: 2px; opacity: 0.7; }
.px-mark.sound { background-color: var(--tertiary); }
.px-mark.missing { background-color: var(--error); }
/* Part 3в: a row of a sound's waves (white in its picture, the colour of sound marks on screen); red without its file. */
.px-sound-row { height: 24px; }
.px-sound-row .px-tl-time { height: 24px; }
.px-wave { position: absolute; left: 0px; top: 0px; image-color: var(--tertiary); }
.px-sound-row.missing .px-tl-name { color: var(--error); }
.px-sound-row.missing .px-tl-time { background-color: var(--error-container); }
/* The line under the views: the zoom, the point under the mouse, the eyedropper's colour; the grid and the eyedropper. */
.px-view-line { gap: var(--space-2); align-items: center; min-height: 28px; padding: 0px var(--space-1); }
.px-swatch { width: 16px; height: 16px; border-radius: 3px; border: 1px var(--outline-variant); }
.px-pause { position: absolute; box-sizing: border-box; top: 3px; height: 16px; overflow: hidden; border-radius: 3px; font-size: 10px; line-height: 16px; padding-left: 3px; background-color: var(--surface-container-highest); color: var(--on-surface-variant); }
.px-tracks { position: relative; height: 104px; overflow-y: auto; }
.px-tracks-in { position: relative; }
.px-track-name { position: absolute; left: 0px; width: 112px; height: 20px; line-height: 20px; padding-right: 8px; text-align: right; font-size: 11px; color: var(--on-surface-variant); overflow: hidden; }
.px-blocks { position: absolute; left: 128px; right: 0px; top: 0px; bottom: 0px; } /* under the ruler, as .px-over */
.px-block {
    position: absolute;
    box-sizing: border-box; /* its box from its start to its end: the edges are where the mouse takes them */
    height: 18px;
    line-height: 16px;
    overflow: hidden;
    white-space: nowrap;
    padding-left: 3px;
    border-radius: 3px;
    font-size: 10px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    border: 1px var(--outline-variant);
    cursor: pointer;
}
.px-block.module { background-color: var(--surface-container-highest); color: var(--on-surface-variant); }
.px-block.lit { border-color: var(--tertiary); background-color: var(--tertiary-container); color: var(--on-tertiary-container); }
.px-block.selected { border-color: var(--primary); background-color: var(--primary); color: var(--on-primary); }
.px-tl.stale .px-block, .px-tl.stale .px-flag, .px-tl.stale .px-pause { opacity: 0.4; }
.px-tl-note { padding: 2px 0px 2px 128px; }
.px-over { position: absolute; left: 128px; right: 0px; top: 0px; bottom: 0px; pointer-events: none; }
.px-head { position: absolute; top: 0px; bottom: 0px; width: 2px; background-color: var(--error); pointer-events: none; }
