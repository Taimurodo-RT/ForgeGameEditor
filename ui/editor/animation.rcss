/* The «Анимация» tab (the #animation part of editor.rml): templates with a picture on the left, the one selected
   playing in the middle over the frames of its picture, the states the game plays it in on the right. */

#animation {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}
.an-bar { height: 52px; gap: var(--space-3); align-items: center; }
.an-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

.an-nav {
    width: 250px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.an-row {
    min-height: 48px;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
}
.an-row:hover { background-color: var(--state-hover-layer); }
.an-row.selected { background-color: var(--surface-container-highest); font-weight: 600; }
.an-row img { width: 40px; height: 40px; }
.an-row .sub, .an-state .sub { font-size: 12px; font-weight: normal; color: var(--on-surface-variant); }
.an-empty, .an-hint, .an-sel-note { padding: var(--space-2); font-size: 13px; color: var(--on-surface-variant); }

.an-stage {
    padding: var(--space-2);
    gap: var(--space-2);
    border-radius: 6px;
    background-color: var(--surface-container-low);
    min-width: 0px;
}
.an-preview {
    flex: 1 1 0px;
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background-color: var(--surface-container-highest);
}
.an-controls { gap: var(--space-1); align-items: center; justify-content: center; }
.an-strip-head { gap: var(--space-1); align-items: center; }
.an-label { font-size: 12px; font-weight: 600; color: var(--on-surface-variant); }
.an-count { min-width: 20px; text-align: center; font-weight: 600; }
.an-strip, .an-seq { flex-wrap: wrap; gap: var(--space-1); }
.an-frame {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px var(--outline-variant);
    border-radius: 6px;
    background-color: var(--surface-container);
    cursor: pointer;
}
.an-frame:hover { border-color: var(--outline); }
.an-frame.used { border-color: var(--tertiary); }
.an-frame.shown { border-color: var(--primary); background-color: var(--primary-container); }
.an-frame.small { width: 44px; height: 44px; cursor: default; }
.an-frame.small img { width: 36px; height: 36px; }
.an-num { position: absolute; left: 4px; top: 2px; font-size: 11px; font-weight: 600; color: var(--on-surface-variant); }
/* Marks of the code (part 5а of docs/models/движение-модель.md): an icon where they begin, a bar under a window. */
.an-mark { position: absolute; right: 2px; top: 2px; font-size: 13px; color: var(--tertiary); }
.an-window { position: absolute; left: 2px; right: 2px; bottom: 2px; height: 3px; border-radius: 2px; background-color: var(--tertiary); }
.an-marks { font-size: 12px; color: var(--on-surface-variant); }

.an-side {
    width: 300px;
    padding: var(--space-1);
    gap: var(--space-1);
    overflow-y: auto;
    border-radius: 6px;
    background-color: var(--surface-container-low);
}
.an-state {
    padding: var(--space-2);
    gap: 2px;
    border: 1px var(--outline-variant);
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
}
.an-state:hover { border-color: var(--outline); }
.an-state.selected { border-color: var(--tertiary); background-color: var(--secondary-container); color: var(--on-secondary-container); }
.an-tag { font-size: 11px; font-weight: 600; padding: 0px 6px; border-radius: 4px; color: var(--on-surface-variant); background-color: var(--surface-container-highest); }
.an-tag.own { color: var(--on-primary); background-color: var(--primary); }
.an-problem { font-size: 12px; color: var(--error); }
.an-actions { gap: var(--space-1); flex-wrap: wrap; }
.an-fps { flex-wrap: wrap; gap: 4px; padding: 0px var(--space-1); }
.an-chip {
    min-width: 32px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    padding: 0px 6px;
    border: 1px var(--outline-variant);
    border-radius: 14px;
    font-size: 13px;
    cursor: pointer;
}
.an-chip:hover { border-color: var(--outline); }
.an-chip.selected { border-color: var(--primary); background-color: var(--primary-container); color: var(--on-primary-container); font-weight: 600; }
.an-check { gap: var(--space-1); align-items: center; padding: var(--space-1) var(--space-2); font-size: 14px; cursor: pointer; }

.an-bar .lg-modes { margin-left: var(--space-3); }
.an-soon { font-size: 11px; color: var(--on-surface-variant); }

/* «Векторная» (step 7 of docs/models/движение-модель.md, «Вид по образцу»): the bar of the path, the three views and
   «Экспорт»; under it the tools' rail, the left panel («Слои», «Файлы») and the middle over the bottom panel, the right
   panel all down the side. What another view or tab of a panel has is in the page, not shown (.px-off), so its fields
   keep what they hold. Sizes are the model's, in px of the interface; the narrow window's at the end. */
.px-body { gap: var(--space-2); }
/* Two classes, so no rule of one class that shows a box as a row or a column shows it here. */
.px-body .px-off { display: none; }
.px-bar { flex: 0 0 auto; height: 40px; gap: var(--space-2); align-items: center; padding: 0px var(--space-2); border-radius: 6px; background-color: var(--surface-container-low); }
.px-path { gap: 6px; align-items: center; font-size: 14px; white-space: nowrap; }
.px-path-kind { color: var(--on-surface-variant); }
.px-path-name { font-weight: 600; }
.px-saved { font-size: 12px; color: var(--on-surface-variant); white-space: nowrap; }
.px-looks { gap: 2px; padding: 2px; border: 1px var(--outline-variant); border-radius: 16px; }
.px-look { height: 26px; line-height: 26px; padding: 0px 14px; border-radius: 13px; font-size: 13px; white-space: nowrap; cursor: pointer; }
.px-look:hover { background-color: var(--state-hover-layer); }
.px-look.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); font-weight: 600; }
.px-main { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }
.px-work { flex: 1 1 0px; min-width: 0px; min-height: 0px; }
/* The bottom panel: 34 % of the height under the bar in «Дизайн» and «Код», 58 % in «Анимация», 120 at least and the
   height − 160 at most (the part over it 154, and the grip 6); its height dragged is its style (px_tl_style). */
.px-upper { flex: 66 1 0px; min-height: 154px; gap: var(--space-2); align-items: stretch; }
.look-animation .px-upper { flex: 42 1 0px; }
.px-grip { flex: 0 0 auto; height: 6px; border-radius: 3px; cursor: ns-resize; }
.px-grip:hover, .px-split:hover { background-color: var(--outline-variant); }
.px-rail { flex: 0 0 auto; width: 46px; gap: 4px; align-items: center; padding: var(--space-1) 0px; border-radius: 6px; background-color: var(--surface-container-low); }
.px-tools { gap: 4px; align-items: center; }
.px-rail-line { width: 24px; height: 1px; margin: 2px 0px; background-color: var(--outline-variant); }
.px-tool { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 8px; cursor: pointer; }
.px-tool:hover { background-color: var(--state-hover-layer); }
.px-tool.selected { background-color: var(--primary-container); color: var(--on-primary-container); }
.px-left { flex: 0 0 auto; width: 216px; min-height: 0px; border-radius: 6px; background-color: var(--surface-container-low); }
.px-tabs { flex: 0 0 auto; gap: 2px; align-items: stretch; padding: 0px var(--space-1); }
.px-tab { height: 30px; line-height: 30px; padding: 0px 10px; font-size: 13px; white-space: nowrap; color: var(--on-surface-variant); border-bottom: 2px transparent; cursor: pointer; }
.px-tab:hover { color: var(--on-surface); }
.px-tab.selected { color: var(--primary); border-bottom-color: var(--primary); font-weight: 600; }
.px-badge { display: inline-block; min-width: 8px; height: 16px; line-height: 16px; padding: 0px 4px; margin-left: 2px; border-radius: 8px; font-size: 11px; text-align: center; background-color: var(--surface-container-highest); color: var(--on-surface-variant); }
.px-badge.bad { background-color: var(--error); color: var(--on-error); }
.px-pane { flex: 1 1 0px; min-height: 0px; overflow-y: auto; padding: var(--space-1); }
.px-center { flex: 1 1 0px; min-width: 0px; min-height: 0px; padding: var(--space-1); border-radius: 6px; background-color: var(--surface-container-low); }
.px-center-in { flex: 1 1 0px; min-height: 0px; gap: var(--space-1); align-items: stretch; }
.px-split { flex: 0 0 auto; width: 6px; border-radius: 3px; cursor: ew-resize; }
.px-stage { flex: 1 1 0px; min-width: 0px; min-height: 0px; gap: 2px; }
.px-canvas-head { flex: 0 0 auto; height: 32px; gap: var(--space-1); align-items: center; padding: 0px var(--space-1); }
/* The problem and the note under the canvas's line wrap at the middle's width: a long line does not widen it. */
.px-said { flex: 0 0 auto; }
.px-said > div { flex: 1 1 0px; min-width: 0px; }
/* Part 7а: the problem and the note lie over the top of the vector, under the canvas row, and take none of its height: the
   vector's frame keeps its size when they come and go. The mouse goes through them to the vector. */
.px-said-over { position: absolute; left: 0px; right: 0px; top: 0px; pointer-events: none; }
.px-said-over .px-said { background-color: var(--surface-container-high); }
/* The vector fills its frame: its picture is that frame's size in pixels of the window (px_vector_style), laid over it. */
.px-views { flex: 1 1 0px; min-height: 0px; gap: var(--space-1); align-items: stretch; }
.px-canvas { position: relative; overflow: hidden; border-radius: 6px; background-color: var(--surface-container-highest); }
.px-vector { flex: 1 1 0px; min-width: 0px; min-height: 0px; cursor: crosshair; }
#px-vector-img { position: absolute; left: 0px; top: 0px; }
.px-canvas-hint { position: absolute; left: 8px; right: 8px; bottom: 6px; white-space: nowrap; overflow: hidden; font-size: 11px; color: var(--on-surface-variant); opacity: 0.75; pointer-events: none; }
.px-pixel-col { flex: 0 0 auto; width: 200px; min-height: 0px; gap: 4px; }
.px-pixel-col.folded { width: 28px; }
.px-pixel-head { flex: 0 0 auto; min-height: 28px; gap: 4px; align-items: center; }
.px-pixel { flex: 1 1 0px; min-height: 0px; display: flex; align-items: center; justify-content: center; }
/* The frame in its real size under it, while it fits (pixel_editor.cpp); cut at the column's edges, never over them. */
.px-one { flex: 0 1 auto; min-height: 0px; overflow: hidden; gap: var(--space-1); align-items: center; }
.px-zoom { min-width: 48px; text-align: center; }
/* The right panel: «Свойства» or «Анимация», or «Экспорт» in their place. */
.px-side { flex: 0 0 auto; width: 270px; min-height: 0px; border-radius: 6px; background-color: var(--surface-container-low); }
.px-side-head { flex: 0 0 auto; height: 32px; gap: var(--space-1); align-items: center; padding: 0px var(--space-2); font-size: 13px; font-weight: 600; }
.px-side-pane { gap: var(--space-1); }
.px-problem { white-space: pre-line; padding: var(--space-1) var(--space-2); }
.px-part {
    min-height: 28px;
    align-items: center;
    gap: var(--space-1);
    padding-right: var(--space-2);
    border-radius: 6px;
    font-size: 13px;
    cursor: pointer;
}
.px-part:hover { background-color: var(--state-hover-layer); }
.px-part.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); font-weight: 600; }
.px-part .sub { flex: 0 0 auto; white-space: nowrap; font-size: 11px; color: var(--on-surface-variant); font-weight: normal; }
/* A long name in a narrow panel is cut, not written over its place. */
.px-part > span.grow { flex: 1 1 0px; min-width: 0px; white-space: nowrap; overflow: hidden; }
.px-field { gap: var(--space-1); align-items: center; padding: 2px var(--space-2); font-size: 13px; }
.px-field input { width: 64px; }
#px-outline-color { width: 84px; }
.px-clip { gap: var(--space-1); }
.an-chip.off { opacity: 0.6; }
.px-warn { gap: var(--space-1); padding: var(--space-2); border-radius: 6px; font-size: 13px; background-color: var(--error-container); color: var(--on-error-container); align-items: center; }
.px-give { gap: 2px; }
.px-inspector { gap: var(--space-1); padding: var(--space-1) var(--space-2); font-size: 13px; }
.px-inspector-text { white-space: pre-line; }
.px-call { font-family: var(--font-mono); font-size: 12px; color: var(--on-surface-variant); }
.px-inspector .px-field { padding: 2px 0px; }
#px-block-value { width: 84px; }
.px-timing-chip { gap: 4px; align-items: center; }
.px-timing-chip img, .px-timing-row img { width: 32px; height: 20px; }
.px-timings { max-height: 220px; overflow-y: auto; gap: 1px; border-radius: 6px; background-color: var(--surface-container-lowest); }
.px-timing-row { gap: var(--space-1); align-items: center; padding: 1px var(--space-2); font-size: 12px; cursor: pointer; }
.px-timing-row:hover { background-color: var(--state-hover-layer); }
.px-timing-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.px-why { white-space: pre-line; }
.px-value { gap: var(--space-1); align-items: center; min-height: 20px; }
/* Part 4ж: the part's fields in three sections; the graph of a block's easing. */
.px-pf-section { margin-top: var(--space-1); }
.px-pf-name { min-width: 72px; }
.px-pf-now { text-align: right; font-size: 11px; color: var(--on-surface-variant); }
.px-pf input { width: 84px; }
.px-ease { gap: 2px; }
.px-ease-graph { width: 200px; height: 180px; border-radius: 6px; background-color: var(--surface-container-lowest); cursor: pointer; }

/* The code panel: line numbers beside the text, the console under it. */
.px-code {
    flex: 0 0 48%;
    min-width: 0px;
    min-height: 0px;
    gap: var(--space-1);
}
.px-code-head { gap: var(--space-1); align-items: center; font-size: 13px; font-weight: 600; min-height: 28px; }
.px-code-head icon { color: var(--primary); }
.px-code-box {
    flex: 1 1 0px;
    align-items: stretch; /* the text and its numbers as tall as the box, not centred in it as a .row */
    min-height: 120px;
    border: 1px var(--outline-variant);
    border-radius: 6px;
    background-color: var(--surface-container-lowest);
}
.px-gutter { position: relative; width: 36px; overflow: hidden; clip: always; border-right: 1px var(--outline-variant); }
/* clip: always, since RmlUi clips only a box whose scrolled content outgrows it, and the numbers are moved by their top */
.px-gutter-in { position: absolute; left: 0px; right: 0px; top: 0px; padding-top: 6px; }
.px-ln { height: 18px; line-height: 18px; padding-right: 6px; text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--outline); }
.px-ln.lit { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.px-ln.error { background-color: var(--error-container); color: var(--on-error-container); }
.px-code-text {
    padding: 6px var(--space-2);
    color: var(--on-surface);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 18px;
    white-space: pre;
}
.px-console-head { align-items: center; padding-top: var(--space-1); }
.px-console {
    height: 110px;
    overflow-y: auto;
    padding: 2px 0px;
    border-radius: 6px;
    background-color: var(--surface-container-lowest);
    font-family: var(--font-mono);
    font-size: 12px;
}
.px-con { padding: 1px var(--space-2); white-space: pre-line; }
.px-con.error { color: var(--error); }
.px-con.warn { color: var(--tertiary); }
.px-con.link { cursor: pointer; }
.px-con.link:hover { background-color: var(--state-hover-layer); }

/* The player and the timeline: a name column on the left, the time to the right of it on every row. */
.px-tl-panel { flex: 34 1 0px; min-height: 120px; gap: 2px; padding: var(--space-1) var(--space-2); border-radius: 6px; background-color: var(--surface-container-low); }
.look-animation .px-tl-panel { flex: 58 1 0px; }
/* Its head: the tabs, the player and its switches, on two lines when they do not fit on one. */
.px-player { flex: 0 0 auto; flex-wrap: wrap; gap: var(--space-1); align-items: center; min-height: 32px; }
.px-tl-panel .px-pane { padding: 0px; }
/* The timeline's pane keeps its scrollbar's room always: a row that comes or goes never moves the time across it. */
.px-tl-panel .px-tl-pane { overflow-y: scroll; }
.px-tl-panel .px-console { flex: 1 1 0px; height: auto; min-height: 0px; }
.px-num { font-family: var(--font-mono); font-size: 12px; min-width: 80px; }
#px-time, #px-shown-fps { margin-left: var(--space-2); } /* the time and the frames shown each a word of its own */
.px-clips { flex: 0 0 auto; gap: 4px; align-items: center; min-height: 32px; }
/* The timeline fills what the bottom panel has and never squeezes its rows: when they need more, the panel scrolls. */
.px-tl { position: relative; flex: 1 0 auto; min-height: 0px; gap: 2px; }
.px-tl-row { flex: 0 0 auto; align-items: stretch; }
.px-tl-name { flex: 0 0 120px; width: 120px; font-size: 12px; color: var(--on-surface-variant); padding-right: var(--space-2); text-align: right; }
.px-tl-row > .px-tl-name { line-height: 22px; }
.px-tl-time { position: relative; flex: 1 1 0px; height: 22px; overflow: hidden; border-radius: 4px; background-color: var(--surface-container); }
.px-ruler-row .px-tl-time { height: 34px; cursor: pointer; }
.px-cell {
    position: absolute;
    top: 2px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    font-size: 10px;
    border-radius: 3px;
    background-color: var(--surface-container-highest);
    color: var(--on-surface-variant);
}
.px-cell.selected { background-color: var(--primary); color: var(--on-primary); font-weight: 600; }
.px-tick { position: absolute; top: 19px; height: 15px; padding-left: 3px; border-left: 1px var(--outline); font-size: 10px; line-height: 15px; color: var(--on-surface-variant); }
.px-range { position: absolute; top: 0px; bottom: 0px; background-color: var(--primary-container); opacity: 0.55; }
.px-edge { position: absolute; top: 0px; bottom: 0px; background-color: var(--primary); cursor: ew-resize; }
.px-trail { position: absolute; top: 4px; height: 14px; background-color: var(--surface-container-highest); }
.px-flag {
    position: absolute;
    top: 0px;
    height: 22px;
    width: 160px;
    border-left: 3px var(--tertiary);
    cursor: ew-resize;
}
.px-flag span { padding-left: 4px; font-size: 11px; line-height: 22px; color: var(--tertiary); }
.px-mark { position: absolute; top: 6px; height: 10px; border-radius: 5px; background-color: var(--secondary); }
.px-mark.span { border-radius: 2px; opacity: 0.7; }
.px-mark.sound { background-color: var(--tertiary); }
.px-mark.missing { background-color: var(--error); }
/* Part 3в: a row of a sound's waves (white in its picture, the colour of sound marks on screen); red without its file. */
.px-sound-row { height: 24px; }
.px-sound-row .px-tl-time { height: 24px; }
.px-wave { position: absolute; left: 0px; top: 0px; image-color: var(--tertiary); }
.px-sound-row.missing .px-tl-name { color: var(--error); }
.px-sound-row.missing .px-tl-time { background-color: var(--error-container); }
/* The line under the views: the zoom, the point under the mouse, the eyedropper's colour; the grid and the eyedropper. */
.px-view-line { flex: 0 0 auto; flex-wrap: wrap; gap: var(--space-2); align-items: center; min-height: 28px; padding: 0px var(--space-1); }
/* Its buttons keep their width; a narrow line goes on below. */
.px-view-line > div, .px-view-line > span { flex-shrink: 0; }
.px-view-line > .grow { flex: 1 1 0px; }
/* Part 4е: the colour of new shapes over the vector; the «Фигура» fields of a part. */
#px-shape-color { width: 84px; }
#px-shape .px-field input { width: 84px; }
.px-swatch { width: 16px; height: 16px; border-radius: 3px; border: 1px var(--outline-variant); }
.px-pause { position: absolute; box-sizing: border-box; top: 3px; height: 16px; overflow: hidden; border-radius: 3px; font-size: 10px; line-height: 16px; padding-left: 3px; background-color: var(--surface-container-highest); color: var(--on-surface-variant); }
.px-tracks { position: relative; flex: 1 1 0px; min-height: 44px; overflow-y: auto; }
.px-tracks-in { position: relative; }
.px-track-name { position: absolute; left: 0px; width: 112px; height: 20px; line-height: 20px; padding-right: 8px; text-align: right; font-size: 11px; color: var(--on-surface-variant); overflow: hidden; }
.px-blocks { position: absolute; left: 128px; right: 0px; top: 0px; bottom: 0px; } /* under the ruler, as .px-over */
.px-block {
    position: absolute;
    box-sizing: border-box; /* its box from its start to its end: the edges are where the mouse takes them */
    height: 18px;
    line-height: 16px;
    overflow: hidden;
    white-space: nowrap;
    padding-left: 3px;
    border-radius: 3px;
    font-size: 10px;
    background-color: var(--secondary-container);
    color: var(--on-secondary-container);
    border: 1px var(--outline-variant);
    cursor: pointer;
}
.px-block.module { background-color: var(--surface-container-highest); color: var(--on-surface-variant); }
.px-block.lit { border-color: var(--tertiary); background-color: var(--tertiary-container); color: var(--on-tertiary-container); }
.px-block.selected { border-color: var(--primary); background-color: var(--primary); color: var(--on-primary); }
.px-tl.stale .px-block, .px-tl.stale .px-flag, .px-tl.stale .px-pause { opacity: 0.4; }
/* Part 6а: the actors' clips of a scene, a row for each actor; a loop's bar runs to its next clip, a stop is a mark. */
.px-plays { flex: 0 0 auto; min-height: 0px; max-height: 80px; border-top: 1px var(--outline-variant); }
.px-block.px-play { background-color: var(--tertiary-container); color: var(--on-tertiary-container); }
.px-block.px-play.loop { border-style: dashed; }
.px-block.px-play.stop { padding-left: 0px; background-color: var(--outline); }
.px-block.px-play.selected { border-color: var(--primary); background-color: var(--primary); color: var(--on-primary); }
/* Part 6г5а: a play's blend, a light wedge from its start as long as the blend lasts. */
.px-play-blend { position: absolute; left: 0px; top: 0px; bottom: 0px; decorator: linear-gradient(to right, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0)); }
.px-pause.px-transition { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.px-pause.px-transition.selected { background-color: var(--primary); color: var(--on-primary); }
/* Part 6в: the scene's music (a block a file plays, its wave in it, its fade a light wedge from its start, a call of the
   same music a line on it; red without its file) and its stops (flags that do not drag; red when the game has not
   what they wait for; the one the player stands at lit); the line under the player while it stands. */
.px-music-row .px-tl-time { height: 22px; }
.px-music {
    position: absolute;
    box-sizing: border-box;
    top: 0px;
    height: 22px;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 3px;
    border: 1px var(--tertiary);
    background-color: rgba(0, 0, 0, 0);
    cursor: pointer;
}
.px-music span { position: absolute; left: 4px; top: 0px; font-size: 10px; line-height: 20px; color: var(--on-surface); }
.px-music.missing { border-color: var(--error); background-color: var(--error-container); }
.px-music.missing span { color: var(--on-error-container); }
.px-music-fade { position: absolute; top: 0px; bottom: 0px; decorator: linear-gradient(to right, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0)); }
.px-music-mark { position: absolute; top: 0px; height: 22px; background-color: var(--tertiary); cursor: pointer; }
.px-flag.px-stop { width: 140px; border-left-color: var(--primary); cursor: pointer; }
.px-flag.px-stop span { color: var(--primary); }
.px-flag.px-stop.missing { border-left-color: var(--error); }
.px-flag.px-stop.missing span { color: var(--error); }
.px-flag.px-stop.held { background-color: var(--primary-container); }
.px-held { flex: 0 0 auto; gap: var(--space-1); align-items: center; min-height: 24px; padding: 0px var(--space-2); border-radius: 4px; font-size: 12px; background-color: var(--primary-container); color: var(--on-primary-container); }
.px-tl-note { flex: 0 0 auto; padding: 2px 0px 2px 128px; }
.px-over { position: absolute; left: 128px; right: 0px; top: 0px; bottom: 0px; pointer-events: none; }
.px-head { position: absolute; top: 0px; bottom: 0px; width: 2px; background-color: var(--error); pointer-events: none; }

/* The narrow window (part 7а): the rail, the left and the right panel by the window's width; under 1200 the path
   without its kind and, in «Код», the code over the vector. */
@media (min-width: 1550px) {
    .px-rail { width: 50px; }
    .px-left { width: 236px; }
    .px-side { width: 296px; }
}
@media (max-width: 1199.9px) {
    .px-rail { width: 42px; }
    .px-left { width: 184px; }
    .px-side { width: 238px; }
    .px-path-kind { display: none; }
    .look-code .px-center-in { flex-direction: column; }
    .look-code .px-code { flex: 0 0 50%; }
    .look-code .px-split { width: auto; height: 6px; cursor: ns-resize; }
    .look-code .px-code-box { min-height: 48px; }
}
@media (max-width: 979.9px) {
    .px-left { width: 164px; }
    .px-side { width: 218px; }
}
