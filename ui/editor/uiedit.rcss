/* The «Интерфейс» tab (the #ui-editor part of editor.rml): screens and
   layers on the left, the canvas with rulers in the middle, the selected
   layer's design on the right. Canvas colours follow Figma's: blue for the
   selection, pink for snapping. */

#ui-editor {
    flex: 1 1 0px;
    min-height: 0px;
    position: relative;
    padding: 0px var(--space-2) var(--space-2) var(--space-2);
}

.ue-bar { height: 52px; gap: var(--space-3); align-items: center; }
.ue-tools, .ue-zoom {
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--surface-container-low);
    align-items: center;
}
.ue-tool {
    width: 34px;
    height: 32px;
    border-radius: 6px;
    text-align: center;
    padding-top: 6px;
    color: var(--on-surface-variant);
    cursor: pointer;
}
.ue-tool:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.ue-check-btn {
    gap: 6px; align-items: center; height: 30px; padding: 0 12px; margin-left: 8px; border-radius: 8px;
    font-size: 13px; font-weight: 600; color: var(--on-surface); background-color: var(--surface-container-high); cursor: pointer;
}
.ue-check-btn:hover { background-color: var(--surface-container-highest); }
.ue-check-btn.on { background-color: #2f7bf5; color: #ffffff; }
.ue-log { color: var(--on-surface); }
.ue-ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ue-tool.selected { background-color: #2f7bf5; color: #ffffff; }
.ue-views {
    gap: 2px; padding: 3px; border-radius: 8px; background-color: var(--surface-container-low); align-items: center;
}
.ue-view {
    height: 28px; padding: 6px 9px 0 9px; border-radius: 6px; font-size: 12.5px; white-space: nowrap;
    color: var(--on-surface-variant); cursor: pointer;
}
.ue-view:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.ue-view.selected { background-color: #2f7bf5; color: #ffffff; }
/* «Простой / Полный» and the simple blocks */
.ue-mode, .ue-blocks {
    gap: 2px; padding: 3px; border-radius: 8px; background-color: var(--surface-container-low); align-items: center; margin-right: 8px;
}
.ue-mode-btn {
    height: 28px; padding: 6px 12px 0 12px; border-radius: 6px; font-size: 12.5px; font-weight: 600; white-space: nowrap;
    color: var(--on-surface-variant); cursor: pointer;
}
.ue-mode-btn:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.ue-mode-btn.selected { background-color: #2f7bf5; color: #ffffff; }
.ue-block {
    gap: 5px; height: 28px; padding: 0 10px; border-radius: 6px; align-items: center; font-size: 12.5px; white-space: nowrap;
    color: var(--on-surface); cursor: pointer;
}
.ue-block:hover { background-color: var(--state-hover-layer); }
.ue-s-theme { gap: 6px; align-items: center; min-height: 28px; flex-wrap: wrap; }
.ue-s-chip {
    width: 22px; height: 22px; border-radius: 11px; border: 2px var(--surface-container-highest); cursor: pointer;
}
.ue-s-chip.selected { border: 2px #2f7bf5; }
.ue-s-link { gap: 6px; align-items: center; height: 26px; font-size: 12.5px; color: #4b8ff7; cursor: pointer; }
.ue-s-link:hover { color: #7aaeff; }
.ue-view-note {
    position: absolute; left: 12px; top: 10px; right: 12px; z-index: 3; padding: 6px 10px; border-radius: 6px;
    font-size: 12.5px; color: var(--on-surface); background-color: var(--surface-container-high); pointer-events: none;
}
.ue-zoom-text {
    min-width: 52px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--on-surface);
    cursor: pointer;
}

.ue-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }

/* Panels */
.ue-panel {
    border-radius: 6px;
    background-color: var(--surface-container-low);
    overflow-y: auto;
    padding: var(--space-1);
}
.ue-left { width: 248px; }
.ue-right { width: 300px; }
.ue-row, .ue-layer {
    min-height: 32px;
    align-items: center;
    gap: var(--space-1);
    padding: 0px var(--space-2);
    border-radius: 6px;
    font-size: 13.5px;
    cursor: pointer;
}
.ue-row:hover, .ue-layer:hover { background-color: var(--state-hover-layer); }
.ue-row.selected { background-color: var(--surface-container-highest); font-weight: 600; }
.ue-row.add { color: var(--primary); font-weight: 600; }
.ue-new-row { gap: 2px; }
/* A narrow window: the bar gives up the tab's name (the tab above says it), not the screen's or a button's. */
@media (max-width: 1700px) {
    .ue-crumb-tab { display: none; }
}
.ue-new-row .ue-row { white-space: nowrap; }
.ue-row.add icon { color: var(--primary); }
.ue-row .count { font-size: 11px; font-family: var(--font-mono); color: var(--on-surface-variant); }
.ue-row .name, .ue-layer .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* The screens scroll in their own place too: a game of many screens keeps room for its layers. */
.ue-screens { max-height: 240px; overflow-y: auto; flex-shrink: 0; }
/* The list scrolls in its own place: else its lower rows, past its height, lie under the components and cannot be clicked. */
.ue-layers { min-height: 0px; overflow-y: auto; }
.ue-layer { min-height: 28px; padding-right: var(--space-1); font-size: 13px; }
.ue-layer.selected { background-color: #2f7bf540; }
.ue-layer.drop-above { border-top: 2px #2f7bf5; }
.ue-layer.drop-below { border-bottom: 2px #2f7bf5; }
.ue-layer.drop-into { background-color: #2f7bf555; border: 1px #2f7bf5; }
.ue-layer.drop-no { background-color: #f5402f30; }
.ue-move-note { padding: var(--space-1) var(--space-2); font-size: 12px; color: #ffb4a8; }
.ue-layer.off .name, .ue-layer.off .ue-type { opacity: 0.45; }
.ue-layer .ue-type { color: var(--on-surface-variant); }
.ue-fold { width: 16px; height: 16px; color: var(--on-surface-variant); }
.ue-eye { width: 22px; height: 22px; padding-top: 3px; text-align: center; border-radius: 4px; color: var(--on-surface-variant); opacity: 0; }
.ue-layer:hover .ue-eye, .ue-eye.on { opacity: 1; }
.ue-eye:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.ue-rename {
    height: 24px;
    padding: 0px 6px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--on-surface);
    background-color: var(--surface-container-lowest);
    border: 1px #2f7bf5;
}
.ue-empty { padding: var(--space-3) var(--space-2); font-size: 13px; color: var(--on-surface-variant); }

/* The canvas and its rulers */
.ue-stage {
    position: relative;
    min-width: 0px;
    border-radius: 6px;
    overflow: hidden;
    background-color: var(--surface-container-lowest);
}
.ue-corner {
    position: absolute;
    left: 0px; top: 0px; width: 20px; height: 20px;
    background-color: var(--surface-container);
    border-right: 1px var(--outline-variant);
    border-bottom: 1px var(--outline-variant);
}
.ue-ruler {
    position: absolute;
    background-color: var(--surface-container);
    overflow: hidden;
    cursor: pointer;
}
.ue-ruler-x { left: 20px; top: 0px; right: 0px; height: 20px; border-bottom: 1px var(--outline-variant); cursor: n-resize; }
.ue-ruler-y { left: 0px; top: 20px; bottom: 0px; width: 20px; border-right: 1px var(--outline-variant); cursor: e-resize; }
.ue-ruler-lines { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
.ue-ruler-sel { position: absolute; background-color: #2f7bf540; }
.ue-ruler-x .ue-ruler-sel { top: 0px; height: 20px; }
.ue-ruler-y .ue-ruler-sel { left: 0px; width: 20px; }
.ue-tick-x {
    position: absolute;
    top: 1px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--on-surface-variant);
    white-space: nowrap;
}
.ue-tick-y {
    position: absolute;
    left: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 12px;
    color: var(--on-surface-variant);
    white-space: nowrap;
    transform: rotate(-90deg);
    transform-origin: 0px 0px;
}
.ue-canvas {
    position: absolute;
    left: 20px; top: 20px; right: 0px; bottom: 0px;
    overflow: hidden;
    cursor: default;
}
.ue-canvas.drawing { cursor: crosshair; }
.ue-frame-label {
    position: absolute;
    font-size: 12px;
    color: var(--on-surface-variant);
    white-space: nowrap;
    cursor: pointer;
}
.ue-frame-label:hover { color: #2f7bf5; }
.ue-frame-shadow { position: absolute; box-shadow: 0px 6px 28px #00000070; }
.ue-screen { position: absolute; }
.ue-guide-x { position: absolute; top: 0px; bottom: 0px; width: 1px; background-color: #ff4d4d; }
.ue-guide-y { position: absolute; left: 0px; right: 0px; height: 1px; background-color: #ff4d4d; }
.ue-hover { position: absolute; border: 1.5px #2f7bf5; }
.ue-drop { position: absolute; border: 2px #2f7bf5; background-color: #2f7bf514; }
.ue-drop-label { position: absolute; left: 0px; top: -24px; padding: 2px 8px; background-color: #2f7bf5; color: #ffffff; font-size: 12px; white-space: nowrap; border-radius: 4px; }
.ue-picked { position: absolute; border: 1px #2f7bf5; }
.ue-selection { position: absolute; border: 1.5px #2f7bf5; }
.ue-handle {
    position: absolute;
    width: 9px; height: 9px;
    background-color: #ffffff;
    border: 1.5px #2f7bf5;
    border-radius: 2px;
}
.ue-handle.tl { left: -5px; top: -5px; }
.ue-handle.t { left: 50%; top: -5px; margin-left: -5px; }
.ue-handle.tr { right: -5px; top: -5px; }
.ue-handle.r { right: -5px; top: 50%; margin-top: -5px; }
.ue-handle.br { right: -5px; bottom: -5px; }
.ue-handle.b { left: 50%; bottom: -5px; margin-left: -5px; }
.ue-handle.bl { left: -5px; bottom: -5px; }
.ue-handle.l { left: -5px; top: 50%; margin-top: -5px; }
.ue-size {
    position: absolute;
    left: 50%;
    bottom: -26px;
    transform: translateX(-50%);
    padding: 1px 6px;
    border-radius: 4px;
    background-color: #2f7bf5;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 11px;
    white-space: nowrap;
}
.ue-safe { position: absolute; border: 1px dashed #4cc38a; }
.ue-marquee { position: absolute; border: 1px #2f7bf5; background-color: #2f7bf518; }
.ue-overlay { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; pointer-events: none; }
.ue-measure {
    position: absolute;
    padding: 0px 4px;
    border-radius: 3px;
    background-color: #ff247c;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 10.5px;
    transform: translateX(-50%);
}

/* The design panel */
.ue-props { gap: 0px; }
.ue-head { gap: var(--space-2); align-items: center; padding: var(--space-2); font-weight: 600; font-size: 14px; }
.ue-tabs { gap: 2px; padding: 0 var(--space-2) var(--space-2); }
.ue-tab {
    padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;
    color: var(--on-surface-variant); cursor: pointer;
}
.ue-tab:hover { color: var(--on-surface); background-color: var(--surface-container-high); }
.ue-tab.on { color: var(--on-surface); background-color: var(--surface-container-highest); }
.ue-head .muted { font-weight: 400; font-size: 12px; color: var(--on-surface-variant); }
.ue-sec { padding: var(--space-2); border-top: 1px var(--outline-variant); }
.ue-sec-title {
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--on-surface);
    align-items: center;
}
.ue-sec-title .muted { font-weight: 400; color: var(--on-surface-variant); }
.ue-gap { gap: 6px; }
.ue-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.ue-grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin-bottom: 6px; }
.ue-grid4 { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 4px; margin-bottom: 6px; }
.ue-grid4 .ue-num { padding: 0px 4px; gap: 2px; }
.off > .ue-paint, .off > .ue-grid4, .off > .ue-line, .off > .ue-check { opacity: 0.5; }
.ue-line .muted { font-size: 11px; color: var(--on-surface-variant); }
.ue-line { gap: 6px; align-items: center; margin-bottom: 6px; }
.ue-key { width: 104px; font-size: 12px; color: var(--on-surface-variant); }
.ue-num {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    height: 28px;
    padding: 0px 6px;
    border-radius: 5px;
    background-color: var(--surface-container);
    font-size: 11.5px;
    color: var(--on-surface-variant);
}
.ue-num:hover { background-color: var(--surface-container-high); }
.ue-num span { min-width: 12px; font-family: var(--font-mono); }
.ue-num input.text, input.text.ue-hex, input.text.ue-pct, input.text.ue-field {
    flex: 1 1 0px;
    min-width: 0px;
    height: 24px;
    line-height: 24px;
    padding: 0px 2px;
    border-width: 0px;
    border-radius: 0px;
    background-color: transparent;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--on-surface);
}
input.text.ue-hex:focus, input.text.ue-pct:focus, .ue-num input.text:focus { background-color: var(--surface-container-highest); border-radius: 3px; }
.ue-short { width: 86px; flex: 0 0 86px; }
input.text.ue-field { width: 100%; height: 28px; padding: 0px 6px; margin-bottom: 6px; border-radius: 5px; background-color: var(--surface-container); font-family: var(--font-sans); }
input.text.ue-field:placeholder-shown { color: var(--outline); }
.ue-select {
    height: 28px;
    padding: 6px 6px 0px 6px;
    border-width: 0px;
    border-radius: 5px;
    background-color: var(--surface-container);
    font-size: 12px;
    color: var(--on-surface);
}
.ue-check { gap: 6px; align-items: center; height: 26px; font-size: 12px; color: var(--on-surface-variant); cursor: pointer; }
.ue-check:hover { color: var(--on-surface); }
.ue-mini {
    width: 24px; height: 24px;
    padding-top: 4px;
    text-align: center;
    border-radius: 4px;
    color: var(--on-surface-variant);
    cursor: pointer;
}
.ue-mini:hover { background-color: var(--state-hover-layer); color: var(--on-surface); }
.ue-seg { gap: 2px; padding: 2px; border-radius: 6px; background-color: var(--surface-container); }
.ue-seg-btn {
    width: 28px; height: 24px;
    padding-top: 4px;
    text-align: center;
    border-radius: 4px;
    color: var(--on-surface-variant);
    cursor: pointer;
}
.ue-seg-btn:hover { color: var(--on-surface); }
.ue-seg-btn.selected { background-color: var(--surface-container-highest); color: var(--on-surface); }
.ue-align9 {
    display: grid;
    grid-template-columns: 20px 20px 20px;
    gap: 2px;
    padding: 4px;
    border-radius: 6px;
    background-color: var(--surface-container);
}
.ue-a9 { width: 20px; height: 20px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.ue-a9 i { display: block; width: 4px; height: 4px; border-radius: 2px; background-color: var(--outline); }
.ue-a9:hover i { background-color: var(--on-surface-variant); }
.ue-a9.selected { background-color: var(--surface-container-highest); }
.ue-a9.selected i { width: 10px; height: 10px; border-radius: 2px; background-color: #2f7bf5; }
.ue-fill { gap: 0px; margin-bottom: 8px; }
.ue-fill.off .ue-paint { opacity: 0.5; }
.ue-paint {
    gap: 6px;
    align-items: center;
    height: 28px;
    padding: 0px 2px 0px 6px;
    margin-bottom: 6px;
    border-radius: 5px;
    background-color: var(--surface-container);
}
.ue-swatch {
    width: 16px; height: 16px;
    border-radius: 3px;
    border: 1px #ffffff30;
}
.ue-swatch.ue-checker { cursor: pointer; }
.ue-swatch.ue-checker:hover { border-color: #2f7bf5; }
/* Under a colour: grey and white squares show where it is see-through. */
.ue-checker { decorator: image(/memory/ue-checker repeat left top); }
.ue-swatch-fill { width: 100%; height: 100%; border-radius: 2px; }
.ue-s-chip .ue-swatch-fill { border-radius: 9px; }

/* The colour picker. */
.ue-cp-cover { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; z-index: 90; }
.ue-cp-cover.dropper { cursor: crosshair; }
.ue-picker {
    position: absolute; z-index: 91; width: 264px; gap: 8px; padding: 10px; border-radius: 8px;
    background-color: var(--surface-container-high); border: 1px var(--outline-variant);
    box-shadow: 0px 8px 28px #00000080; overflow-y: auto; font-size: 12.5px; color: var(--on-surface);
    visibility: hidden; /* until it stands beside its swatch */
}
.ue-picker.dropper { border-color: #2f7bf5; }
.ue-cp-head { align-items: center; gap: 6px; height: 22px; font-weight: 600; }
.ue-picker .ue-mini.selected { background-color: #2f7bf5; color: #ffffff; }
.ue-cp-sv { position: relative; height: 150px; border-radius: 4px; cursor: crosshair; }
.ue-cp-white { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; border-radius: 4px;
    decorator: linear-gradient(90deg, #ffffffff 0%, #ffffff00 100%); }
.ue-cp-black { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; border-radius: 4px;
    decorator: linear-gradient(180deg, #00000000 0%, #000000ff 100%); }
.ue-cp-dot { position: absolute; width: 12px; height: 12px; margin: -6px 0px 0px -6px; border-radius: 6px;
    border: 2px #ffffff; box-shadow: 0px 0px 2px #000000c0; }
.ue-cp-bar { position: relative; height: 12px; border-radius: 6px; cursor: pointer; }
.ue-cp-hue { decorator: linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%); }
.ue-cp-fill { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; border-radius: 6px; }
.ue-cp-knob { position: absolute; top: -2px; width: 8px; height: 16px; margin-left: -4px; border-radius: 3px;
    border: 2px #ffffff; box-shadow: 0px 0px 2px #000000c0; }
.ue-cp-fields { align-items: center; gap: 4px; }
.ue-cp-compare { width: 34px; height: 22px; border-radius: 4px; border: 1px #ffffff30; }
.ue-cp-compare div { height: 100%; }
#ue-cp-old { border-radius: 3px 0px 0px 3px; }
#ue-cp-new { border-radius: 0px 3px 3px 0px; }
#ue-cp-hex { font-family: var(--font-mono); }
.ue-cp-hint { color: #7aaeff; }
.ue-cp-buttons { gap: 6px; }
.ue-btn.ue-btn-primary { background-color: #2f7bf5; color: #ffffff; }
.ue-btn.ue-btn-primary:hover { background-color: #4b8ff7; }
.ue-swatch.grad { border: 0px; color: var(--on-surface-variant); }
.ue-pct { flex: 0 0 44px; width: 44px; text-align: right; }

/* Components: purple, as in Figma. */
.ue-comp-icon { color: #b48cff; }
.ue-layer.comp .name, .ue-layer.comp .ue-type { color: #c7a8ff; }
.ue-comps { max-height: 180px; overflow-y: auto; }
.ue-btn {
    height: 28px;
    gap: 6px;
    align-items: center;
    justify-content: center;
    padding: 0px 8px;
    border-radius: 5px;
    font-size: 12px;
    color: var(--on-surface);
    background-color: var(--surface-container);
    cursor: pointer;
}
.ue-btn:hover { background-color: var(--surface-container-highest); }
.ue-btn.off { opacity: 0.5; }
.ue-note { font-size: 11.5px; line-height: 16px; color: var(--on-surface-variant); }
.ue-note.ue-warn { color: var(--warning); margin-bottom: 6px; }
.ue-sec.ue-comp .ue-sec-title, .ue-sec.ue-comp .ue-key { color: #c7a8ff; }
input.text.ue-hex.ue-sans { font-family: var(--font-sans); }
.ue-key-row { padding: 6px 0px; border-top: 1px var(--outline-variant); }
.ue-key-row:first-child { border-top-width: 0px; }
.ue-key-row.selected { background-color: var(--surface-container-high); border-left: 2px var(--primary); padding-left: 4px; }
/* The movement's timeline */
.ue-tl { gap: 4px; padding: 4px 0px 8px 0px; }
.ue-tl-track { position: relative; height: 34px; margin: 0px 8px; border-radius: 4px; background-color: var(--surface-container-lowest); border: 1px var(--outline-variant); cursor: pointer; }
.ue-tl-delay { position: absolute; left: 0px; top: 0px; bottom: 0px; background-color: var(--surface-container-high); }
.ue-tl-pass { position: absolute; top: 0px; bottom: 0px; background-color: var(--surface-container); border-left: 1px var(--outline); border-right: 1px var(--outline); }
.ue-tl-ghost { position: absolute; top: 13px; width: 8px; height: 8px; margin-left: -4px; border-radius: 4px; border: 1px var(--outline); }
.ue-tl-key { position: absolute; top: 5px; width: 18px; height: 24px; margin-left: -9px; cursor: ew-resize; }
.ue-tl-dot { position: absolute; left: 4px; top: 7px; width: 10px; height: 10px; transform: rotate(45deg); background-color: var(--on-surface-variant); border: 1px var(--surface); }
.ue-tl-key:hover .ue-tl-dot { background-color: var(--on-surface); }
.ue-tl-key.selected .ue-tl-dot { background-color: var(--primary); border-color: var(--on-primary); }
.ue-tl-tint { position: absolute; left: 6px; top: 9px; width: 6px; height: 6px; transform: rotate(45deg); }
.ue-tl-head { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background-color: var(--error); }
.ue-tl-scale { margin: 0px 8px; font-size: 11px; color: var(--on-surface-variant); }

/* «Создать +» and the right button's menus (13.8). */
.ue-create-btn {
    gap: 4px; align-items: center; height: 30px; padding: 0 8px 0 10px; border-radius: 8px;
    font-size: 13px; font-weight: 600; color: var(--on-surface); background-color: var(--surface-container-high); cursor: pointer;
}
.ue-create-btn:hover { background-color: var(--surface-container-highest); }
.ue-create-btn.on { background-color: #2f7bf5; color: #ffffff; }
.ue-create-btn.on icon { color: #ffffff; }
.as-menu.ue-menu { width: 290px; z-index: 60; padding: var(--space-1) 0px; }
.ue-menu .menu-item { margin: 0px var(--space-1); }
.ue-menu .menu-item .label { white-space: nowrap; }
.ue-menu .menu-item.disabled icon { color: var(--disabled-content); }
.ue-menu-group {
    height: 28px; align-items: center; gap: var(--space-2); padding: 0px var(--space-3);
    font-size: 12px; font-weight: 600; color: var(--on-surface-variant);
}
.ue-menu-note { padding: var(--space-1) var(--space-3) var(--space-2) var(--space-3); font-size: 12.5px; color: var(--on-surface-variant); }
.ue-create-menu { max-height: 560px; overflow-y: auto; }

/* The panel over the selected layer (13.10). Rows of 32 px, 6 px apart, a 1 px border and 6 px padding, widths
   280 / 300 / 320 with them: UiEditor::refresh_overlay places it by these. Its kinds are ue-float-*, never the
   design system's .button / .text. */
.ue-float {
    position: absolute;
    z-index: 20;
    box-sizing: border-box;
    width: 280px;
    padding: 6px;
    gap: 6px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--outline-variant);
    background-color: var(--surface-container-high);
    box-shadow: var(--elevation-2);
    overflow: visible;
    cursor: default;
}
.ue-float.ue-float-button { width: 300px; }
.ue-float.ue-float-text { width: 320px; }
.ue-float-row { height: 32px; gap: 6px; align-items: center; }
.ue-float .ue-select { height: 32px; padding-top: 8px; background-color: var(--surface-container-highest); }
.ue-float .ue-num { height: 32px; background-color: var(--surface-container-highest); }
.ue-float input.text.ue-field { height: 32px; margin-bottom: 0px; background-color: var(--surface-container-highest); }
.ue-float .ue-seg { background-color: var(--surface-container-highest); }
.ue-float .ue-seg-btn.selected { background-color: #2f7bf5; color: #ffffff; }
.ue-f-size { width: 72px; flex: 0 0 72px; }
.ue-float .ue-swatch { width: 26px; height: 26px; flex: 0 0 26px; border-radius: 6px; }
.ue-float .ue-swatch-fill { border-radius: 5px; }
.ue-f-icon { width: 20px; flex: 0 0 20px; color: var(--on-surface-variant); }
.ue-f-note { font-size: 12px; color: var(--on-surface-variant); }

/* The template library (13.12): a window over the tab; groups on the left, the templates' pictures in the
   middle, the selected one on the right with what taking it does. */
.ue-tpl-scrim { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; z-index: 65; background-color: rgba(0, 0, 0, 0.45); }
.ue-tpl {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 48px;
    bottom: 32px;
    z-index: 70;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: 12px;
    background-color: var(--surface-container-high);
    border-width: var(--border-hairline);
    border-color: var(--outline-variant);
    box-shadow: var(--elevation-2);
}
.ue-tpl-head { align-items: center; gap: var(--space-2); height: 36px; }
.ue-tpl-head > icon { color: var(--primary); }
.ue-tpl-title { font-size: 18px; font-weight: 600; }
.ue-tpl-sub { margin-left: var(--space-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ue-tpl-head .search-box { width: 300px; background-color: var(--surface-container-highest); }
.ue-tpl-body { flex: 1 1 0px; min-height: 0px; gap: var(--space-2); align-items: stretch; }
.ue-tpl-nav {
    width: 210px;
    padding: var(--space-1);
    overflow-y: auto;
    border-radius: 8px;
    background-color: var(--surface-container-low);
}
.ue-tpl-nav > .ol-nav-row { font-weight: 600; margin-top: var(--space-2); }
.ue-tpl-nav > .ol-nav-row:first-child { margin-top: 0px; }
.ue-tpl-group { padding-left: 34px; }
.ue-tpl-group.off { color: var(--on-surface-variant); }
.ue-tpl-grid-wrap {
    flex: 1 1 0px;
    min-width: 0px;
    position: relative;
    overflow-y: auto;
    border-radius: 8px;
    background-color: var(--surface-container);
}
.ue-tpl-heading { padding: var(--space-3) var(--space-3) 0px var(--space-3); font-size: 14px; font-weight: 600; color: var(--on-surface-variant); }
.ue-tpl-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2);
}
.ue-tpl-card {
    box-sizing: border-box;
    width: 216px;
    gap: 2px;
    padding: 8px;
    border-radius: 10px;
    cursor: pointer;
}
.ue-tpl-card:hover { background-color: var(--state-hover-layer); }
.ue-tpl-card.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
.ue-tpl-thumb {
    position: relative;
    width: 200px;
    height: 113px;
    margin-bottom: 6px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #23272e;
}
.ue-tpl-card.selected .ue-tpl-thumb { outline: 2px var(--primary); }
.ue-tpl-thumb img { width: 200px; height: 113px; }
.ue-tpl-card .name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ue-tpl-card .kind { font-size: 11.5px; color: var(--on-surface-variant); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ue-tpl-card.selected .kind { color: var(--on-secondary-container); }
.ue-tpl-empty {
    position: absolute;
    top: 120px;
    left: 40px;
    right: 40px;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    color: var(--on-surface-variant);
}
.ue-tpl-side {
    width: 360px;
    padding: var(--space-3);
    overflow-y: auto;
    border-radius: 8px;
    background-color: var(--surface-container-low);
}
.ue-tpl-preview {
    width: 334px;
    height: 188px;
    margin-bottom: var(--space-3);
    border-radius: 8px;
    overflow: hidden;
    background-color: #23272e;
}
.ue-tpl-preview img { width: 334px; height: 188px; }
.ue-tpl-variants { flex-wrap: wrap; gap: 6px; margin: var(--space-2) 0px var(--space-1) 0px; }
.ue-tpl-variant {
    height: 28px;
    padding: 0px 12px;
    line-height: 28px;
    border-radius: 14px;
    font-size: 13px;
    background-color: var(--surface-container-highest);
    cursor: pointer;
}
.ue-tpl-variant:hover { background-color: var(--state-hover-layer); }
.ue-tpl-variant.selected { background-color: var(--primary); color: var(--on-primary); font-weight: 600; }
.ue-tpl-about { margin: var(--space-2) 0px var(--space-3) 0px; line-height: 1.45; color: var(--on-surface-variant); }
.ue-tpl-actions { gap: 4px; }
.ue-tpl-actions .command.strong { color: var(--primary); font-weight: 600; }
.ue-tpl-actions .command.strong icon { color: var(--primary); }
.ue-tpl-actions .command.disabled { opacity: 0.4; cursor: default; }
.ue-tpl-note { margin-top: var(--space-2); line-height: 1.4; color: #ffb4a8; }
.ue-tpl-own {
    position: absolute; right: 6px; top: 6px; padding: 1px 7px; border-radius: 9px;
    font-size: 11px; font-weight: 600; background-color: var(--primary); color: var(--on-primary);
}
.ue-tpl-needs { gap: 4px; margin: 0px 0px var(--space-3) 0px; padding: var(--space-2); border-radius: 8px; background-color: var(--surface-container-highest); line-height: 1.4; }
.ue-tpl-needs-head { gap: 6px; align-items: center; font-weight: 600; font-size: 12.5px; color: var(--primary); }
.ue-tpl-nav > .command { margin-top: var(--space-2); }
.ue-tpl-save .ue-tpl-actions { margin-top: var(--space-2); }
.ue-tpl-label { margin-top: var(--space-2); font-size: 12px; color: var(--on-surface-variant); }
.ue-tpl-input { margin: 4px 0px; height: 30px; padding: 0px 8px; border-radius: 6px; background-color: var(--surface-container-highest); }
.ue-tpl-confirm { gap: 6px; margin-top: var(--space-2); padding: var(--space-2); border-radius: 8px; background-color: var(--surface-container-highest); }
.ue-tpl-confirm .row { gap: 6px; }
.ue-create-btn.off { opacity: 0.4; cursor: default; }
