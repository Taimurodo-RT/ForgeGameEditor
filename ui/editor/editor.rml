<rml>
<head>
    <title>Forge — редактор</title>
    <link type="text/rcss" href="../forge-ui/base.rcss"/>
    <link type="text/rcss" href="../forge-ui/typography.rcss"/>
    <link type="text/rcss" href="../forge-ui/actions.rcss"/>
    <link type="text/rcss" href="../forge-ui/containers.rcss"/>
    <link type="text/rcss" href="../forge-ui/menus.rcss"/>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="level.rcss"/>
    <link type="text/rcss" href="assets.rcss"/>
</head>
<!-- The editor window. C++ fills the "editor" data model and draws the world
     under the #viewport element; everything you see here can be changed in
     this file and editor.rcss while the editor runs. -->
<body data-model="editor">
    <div id="topbar" class="row gap-1">
        <div class="brand row gap-2"><icon name="hardware"/><span>Forge</span></div>
        <div class="divider vertical"/>
        <div class="icon-button" data-class-disabled="!can_undo" data-event-click="undo"><icon name="undo"/></div>
        <div class="icon-button" data-class-disabled="!can_redo" data-event-click="redo"><icon name="redo"/></div>
        <div class="icon-button" data-event-click="save"><icon name="save"/></div>
        <span class="scene-name">{{ scene_name }}</span><div class="dirty-dot" data-if="dirty"/>
        <span class="hint muted" data-if="can_undo">Ctrl+Z: {{ undo_label }}</span>
        <div class="grow"/>
        <div class="play row gap-2">
            <div class="button filled small" data-if="!playing" data-event-click="play"><icon name="play_arrow"/>Играть</div>
            <div class="button danger small" data-if="playing" data-event-click="stop"><icon name="stop"/>Стоп</div>
            <div class="icon-button" data-class-selected="paused" data-class-disabled="!playing" data-event-click="pause"><icon name="pause"/></div>
        </div>
        <div class="grow"/>
        <div class="icon-button" data-class-selected="theme == 'dark'" data-event-click="set_theme('dark')"><icon name="dark_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'light'" data-event-click="set_theme('light')"><icon name="light_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'fantasy'" data-event-click="set_theme('fantasy')"><icon name="castle"/></div>
        <div class="icon-button" data-class-selected="theme == 'parchment'" data-event-click="set_theme('parchment')"><icon name="history_edu"/></div>
    </div>

    <!-- Editors. Each tab: open_tab(key, title, what it is for, roadmap step, icon).
         "level" and "world" work; the others show what will be there. -->
    <div id="editor-tabs" class="row">
        <div class="editor-tab" data-class-selected="tab == 'level'" data-event-click="open_tab('level', 'Уровень', '', '', 'landscape')"><icon name="landscape"/><span>Уровень</span></div>
        <div class="editor-tab" data-class-selected="tab == 'world'" data-event-click="open_tab('world', 'Сцена', '', '', 'public')"><icon name="public"/><span>Сцена</span></div>
        <div class="editor-tab" data-class-selected="tab == 'objects'" data-event-click="open_tab('objects', 'Объекты', 'Библиотека объектов: персонажи, предметы, декор из ассетов', 'шаг 10: библиотека объектов', 'deployed_code')"><icon name="deployed_code"/><span>Объекты</span></div>
        <div class="editor-tab" data-class-selected="tab == 'animation'" data-event-click="open_tab('animation', 'Анимация', 'Кадры, ключи и состояния анимаций', 'шаг 10: библиотека объектов', 'movie')"><icon name="movie"/><span>Анимация</span></div>
        <div class="editor-tab" data-class-selected="tab == 'images'" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'шаг 9: библиотека ассетов', 'image')"><icon name="image"/><span>Изображения</span></div>
        <div class="editor-tab" data-class-selected="tab == 'audio'" data-event-click="open_tab('audio', 'Аудио', 'Звуки и музыка проекта', 'шаг 9: библиотека ассетов', 'volume_up')"><icon name="volume_up"/><span>Аудио</span></div>
        <div class="editor-tab" data-class-selected="tab == 'logic'" data-event-click="open_tab('logic', 'Логика', 'Скрипты на нодах', 'шаг 11: редактор скриптов', 'account_tree')"><icon name="account_tree"/><span>Логика</span></div>
        <div class="editor-tab" data-class-selected="tab == 'story'" data-event-click="open_tab('story', 'Сюжет', 'Диалоги и квесты, проверка без запуска игры', 'шаг 12: редактор сюжета', 'forum')"><icon name="forum"/><span>Сюжет</span></div>
        <div class="editor-tab" data-class-selected="tab == 'ui'" data-event-click="open_tab('ui', 'Интерфейс', 'Меню и экраны игры, как в Figma', 'шаг 13: редактор интерфейсов', 'dashboard')"><icon name="dashboard"/><span>Интерфейс</span></div>
        <div class="editor-tab" data-class-selected="tab == 'input'" data-event-click="open_tab('input', 'Ввод', 'Клавиши, мышь и геймпад для действий игры', 'шаг 13: редактор интерфейсов', 'sports_esports')"><icon name="sports_esports"/><span>Ввод</span></div>
        <div class="editor-tab" data-class-selected="tab == 'assets'" data-event-click="open_tab('assets', 'Ресурсы', '', '', 'folder')"><icon name="folder"/><span>Ресурсы</span></div>
    </div>

    <div id="placeholder" class="column" data-if="!(tab == 'world' || tab == 'level' || tab == 'assets')">
        <icon class="big" data-attr-name="tab_icon"/>
        <div class="headline-small">{{ tab_title }}</div>
        <div class="muted">{{ tab_description }}</div>
        <div class="chip">Появится: {{ tab_step }}</div>
    </div>

    <div id="main" class="row" data-if="tab == 'world'">
        <div id="hierarchy-panel" class="panel column">
            <div class="panel-header">
                <icon name="account_tree" class="s"/><span class="title">Иерархия</span>
                <div class="icon-button small" data-event-click="add_object"><icon name="add" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(true)"><icon name="unfold_more" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(false)"><icon name="unfold_less" class="s"/></div>
                <div class="icon-button small" data-class-disabled="!has_selection" data-event-click="delete_selection"><icon name="delete" class="s"/></div>
            </div>
            <virtual-list id="hierarchy" source="hierarchy" class="grow">
                <div class="tree-row" vl-class-selected="selected" vl-style-padding-left="indent">
                    <icon class="s arrow" vl-attr-name="arrow"/>
                    <icon class="s" vl-attr-name="icon"/>
                    <span class="name" vl-text="name"/>
                    <span class="kind" vl-text="kind"/>
                </div>
            </virtual-list>
            <div class="panel-footer muted">{{ object_count }}</div>
        </div>

        <div id="center" class="column grow">
            <div id="viewport" data-class-playing="playing">
                <div class="viewport-label row gap-2" data-if="!playing"><icon name="map" class="s"/><span>Мир · {{ zoom }}</span></div>
                <div class="viewport-label playing row gap-2" data-if="playing"><icon name="sports_esports" class="s"/><span>Игра идёт</span><span data-if="paused">· пауза</span></div>
            </div>
            <div id="bottom-panel" class="panel column">
                <div class="tabs">
                    <div class="tab" data-class-selected="bottom_tab == 0" data-event-click="bottom_tab = 0"><icon name="terminal"/>Журнал</div>
                    <div class="tab" data-class-selected="bottom_tab == 1" data-event-click="bottom_tab = 1"><icon name="history"/>История</div>
                </div>
                <div id="log" class="bottom-body grow" data-if="bottom_tab == 0">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
                <div id="history" class="bottom-body grow" data-if="bottom_tab == 1">
                    <div class="history-line" data-class-current="history_cursor == 0" data-event-click="history_jump(-1)">Начало</div>
                    <div data-for="label : history" class="history-line" data-class-current="it_index + 1 == history_cursor" data-class-future="it_index >= history_cursor" data-event-click="history_jump(it_index)">{{ label }}</div>
                </div>
            </div>
        </div>

        <div id="inspector-panel" class="panel column">
            <div class="panel-header"><icon name="tune" class="s"/><span class="title">Инспектор</span></div>
            <div id="inspector" class="grow">
                <div class="empty muted" data-if="!has_selection">Выберите объект в иерархии или в окне мира.</div>
                <div data-if="has_selection">
                    <div class="name-row row gap-2">
                        <icon name="deployed_code"/>
                        <input type="text" class="small grow" data-attr-value="selected_name" data-event-change="rename(ev.value, ev.linebreak)" data-event-blur="rename_commit"/>
                    </div>
                    <div class="muted body-small selection-note" data-if="selection_count > 1">Выбрано объектов: {{ selection_count }}; показан первый.</div>
                    <div data-for="f : fields">
                        <div class="component-header row gap-2" data-if="f.kind == 'header'">
                            <icon name="widgets" class="s"/><span class="grow">{{ f.label }}</span>
                            <div class="icon-button small" data-event-click="remove_component(it_index)"><icon name="close" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="f.kind != 'header'" data-style-padding-left="(12 + f.depth * 14) + 'px'">
                            <span class="prop-label">{{ f.label }}</span>
                            <div class="prop-value row gap-2">
                                <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="field_slide(it_index, ev.value)"/>
                                <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="field_toggle(it_index)"><div class="thumb"/></div>
                                <div data-if="f.kind == 'enum'" class="cycler grow">
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                    <span class="value">{{ f.value }}</span>
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                </div>
                                <div data-if="f.kind == 'color'" class="swatch" data-style-background-color="f.color"/>
                                <input data-if="f.kind == 'color'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <span data-if="f.kind == 'group' || f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="add-component" data-if="addable.size > 0">
                        <div class="label-small muted">Добавить компонент</div>
                        <div class="row gap-2">
                            <div data-for="c : addable" class="chip" data-event-click="add_component(it_index)"><icon name="add"/>{{ c }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- The level editor: modes over the level, the tools of the mode, then
         panels docked around the world view. C++ places the panes and the
         view (ids pane-<panel> and level-view) where the layout says; the
         frames behind them carry the headers you drag. -->
    <div id="level" class="column" data-if="tab == 'level'">
        <div id="level-bar" class="row">
            <div class="modes row">
                <div class="mode" data-class-selected="lv_mode == 'select'" data-event-click="lv_mode('select')"><icon name="near_me"/><span>Выбор</span></div>
                <div class="mode" data-class-selected="lv_mode == 'tiles'" data-event-click="lv_mode('tiles')"><icon name="grid_on"/><span>Тайлы</span></div>
                <div class="mode" data-class-selected="lv_mode == 'objects'" data-event-click="lv_mode('objects')"><icon name="deployed_code"/><span>Объекты</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'physics'" data-event-click="lv_mode('physics')"><icon name="water_drop"/><span>Физика</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'light'" data-event-click="lv_mode('light')"><icon name="lightbulb"/><span>Свет</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'zones'" data-event-click="lv_mode('zones')"><icon name="flag"/><span>Зоны</span></div>
            </div>
            <div class="divider vertical"/>
            <div class="tools row" data-if="lv_mode == 'tiles'">
                <div id="tool-brush" class="icon-button" data-class-selected="lv_tool == 'brush'" data-event-click="lv_tool('brush')"><icon name="brush"/></div>
                <div id="tool-line" class="icon-button" data-class-selected="lv_tool == 'line'" data-event-click="lv_tool('line')"><icon name="timeline"/></div>
                <div id="tool-rect" class="icon-button" data-class-selected="lv_tool == 'rect'" data-event-click="lv_tool('rect')"><icon name="crop_square"/></div>
                <div id="tool-fill" class="icon-button" data-class-selected="lv_tool == 'fill'" data-event-click="lv_tool('fill')"><icon name="format_color_fill"/></div>
                <div id="tool-eraser" class="icon-button" data-class-selected="lv_tool == 'eraser'" data-event-click="lv_tool('eraser')"><icon name="ink_eraser"/></div>
                <div id="tool-picker" class="icon-button" data-class-selected="lv_tool == 'picker'" data-event-click="lv_tool('picker')"><icon name="colorize"/></div>
                <div class="divider vertical"/>
                <icon name="layers" class="s muted label"/>
                <div data-for="l : lv_layers" class="layer-chip" data-class-selected="it_index == lv_layer" data-event-click="lv_layer(it_index)">{{ l }}</div>
                <div class="divider vertical"/>
                <icon name="brush" class="s muted label"/>
                <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                <span class="size">{{ lv_radius }}</span>
                <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
            </div>
            <span class="muted mode-hint" data-if="lv_mode != 'tiles'">{{ lv_mode_help }}</span>
            <div class="grow"/>
            <div class="icon-button" data-class-selected="lv_light" data-event-click="lv_toggle('light')"><icon name="dark_mode"/></div>
            <div class="icon-button" data-class-selected="lv_grid" data-event-click="lv_toggle('grid')"><icon name="grid_4x4"/></div>
            <div class="icon-button" data-class-selected="lv_chunks" data-event-click="lv_toggle('chunks')"><icon name="border_outer"/></div>
            <div class="icon-button" data-event-click="dock_reset"><icon name="dashboard"/></div>
            <div class="divider vertical"/>
            <div class="button outlined small" data-event-click="lv_save"><icon name="save"/>Сохранить<div class="dirty-dot" data-if="lv_dirty"/></div>
            <div id="play-here" class="button filled small" data-event-click="lv_play"><icon name="play_arrow"/>Играть отсюда</div>
        </div>

        <div id="dock">
            <div data-for="f : dock_frames" class="dock-frame" data-class-view="f.view" data-if="f.used"
                 data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'">
                <div class="dock-header row" data-if="!f.view">
                    <div data-for="t : f.tabs" class="dock-tab" data-if="t.used" data-class-active="t.active" data-attr-id="'dock-tab-' + t.id"
                         data-event-mousedown="dock_grab(t.id)"><icon class="s" data-attr-name="t.icon"/><span>{{ t.title }}</span></div>
                </div>
            </div>
            <div data-for="g : dock_gaps" class="dock-gap" data-class-column="g.column" data-if="g.used"
                 data-style-left="g.x + 'px'" data-style-top="g.y + 'px'" data-style-width="g.w + 'px'" data-style-height="g.h + 'px'"
                 data-event-mousedown="dock_split(it_index)"><div class="grip"/></div>

            <div id="level-view" class="dock-pane">
                <div class="viewport-label row gap-2"><icon name="landscape" class="s"/><span>{{ lv_mode_name }} · {{ lv_place }}</span></div>
            </div>

            <div id="pane-palette" class="dock-pane column">
                <div class="pane-scroll" data-if="lv_mode == 'objects' || lv_mode == 'select'">
                    <div data-for="g : lv_objects" class="pal-group">
                        <div class="label-small muted pal-title">{{ g.name }}</div>
                        <div data-for="t : g.tiles" class="pal-tile row" data-class-selected="t.index == lv_object"
                             data-attr-id="'obj-' + t.index" data-event-click="lv_object(t.index)">
                            <img data-attr-src="t.icon"/>
                            <span class="name">{{ t.name }}</span>
                        </div>
                    </div>
                </div>
                <div class="pane-scroll" data-if="lv_mode != 'objects' && lv_mode != 'select'">
                    <div data-for="g : lv_palette" class="pal-group">
                        <div class="label-small muted pal-title">{{ g.name }}</div>
                        <div data-for="t : g.tiles" class="pal-tile row" data-class-selected="t.index == lv_tile"
                             data-attr-id="'pal-' + t.index" data-event-click="lv_tile(t.index)">
                            <img data-attr-src="t.icon"/>
                            <span class="name">{{ t.name }}</span>
                            <span class="key" data-if="t.key != ''">{{ t.key }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="pane-minimap" class="dock-pane column">
                <div class="minimap-box"><img id="minimap" data-attr-src="lv_minimap" data-event-mousedown="lv_minimap_click"/></div>
                <div class="muted body-small minimap-place">{{ lv_place }}</div>
            </div>

            <div id="pane-props" class="dock-pane column">
                <div class="pane-scroll props">
                    <div class="section-title">{{ lv_mode_name }}</div>
                    <div class="muted body-small">{{ lv_mode_help }}</div>
                    <div class="chip soon-chip" data-if="lv_mode_when != ''">Появится: {{ lv_mode_when }}</div>
                    <div data-if="lv_mode == 'tiles'">
                        <div class="section-title">Плитка</div>
                        <div class="tile-card row gap-3">
                            <img data-attr-src="lv_tile_icon"/>
                            <div class="column">
                                <span>{{ lv_tile_name }}</span>
                                <span class="muted body-small">Слой: {{ lv_tile_layer }}</span>
                                <span class="muted body-small">{{ lv_tile_hint }}</span>
                            </div>
                        </div>
                        <div class="section-title">{{ lv_tool_name }}</div>
                        <div class="muted body-small">{{ lv_tool_help }}</div>
                        <div class="prop row gap-2" data-if="lv_tool == 'brush' || lv_tool == 'eraser'">
                            <span class="prop-label">Размер</span>
                            <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                            <span class="size">{{ lv_radius }}</span>
                            <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="lv_tool == 'rect'">
                            <span class="prop-label">Только контур</span>
                            <div class="switch" data-class-on="lv_outline" data-event-click="lv_toggle('outline')"><div class="thumb"/></div>
                        </div>
                    </div>
                    <div data-if="lv_mode == 'objects' || lv_mode == 'select'">
                        <div class="muted body-small" data-if="lv_sel_count == 0">Ничего не выбрано.</div>
                        <div data-if="lv_sel_count > 0 && lv_sel_name != ''">
                            <div class="tile-card row gap-3">
                                <img data-attr-src="lv_sel_icon"/>
                                <div class="column grow">
                                    <span>{{ lv_sel_name }}</span>
                                    <span class="muted body-small">{{ lv_sel_hint }}</span>
                                    <span class="muted body-small" data-if="lv_sel_count > 1">Выбрано: {{ lv_sel_count }}; показан первый.</span>
                                </div>
                                <div id="obj-delete" class="icon-button small" data-event-click="lv_delete"><icon name="delete" class="s"/></div>
                            </div>
                            <div data-for="f : lv_fields" class="prop row gap-2">
                                <span class="prop-label">{{ f.label }}</span>
                                <div class="prop-value row gap-2">
                                    <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-id="'lv-field-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="lv_field_slide(it_index, ev.value)"/>
                                    <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-id="'lv-num-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="lv_field_toggle(it_index)"><div class="thumb"/></div>
                                    <div data-if="f.kind == 'enum'" class="cycler grow">
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                        <span class="value">{{ f.value }}</span>
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                    </div>
                                    <span data-if="f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="section-title">Вид</div>
                    <div class="prop row gap-2"><span class="prop-label grow">Свет как в игре</span>
                        <div class="switch" data-class-on="lv_light" data-event-click="lv_toggle('light')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Сетка</span>
                        <div class="switch" data-class-on="lv_grid" data-event-click="lv_toggle('grid')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Границы участков</span>
                        <div class="switch" data-class-on="lv_chunks" data-event-click="lv_toggle('chunks')"><div class="thumb"/></div></div>
                    <div class="section-title">Уровень</div>
                    <div class="muted body-small">{{ lv_info }}</div>
                    <div class="muted body-small" data-if="lv_dirty">Есть несохранённые изменения (Ctrl+S)</div>
                </div>
            </div>

            <div id="pane-history" class="dock-pane column">
                <div class="pane-scroll bottom-body">
                    <div class="history-line" data-class-current="lv_history_cursor == 0" data-event-click="lv_history_jump(-1)">Начало</div>
                    <div data-for="label : lv_history" class="history-line" data-class-current="it_index + 1 == lv_history_cursor" data-class-future="it_index >= lv_history_cursor" data-event-click="lv_history_jump(it_index)">{{ label }}</div>
                </div>
            </div>

            <div id="pane-log" class="dock-pane column">
                <div id="lv-log" class="pane-scroll bottom-body">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
            </div>

            <div id="dock-drop" data-if="dock_drop"
                 data-style-left="dock_drop_x + 'px'" data-style-top="dock_drop_y + 'px'" data-style-width="dock_drop_w + 'px'" data-style-height="dock_drop_h + 'px'"/>
        </div>
    </div>

    <div id="assets" class="column" data-if="tab == 'assets'">
        <!-- Like the explorer: back, forward, up, the address, the search. -->
        <div class="as-nav row">
            <div id="as-back" class="icon-button small" title="Назад (Alt+←)" data-class-disabled="!as_can_back" data-event-click="as_back"><icon name="arrow_back"/></div>
            <div id="as-forward" class="icon-button small" title="Вперёд (Alt+→)" data-class-disabled="!as_can_forward" data-event-click="as_forward"><icon name="arrow_forward"/></div>
            <div id="as-up" class="icon-button small" title="Наверх (Alt+↑, Backspace)" data-class-disabled="!as_can_up" data-event-click="as_up"><icon name="arrow_upward"/></div>
            <div class="icon-button small" title="Обновить (F5)" data-class-busy="as_busy" data-event-click="as_refresh"><icon name="refresh"/></div>
            <div class="address row">
                <icon data-attr-class="'s ft-' + (as_filter == '' ? 'folder' : (as_filter == 'image' ? 'image' : (as_filter == 'audio' ? 'audio' : 'recent')))" data-attr-name="as_place_icon"/>
                <div data-for="c : as_crumbs" class="crumb row" data-attr-id="'crumb-' + it_index" data-event-click="as_go(c.path)">
                    <icon class="s chevron" name="chevron_right"/><span>{{ c.name }}</span>
                </div>
            </div>
            <div class="search-box row">
                <input id="as-search" type="text" class="grow" placeholder="Поиск в проекте" data-attr-value="as_search" data-event-change="as_search(ev.value)"/>
                <div class="icon-button small" data-if="as_searching" title="Очистить" data-event-click="as_search_clear"><icon class="s" name="close"/></div>
                <icon class="s" name="search" data-if="!as_searching"/>
            </div>
        </div>

        <!-- Commands -->
        <div class="as-commands row">
            <div class="menu-anchor">
                <div id="as-new" class="command" data-event-click="as_menu('new')"><icon name="add_circle"/><span>Создать</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'new'">
                    <div id="as-new-folder" class="menu-item" data-event-click="as_new_folder"><icon class="ft-folder" name="create_new_folder"/><span class="label">Папку</span><span class="trailing">Ctrl+Shift+N</span></div>
                    <div class="menu-item" data-event-click="as_import('files')"><icon name="upload_file"/><span class="label">Импорт файлов…</span></div>
                    <div class="menu-item" data-event-click="as_import('folder')"><icon name="drive_folder_upload"/><span class="label">Импорт папки…</span></div>
                </div>
            </div>
            <div class="divider vertical"/>
            <div class="icon-button" title="Вырезать (Ctrl+X)" data-class-disabled="as_sel_count == 0" data-event-click="as_cut"><icon name="content_cut"/></div>
            <div id="as-copy" class="icon-button" title="Копировать (Ctrl+C)" data-class-disabled="as_sel_count == 0" data-event-click="as_copy"><icon name="content_copy"/></div>
            <div class="icon-button" title="Вставить (Ctrl+V)" data-class-disabled="!as_has_cut" data-event-click="as_paste"><icon name="content_paste"/></div>
            <div class="icon-button" title="Переименовать (F2)" data-class-disabled="as_sel_count != 1" data-event-click="as_rename_start"><icon name="drive_file_rename_outline"/></div>
            <div class="icon-button" title="Удалить (Del)" data-class-disabled="as_sel_count == 0" data-event-click="as_delete"><icon name="delete"/></div>
            <div class="divider vertical"/>
            <div class="menu-anchor">
                <div id="as-sort-menu" class="command" data-event-click="as_menu('sort')"><icon name="swap_vert"/><span>Сортировка</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'sort'">
                    <div id="sort-name" class="menu-item" data-event-click="as_sort('name')"><icon data-attr-name="as_sort == 'name' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Имя</span></div>
                    <div id="sort-date" class="menu-item" data-event-click="as_sort('date')"><icon data-attr-name="as_sort == 'date' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Дата изменения</span></div>
                    <div id="sort-type" class="menu-item" data-event-click="as_sort('type')"><icon data-attr-name="as_sort == 'type' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Тип</span></div>
                    <div id="sort-size" class="menu-item" data-event-click="as_sort('size')"><icon data-attr-name="as_sort == 'size' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Размер</span></div>
                    <div class="divider"/>
                    <div class="menu-item" data-event-click="as_sort_order(false)"><icon data-attr-name="!as_sort_desc ? 'check' : ''"/><span class="label">По возрастанию</span></div>
                    <div class="menu-item" data-event-click="as_sort_order(true)"><icon data-attr-name="as_sort_desc ? 'check' : ''"/><span class="label">По убыванию</span></div>
                </div>
            </div>
            <div class="menu-anchor">
                <div id="as-view-menu" class="command" data-event-click="as_menu('view')"><icon data-attr-name="as_view == 'icons' ? 'grid_view' : (as_view == 'large' ? 'view_agenda' : 'view_list')"/><span>Вид</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'view'">
                    <div class="menu-item" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon name="grid_view"/><span class="label">Значки</span></div>
                    <div class="menu-item" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon name="view_agenda"/><span class="label">Список с превью</span></div>
                    <div class="menu-item" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon name="view_list"/><span class="label">Таблица</span></div>
                    <div class="divider"/>
                    <div class="menu-item" data-event-click="as_layout_reset"><icon name="dashboard"/><span class="label">Вернуть панели на место</span></div>
                </div>
            </div>
            <div class="grow"/>
            <div id="as-import" class="button filled small" data-event-click="as_import('files')"><icon name="upload_file"/>Импорт</div>
        </div>

        <div id="as-dock">
            <div data-for="f : as_dock_frames" class="dock-frame" data-class-view="f.view" data-if="f.used"
                 data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'">
                <div class="dock-header row" data-if="!f.view">
                    <div data-for="t : f.tabs" class="dock-tab" data-if="t.used" data-class-active="t.active" data-attr-id="'as-dock-tab-' + t.id"
                         data-event-mousedown="as_dock_grab(t.id)"><icon class="s" data-attr-name="t.icon"/><span>{{ t.title }}</span></div>
                </div>
            </div>
            <div data-for="g : as_dock_gaps" class="dock-gap" data-class-column="g.column" data-if="g.used"
                 data-style-left="g.x + 'px'" data-style-top="g.y + 'px'" data-style-width="g.w + 'px'" data-style-height="g.h + 'px'"
                 data-event-mousedown="as_dock_split(it_index)"><div class="grip"/></div>

            <div id="as-view" class="dock-pane column" data-class-large="as_view == 'large'" data-class-icons="as_view == 'icons'">
                <div class="as-head row" data-if="as_view != 'icons'">
                    <div class="col col-name" data-class-sorted="as_sort == 'name'" data-event-click="as_sort('name')"><span>Имя</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-where" data-if="as_listing"><span>Папка</span></div>
                    <div class="col col-date" data-class-sorted="as_sort == 'date'" data-event-click="as_sort('date')"><span>Дата изменения</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-kind" data-class-sorted="as_sort == 'type'" data-event-click="as_sort('type')"><span>Тип</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-size" data-class-sorted="as_sort == 'size'" data-event-click="as_sort('size')"><span>Размер</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                </div>
                <virtual-list id="as-list" source="assets" data-attr-row-height="as_view == 'icons' ? 136 : (as_view == 'large' ? 60 : 30)" data-attr-cell-width="as_view == 'icons' ? 128 : 0" class="grow">
                    <div class="asset-row" vl-class-selected="selected" vl-class-cut="cut">
                        <div class="thumb">
                            <img vl-attr-src="thumb" vl-class-hidden="noimg"/>
                            <div class="glyph" vl-class-hidden="img"><icon vl-attr-name="icon" vl-attr-class="tint"/></div>
                        </div>
                        <span class="name" vl-text="name"/>
                        <span class="where" vl-text="where"/>
                        <span class="date" vl-text="date"/>
                        <span class="kind" vl-text="kind"/>
                        <span class="size" vl-text="size"/>
                    </div>
                </virtual-list>
                <div class="as-empty column" data-if="as_empty">
                    <icon name="upload_file" class="l"/>
                    <span data-if="!as_searching">Папка пуста. Перетащите сюда файлы или папки из проводника, или нажмите «Импорт».</span>
                    <span data-if="as_searching">Ничего не найдено.</span>
                </div>
            </div>

            <div id="as-pane-folders" class="dock-pane column">
                <div class="pane-scroll nav">
                    <div id="nav-recent" class="tree-row nav-row" data-class-selected="as_filter == 'recent'" data-event-click="as_filter('recent')"><icon class="s ft-recent" name="schedule"/><span class="name">Недавние</span></div>
                    <div id="nav-images" class="tree-row nav-row" data-class-selected="as_filter == 'image'" data-event-click="as_filter('image')"><icon class="s ft-image" name="photo_library"/><span class="name">Все картинки</span></div>
                    <div id="nav-audio" class="tree-row nav-row" data-class-selected="as_filter == 'audio'" data-event-click="as_filter('audio')"><icon class="s ft-audio" name="library_music"/><span class="name">Все звуки</span></div>
                    <div class="divider"/>
                    <div data-for="t : as_tree" class="tree-row folder-row" data-class-selected="t.selected &amp;&amp; as_filter == ''" data-attr-id="'folder-' + it_index"
                         data-style-padding-left="(4 + t.depth * 14) + 'px'" data-event-click="as_go(t.path)">
                        <div class="arrow" data-event-click="as_tree_toggle(t.path)"><icon class="s" name="chevron_right" data-if="t.kids &amp;&amp; t.depth > 0" data-class-open="t.open"/></div>
                        <icon class="s ft-folder" data-attr-name="t.depth == 0 ? 'inventory_2' : (t.selected ? 'folder_open' : 'folder')"/>
                        <span class="name">{{ t.name }}</span>
                    </div>
                </div>
            </div>

            <div id="as-pane-preview" class="dock-pane column">
                <div class="pane-scroll props details">
                    <div class="preview-box">
                        <img id="as-preview" data-if="as_sel_preview != ''" data-attr-src="as_sel_preview"/>
                        <icon class="xl" data-if="as_sel_preview == ''" data-attr-name="as_sel_icon" data-attr-class="'xl ' + as_sel_tint"/>
                    </div>
                    <div class="name-row row" data-if="as_sel_count == 1">
                        <input id="as-name" type="text" class="small grow" title="Имя (F2)" data-attr-value="as_sel_name" data-event-change="as_rename(ev.value, ev.linebreak)" data-event-blur="as_rename_commit"/>
                        <span class="muted ext">{{ as_sel_ext }}</span>
                    </div>
                    <div class="title-row" data-if="as_sel_count != 1"><span>{{ as_sel_name }}</span></div>

                    <div class="section-title">Сведения</div>
                    <div class="info row"><span class="key">Тип</span><span class="value">{{ as_sel_kind }}</span></div>
                    <div class="info row"><span class="key">Размер</span><span class="value">{{ as_sel_size }}</span></div>
                    <div class="info row" data-if="as_sel_dims != ''"><span class="key">Картинка</span><span class="value">{{ as_sel_dims }}</span></div>
                    <div class="info row" data-if="as_sel_extra != ''"><span class="key">Звук</span><span class="value">{{ as_sel_extra }}</span></div>
                    <div class="info row" data-if="as_sel_date != ''"><span class="key">Изменён</span><span class="value">{{ as_sel_date }}</span></div>
                    <div class="info row" data-if="as_sel_path != ''"><span class="key">Где</span><span class="value path">{{ as_sel_path }}</span></div>
                    <div class="prop row gap-2" data-if="as_sel_count == 1 &amp;&amp; !as_sel_dir">
                        <span class="key">Метки</span>
                        <input id="as-tags" type="text" class="small grow" placeholder="через пробел" data-attr-value="as_sel_tags" data-event-change="as_tags(ev.value, ev.linebreak)" data-event-blur="as_tags_commit"/>
                    </div>

                    <div data-if="as_sel_count == 1 &amp;&amp; as_sel_image">
                        <div class="section-title">Правка</div>
                        <div class="row gap-1" data-if="as_sel_editable">
                            <div id="img-ccw" class="icon-button" title="Повернуть влево" data-event-click="as_image('ccw')"><icon name="rotate_left"/></div>
                            <div id="img-cw" class="icon-button" title="Повернуть вправо" data-event-click="as_image('cw')"><icon name="rotate_right"/></div>
                            <div id="img-fliph" class="icon-button" title="Отразить по горизонтали" data-event-click="as_image('fliph')"><icon name="swap_horiz"/></div>
                            <div id="img-flipv" class="icon-button" title="Отразить по вертикали" data-event-click="as_image('flipv')"><icon name="swap_vert"/></div>
                            <div id="img-half" class="icon-button" title="Уменьшить вдвое" data-event-click="as_image('half')"><icon name="zoom_out"/></div>
                            <div id="img-double" class="icon-button" title="Увеличить вдвое" data-event-click="as_image('double')"><icon name="zoom_in"/></div>
                        </div>
                        <div class="muted body-small" data-if="!as_sel_editable">Этот формат только читается; сделайте копию в PNG, чтобы править.</div>
                        <div class="section-title">Копия в другом формате</div>
                        <div class="row gap-1">
                            <div class="button outlined small" data-if="as_sel_ext != '.png'" data-event-click="as_convert('.png')">PNG</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.jpg' &amp;&amp; as_sel_ext != '.jpeg'" data-event-click="as_convert('.jpg')">JPG</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.bmp'" data-event-click="as_convert('.bmp')">BMP</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.tga'" data-event-click="as_convert('.tga')">TGA</div>
                        </div>
                    </div>
                    <div data-if="as_sel_count == 1 &amp;&amp; as_sel_wav">
                        <div class="section-title">Звук</div>
                        <div class="button outlined small" data-event-click="as_play"><icon name="play_arrow"/>Слушать</div>
                    </div>

                    <div class="section-title" data-if="as_sel_count &lt;= 1">Открыть</div>
                    <div class="links column" data-if="as_sel_count &lt;= 1">
                        <div class="link row" data-if="as_sel_count == 1 &amp;&amp; as_sel_image" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'позже: рисование и нарезка спрайтов', 'image')"><icon class="s" name="open_in_new"/><span>В редакторе изображений</span></div>
                        <div class="link row" data-if="as_sel_count == 1 &amp;&amp; as_sel_image" data-event-click="open_tab('animation', 'Анимация', 'Кадры, ключи и состояния анимаций', 'шаг 10: библиотека объектов', 'movie')"><icon class="s" name="open_in_new"/><span>Сделать анимацию</span></div>
                        <div class="link row" data-if="as_sel_count == 1 &amp;&amp; as_sel_audio" data-event-click="open_tab('audio', 'Аудио', 'Звуки и музыка проекта', 'позже: обрезка и громкость', 'volume_up')"><icon class="s" name="open_in_new"/><span>В редакторе звука</span></div>
                        <div class="link row" data-event-click="as_show"><icon class="s" name="folder_open"/><span>Показать в проводнике Windows</span></div>
                    </div>
                </div>
            </div>

            <div id="as-pane-history" class="dock-pane column">
                <div class="pane-scroll bottom-body">
                    <div class="history-line" data-class-current="as_history_cursor == 0" data-event-click="as_history_jump(-1)">Начало</div>
                    <div data-for="label : as_history" class="history-line" data-class-current="it_index + 1 == as_history_cursor" data-class-future="it_index >= as_history_cursor" data-event-click="as_history_jump(it_index)">{{ label }}</div>
                </div>
            </div>

            <div id="as-pane-log" class="dock-pane column">
                <div id="as-log" class="pane-scroll bottom-body">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
            </div>

            <div id="as-dock-drop" data-if="as_dock_drop"
                 data-style-left="as_dock_drop_x + 'px'" data-style-top="as_dock_drop_y + 'px'" data-style-width="as_dock_drop_w + 'px'" data-style-height="as_dock_drop_h + 'px'"/>
        </div>

        <div class="as-foot row">
            <span>{{ as_count_text }}</span>
            <span class="sep" data-if="as_sel_text != ''"/>
            <span>{{ as_sel_text }}</span>
            <div class="grow"/>
            <span class="muted" data-if="as_busy">Обновляю…</span>
            <span class="muted">{{ as_status }}</span>
            <div id="as-view-table" class="icon-button small" title="Таблица" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon class="s" name="view_list"/></div>
            <div id="as-view-large" class="icon-button small" title="Список с превью" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon class="s" name="view_agenda"/></div>
            <div id="as-view-icons" class="icon-button small" title="Значки" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon class="s" name="grid_view"/></div>
        </div>
        <div class="as-backdrop" data-if="as_menu != ''" data-event-mousedown="as_menu('')"/>

        <!-- The right-click menu: for the chosen files, or (nothing chosen) for the open folder. -->
        <div id="as-ctx" class="as-menu ctx menu-list" data-if="as_menu == 'ctx'" data-style-left="as_ctx_x + 'px'" data-style-top="as_ctx_y + 'px'">
            <div data-if="as_sel_count > 0">
                <div id="ctx-open" class="menu-item strong" data-if="as_sel_count == 1 &amp;&amp; as_sel_dir" data-event-click="as_open_selected"><icon name="folder_open"/><span class="label">Открыть</span><span class="trailing">Enter</span></div>
                <div class="menu-item strong" data-if="as_sel_count == 1 &amp;&amp; as_sel_wav" data-event-click="as_open_selected"><icon name="play_arrow"/><span class="label">Слушать</span></div>
                <div class="menu-item" data-if="as_sel_count == 1 &amp;&amp; as_sel_image" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'позже: рисование и нарезка спрайтов', 'image')"><icon name="open_in_new"/><span class="label">Открыть в редакторе изображений</span></div>
                <div class="divider" data-if="as_sel_count == 1 &amp;&amp; (as_sel_dir || as_sel_wav || as_sel_image)"/>
                <div id="ctx-cut" class="menu-item" data-event-click="as_cut"><icon name="content_cut"/><span class="label">Вырезать</span><span class="trailing">Ctrl+X</span></div>
                <div id="ctx-copy" class="menu-item" data-event-click="as_copy"><icon name="content_copy"/><span class="label">Копировать</span><span class="trailing">Ctrl+C</span></div>
                <div id="ctx-rename" class="menu-item" data-if="as_sel_count == 1" data-event-click="as_rename_start"><icon name="drive_file_rename_outline"/><span class="label">Переименовать</span><span class="trailing">F2</span></div>
                <div id="ctx-delete" class="menu-item" data-event-click="as_delete"><icon name="delete"/><span class="label">Удалить</span><span class="trailing">Del</span></div>
                <div data-if="as_sel_count == 1 &amp;&amp; as_sel_image &amp;&amp; as_sel_editable">
                    <div class="divider"/>
                    <div id="ctx-rotate" class="menu-item" data-event-click="as_image('cw')"><icon name="rotate_right"/><span class="label">Повернуть вправо</span></div>
                    <div class="menu-item" data-event-click="as_image('ccw')"><icon name="rotate_left"/><span class="label">Повернуть влево</span></div>
                    <div class="menu-item" data-if="as_sel_ext != '.png'" data-event-click="as_convert('.png')"><icon name="image"/><span class="label">Копия в PNG</span></div>
                </div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_show"><icon name="folder_open"/><span class="label">Показать в проводнике Windows</span></div>
            </div>
            <div data-if="as_sel_count == 0">
                <div class="menu-item" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon name="grid_view"/><span class="label">Значки</span></div>
                <div class="menu-item" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon name="view_agenda"/><span class="label">Список с превью</span></div>
                <div class="menu-item" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon name="view_list"/><span class="label">Таблица</span></div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_sort('name')"><icon data-attr-name="as_sort == 'name' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Сортировать по имени</span></div>
                <div class="menu-item" data-event-click="as_sort('date')"><icon data-attr-name="as_sort == 'date' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По дате изменения</span></div>
                <div class="menu-item" data-event-click="as_sort('type')"><icon data-attr-name="as_sort == 'type' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По типу</span></div>
                <div class="menu-item" data-event-click="as_sort('size')"><icon data-attr-name="as_sort == 'size' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По размеру</span></div>
                <div class="divider"/>
                <div id="ctx-paste" class="menu-item" data-class-disabled="!as_has_cut" data-event-click="as_paste"><icon name="content_paste"/><span class="label">Вставить</span><span class="trailing">Ctrl+V</span></div>
                <div id="ctx-new-folder" class="menu-item" data-event-click="as_new_folder"><icon class="ft-folder" name="create_new_folder"/><span class="label">Создать папку</span><span class="trailing">Ctrl+Shift+N</span></div>
                <div class="menu-item" data-event-click="as_import('files')"><icon name="upload_file"/><span class="label">Импорт файлов…</span></div>
                <div class="menu-item" data-event-click="as_refresh"><icon name="refresh"/><span class="label">Обновить</span><span class="trailing">F5</span></div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_show"><icon name="folder_open"/><span class="label">Показать в проводнике Windows</span></div>
            </div>
        </div>
    </div>

    <div id="statusbar" class="row gap-4">
        <span>{{ status }}</span>
        <div class="grow"/>
        <span class="muted" data-if="tab == 'level'">Ctrl+Z / Ctrl+Y отмена и повтор · Ctrl+S сохранить · F5 играть отсюда · B L R G E I инструменты · [ ] размер · колесо и правая кнопка: камера</span>
        <span class="muted" data-if="tab == 'assets'">Ctrl+Z / Ctrl+Y отмена и повтор · Alt+← / Alt+→ назад и вперёд · F2 имя · Ctrl+C / X / V · Del удалить · перетащите файлы в окно для импорта</span>
        <span class="muted" data-if="tab != 'level' &amp;&amp; tab != 'assets'">Ctrl+Z / Ctrl+Y отмена и повтор · F5 играть · Del удалить · Ctrl+D копия · F фокус · колесо и правая кнопка: камера</span>
    </div>
</body>
</rml>
