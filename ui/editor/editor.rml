<rml>
<head>
    <title>Forge — редактор</title>
    <link type="text/rcss" href="../forge-ui/base.rcss"/>
    <link type="text/rcss" href="../forge-ui/typography.rcss"/>
    <link type="text/rcss" href="../forge-ui/actions.rcss"/>
    <link type="text/rcss" href="../forge-ui/containers.rcss"/>
    <link type="text/rcss" href="../forge-ui/menus.rcss"/>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="level.rcss"/>
    <link type="text/rcss" href="assets.rcss"/>
    <link type="text/rcss" href="objects.rcss"/>
    <link type="text/rcss" href="logic.rcss"/>
    <link type="text/rcss" href="story.rcss"/>
    <link type="text/rcss" href="uiedit.rcss"/>
</head>
<!-- The editor window. C++ fills the "editor" data model and draws the world
     under the #viewport element; everything you see here can be changed in
     this file and editor.rcss while the editor runs. -->
<body data-model="editor">
    <div id="topbar" class="row gap-1">
        <div class="brand row gap-2"><icon name="hardware"/><span>Forge</span></div>
        <div class="divider vertical"/>
        <div class="icon-button" data-class-disabled="!can_undo" data-event-click="undo"><icon name="undo"/></div>
        <div class="icon-button" data-class-disabled="!can_redo" data-event-click="redo"><icon name="redo"/></div>
        <div class="icon-button" data-event-click="save"><icon name="save"/></div>
        <span class="scene-name">{{ scene_name }}</span><div class="dirty-dot" data-if="dirty"/>
        <span class="hint muted" data-if="can_undo">Ctrl+Z: {{ undo_label }}</span>
        <div class="grow"/>
        <div class="play row gap-2">
            <div class="button filled small" data-if="!playing" data-event-click="play"><icon name="play_arrow"/>Играть</div>
            <div class="button danger small" data-if="playing" data-event-click="stop"><icon name="stop"/>Стоп</div>
            <div class="icon-button" data-class-selected="paused" data-class-disabled="!playing" data-event-click="pause"><icon name="pause"/></div>
        </div>
        <div class="grow"/>
        <div class="icon-button" data-class-selected="theme == 'dark'" data-event-click="set_theme('dark')"><icon name="dark_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'light'" data-event-click="set_theme('light')"><icon name="light_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'fantasy'" data-event-click="set_theme('fantasy')"><icon name="castle"/></div>
        <div class="icon-button" data-class-selected="theme == 'parchment'" data-event-click="set_theme('parchment')"><icon name="history_edu"/></div>
    </div>

    <!-- Editors. Each tab: open_tab(key, title, what it is for, roadmap step, icon).
         "level" and "world" work; the others show what will be there. -->
    <div id="editor-tabs" class="row">
        <div class="editor-tab" data-class-selected="tab == 'level'" data-event-click="open_tab('level', 'Уровень', '', '', 'landscape')"><icon name="landscape"/><span>Уровень</span></div>
        <div class="editor-tab" data-class-selected="tab == 'world'" data-event-click="open_tab('world', 'Сцена', '', '', 'public')"><icon name="public"/><span>Сцена</span></div>
        <div class="editor-tab" data-class-selected="tab == 'objects'" data-event-click="open_tab('objects', 'Объекты', '', '', 'deployed_code')"><icon name="deployed_code"/><span>Объекты</span></div>
        <div class="editor-tab" data-class-selected="tab == 'animation'" data-event-click="open_tab('animation', 'Анимация', 'Кадры, ключи и состояния анимаций', 'шаг 10: библиотека объектов', 'movie')"><icon name="movie"/><span>Анимация</span></div>
        <div class="editor-tab" data-class-selected="tab == 'images'" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'шаг 9: библиотека ассетов', 'image')"><icon name="image"/><span>Изображения</span></div>
        <div class="editor-tab" data-class-selected="tab == 'audio'" data-event-click="open_tab('audio', 'Аудио', 'Звуки и музыка проекта', 'шаг 9: библиотека ассетов', 'volume_up')"><icon name="volume_up"/><span>Аудио</span></div>
        <div class="editor-tab" data-class-selected="tab == 'logic'" data-event-click="open_tab('logic', 'Логика', '', '', 'account_tree')"><icon name="account_tree"/><span>Логика</span></div>
        <div class="editor-tab" data-class-selected="tab == 'story'" data-event-click="open_tab('story', 'Сюжет', '', '', 'forum')"><icon name="forum"/><span>Сюжет</span></div>
        <div class="editor-tab" data-class-selected="tab == 'ui'" data-event-click="open_tab('ui', 'Интерфейс', 'Меню и экраны игры, как в Figma', 'шаг 13: редактор интерфейсов', 'dashboard')"><icon name="dashboard"/><span>Интерфейс</span></div>
        <div class="editor-tab" data-class-selected="tab == 'input'" data-event-click="open_tab('input', 'Ввод', 'Клавиши, мышь и геймпад для действий игры', 'шаг 13: редактор интерфейсов', 'sports_esports')"><icon name="sports_esports"/><span>Ввод</span></div>
        <div class="editor-tab" data-class-selected="tab == 'assets'" data-event-click="open_tab('assets', 'Ресурсы', '', '', 'folder')"><icon name="folder"/><span>Ресурсы</span></div>
    </div>

    <div id="placeholder" class="column" data-if="!(tab == 'world' || tab == 'level' || tab == 'assets' || tab == 'objects' || tab == 'logic' || tab == 'story' || tab == 'ui')">
        <icon class="big" data-attr-name="tab_icon"/>
        <div class="headline-small">{{ tab_title }}</div>
        <div class="muted">{{ tab_description }}</div>
        <div class="chip">Появится: {{ tab_step }}</div>
    </div>

    <div id="main" class="row" data-if="tab == 'world'">
        <div id="hierarchy-panel" class="panel column">
            <div class="panel-header">
                <icon name="account_tree" class="s"/><span class="title">Иерархия</span>
                <div class="icon-button small" data-event-click="add_object"><icon name="add" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(true)"><icon name="unfold_more" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(false)"><icon name="unfold_less" class="s"/></div>
                <div class="icon-button small" data-class-disabled="!has_selection" data-event-click="delete_selection"><icon name="delete" class="s"/></div>
            </div>
            <virtual-list id="hierarchy" source="hierarchy" class="grow">
                <div class="tree-row" vl-class-selected="selected" vl-style-padding-left="indent">
                    <icon class="s arrow" vl-attr-name="arrow"/>
                    <icon class="s" vl-attr-name="icon"/>
                    <span class="name" vl-text="name"/>
                    <span class="kind" vl-text="kind"/>
                </div>
            </virtual-list>
            <div class="panel-footer muted">{{ object_count }}</div>
        </div>

        <div id="center" class="column grow">
            <div id="viewport" data-class-playing="playing">
                <div class="viewport-label row gap-2" data-if="!playing"><icon name="map" class="s"/><span>Мир · {{ zoom }}</span></div>
                <div class="viewport-label playing row gap-2" data-if="playing"><icon name="sports_esports" class="s"/><span>Игра идёт</span><span data-if="paused">· пауза</span></div>
            </div>
            <div id="bottom-panel" class="panel column">
                <div class="tabs">
                    <div class="tab" data-class-selected="bottom_tab == 0" data-event-click="bottom_tab = 0"><icon name="terminal"/>Журнал</div>
                    <div class="tab" data-class-selected="bottom_tab == 1" data-event-click="bottom_tab = 1"><icon name="history"/>История</div>
                </div>
                <div id="log" class="bottom-body grow" data-if="bottom_tab == 0">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
                <div id="history" class="bottom-body grow" data-if="bottom_tab == 1">
                    <div class="history-line" data-class-current="history_cursor == 0" data-event-click="history_jump(-1)">Начало</div>
                    <div data-for="label : history" class="history-line" data-class-current="it_index + 1 == history_cursor" data-class-future="it_index >= history_cursor" data-event-click="history_jump(it_index)">{{ label }}</div>
                </div>
            </div>
        </div>

        <div id="inspector-panel" class="panel column">
            <div class="panel-header"><icon name="tune" class="s"/><span class="title">Инспектор</span></div>
            <div id="inspector" class="grow">
                <div class="empty muted" data-if="!has_selection">Выберите объект в иерархии или в окне мира.</div>
                <div data-if="has_selection">
                    <div class="name-row row gap-2">
                        <icon name="deployed_code"/>
                        <input type="text" class="small grow" data-attr-value="selected_name" data-event-change="rename(ev.value, ev.linebreak)" data-event-blur="rename_commit"/>
                    </div>
                    <div class="muted body-small selection-note" data-if="selection_count > 1">Выбрано объектов: {{ selection_count }}; показан первый.</div>
                    <div data-for="f : fields">
                        <div class="component-header row gap-2" data-if="f.kind == 'header'">
                            <icon name="widgets" class="s"/><span class="grow">{{ f.label }}</span>
                            <div class="icon-button small" data-event-click="remove_component(it_index)"><icon name="close" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="f.kind != 'header'" data-style-padding-left="(12 + f.depth * 14) + 'px'">
                            <span class="prop-label">{{ f.label }}</span>
                            <div class="prop-value row gap-2">
                                <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="field_slide(it_index, ev.value)"/>
                                <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="field_toggle(it_index)"><div class="thumb"/></div>
                                <div data-if="f.kind == 'enum'" class="cycler grow">
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                    <span class="value">{{ f.value }}</span>
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                </div>
                                <div data-if="f.kind == 'color'" class="swatch" data-style-background-color="f.color"/>
                                <input data-if="f.kind == 'color'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <span data-if="f.kind == 'group' || f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="add-component" data-if="addable.size > 0">
                        <div class="label-small muted">Добавить компонент</div>
                        <div class="row gap-2">
                            <div data-for="c : addable" class="chip" data-event-click="add_component(it_index)"><icon name="add"/>{{ c }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- The level editor: modes over the level, the tools of the mode, then
         panels docked around the world view. C++ places the panes and the
         view (ids pane-<panel> and level-view) where the layout says; the
         frames behind them carry the headers you drag. -->
    <div id="level" class="column" data-if="tab == 'level'">
        <div id="level-bar" class="row">
            <div class="modes row">
                <div class="mode" data-class-selected="lv_mode == 'select'" data-event-click="lv_mode('select')"><icon name="near_me"/><span>Выбор</span></div>
                <div class="mode" data-class-selected="lv_mode == 'tiles'" data-event-click="lv_mode('tiles')"><icon name="grid_on"/><span>Тайлы</span></div>
                <div class="mode" data-class-selected="lv_mode == 'objects'" data-event-click="lv_mode('objects')"><icon name="deployed_code"/><span>Объекты</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'physics'" data-event-click="lv_mode('physics')"><icon name="water_drop"/><span>Физика</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'light'" data-event-click="lv_mode('light')"><icon name="lightbulb"/><span>Свет</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'zones'" data-event-click="lv_mode('zones')"><icon name="flag"/><span>Зоны</span></div>
            </div>
            <div class="divider vertical"/>
            <div class="tools row" data-if="lv_mode == 'tiles'">
                <div id="tool-brush" class="icon-button" data-class-selected="lv_tool == 'brush'" data-event-click="lv_tool('brush')"><icon name="brush"/></div>
                <div id="tool-line" class="icon-button" data-class-selected="lv_tool == 'line'" data-event-click="lv_tool('line')"><icon name="timeline"/></div>
                <div id="tool-rect" class="icon-button" data-class-selected="lv_tool == 'rect'" data-event-click="lv_tool('rect')"><icon name="crop_square"/></div>
                <div id="tool-fill" class="icon-button" data-class-selected="lv_tool == 'fill'" data-event-click="lv_tool('fill')"><icon name="format_color_fill"/></div>
                <div id="tool-eraser" class="icon-button" data-class-selected="lv_tool == 'eraser'" data-event-click="lv_tool('eraser')"><icon name="ink_eraser"/></div>
                <div id="tool-picker" class="icon-button" data-class-selected="lv_tool == 'picker'" data-event-click="lv_tool('picker')"><icon name="colorize"/></div>
                <div class="divider vertical"/>
                <icon name="layers" class="s muted label"/>
                <div data-for="l : lv_layers" class="layer-chip" data-class-selected="it_index == lv_layer" data-event-click="lv_layer(it_index)">{{ l }}</div>
                <div class="divider vertical"/>
                <icon name="brush" class="s muted label"/>
                <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                <span class="size">{{ lv_radius }}</span>
                <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
            </div>
            <span class="muted mode-hint" data-if="lv_mode != 'tiles'">{{ lv_mode_help }}</span>
            <div class="grow"/>
            <div class="icon-button" data-class-selected="lv_light" data-event-click="lv_toggle('light')"><icon name="dark_mode"/></div>
            <div class="icon-button" data-class-selected="lv_grid" data-event-click="lv_toggle('grid')"><icon name="grid_4x4"/></div>
            <div class="icon-button" data-class-selected="lv_chunks" data-event-click="lv_toggle('chunks')"><icon name="border_outer"/></div>
            <div class="icon-button" data-event-click="dock_reset"><icon name="dashboard"/></div>
            <div class="divider vertical"/>
            <div class="button outlined small" data-event-click="lv_save"><icon name="save"/>Сохранить<div class="dirty-dot" data-if="lv_dirty"/></div>
            <div id="play-here" class="button filled small" data-event-click="lv_play"><icon name="play_arrow"/>Играть отсюда</div>
        </div>

        <div id="dock">
            <div data-for="f : dock_frames" class="dock-frame" data-class-view="f.view" data-if="f.used"
                 data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'">
                <div class="dock-header row" data-if="!f.view">
                    <div data-for="t : f.tabs" class="dock-tab" data-if="t.used" data-class-active="t.active" data-attr-id="'dock-tab-' + t.id"
                         data-event-mousedown="dock_grab(t.id)"><icon class="s" data-attr-name="t.icon"/><span>{{ t.title }}</span></div>
                </div>
            </div>
            <div data-for="g : dock_gaps" class="dock-gap" data-class-column="g.column" data-if="g.used"
                 data-style-left="g.x + 'px'" data-style-top="g.y + 'px'" data-style-width="g.w + 'px'" data-style-height="g.h + 'px'"
                 data-event-mousedown="dock_split(it_index)"><div class="grip"/></div>

            <div id="level-view" class="dock-pane">
                <div class="viewport-label row gap-2"><icon name="landscape" class="s"/><span>{{ lv_mode_name }} · {{ lv_place }}</span></div>
            </div>

            <div id="pane-palette" class="dock-pane column">
                <div class="pane-scroll" data-if="lv_mode == 'objects' || lv_mode == 'select'">
                    <div data-for="g : lv_objects" class="pal-group">
                        <div class="label-small muted pal-title">{{ g.name }}</div>
                        <div data-for="t : g.tiles" class="pal-tile row" data-class-selected="t.index == lv_object"
                             data-attr-id="'obj-' + t.index" data-event-click="lv_object(t.index)">
                            <img data-attr-src="t.icon"/>
                            <span class="name">{{ t.name }}</span>
                        </div>
                    </div>
                </div>
                <div class="pane-scroll" data-if="lv_mode != 'objects' && lv_mode != 'select'">
                    <div data-for="g : lv_palette" class="pal-group">
                        <div class="label-small muted pal-title">{{ g.name }}</div>
                        <div data-for="t : g.tiles" class="pal-tile row" data-class-selected="t.index == lv_tile"
                             data-attr-id="'pal-' + t.index" data-event-click="lv_tile(t.index)">
                            <img data-attr-src="t.icon"/>
                            <span class="name">{{ t.name }}</span>
                            <span class="key" data-if="t.key != ''">{{ t.key }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="pane-minimap" class="dock-pane column">
                <div class="minimap-box"><img id="minimap" data-attr-src="lv_minimap" data-event-mousedown="lv_minimap_click"/></div>
                <div class="muted body-small minimap-place">{{ lv_place }}</div>
            </div>

            <div id="pane-props" class="dock-pane column">
                <div class="pane-scroll props">
                    <div class="section-title">{{ lv_mode_name }}</div>
                    <div class="muted body-small">{{ lv_mode_help }}</div>
                    <div class="chip soon-chip" data-if="lv_mode_when != ''">Появится: {{ lv_mode_when }}</div>
                    <div data-if="lv_mode == 'tiles'">
                        <div class="section-title">Плитка</div>
                        <div class="tile-card row gap-3">
                            <img data-attr-src="lv_tile_icon"/>
                            <div class="column">
                                <span>{{ lv_tile_name }}</span>
                                <span class="muted body-small">Слой: {{ lv_tile_layer }}</span>
                                <span class="muted body-small">{{ lv_tile_hint }}</span>
                            </div>
                        </div>
                        <div class="section-title">{{ lv_tool_name }}</div>
                        <div class="muted body-small">{{ lv_tool_help }}</div>
                        <div class="prop row gap-2" data-if="lv_tool == 'brush' || lv_tool == 'eraser'">
                            <span class="prop-label">Размер</span>
                            <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                            <span class="size">{{ lv_radius }}</span>
                            <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="lv_tool == 'rect'">
                            <span class="prop-label">Только контур</span>
                            <div class="switch" data-class-on="lv_outline" data-event-click="lv_toggle('outline')"><div class="thumb"/></div>
                        </div>
                    </div>
                    <div data-if="lv_mode == 'objects' || lv_mode == 'select'">
                        <div class="muted body-small" data-if="lv_sel_count == 0">Ничего не выбрано.</div>
                        <div data-if="lv_sel_count > 0 && lv_sel_name != ''">
                            <div class="tile-card row gap-3">
                                <img data-attr-src="lv_sel_icon"/>
                                <div class="column grow">
                                    <span>{{ lv_sel_name }}</span>
                                    <span class="muted body-small" data-if="lv_sel_kind != ''">{{ lv_sel_kind }}<span data-if="lv_sel_hint != ''"> · {{ lv_sel_hint }}</span></span>
                                    <span class="muted body-small" data-if="lv_sel_kind == ''">{{ lv_sel_hint }}</span>
                                    <span class="muted body-small" data-if="lv_sel_count > 1">Выбрано: {{ lv_sel_count }}; показан первый.</span>
                                </div>
                                <div id="obj-delete" class="icon-button small" data-event-click="lv_delete"><icon name="delete" class="s"/></div>
                            </div>
                            <div data-for="f : lv_fields"><div data-if="!f.advanced" class="prop row gap-2" data-class-own="f.own" data-attr-title="f.hint">
                                <span class="prop-label">{{ f.label }}</span>
                                <div class="prop-value row gap-2">
                                    <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-id="'lv-field-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="lv_field_slide(it_index, ev.value)"/>
                                    <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-id="'lv-num-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="lv_field_toggle(it_index)"><div class="thumb"/></div>
                                    <div data-if="f.kind == 'enum'" class="cycler grow">
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                        <span class="value">{{ f.value }}</span>
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                    </div>
                                    <span data-if="f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                                    <div data-if="f.own" class="icon-button small own-reset" data-attr-id="'lv-reset-' + it_index" title="Своё значение этой копии. Нажми, чтобы вернуть как в шаблоне" data-event-click="lv_field_reset(it_index)"><icon name="undo" class="s"/></div>
                                </div>
                            </div></div>
                            <div id="lv-details" class="details-toggle row gap-1" data-event-click="lv_details">
                                <icon name="chevron_right" data-class-open="lv_details"/>
                                <span>Подробно</span>
                            </div>
                            <div data-for="f : lv_fields"><div data-if="f.advanced && lv_details" class="prop row gap-2" data-class-own="f.own" data-attr-title="f.hint">
                                <span class="prop-label">{{ f.label }}</span>
                                <div class="prop-value row gap-2">
                                    <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-id="'lv-field-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="lv_field_slide(it_index, ev.value)"/>
                                    <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-id="'lv-num-' + it_index" data-attr-value="f.value" data-event-change="lv_field_text(it_index, ev.value, ev.linebreak)" data-event-blur="lv_field_commit(it_index)"/>
                                    <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="lv_field_toggle(it_index)"><div class="thumb"/></div>
                                    <div data-if="f.kind == 'enum'" class="cycler grow">
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                        <span class="value">{{ f.value }}</span>
                                        <div class="icon-button small" data-event-click="lv_field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                    </div>
                                    <span data-if="f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                                    <div data-if="f.own" class="icon-button small own-reset" data-attr-id="'lv-reset-' + it_index" title="Своё значение этой копии. Нажми, чтобы вернуть как в шаблоне" data-event-click="lv_field_reset(it_index)"><icon name="undo" class="s"/></div>
                                </div>
                            </div></div>
                        </div>
                    </div>
                    <div class="section-title">Вид</div>
                    <div class="prop row gap-2"><span class="prop-label grow">Свет как в игре</span>
                        <div class="switch" data-class-on="lv_light" data-event-click="lv_toggle('light')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Сетка</span>
                        <div class="switch" data-class-on="lv_grid" data-event-click="lv_toggle('grid')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Границы участков</span>
                        <div class="switch" data-class-on="lv_chunks" data-event-click="lv_toggle('chunks')"><div class="thumb"/></div></div>
                    <div class="section-title">Уровень</div>
                    <div class="muted body-small">{{ lv_info }}</div>
                    <div class="muted body-small" data-if="lv_dirty">Есть несохранённые изменения (Ctrl+S)</div>
                </div>
            </div>

            <div id="pane-history" class="dock-pane column">
                <div class="pane-scroll bottom-body">
                    <div class="history-line" data-class-current="lv_history_cursor == 0" data-event-click="lv_history_jump(-1)">Начало</div>
                    <div data-for="label : lv_history" class="history-line" data-class-current="it_index + 1 == lv_history_cursor" data-class-future="it_index >= lv_history_cursor" data-event-click="lv_history_jump(it_index)">{{ label }}</div>
                </div>
            </div>

            <div id="pane-log" class="dock-pane column">
                <div id="lv-log" class="pane-scroll bottom-body">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
            </div>

            <div id="dock-drop" data-if="dock_drop"
                 data-style-left="dock_drop_x + 'px'" data-style-top="dock_drop_y + 'px'" data-style-width="dock_drop_w + 'px'" data-style-height="dock_drop_h + 'px'"/>
        </div>
    </div>

    <!-- «Объекты»: the library of the game's objects (find, place, copy,
         rename, open) and the object's editor (its properties). -->
    <div id="objects" class="column" data-if="tab == 'objects'">
        <div class="ol-bar row">
            <div class="menu-anchor">
                <div id="ol-new" class="command" title="Создать (Ctrl+N)" data-event-click="ol_menu"><icon name="add_circle"/><span>Создать</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list ol-create" data-if="ol_menu == 'new'">
                    <div data-for="g : ol_create" class="ol-create-group">
                        <div class="ol-create-kind row"><icon class="s" data-attr-name="g.icon"/><span>{{ g.name }}</span></div>
                        <div data-for="p : g.presets" class="menu-item" data-attr-id="'ol-new-' + p.kind + '-' + p.index" data-attr-title="p.about" data-event-click="ol_create(p.kind, p.index)">
                            <span class="label">{{ p.name }}</span>
                            <span class="trailing" data-if="p.genre != ''">{{ p.genre }}</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="divider vertical"/>
            <div id="ol-open" class="command strong" title="Открыть редактор объекта (Enter, двойной щелчок)" data-if="!ol_in_shared" data-class-disabled="!ol_has_sel" data-event-click="ol_open"><icon name="edit_square"/><span>Открыть редактор</span></div>
            <div id="ol-take" class="command strong" title="Скопировать общий объект в эту игру" data-if="ol_in_shared" data-class-disabled="!ol_has_sel || ol_sel_twin == 'same'" data-event-click="ol_take"><icon name="download"/><span>{{ ol_sel_twin == 'differs' ? 'Обновить из общих' : 'Взять в игру' }}</span></div>
            <div id="ol-place" class="command strong" title="Поставить на уровень" data-class-disabled="!ol_has_sel" data-event-click="ol_place"><icon name="add_location_alt"/><span>Поставить на уровень</span></div>
            <div id="ol-share" class="command" title="Положить копию объекта в общие, чтобы взять его в другую игру" data-if="!ol_in_shared" data-class-disabled="!ol_has_sel || ol_sel_twin == 'same'" data-event-click="ol_share"><icon name="share"/><span>{{ ol_sel_twin == 'differs' ? 'Обновить в общих' : 'Сделать общим' }}</span></div>
            <div id="ol-duplicate" class="command" title="Копия (Ctrl+D)" data-if="!ol_in_shared" data-class-disabled="!ol_has_sel" data-event-click="ol_duplicate"><icon name="content_copy"/><span>Копия</span></div>
            <div id="ol-rename" class="command" title="Переименовать (F2)" data-if="!ol_in_shared" data-class-disabled="!ol_has_sel" data-event-click="ol_rename_start"><icon name="drive_file_rename_outline"/><span>Переименовать</span></div>
            <div id="ol-delete" class="command" data-attr-title="ol_in_shared ? 'Убрать из общих (в играх копии останутся)' : 'Удалить (Delete)'" data-class-disabled="!ol_has_sel" data-event-click="ol_delete"><icon name="delete"/><span>{{ ol_in_shared ? 'Убрать из общих' : 'Удалить' }}</span></div>
            <div class="grow"/>
            <div class="search-box row">
                <input id="ol-search" type="text" class="grow" placeholder="Поиск объектов" data-attr-value="ol_search" data-event-change="ol_search"/>
                <icon class="s" name="search"/>
            </div>
        </div>
        <div class="ol-body row grow">
            <!-- Where to look: everything, a genre, a kind -->
            <div class="ol-nav column">
                <div id="ol-place-all" class="ol-nav-row row" data-class-selected="ol_all.selected" data-event-click="ol_show('')">
                    <icon data-attr-name="ol_all.icon"/><span class="grow name">{{ ol_all.name }}</span><span class="count">{{ ol_all.count }}</span>
                </div>
                <div class="ol-nav-title">Жанры</div>
                <div data-for="r : ol_genres" class="ol-nav-row row" data-attr-id="'ol-genre-' + it_index" data-class-selected="r.selected" data-attr-title="r.about" data-event-click="ol_show(r.place)">
                    <icon data-attr-name="r.icon"/><span class="grow name">{{ r.name }}</span><span class="count">{{ r.count }}</span>
                </div>
                <div class="ol-nav-title">Виды</div>
                <div data-for="r : ol_kinds" class="ol-nav-row row" data-attr-id="'ol-kind-' + r.place" data-class-selected="r.selected" data-attr-title="r.about" data-event-click="ol_show(r.place)">
                    <icon data-attr-name="r.icon"/><span class="grow name">{{ r.name }}</span><span class="count">{{ r.count }}</span>
                </div>
                <div class="ol-nav-title">Для всех игр</div>
                <div id="ol-place-shared" class="ol-nav-row row" data-class-selected="ol_shared.selected" data-attr-title="ol_shared.about" data-event-click="ol_show('s:')">
                    <icon data-attr-name="ol_shared.icon"/><span class="grow name">{{ ol_shared.name }}</span><span class="count">{{ ol_shared.count }}</span>
                </div>
                <div class="grow"/>
                <div class="ol-help muted body-small">Жанры и виды только помогают искать: любой объект можно поставить в любую игру. Копии объекта на уровне меняются вместе с ним.</div>
            </div>

            <!-- The library: cards, and what the selected one is -->
            <div id="ol-grid-wrap" class="ol-grid-wrap grow" data-if="!ol_editing" data-event-mousedown="ol_space_down">
                <div id="ol-shared-note" class="ol-shared-note row" data-if="ol_in_shared"><icon class="s" name="share"/><span class="body-small">{{ ol_shared_note }}</span></div>
                <div id="ol-grid" class="ol-grid">
                    <div data-for="c : ol_cards" class="ol-card column" data-attr-id="'ol-card-' + it_index" data-class-selected="c.selected" data-attr-title="c.about" data-event-mousedown="ol_card_down(it_index)" data-event-dblclick="ol_card_open(it_index)">
                        <div class="ol-thumb"><img data-attr-src="c.icon"/><span class="ol-badge" data-if="c.badge != ''">{{ c.badge }}</span></div>
                        <span class="name" data-if="!c.renaming">{{ c.name }}</span>
                        <input id="ol-rename" type="text" class="small ol-rename" data-if="c.renaming" data-attr-value="c.name" data-event-change="ol_rename_done(ev.linebreak)" data-event-blur="ol_rename_done(true)"/>
                        <span class="kind">{{ c.kind }}</span>
                    </div>
                </div>
                <div class="ol-empty column" data-if="ol_cards.size == 0">
                    <icon class="xl" name="deployed_code"/>
                    <span data-if="ol_total == 0 && ol_in_shared">Общих объектов пока нет. Выберите объект игры и нажмите «Сделать общим».</span>
                    <span data-if="ol_total == 0 && !ol_in_shared">Пока ни одного объекта. Нажми «Создать» и выбери заготовку.</span>
                    <span data-if="ol_total > 0">Здесь пока пусто.</span>
                </div>
            </div>
            <div class="ol-side column" data-if="!ol_editing">
                <div data-if="!ol_has_sel" class="muted body-small">Выбери объект.</div>
                <div data-if="ol_has_sel" class="column">
                    <div class="ol-preview"><img data-attr-src="ol_sel_icon"/></div>
                    <div class="ol-title">{{ ol_sel_name }}</div>
                    <div class="ol-kind-line row"><icon class="s" data-attr-name="ol_sel_kind_icon"/><span>{{ ol_sel_kind }}</span></div>
                    <div class="muted body-small ol-kind-about">{{ ol_sel_kind_about }}</div>
                    <div class="details">
                        <div class="info row"><span class="key">Жанр</span><span class="value">{{ ol_sel_genre }}</span></div>
                        <div class="info row" data-if="ol_sel_about != ''"><span class="key">Заметка</span><span class="value">{{ ol_sel_about }}</span></div>
                        <div class="info row"><span class="key">Файл</span><span class="value path">{{ ol_sel_file }}</span></div>
                        <div id="ol-twin" class="info row"><span class="key">{{ ol_in_shared ? 'В этой игре' : 'Общий' }}</span><span class="value">{{ ol_sel_twin == 'same' ? 'да, такой же' : ol_sel_twin == 'differs' ? 'да, но отличается' : 'нет' }}</span></div>
                    </div>
                    <div class="links column">
                        <div id="ol-open-link" class="link row" data-if="!ol_in_shared" data-event-click="ol_open"><icon class="s" name="edit_square"/><span>Открыть редактор</span></div>
                        <div id="ol-take-link" class="link row" data-if="ol_in_shared && ol_sel_twin != 'same'" data-event-click="ol_take"><icon class="s" name="download"/><span>{{ ol_sel_twin == 'differs' ? 'Обновить из общих' : 'Взять в игру' }}</span></div>
                        <div id="ol-place-link" class="link row" data-event-click="ol_place"><icon class="s" name="add_location_alt"/><span>Поставить на уровень</span></div>
                        <div id="ol-share-link" class="link row" data-if="!ol_in_shared && ol_sel_twin != 'same'" data-event-click="ol_share"><icon class="s" name="share"/><span>{{ ol_sel_twin == 'differs' ? 'Обновить в общих' : 'Сделать общим' }}</span></div>
                    </div>
                </div>
            </div>

            <!-- The object's editor -->
            <div id="ol-editor" class="ol-editor column grow" data-if="ol_editing">
                <div class="ol-editor-head row">
                    <div id="ol-back" class="command" title="К библиотеке (Esc)" data-event-click="ol_back"><icon name="arrow_back"/><span>К библиотеке</span></div>
                    <div class="divider vertical"/>
                    <icon data-attr-name="ol_sel_kind_icon"/>
                    <span class="ol-editor-title">{{ ol_sel_name }}</span>
                    <span class="muted">{{ ol_sel_kind }}</span>
                    <div class="grow"/>
                    <div class="command strong" data-event-click="ol_place"><icon name="add_location_alt"/><span>Поставить на уровень</span></div>
                </div>
                <div class="ol-editor-body row grow">
                    <div class="ol-editor-look column">
                        <div class="ol-preview big"><img data-attr-src="ol_sel_icon"/></div>
                        <div class="ol-picture column">
                            <div class="section-title">Графика</div>
                            <span id="ol-picture-name" class="muted body-small">{{ ol_sel_picture == '' ? 'обычная для этого вида' : ol_sel_picture }}</span>
                            <div class="row gap-1">
                                <div id="ol-picture-pick" class="command" title="Выбрать картинку из «Ресурсов»" data-event-click="ol_picture_pick"><icon name="image"/><span>Выбрать…</span></div>
                                <div id="ol-picture-clear" class="command" title="Вернуть обычную картинку" data-if="ol_sel_picture != ''" data-event-click="ol_picture_clear"><icon name="hide_image"/><span>Убрать</span></div>
                            </div>
                        </div>
                        <div class="muted body-small ol-kind-about">{{ ol_sel_kind_about }}</div>
                    </div>
                    <div class="ol-editor-props column grow">
                        <div class="section-title">Из чего сделан</div>
                        <!-- Blocks: each adds something to the object, with its own properties. -->
                        <div data-for="b : ol_blocks" class="ol-block column" data-attr-id="'ol-block-' + b.id">
                            <div class="ol-block-head row gap-2" data-attr-title="b.about">
                                <icon data-attr-name="b.icon"/>
                                <span class="ol-block-name">{{ b.name }}</span>
                                <span class="muted body-small grow ol-block-about">{{ b.about }}</span>
                                <div data-if="b.removable" class="icon-button small" data-attr-id="'ol-block-remove-' + b.id" data-attr-title="'Убрать блок' + (b.note == '' ? '' : ': ' + b.note)" data-event-click="ol_block_remove(b.id)"><icon name="close"/></div>
                            </div>
                            <div data-for="f : b.props"><div data-if="!f.advanced || ol_details">
                                <div class="prop row gap-2" data-attr-title="f.hint">
                                    <span class="prop-label">{{ f.label }}</span>
                                    <div class="prop-value row gap-2">
                                        <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-id="'ol-field-' + f.index" data-attr-value="f.value" data-event-change="ol_prop_text(f.index, ev.value, ev.linebreak)" data-event-blur="ol_prop_commit(f.index)"/>
                                        <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="ol_prop_slide(f.index, ev.value)"/>
                                        <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-id="'ol-num-' + f.index" data-attr-value="f.value" data-event-change="ol_prop_text(f.index, ev.value, ev.linebreak)" data-event-blur="ol_prop_commit(f.index)"/>
                                        <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="ol_prop_toggle(f.index)"><div class="thumb"/></div>
                                        <div data-if="f.kind == 'sound'" class="row gap-1 grow ol-sound">
                                            <span class="ol-sound-name grow" data-class-muted="!f.filled" data-attr-id="'ol-sound-' + f.index">{{ f.value }}</span>
                                            <div data-if="f.filled" class="icon-button small" data-attr-id="'ol-sound-play-' + f.index" title="Послушать" data-event-click="ol_sound_play(f.index)"><icon name="play_arrow"/></div>
                                            <div class="command" data-attr-id="'ol-sound-pick-' + f.index" title="Выбрать звук из «Ресурсов»" data-event-click="ol_sound_pick(f.index)"><icon name="library_music"/><span>Выбрать…</span></div>
                                            <div data-if="f.filled" class="icon-button small" data-attr-id="'ol-sound-clear-' + f.index" title="Убрать свой звук" data-event-click="ol_sound_clear(f.index)"><icon name="close"/></div>
                                        </div>
                                        <div data-if="f.kind == 'enum'" class="cycler grow">
                                            <div class="icon-button small" data-attr-id="'ol-prev-' + f.index" data-event-click="ol_prop_cycle(f.index, -1)"><icon name="chevron_left"/></div>
                                            <span class="value">{{ f.value }}</span>
                                            <div class="icon-button small" data-attr-id="'ol-next-' + f.index" data-event-click="ol_prop_cycle(f.index, 1)"><icon name="chevron_right"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div></div>
                        </div>
                        <div class="ol-add-block">
                            <div id="ol-block-add" class="command" title="Добавить объекту блок" data-event-click="ol_blocks_menu"><icon name="add_box"/><span>Добавить блок</span><icon class="s" name="expand_more"/></div>
                            <div id="ol-blocks-menu" class="as-menu menu-list ol-blocks-menu" data-if="ol_menu == 'blocks'">
                                <div data-if="ol_add_blocks.size == 0" class="muted body-small ol-blocks-none">Все блоки уже есть.</div>
                                <div data-for="b : ol_add_blocks" class="menu-item ol-block-item" data-attr-id="'ol-add-' + b.id" data-event-click="ol_block_add(b.id)">
                                    <icon data-attr-name="b.icon"/>
                                    <div class="column grow">
                                        <span class="ol-block-item-name">{{ b.name }}</span>
                                        <span class="muted body-small">{{ b.about }}</span>
                                        <span data-if="b.note != ''" class="ol-block-note body-small">{{ b.note }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="props">
                            <div class="prop row gap-2">
                                <span class="prop-label">Заметка</span>
                                <input id="ol-about" type="text" class="small grow" placeholder="для чего этот объект" data-attr-value="ol_sel_about" data-event-change="ol_about(ev.linebreak)" data-event-blur="ol_about(true)"/>
                            </div>
                            <div id="ol-details" class="details-toggle row gap-1" data-event-click="ol_details">
                                <icon name="chevron_right" data-class-open="ol_details"/>
                                <span>Подробно</span>
                            </div>
                            <div data-if="ol_details" class="prop row gap-2"><span class="prop-label">Файл</span><span class="muted body-small">{{ ol_sel_file }}</span></div>
                        </div>
                        <div class="muted body-small ol-editor-note">Правка меняет этот объект и все его копии на уровнях. Ctrl+Z отменит.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- The picture chooser: the project's images, from «Ресурсы» -->
        <div class="as-backdrop" data-if="ol_pics_open" data-event-mousedown="ol_pics_close"/>
        <div id="ol-pics" class="ol-pics column" data-if="ol_pics_open">
            <div class="ol-pics-head row gap-2">
                <span class="ol-editor-title grow">Картинка для «{{ ol_sel_name }}»</span>
                <input id="ol-pics-search" type="text" class="small" placeholder="Поиск картинок" data-attr-value="ol_pics_search" data-event-change="ol_pics_search"/>
                <div id="ol-pics-close" class="icon-button" title="Закрыть (Esc)" data-event-click="ol_pics_close"><icon name="close"/></div>
            </div>
            <div class="ol-pics-grid grow">
                <div data-for="p : ol_pics" class="ol-pic column" data-attr-id="'ol-pic-' + it_index" data-attr-title="p.folder" data-event-click="ol_picture_choose(it_index)">
                    <div class="ol-pic-img"><img data-attr-src="p.icon"/></div>
                    <span class="ol-pic-name">{{ p.name }}</span>
                </div>
            </div>
            <div class="muted body-small">{{ ol_pics_note }}</div>
        </div>

        <!-- The sound chooser: the project's sounds, from «Ресурсы» -->
        <div class="as-backdrop" data-if="ol_snds_open" data-event-mousedown="ol_snds_close"/>
        <div id="ol-snds" class="ol-pics ol-snds column" data-if="ol_snds_open">
            <div class="ol-pics-head row gap-2">
                <span class="ol-editor-title grow">{{ ol_snds_title }} для «{{ ol_sel_name }}»</span>
                <input id="ol-snds-search" type="text" class="small" placeholder="Поиск звуков" data-attr-value="ol_snds_search" data-event-change="ol_snds_search"/>
                <div id="ol-snds-close" class="icon-button" title="Закрыть (Esc)" data-event-click="ol_snds_close"><icon name="close"/></div>
            </div>
            <div class="ol-snds-list column grow">
                <div data-for="a : ol_snds" class="ol-snd row gap-2" data-class-unplayable="!a.playable" data-attr-id="'ol-snd-' + it_index" data-attr-title="a.playable ? a.folder : 'Игра читает WAV и OGG: переведите его через «Конвертировать…»'" data-event-click="ol_snd_choose(it_index)">
                    <div class="icon-button small" data-attr-id="'ol-snd-play-' + it_index" title="Послушать" data-event-click="ol_snd_preview(it_index)"><icon name="play_arrow"/></div>
                    <icon class="s ft-audio" name="music_note"/>
                    <span class="ol-snd-name grow">{{ a.name }}</span>
                    <span class="muted body-small">{{ a.folder }}</span>
                    <span class="ol-snd-format body-small">{{ a.format }}</span>
                </div>
            </div>
            <div id="ol-snds-note" class="muted body-small">{{ ol_snds_note }}</div>
        </div>

        <!-- The right-click menu: of a card, or of empty space -->
        <div class="as-backdrop" data-if="ol_menu != ''" data-event-mousedown="ol_menu_close"/>
        <div id="ol-ctx" class="as-menu menu-list ol-ctx" data-if="ol_menu == 'card' || ol_menu == 'empty'" data-style-left="ol_menu_x + 'px'" data-style-top="ol_menu_y + 'px'">
            <div data-if="ol_menu == 'card' && ol_in_shared">
                <div id="ctx-ol-take" class="menu-item strong" data-class-disabled="ol_sel_twin == 'same'" data-event-click="ol_take"><icon name="download"/><span class="label">{{ ol_sel_twin == 'differs' ? 'Обновить из общих' : ol_sel_twin == 'same' ? 'Уже в игре' : 'Взять в игру' }}</span></div>
                <div id="ctx-ol-place-shared" class="menu-item" data-event-click="ol_place"><icon name="add_location_alt"/><span class="label">Поставить на уровень</span></div>
                <div class="divider"/>
                <div id="ctx-ol-unshare" class="menu-item" data-event-click="ol_delete"><icon name="delete"/><span class="label">Убрать из общих</span><span class="trailing">Del</span></div>
            </div>
            <div data-if="ol_menu == 'card' && !ol_in_shared">
                <div id="ctx-ol-open" class="menu-item strong" data-event-click="ol_open"><icon name="edit_square"/><span class="label">Открыть редактор</span><span class="trailing">Enter</span></div>
                <div id="ctx-ol-place" class="menu-item" data-event-click="ol_place"><icon name="add_location_alt"/><span class="label">Поставить на уровень</span></div>
                <div id="ctx-ol-share" class="menu-item" data-class-disabled="ol_sel_twin == 'same'" data-event-click="ol_share"><icon name="share"/><span class="label">{{ ol_sel_twin == 'differs' ? 'Обновить в общих' : ol_sel_twin == 'same' ? 'Уже среди общих' : 'Сделать общим' }}</span></div>
                <div class="divider"/>
                <div id="ctx-ol-copy" class="menu-item" data-event-click="ol_duplicate"><icon name="content_copy"/><span class="label">Копия</span><span class="trailing">Ctrl+D</span></div>
                <div id="ctx-ol-rename" class="menu-item" data-event-click="ol_rename_start"><icon name="drive_file_rename_outline"/><span class="label">Переименовать</span><span class="trailing">F2</span></div>
                <div id="ctx-ol-delete" class="menu-item" data-event-click="ol_delete"><icon name="delete"/><span class="label">Удалить</span><span class="trailing">Del</span></div>
                <div class="divider"/>
                <div class="ol-create-kind row"><icon class="s" name="sports_esports"/><span>Жанр</span></div>
                <div data-for="g : ol_genre_items" class="menu-item genre" data-attr-id="'ctx-ol-genre-' + it_index" data-event-click="ol_genre(g.name)">
                    <icon class="s" data-attr-name="g.checked ? 'check' : ''"/><span class="label">{{ g.label }}</span>
                </div>
            </div>
            <div data-if="ol_menu == 'empty'">
                <div id="ctx-ol-new" class="menu-item" data-event-click="ol_create_menu"><icon name="add_circle"/><span class="label">Создать объект…</span><span class="trailing">Ctrl+N</span></div>
            </div>
        </div>
    </div>

    <!-- «Логика»: things of the game on a board, links between them as arrows
         with a verb. The same logic will have other views (the mode strip). -->
    <div id="logic" class="column" data-if="tab == 'logic'">
        <div class="lg-bar row">
            <div class="lg-modes row">
                <div id="lg-mode-links" class="lg-mode" data-class-selected="lg_mode == 'links'" title="Вещи и связи между ними" data-event-click="lg_mode('links')"><icon name="share"/><span>Связи</span></div>
                <div id="lg-mode-ideas" class="lg-mode" data-class-selected="lg_mode == 'ideas'" title="Готовые идеи с парой полей" data-event-click="lg_mode('ideas')"><icon name="lightbulb"/><span>Идеи</span></div>
                <div id="lg-mode-steps" class="lg-mode" data-class-selected="lg_mode == 'steps'" title="Та же логика по шагам: когда, если, тогда, иначе" data-event-click="lg_mode('steps')"><icon name="format_list_numbered"/><span>Шаги</span></div>
                <div id="lg-mode-scheme" class="lg-mode" data-class-selected="lg_mode == 'scheme'" title="Та же логика схемой из узлов, как в Unreal" data-event-click="lg_mode('scheme')"><icon name="hub"/><span>Схема</span></div>
                <div id="lg-mode-code" class="lg-mode" data-class-selected="lg_mode == 'code'" title="Та же логика кодом на Luau" data-event-click="lg_mode('code')"><icon name="code"/><span>Код</span></div>
            </div>
            <div class="grow"/>
            <span class="muted body-small">{{ lg_count }}</span>
        </div>
        <div class="lg-body row grow">
            <!-- The game's things: on the board, and the rest of the library -->
            <div class="lg-nav column">
                <div class="lg-nav-title">На доске</div>
                <div data-for="r : lg_board_rows" class="lg-nav-row row" data-attr-id="'lg-row-' + r.id" data-class-selected="r.selected" data-attr-title="r.about" data-event-click="lg_select_thing(r.id)">
                    <img data-attr-src="r.icon"/><span class="grow name">{{ r.name }}</span><span class="count" data-if="r.links > 0">{{ r.links }} св.</span>
                </div>
                <div class="lg-nav-title">Добавить на доску</div>
                <div data-for="r : lg_add_rows" class="lg-nav-row row add" data-attr-id="'lg-add-' + r.id" data-attr-title="r.about" data-event-click="lg_add(r.id)">
                    <img data-attr-src="r.icon"/><span class="grow name">{{ r.name }}</span><icon class="s" name="add"/>
                </div>
                <div class="lg-nav-empty muted body-small" data-if="lg_add_rows.size == 0">Все вещи игры уже на доске. Новые вещи делаются во вкладке «Объекты».</div>
            </div>

            <!-- The board -->
            <div id="lg-board" class="lg-board grow" data-if="lg_mode == 'links'" data-event-mousedown="lg_board_down">
                <div data-for="l : lg_links">
                    <div class="lg-line" data-class-selected="l.selected" data-class-broken="l.broken" data-class-lit="l.lit"
                         data-style-left="l.lx + 'px'" data-style-top="l.ly + 'px'" data-style-width="l.len + 'px'" data-style-transform="'rotate(' + l.angle + 'deg)'"/>
                    <icon class="lg-head" name="play_arrow" data-class-selected="l.selected" data-class-broken="l.broken" data-class-lit="l.lit"
                          data-style-left="(l.hx - 12) + 'px'" data-style-top="(l.hy - 12) + 'px'" data-style-transform="'rotate(' + l.angle + 'deg)'"/>
                </div>
                <div data-for="t : lg_things" class="lg-thing column" data-attr-id="'lg-thing-' + t.id" data-class-selected="t.selected" data-class-broken="t.broken"
                     data-style-left="t.x + 'px'" data-style-top="t.y + 'px'" data-event-mousedown="lg_thing_down(it_index)">
                    <div class="lg-pic"><img data-attr-src="t.icon"/></div>
                    <span class="name">{{ t.name }}</span>
                </div>
                <div data-for="l : lg_links" class="lg-chip row" data-attr-id="'lg-link-' + l.id" data-class-selected="l.selected" data-class-broken="l.broken" data-class-lit="l.lit" data-attr-title="l.phrase"
                     data-style-left="l.cx + 'px'" data-style-top="l.cy + 'px'" data-event-mousedown="lg_link(l.id)">
                    <icon class="s" data-attr-name="l.broken ? 'error' : l.icon"/><span>{{ l.verb }}</span><span class="lg-refined" data-if="l.refined > 0">+{{ l.refined }}</span>
                </div>
                <div id="lg-first" class="lg-first column" data-if="lg_hint" data-event-mousedown="lg_stop">
                    <span class="title">Как сделать, чтобы что-то происходило?</span>
                    <span>Нажмите на вещь, а потом на другую, и выберите, что первая делает со второй. Вещи можно двигать мышкой, новые — добавить слева.</span>
                    <div id="lg-first-ok" class="button filled small" data-event-click="lg_hint_ok">Понятно</div>
                </div>
                <div id="lg-picker" class="lg-picker column" data-if="lg_picking" data-style-left="lg_pick_x + 'px'" data-style-top="lg_pick_y + 'px'" data-event-mousedown="lg_stop">
                    <div class="lg-picker-head row"><span class="grow">{{ lg_pick_title }}</span><div id="lg-pick-cancel" class="icon-button small" data-event-click="lg_pick_cancel"><icon name="close"/></div></div>
                    <div data-for="v : lg_verbs" class="lg-option column" data-attr-id="'lg-pick-' + it_index" data-class-reversed="v.reversed" data-event-click="lg_pick(it_index)">
                        <div class="row gap-2"><icon class="s" data-attr-name="v.icon"/><span class="phrase">{{ v.phrase }}</span></div>
                        <span class="about">{{ v.about }}</span>
                    </div>
                    <div class="muted body-small" data-if="lg_verbs.size == 0">Этим двум вещам игра пока ничего не умеет делать друг с другом.</div>
                </div>
            </div>

            <!-- «Идеи»: each link as a ready idea with a few fields -->
            <div id="lg-ideas" class="lg-ideas column grow" data-if="lg_mode == 'ideas'">
                <div class="lg-ideas-bar row">
                    <div id="lg-idea-new" class="button filled small" data-event-click="lg_gallery"><icon class="s" name="add"/><span>Новая идея</span></div>
                    <span class="muted body-small">Идея — это связь, показанная попроще: выберите вещи и уточнения.</span>
                </div>
                <div class="lg-gallery" data-if="lg_gallery">
                    <div data-for="d : lg_ideas" class="lg-idea column" data-attr-id="'lg-idea-' + d.id" data-class-off="!d.can" data-attr-title="d.can ? d.about : 'В игре нет подходящей вещи: её делают во вкладке «Объекты»'" data-event-click="lg_idea_add(d.id)">
                        <div class="row gap-2"><icon data-attr-name="d.icon"/><span class="name grow">{{ d.name }}</span><span class="group">{{ d.group }}</span></div>
                        <span class="about">{{ d.about }}</span>
                    </div>
                </div>
                <div class="lg-empty muted" data-if="lg_idea_cards.size == 0 && !lg_gallery">Связей пока нет. Нажмите «Новая идея» и выберите, что должно быть в игре.</div>
                <div class="lg-idea-cards">
                    <div data-for="c : lg_idea_cards" class="lg-recipe column" data-attr-id="'lg-recipe-' + c.id" data-class-selected="c.selected" data-class-lit="c.lit" data-event-click="lg_card(c.id)">
                        <div class="lg-recipe-head row">
                            <icon data-attr-name="c.icon"/>
                            <div class="column grow"><span class="name">{{ c.name }}</span><span class="phrase">{{ c.phrase }}</span></div>
                        </div>
                        <div class="lg-problem row" data-if="c.problem != ''"><icon class="s" name="error"/><span>{{ c.problem }}</span></div>
                        <div data-for="f : c.fields" class="lg-field row">
                            <span class="label">{{ f.label }}</span>
                            <div class="lg-thing-chip row" data-attr-id="'lg-field-' + c.id + '-' + f.side" title="Выбрать другую вещь" data-event-click="lg_field(c.id, f.side)">
                                <img data-attr-src="f.icon"/><span>{{ f.name }}</span><icon class="s" name="expand_more"/>
                            </div>
                        </div>
                        <div data-for="r : c.refine" class="lg-refine row" data-attr-id="'lg-idea-refine-' + c.id + '-' + r.id" data-attr-title="r.hint" data-event-click="lg_idea_refine(c.id, r.id)">
                            <icon data-attr-name="r.on ? 'check_box' : 'check_box_outline_blank'"/><span>{{ r.label }}</span>
                        </div>
                        <div class="command" data-attr-id="'lg-idea-steps-' + c.id" data-event-click="lg_idea_steps(c.id)"><icon name="unfold_more"/><span>Раскрыть в шаги</span></div>
                    </div>
                </div>
                <div id="lg-chooser" class="lg-chooser column" data-if="lg_choosing" data-event-click="lg_stop">
                    <div class="lg-picker-head row"><span class="grow">{{ lg_choose_title }}</span><div id="lg-choose-cancel" class="icon-button small" data-event-click="lg_choose_cancel"><icon name="close"/></div></div>
                    <div data-for="ch : lg_choices" class="lg-choice row" data-attr-id="'lg-choice-' + ch.id" data-class-current="ch.current" data-event-click="lg_choose(ch.id)">
                        <img data-attr-src="ch.icon"/><span class="grow">{{ ch.name }}</span><icon class="s" name="check" data-if="ch.current"/>
                    </div>
                    <div class="muted body-small" data-if="lg_choices.size == 0">Подходящих вещей нет.</div>
                </div>
            </div>

            <!-- «Шаги»: each link as steps -->
            <div id="lg-steps" class="lg-steps column grow" data-if="lg_mode == 'steps'">
                <div class="lg-empty muted" data-if="lg_cards.size == 0">Связей пока нет. Их проще всего сделать в режиме «Связи».</div>
                <div data-for="c : lg_cards" class="lg-card column" data-attr-id="'lg-card-' + c.id" data-class-selected="c.selected" data-class-lit="c.lit" data-event-click="lg_card(c.id)">
                    <div class="lg-card-head row"><span class="grow">{{ c.phrase }}</span></div>
                    <div class="lg-problem row" data-if="c.problem != ''"><icon class="s" name="error"/><span>{{ c.problem }}</span></div>
                    <div data-for="st : c.steps" data-attr-class="'lg-step row ' + st.part">
                        <span class="lg-part">{{ st.label }}</span>
                        <div class="lg-step-body row grow">
                            <icon class="s" data-attr-name="st.icon"/><span class="grow">{{ st.text }}</span>
                            <div class="icon-button small" data-if="st.refine != ''" data-attr-id="'lg-step-x-' + c.id + '-' + st.refine" title="Убрать шаг" data-event-click="lg_step_remove(c.id, st.refine)"><icon class="s" name="close"/></div>
                        </div>
                    </div>
                    <div class="lg-adds row" data-if="c.adds.size > 0">
                        <div class="command" data-attr-id="'lg-step-add-' + c.id" data-event-click="lg_step_adds(c.id)"><icon name="add"/><span>Добавить шаг</span></div>
                        <div data-if="c.adding" class="row lg-add-list">
                            <div data-for="ad : c.adds" class="lg-add-chip" data-attr-id="'lg-add-step-' + c.id + '-' + ad.id" data-attr-title="ad.about" data-event-click="lg_step_add(c.id, ad.id)">{{ ad.label }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- «Схема»: each link a frame with its node graph (scheme_view.h) -->
            <div id="lg-scheme" class="lg-scheme grow" data-if="lg_mode == 'scheme'" data-event-mousedown="sc_down">
                <lines id="sc-grid" source="sc-grid" class="sc-lines"/>
                <div class="lg-empty muted" data-if="sc_frames.size == 0">Связей пока нет. Их проще всего сделать в режиме «Связи». А вещь может что-то делать и сама по себе: «Своя схема вещи».</div>
                <div id="sc-world" class="sc-world" data-style-left="sc_pan_x + 'px'" data-style-top="sc_pan_y + 'px'" data-style-transform="'translate(' + sc_slide_x + 'px, ' + sc_slide_y + 'px)'">
                <div data-for="f : sc_frames" class="sc-frame" data-attr-id="'sc-frame-' + f.id" data-class-selected="f.selected" data-class-lit="f.lit" data-class-custom="f.custom" data-class-own="f.own"
                     data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'" data-event-mousedown="sc_frame_down(f.id)">
                    <div class="sc-frame-head row">
                        <icon class="s" data-attr-name="f.own ? 'category' : f.custom ? 'account_tree' : 'link'"/>
                        <span class="sc-frame-title grow">{{ f.phrase }}</span>
                        <span class="sc-badge" data-if="f.custom">своя схема</span>
                        <span class="sc-badge own" data-if="f.own">без связи</span>
                        <icon class="s err" name="error" data-if="f.problem != ''" data-attr-title="f.problem"/>
                        <div class="sc-head-button row" data-if="f.note == ''" data-attr-id="'sc-arrange-' + f.id" title="Разложить ноды по порядку: слева направо, значения под шагами (Ctrl+Z вернёт)" data-event-mousedown="sc_stop" data-event-click="sc_arrange(f.id)"><icon class="s" name="auto_awesome_mosaic"/><span>Упорядочить</span></div>
                        <div class="sc-head-button row" data-if="f.note == ''" data-attr-id="'sc-add-' + f.id" title="Добавить ноду (или правый щелчок по рамке)" data-event-mousedown="sc_stop" data-event-click="sc_add(f.id)"><icon class="s" name="add"/><span>Нода</span></div>
                        <div class="sc-head-button row" data-if="f.custom" data-attr-id="'sc-reset-' + f.id" title="Убрать свою схему: связь снова делает то, что в «Связях»" data-event-mousedown="sc_stop" data-event-click="sc_reset(f.id)"><icon class="s" name="undo"/><span>Как в Связях</span></div>
                        <div class="sc-head-button row" data-if="f.own" data-attr-id="'sc-drop-' + f.id" title="Убрать схему: вещь больше ничего не делает сама (Ctrl+Z вернёт)" data-event-mousedown="sc_stop" data-event-click="sc_reset(f.id)"><icon class="s" name="delete"/><span>Убрать</span></div>
                    </div>
                    <div class="sc-note" data-if="f.note != ''">{{ f.note }}</div>
                </div>
                <lines id="sc-wires" source="sc-wires" class="sc-lines"/>
                <div data-for="n : sc_nodes" data-attr-class="'sc-node ' + n.tone + (n.hidden ? ' hidden' : '') + (n.selected ? ' selected' : '') + (n.lit ? ' lit' : '') + (n.problem != '' ? (n.warning ? ' warn' : ' bad') : '')"
                     data-attr-id="'sc-node-' + n.id" data-style-left="n.x + 'px'" data-style-top="n.y + 'px'" data-style-width="n.w + 'px'" data-style-height="n.h + 'px'"
                     data-attr-title="n.problem != '' ? n.problem : n.help" data-event-mousedown="sc_node_down(n.link, n.uid)" data-event-click="sc_node(n.link, n.uid)">
                    <div class="sc-node-head row">
                        <icon class="s" data-attr-name="n.icon"/><span class="grow">{{ n.title }}</span>
                        <icon class="s sc-flag" name="error" data-if="n.problem != ''"/>
                        <div class="icon-button small" data-if="n.selected && !n.fixed" data-attr-id="'sc-remove-' + n.id" title="Убрать ноду (Delete)" data-event-mousedown="sc_stop" data-event-click="sc_remove(n.link, n.uid)"><icon class="s" name="close"/></div>
                    </div>
                    <div data-for="r : n.rows" class="sc-row row">
                        <div class="sc-in row grow">
                            <div data-if="r.in.on" data-attr-class="'sc-pin ' + r.in.kind + (r.in.wired ? ' wired' : '') + (r.in.pending ? ' pending' : '')" data-attr-id="'sc-pin-' + n.link + '-' + n.uid + '-i-' + r.in.id"
                                 data-event-mousedown="sc_pin_down(n.link, n.uid, false, r.in.id)" data-event-click="sc_pin(n.link, n.uid, false, r.in.id)"><shape data-if="r.in.kind == 'flow'" kind="exec" data-attr-fill="r.in.wired || r.in.pending ? 'true' : 'false'"/><div data-if="r.in.kind != 'flow'" class="sc-dot"></div></div>
                            <div data-if="!r.in.on && r.in.id != ''" class="sc-pin-gap"></div>
                            <span class="sc-label" data-if="r.in.field != 'pick'">{{ r.in.title }}</span>
                            <input data-if="r.in.field == 'text' || r.in.field == 'number'" type="text" data-attr-class="'sc-field ' + (r.in.field == 'number' ? 'sc-num' : 'sc-txt')" data-attr-id="'sc-field-' + n.link + '-' + n.uid + '-' + r.in.id" data-attr-value="r.in.value"
                                   data-event-mousedown="sc_stop" data-event-click="sc_stop" data-event-change="sc_text(n.link, n.uid, r.in.id, ev.value, ev.linebreak)" data-event-blur="sc_text_done(n.link, n.uid, r.in.id)"/>
                            <div data-if="r.in.field == 'check'" class="sc-check" data-attr-id="'sc-check-' + n.link + '-' + n.uid + '-' + r.in.id" data-event-mousedown="sc_stop" data-event-click="sc_check(n.link, n.uid, r.in.id, r.in.check)"><icon class="s" data-attr-name="r.in.check ? 'check_box' : 'check_box_outline_blank'"/></div>
                            <div data-if="r.in.field == 'pick'" class="sc-pick row" data-attr-id="'sc-pick-' + n.link + '-' + n.uid + '-' + r.in.id" data-event-mousedown="sc_stop" data-event-click="sc_pick_open(n.link, n.uid, r.in.id)"><span class="grow">{{ r.in.title }}</span><icon class="s" name="arrow_drop_down"/></div>
                        </div>
                        <div class="sc-out row">
                            <span class="sc-label">{{ r.out.title }}</span>
                            <div data-if="r.out.on" data-attr-class="'sc-pin ' + r.out.kind + (r.out.wired ? ' wired' : '') + (r.out.pending ? ' pending' : '')" data-attr-id="'sc-pin-' + n.link + '-' + n.uid + '-o-' + r.out.id"
                                 data-event-mousedown="sc_pin_down(n.link, n.uid, true, r.out.id)" data-event-click="sc_pin(n.link, n.uid, true, r.out.id)"><shape data-if="r.out.kind == 'flow'" kind="exec" data-attr-fill="r.out.wired || r.out.pending ? 'true' : 'false'"/><div data-if="r.out.kind != 'flow'" class="sc-dot"></div></div>
                        </div>
                    </div>
                </div>
                </div>
                <div id="sc-own-add" class="sc-tools button tonal small" title="Что вещь делает сама по себе, без связей: при старте, каждый шаг, при ударе…" data-event-mousedown="sc_stop" data-event-click="sc_own_add"><icon class="s" name="add"/><span>Своя схема вещи</span></div>
                <div id="sc-choose" class="sc-choose column" data-if="sc_choosing" data-style-left="sc_choose_x + 'px'" data-style-top="sc_choose_y + 'px'" data-event-mousedown="sc_stop">
                    <div data-for="c : sc_choices" class="sc-choice" data-attr-id="'sc-choice-' + c.id" data-event-click="sc_pick(c.id)">{{ c.name }}</div>
                </div>
                <div id="sc-palette" class="sc-palette column" data-if="sc_palette" data-style-left="sc_pal_x + 'px'" data-style-top="sc_pal_y + 'px'" data-event-mousedown="sc_stop">
                    <div class="sc-pal-head row">
                        <icon class="s" name="search"/>
                        <input id="sc-search" type="text" class="small grow" data-attr-value="sc_search" data-event-change="sc_search"/>
                        <div class="icon-button small" title="Закрыть (Esc)" data-event-click="sc_pal_close"><icon class="s" name="close"/></div>
                    </div>
                    <div class="sc-pal-list column">
                        <div data-for="it : sc_pal_items" class="column">
                            <div class="sc-pal-group" data-if="it.first">{{ it.group }}</div>
                            <div data-attr-class="'sc-pal-item row ' + it.tone" data-attr-id="'sc-pal-' + it.id" data-attr-title="it.help" data-event-click="sc_pal_pick(it.id)"><icon class="s" data-attr-name="it.icon"/><span>{{ it.title }}</span></div>
                        </div>
                        <div class="muted body-small sc-pal-none" data-if="sc_pal_items.size == 0">Такой ноды нет</div>
                    </div>
                </div>
                <div class="sc-tip row" data-if="sc_tip != ''"><icon class="s" name="cable"/><span>{{ sc_tip }}</span></div>
            </div>

            <!-- «Код»: the Luau the links become -->
            <div id="lg-code" class="lg-code-pane column grow" data-if="lg_mode == 'code'">
                <div class="lg-code-note row" data-if="!lg_editing"><icon class="s" name="info"/><span class="grow">Этот код игра собирает из связей сама. Щелчок по строке показывает её связь; «Править» задаёт ей свой код.</span>
                    <div id="lg-code-open" class="button tonal small" data-if="lg_has_link" data-event-click="lg_code_edit"><span>Править</span></div></div>
                <div id="lg-code-editor" class="lg-code-editor column grow" data-if="lg_editing">
                    <div class="lg-code-head row"><icon class="s" name="code"/><span class="grow">{{ lg_edit_title }}</span></div>
                    <div class="lg-code-help">Код выполняется, когда связь срабатывает. Есть: <b>self</b> — эта вещь, <b>hero</b> — герой, <b>target</b> — с кем действие; <b>logic.act</b>, <b>logic.sound</b>, <b>logic.hint</b>, <b>logic.has</b>, <b>logic.night</b>. В других режимах связь станет блоком «Код».</div>
                    <textarea id="lg-code-text" class="lg-code-text grow" data-value="lg_edit_text"></textarea>
                    <div class="lg-problem row" data-if="lg_edit_error != ''"><icon class="s" name="error"/><span>{{ lg_edit_error }}</span></div>
                    <div class="row gap-2">
                        <div id="lg-code-save" class="button filled small" data-event-click="lg_code_save"><span>Сохранить</span></div>
                        <div id="lg-code-cancel" class="button text small" data-event-click="lg_code_cancel"><span>Отмена</span></div>
                    </div>
                </div>
                <div class="lg-code column" data-if="!lg_editing">
                    <div data-for="ln : lg_code" class="lg-line-row row" data-attr-id="'lg-code-' + ln.n" data-class-selected="ln.selected" data-class-comment="ln.comment" data-class-lit="ln.lit" data-event-click="lg_code_line(ln.link)">
                        <span class="n">{{ ln.n }}</span><span class="t">{{ ln.text }}</span>
                    </div>
                </div>
            </div>

            <!-- In plain words -->
            <div class="lg-side column">
                <div data-if="lg_has_link" class="column">
                    <div class="lg-title">{{ lg_sel_phrase }}</div>
                    <div class="lg-problem row" data-if="lg_sel_problem != ''"><icon class="s" name="error"/><span>{{ lg_sel_problem }}</span></div>
                    <div class="lg-meaning">{{ lg_sel_meaning }}</div>
                    <div class="section-title" data-if="!lg_sel_code && !lg_sel_scheme">Уточнить</div>
                    <div data-for="r : lg_refine" class="lg-refine row" data-attr-id="'lg-refine-' + r.id" data-attr-title="r.hint" data-event-click="lg_refine(r.id)">
                        <icon data-attr-name="r.on ? 'check_box' : 'check_box_outline_blank'"/>
                        <div class="column grow"><span>{{ r.label }}</span><span class="muted body-small">{{ r.hint }}</span></div>
                    </div>
                    <div id="lg-code-edit" class="command" data-attr-title="'Задать связи своё поведение кодом на Luau'" data-event-click="lg_code_edit"><icon name="code"/><span>{{ lg_sel_code ? 'Править свой код' : 'Свой код вместо действия…' }}</span></div>
                    <div id="lg-code-reset" class="command" data-if="lg_sel_code" data-event-click="lg_code_reset"><icon name="undo"/><span>Вернуть обычное действие</span></div>
                    <div id="lg-scheme-open" class="command" data-if="lg_mode != 'scheme'" data-attr-title="'Связь нодами: её можно усложнить как угодно'" data-event-click="lg_scheme_open"><icon name="account_tree"/><span>{{ lg_sel_scheme ? 'Открыть свою схему' : 'Уточнить схемой…' }}</span></div>
                    <div id="lg-scheme-reset" class="command" data-if="lg_sel_scheme" data-event-click="lg_scheme_reset"><icon name="undo"/><span>Убрать свою схему</span></div>
                    <div id="lg-remove-link" class="command" data-event-click="lg_remove_link"><icon name="delete"/><span>Удалить связь</span></div>
                </div>
                <div data-if="lg_has_thing" class="column">
                    <div class="lg-preview"><img data-attr-src="lg_sel_icon"/></div>
                    <div class="lg-title">{{ lg_sel_name }}</div>
                    <div class="muted body-small">Нажмите на другую вещь на доске, чтобы связать их.</div>
                    <div class="section-title" data-if="lg_sel_links > 0">Связи</div>
                    <div data-for="w : lg_thing_links" class="lg-word column" data-event-click="lg_link(w.id)">
                        <span class="phrase">{{ w.phrase }}</span>
                        <span class="problem" data-if="w.problem != ''">{{ w.problem }}</span>
                    </div>
                    <div id="lg-thing-scheme" class="command" data-attr-title="'Что вещь делает сама по себе, без связей: при старте, каждый шаг, при ударе…'" data-event-click="lg_thing_scheme"><icon name="category"/><span>{{ lg_sel_own ? 'Открыть её свою схему' : 'Своя схема вещи…' }}</span></div>
                    <div id="lg-remove-thing" class="command" data-event-click="lg_remove_thing"><icon name="remove_circle_outline"/><span>{{ lg_sel_links > 0 ? 'Убрать с доски вместе со связями' : 'Убрать с доски' }}</span></div>
                </div>
                <div data-if="!lg_has_link && !lg_has_thing" class="column">
                    <div class="section-title">Вся логика словами</div>
                    <div class="muted body-small" data-if="lg_words.size == 0">Связей пока нет.</div>
                    <div data-for="w : lg_words" class="lg-word column" data-attr-id="'lg-word-' + w.id" data-class-lit="w.lit" data-event-click="lg_link(w.id)">
                        <span class="phrase">{{ w.phrase }}.</span>
                        <span class="meaning">{{ w.meaning }}</span>
                        <span class="problem" data-if="w.problem != ''">{{ w.problem }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="story" class="column" data-if="tab == 'story'">
        <div class="st-bar row">
            <div class="st-crumb row"><icon class="s" name="forum"/><span>Сюжет</span><icon class="s" name="chevron_right"/><b>{{ st_title }}</b></div>
            <div class="lg-modes row">
                <div id="st-mode-script" class="lg-mode selected" title="Разговор как пьеса"><icon name="menu_book"/><span>Сценарий</span></div>
                <div class="lg-mode soon" title="Ветки разговора стрелками: следующим шагом"><icon name="hub"/><span>Карта</span></div>
            </div>
            <div class="grow"/>
            <div id="st-replay" class="button filled small" data-event-click="st_play"><icon class="s" name="play_arrow"/><span>Проиграть сначала</span></div>
        </div>
        <div class="st-body row grow">
            <!-- The game's conversations and who speaks in the open one -->
            <div class="st-nav column">
                <div class="lg-nav-title">Разговоры</div>
                <div data-for="t : st_talks" class="st-nav-item">
                    <div class="st-nav-row row" data-if="t.kind == 'talk' || t.kind == 'subtalk'" data-class-sub="t.kind == 'subtalk'" data-class-empty="t.kind == 'subtalk' && t.lines == 0" data-attr-id="'st-talk-' + t.id" data-class-selected="t.selected" data-event-click="st_open(t.id)">
                        <span class="st-ava" data-if="t.kind == 'talk'" data-style-background-color="t.color">{{ t.letter }}</span><icon class="s" data-if="t.kind == 'subtalk'" name="description"/><span class="grow name">{{ t.name }}</span><span class="count">{{ t.lines }}</span>
                    </div>
                    <div class="st-nav-row row story" data-if="t.kind == 'story'" data-attr-id="'st-story-' + t.id" title="История из нескольких разговоров" data-event-click="st_story(t.id)">
                        <icon class="s" data-attr-name="t.open ? 'expand_more' : 'chevron_right'"/><icon class="s" name="auto_stories"/><span class="grow name">{{ t.name }}</span><span class="count">{{ t.lines }}</span>
                    </div>
                    <div class="st-nav-row row sub extra" data-if="t.kind == 'cast'" data-attr-id="'st-cast-' + t.id" data-class-selected="t.selected" title="Кто есть в истории: имена, цвета, позы" data-event-click="st_cast(t.id)">
                        <icon class="s" name="groups"/><span class="grow name">{{ t.name }}</span>
                    </div>
                    <div class="st-nav-row row sub extra" data-if="t.kind == 'novel'" data-attr-id="'st-novel-' + t.id" data-class-selected="t.selected" title="Настройки игры из Ren'Py: сохранены для модуля визуальной новеллы" data-event-click="st_novel(t.id)">
                        <icon class="s" name="tune"/><span class="grow name">{{ t.name }}</span>
                    </div>
                    <div class="st-nav-row row scene" data-if="t.kind == 'scene'" data-attr-id="'st-goto-' + t.id" title="Перейти к сцене" data-event-click="st_scene(t.id)">
                        <icon class="s" name="movie"/><span class="grow name">{{ t.name }}</span>
                    </div>
                </div>
                <div id="st-new-talk" class="st-nav-row row add" data-event-click="st_new_talk"><icon class="s" name="add"/><span>Новый разговор</span></div>
                <div id="st-import" class="st-nav-row row add" data-class-busy="st_importing" title="Перенести игру Ren'Py: выберите её папку" data-event-click="st_import"><icon class="s" name="download"/><span>Импорт из Ren'Py…</span></div>
                <div id="st-import-text" class="st-import-text" data-if="st_import_text != ''">{{ st_import_text }}</div>
                <div class="lg-nav-title">Кто говорит</div>
                <div data-for="s : st_speakers" class="st-nav-row row" data-attr-id="'st-speaker-' + s.key" title="Щёлкните, чтобы переименовать" data-event-click="st_edit('speaker', s.key, -1)">
                    <span class="st-ava" data-style-background-color="s.color">{{ s.letter }}</span>
                    <span class="grow name" data-if="!s.editing">{{ s.name }}</span>
                    <input id="st-edit" type="text" class="st-field grow" data-if="s.editing" data-value="st_edit_text" data-event-click="st_stop"/>
                </div>
                <div class="st-nav-row row muted"><span class="st-ava st-hero-ava">Я</span><span class="grow name">Герой (игрок)</span></div>
            </div>

            <!-- «Сценарий»: the conversation as a play -->
            <div id="st-script" class="st-script grow">
                <!-- An imported story's cast -->
                <div id="st-cast-page" class="st-page" data-if="st_view == 'cast'">
                    <div class="st-page-head row"><icon name="groups"/><span class="grow">Персонажи</span><span class="st-page-sub">{{ st_view_story }}</span></div>
                    <div class="st-cards row">
                        <div data-for="c : st_cast" class="st-card" data-attr-id="'st-card-' + c.key">
                            <div class="st-card-head row">
                                <span class="st-ava big" data-style-background-color="c.color">{{ c.letter }}</span>
                                <div class="grow st-card-names"><div class="st-card-name" data-style-color="c.color">{{ c.name }}</div><div class="st-card-sub">{{ c.sub }}</div></div>
                                <div class="st-card-count"><b>{{ c.lines }}</b><span>реплик</span></div>
                            </div>
                            <div class="st-card-row" data-if="c.pose_count > 0"><div class="st-card-label">Позы и виды · {{ c.pose_count }}</div><div class="st-card-text">{{ c.poses }}</div></div>
                            <div class="st-card-row" data-if="c.talks != ''"><div class="st-card-label">Где говорит</div><div class="st-card-text">{{ c.talks }}</div></div>
                            <div class="st-card-row" data-if="c.extra != ''"><div class="st-card-label">Настройки Ren'Py</div><div class="st-card-text code">{{ c.extra }}</div></div>
                        </div>
                    </div>
                </div>
                <!-- An imported story's settings, kept for the visual novel module -->
                <div id="st-novel-page" class="st-page" data-if="st_view == 'novel'">
                    <div class="st-page-head row"><icon name="tune"/><span class="grow">Настройки новеллы</span><span class="st-page-sub">{{ st_view_story }}</span></div>
                    <div class="st-novel-title">{{ st_novel_title }}</div>
                    <div class="st-novel-info">{{ st_novel_info }}</div>
                    <div class="st-hint row"><icon class="s" name="info"/><span>Это настройки игры из Ren'Py (options.rpy, gui.rpy, screens.rpy). Они не сюжет: их сохранили, чтобы модуль визуальной новеллы взял из них размер экрана, музыку, шрифты и вид окна текста.</span></div>
                    <div data-for="g : st_novel_groups" class="st-set-group">
                        <div class="st-set-title row"><span class="grow">{{ g.name }}</span><span class="count">{{ g.items.size }}</span></div>
                        <div data-for="r : g.items" class="st-set-row row"><span class="st-set-name" data-if="r.name != ''">{{ r.name }}</span><span class="st-set-value grow">{{ r.value }}</span></div>
                    </div>
                </div>
                <div class="st-hint row" data-if="st_view == ''"><icon class="s" name="lightbulb"/><span>Пишите, как пьесу: щёлкните по реплике и правьте текст, Enter сохраняет, Esc отменяет. Цветные пометки показывают, когда реплика звучит и что она меняет; щелчок по пометке открывает список. Справа разговор сразу проигрывается.</span></div>
                <div class="st-sheet column" data-if="st_view == ''">
                    <div class="st-pages row" data-if="st_page_on">
                        <div id="st-page-prev" class="button text small" data-class-disabled="!st_page_prev" data-event-click="st_page(-1)"><icon class="s" name="chevron_left"/><span>Раньше</span></div>
                        <span class="grow st-page-text">{{ st_page_text }}</span>
                        <div id="st-page-next" class="button text small" data-class-disabled="!st_page_next" data-event-click="st_page(1)"><span>Дальше</span><icon class="s" name="chevron_right"/></div>
                    </div>
                    <div class="st-start column">
                        <div class="st-label">Когда герой заговаривает</div>
                        <div data-for="r : st_rules" class="st-rule row" data-attr-id="'st-rule-' + r.index" data-class-lit="r.lit">
                            <div data-for="c : r.chips" data-attr-class="'st-chip ' + c.kind" data-attr-id="'st-rule-' + r.index + '-' + c.part" data-event-click="st_chip('', 'start', r.index, c.part, c.mark, 'open')">
                                <icon class="s" data-attr-name="c.icon"/><span>{{ c.text }}</span><icon class="s more" name="expand_more" data-if="c.kind == 'go'" data-event-click="st_chip('', 'start', r.index, c.part, c.mark, 'menu')"/>
                            </div>
                        </div>
                    </div>
                    <div data-for="l : st_lines" class="st-part column">
                        <div class="st-scene row" data-if="l.scene != '' && !l.editing_scene" data-attr-id="'st-scene-' + l.id" data-event-click="st_edit('scene', l.id, -1)"><icon class="s" name="movie"/><span>{{ l.scene }}</span></div>
                        <input id="st-edit" type="text" class="st-field st-scene-field" data-if="l.editing_scene" data-value="st_edit_text" data-event-click="st_stop"/>
                        <div data-attr-id="'st-line-' + l.id" data-attr-class="'st-line column ' + l.kind" data-class-lit="l.lit" data-class-flash="l.flash">
                            <div class="st-chips st-stage row" data-if="l.stage.size > 0">
                                <div data-for="c : l.stage" class="st-stage-item">
                                    <div data-if="l.editing_stage != c.mark" data-attr-class="'st-chip ' + c.kind" data-attr-id="'st-stage-' + l.id + '-' + c.mark" title="Что происходит на экране; щёлкните, чтобы поправить" data-event-click="st_chip(l.id, 'node', -1, 'stage', c.mark, 'open')">
                                        <icon class="s" data-attr-name="c.icon"/><span>{{ c.text }}</span>
                                    </div>
                                    <input id="st-edit" type="text" class="st-field st-code" data-if="l.editing_stage == c.mark" data-value="st_edit_text" data-event-click="st_stop"/>
                                </div>
                            </div>
                            <div class="st-note" data-if="l.note != '' && !l.editing_note" data-attr-id="'st-note-' + l.id" data-event-click="st_edit('note', l.id, -1)">{{ l.note }}</div>
                            <textarea id="st-edit" class="st-field st-note-field" data-if="l.editing_note" data-attr-rows="st_edit_rows" data-value="st_edit_text" data-event-click="st_stop"></textarea>
                            <div class="row st-say-row">
                                <div class="st-who column" data-attr-id="'st-who-' + l.id" data-style-color="l.color" title="Кто говорит" data-event-click="st_chip(l.id, 'node', -1, 'speaker', -1, 'menu')"><span>{{ l.who }}</span><span class="st-pose" data-if="l.pose != ''" title="Как выглядит, когда говорит">{{ l.pose }}</span></div>
                                <div class="column grow st-say-col">
                                    <span class="st-say" data-if="l.kind == 'line' && !l.editing" data-class-empty="l.text == ''" data-attr-id="'st-say-' + l.id" data-event-click="st_edit('text', l.id, -1)">{{ l.text == '' ? 'Новая реплика: щёлкните и пишите' : l.text }}</span>
                                    <textarea id="st-edit" class="st-field st-say-field" data-if="l.editing" data-attr-rows="st_edit_rows" data-value="st_edit_text" data-event-click="st_stop"></textarea>
                                    <div class="st-chips row" data-if="l.chips.size > 0">
                                        <div data-for="c : l.chips" data-attr-class="'st-chip ' + c.look" data-attr-id="'st-chip-' + l.id + '-' + c.part + '-' + c.mark" data-event-click="st_chip(l.id, 'node', -1, c.part, c.mark, 'open')">
                                            <icon class="s" data-attr-name="c.icon"/><span>{{ c.text }}</span><icon class="s more" name="expand_more" data-if="c.kind == 'go'" data-event-click="st_chip(l.id, 'node', -1, c.part, c.mark, 'menu')"/>
                                        </div>
                                    </div>

                                    <!-- Questions typed in words -->
                                    <div class="st-topics column" data-if="l.topics_on">
                                        <div class="st-label row"><icon class="s" name="keyboard"/><span>Игрок пишет вопрос словами</span></div>
                                        <div data-for="t : l.topics" class="st-topic row" data-attr-id="'st-topic-' + l.id + '-' + t.index" data-class-lit="t.lit">
                                            <div class="st-words">
                                                <span class="st-word" data-if="!t.editing_words" data-event-click="st_edit('words', l.id, t.index)">{{ t.words }}</span>
                                                <input id="st-edit" type="text" class="st-field" data-if="t.editing_words" data-value="st_edit_text" data-event-click="st_stop"/>
                                            </div>
                                            <div class="column grow">
                                                <span class="st-say small" data-if="t.answer != '' && !t.editing_text" data-event-click="st_edit('topic', l.id, t.index)">{{ t.text }}</span>
                                                <textarea id="st-edit" class="st-field st-say-field" data-if="t.editing_text" data-attr-rows="st_edit_rows" data-value="st_edit_text" data-event-click="st_stop"></textarea>
                                                <div class="st-chips row" data-if="t.chips.size > 0">
                                                    <div data-for="c : t.chips" data-attr-class="'st-chip ' + c.kind" data-event-click="st_chip(l.id, 'topic', t.index, c.part, c.mark, 'open')">
                                                        <icon class="s" data-attr-name="c.icon"/><span>{{ c.text }}</span><icon class="s more" name="expand_more" data-if="c.kind == 'go'" data-event-click="st_chip(l.id, 'topic', t.index, c.part, c.mark, 'menu')"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="st-x" title="Убрать тему" data-event-click="st_remove_topic(l.id, t.index)"><icon class="s" name="close"/></div>
                                        </div>
                                        <div class="st-topic row" data-if="l.has_fallback">
                                            <div class="st-words"><span class="st-word other">другие слова</span></div>
                                            <span class="st-say small grow" data-if="!l.editing_fallback" data-event-click="st_edit('fallback', l.id, -1)">{{ l.fallback }}</span>
                                            <textarea id="st-edit" class="st-field st-say-field grow" data-if="l.editing_fallback" data-attr-rows="st_edit_rows" data-value="st_edit_text" data-event-click="st_stop"></textarea>
                                        </div>
                                    </div>

                                    <!-- The hero's answers -->
                                    <div class="st-choices column" data-if="l.choices_on">
                                        <div data-for="ch : l.choices" class="st-choice row" data-attr-id="'st-choice-' + l.id + '-' + ch.index" data-class-lit="ch.lit">
                                            <span class="st-who st-hero">Я</span>
                                            <div class="column grow">
                                                <span class="st-answer" data-if="!ch.editing" data-class-empty="ch.text == ''" data-event-click="st_edit('choice', l.id, ch.index)">{{ ch.text == '' ? 'Ответ героя: щёлкните и пишите' : ch.text }}</span>
                                                <textarea id="st-edit" class="st-field st-say-field" data-if="ch.editing" data-attr-rows="st_edit_rows" data-value="st_edit_text" data-event-click="st_stop"></textarea>
                                                <div class="st-chips row">
                                                    <div data-for="c : ch.chips" data-attr-class="'st-chip ' + c.kind" data-attr-id="'st-choice-' + l.id + '-' + ch.index + '-' + c.part + '-' + c.mark" data-event-click="st_chip(l.id, 'choice', ch.index, c.part, c.mark, 'open')">
                                                        <icon class="s" data-attr-name="c.icon"/><span>{{ c.text }}</span><icon class="s more" name="expand_more" data-if="c.kind == 'go'" data-event-click="st_chip(l.id, 'choice', ch.index, c.part, c.mark, 'menu')"/>
                                                    </div>
                                                    <div class="st-add-mark" title="Когда этот ответ виден" data-event-click="st_add_mark(l.id, 'choice', ch.index, 'if')"><icon class="s" name="help"/></div>
                                                    <div class="st-add-mark" title="Что ответ меняет в игре" data-event-click="st_add_mark(l.id, 'choice', ch.index, 'do')"><icon class="s" name="bolt"/></div>
                                                </div>
                                            </div>
                                            <div class="st-x" title="Убрать ответ" data-event-click="st_remove_choice(l.id, ch.index)"><icon class="s" name="close"/></div>
                                        </div>
                                    </div>

                                    <div class="st-adds row" data-if="l.kind == 'line'">
                                        <div class="st-add" data-if="l.can_add" data-attr-id="'st-add-line-' + l.id" data-event-click="st_add_line(l.id)"><icon class="s" name="add"/><span>Реплика</span></div>
                                        <div class="st-add" data-attr-id="'st-add-choice-' + l.id" data-event-click="st_add_choice(l.id)"><icon class="s" name="add"/><span>Ответ героя</span></div>
                                        <div class="st-add" data-attr-id="'st-add-topic-' + l.id" data-event-click="st_add_topic(l.id)"><icon class="s" name="add"/><span>Тема</span></div>
                                        <div class="st-add" data-attr-id="'st-add-mark-' + l.id" data-event-click="st_add_mark(l.id, 'node', -1, 'do')"><icon class="s" name="bolt"/><span>Что меняет</span></div>
                                        <div class="st-add" data-if="l.note == '' && !l.editing_note" data-event-click="st_edit('note', l.id, -1)"><icon class="s" name="theater_comedy"/><span>Ремарка</span></div>
                                        <div class="st-add" data-if="l.scene == '' && !l.editing_scene" data-event-click="st_edit('scene', l.id, -1)"><icon class="s" name="movie"/><span>Сцена</span></div>
                                        <div class="grow"/>
                                        <div class="st-add quiet" data-if="l.seq" data-attr-id="'st-seq-' + l.id" title="Сейчас разговор идёт к реплике ниже; щёлкните, чтобы выбрать другую" data-event-click="st_chip(l.id, 'node', -1, 'next', -1, 'menu')"><icon class="s" name="south"/><span>Дальше…</span></div>
                                        <div class="st-add danger" data-attr-id="'st-remove-' + l.id" data-event-click="st_remove_line(l.id)"><icon class="s" name="delete"/><span>Убрать</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="st-pages row" data-if="st_page_on">
                        <div class="button text small" data-class-disabled="!st_page_prev" data-event-click="st_page(-1)"><icon class="s" name="chevron_left"/><span>Раньше</span></div>
                        <span class="grow st-page-text">{{ st_page_text }}</span>
                        <div class="button text small" data-class-disabled="!st_page_next" data-event-click="st_page(1)"><span>Дальше</span><icon class="s" name="chevron_right"/></div>
                    </div>
                    <div id="st-add-scene" class="st-add big" data-event-click="st_add_scene"><icon class="s" name="add"/><span>Новая сцена</span></div>
                </div>
            </div>

            <!-- The test: the conversation plays without the game -->
            <div class="st-test column">
                <div class="lg-nav-title row"><icon class="s" name="play_circle"/><span>Проверка без игры</span></div>
                <div class="st-screen column">
                    <div class="st-bubble column" data-if="st_play_on">
                        <span id="st-play-who" class="st-bubble-who" data-style-color="st_play_color">{{ st_play_who }}</span>
                        <span id="st-play-text" class="st-bubble-text">{{ st_play_text }}</span>
                    </div>
                    <div class="row st-ask" data-if="st_play_on && st_play_asks">
                        <input id="st-ask" type="text" class="st-field grow" placeholder="Спросите словами: где шахта?" data-value="st_ask_text"/>
                        <div id="st-ask-send" class="icon-button" data-event-click="st_ask"><icon name="send"/></div>
                    </div>
                    <div data-for="c : st_play_choices" class="st-opt" data-attr-id="'st-opt-' + it_index" data-event-click="st_choose(it_index)">{{ c }}</div>
                    <div id="st-next" class="st-opt plain" data-if="st_play_on && st_play_next" data-event-click="st_next">Дальше</div>
                    <div class="st-ended column" data-if="!st_play_on">
                        <span>Разговор окончен. Поменяйте, что сейчас в игре, и проиграйте снова.</span>
                        <div id="st-again" class="st-opt plain" data-event-click="st_play">Заговорить снова</div>
                    </div>
                </div>
                <div class="lg-nav-title row"><icon class="s" name="tune"/><span>Что сейчас в игре</span></div>
                <div class="st-state column">
                    <div data-for="s : st_state" class="st-state-row row" data-attr-id="'st-state-' + s.id">
                        <img data-if="s.icon != ''" data-attr-src="s.icon"/>
                        <span class="grow">{{ s.name }}</span>
                        <div class="icon-button small" data-event-click="st_state(s.id, s.kind, -1)"><icon class="s" name="remove"/></div>
                        <span class="st-value">{{ s.value }}</span>
                        <div class="icon-button small" data-attr-id="'st-more-' + s.id" data-event-click="st_state(s.id, s.kind, 1)"><icon class="s" name="add"/></div>
                    </div>
                </div>
                <div class="lg-nav-title row"><icon class="s" name="history"/><span>Что случилось</span></div>
                <div class="st-log column grow">
                    <div data-for="r : st_log" data-attr-class="'st-log-row row ' + r.kind"><icon class="s" data-attr-name="r.icon"/><span class="grow">{{ r.text }}</span></div>
                </div>
            </div>
        </div>

        <!-- A mark's list: quest stages, the game's things, the other lines -->
        <div id="st-menu" class="st-menu column" data-if="st_menu" data-style-left="st_menu_x + 'px'" data-style-top="st_menu_y + 'px'" data-event-click="st_stop">
            <div class="lg-picker-head row"><span class="grow">{{ st_menu_title }}</span><div id="st-menu-close" class="icon-button small" data-event-click="st_menu_close"><icon name="close"/></div></div>
            <div class="st-menu-list column">
                <div data-for="m : st_menu_items" class="st-menu-item row" data-attr-id="'st-menu-' + it_index" data-class-current="m.current" data-event-click="st_menu_pick(it_index)">
                    <icon class="s" data-attr-name="m.icon"/><span class="grow">{{ m.text }}</span><icon class="s" name="check" data-if="m.current"/>
                </div>
            </div>
        </div>
        <!-- «своё условие…»: typed as the game reads it -->
        <div id="st-raw" class="st-menu column" data-if="st_editing != ''" data-style-left="st_menu_x + 'px'" data-style-top="st_menu_y + 'px'" data-event-click="st_stop">
            <div class="lg-picker-head row"><span class="grow">{{ st_editing == 'cond' ? 'Своё условие' : 'Своё действие' }}</span></div>
            <input id="st-edit" type="text" class="st-field st-code" data-value="st_edit_text"/>
            <span class="muted body-small">{{ st_editing == 'cond' ? 'Например: quest.pickaxe >= 1 and has("pickaxe")' : 'Например: give("coins", 30); quest.pickaxe = 3' }}</span>
            <div class="row gap-2"><div class="grow"/><div class="button text small" data-event-click="st_cancel">Отмена</div><div id="st-raw-ok" class="button filled small" data-event-click="st_commit">Готово</div></div>
        </div>
    </div>

    <!-- «Интерфейс»: the game's screens drawn like Figma frames. C++: apps/editor/ui_editor.cpp. -->
    <div id="ui-editor" class="column" data-if="tab == 'ui'">
        <div class="ue-bar row">
            <div class="st-crumb row"><icon class="s" name="dashboard"/><span>Интерфейс</span><icon class="s" name="chevron_right"/><b>{{ ue_title }}</b></div>
            <div id="ue-mode" class="ue-mode row" title="Простой: кнопки, тексты, картинки, полоски и списки обычными словами. Полный: все настройки. Экран от этого не меняется.">
                <div id="ue-mode-simple" class="ue-mode-btn" data-class-selected="ue_simple" data-event-click="ue_mode('simple')">Простой</div>
                <div id="ue-mode-full" class="ue-mode-btn" data-class-selected="!ue_simple" data-event-click="ue_mode('full')">Полный</div>
            </div>
            <div id="ue-blocks" class="ue-blocks row" data-if="ue_simple &amp;&amp; !ue_library_open">
                <div id="ue-block-button" class="ue-block row" title="Кнопка с надписью: назначьте ей действие справа" data-event-click="ue_block('button')"><icon class="s" name="smart_button"/><span>Кнопка</span></div>
                <div id="ue-block-text" class="ue-block row" title="Надпись, можно с данными игры" data-event-click="ue_block('text')"><icon class="s" name="title"/><span>Текст</span></div>
                <div id="ue-block-picture" class="ue-block row" title="Картинка из папки игры" data-event-click="ue_block('picture')"><icon class="s" name="image"/><span>Картинка</span></div>
                <div id="ue-block-bar" class="ue-block row" title="Полоска по данным игры: здоровье, опыт" data-event-click="ue_block('bar')"><icon class="s" name="linear_scale"/><span>Полоска</span></div>
                <div id="ue-block-list" class="ue-block row" title="Список вещей героя или заданий" data-event-click="ue_block('list')"><icon class="s" name="view_list"/><span>Список</span></div>
            </div>
            <div class="ue-tools row" data-if="!ue_simple">
                <div id="ue-tool-select" class="ue-tool" data-class-selected="ue_tool == 'select'" title="Выбор и перемещение (V)" data-event-click="ue_tool('select')"><icon name="near_me"/></div>
                <div id="ue-tool-frame" class="ue-tool" data-class-selected="ue_tool == 'frame'" title="Рамка (F): держит другие слои, умеет автораскладку" data-event-click="ue_tool('frame')"><icon name="tag"/></div>
                <div id="ue-tool-rectangle" class="ue-tool" data-class-selected="ue_tool == 'rectangle'" title="Прямоугольник (R)" data-event-click="ue_tool('rectangle')"><icon name="rectangle"/></div>
                <div id="ue-tool-ellipse" class="ue-tool" data-class-selected="ue_tool == 'ellipse'" title="Эллипс (O)" data-event-click="ue_tool('ellipse')"><icon name="circle"/></div>
                <div id="ue-tool-text" class="ue-tool" data-class-selected="ue_tool == 'text'" title="Текст (T)" data-event-click="ue_tool('text')"><icon name="title"/></div>
            </div>
            <div id="ue-check" class="ue-check-btn row" data-class-on="ue_checking" title="Проверить: экран оживает, как в игре (Esc — закончить)" data-event-click="ue_check">
                <icon class="s" data-attr-name="ue_checking ? 'stop_circle' : 'play_circle'"/><span>{{ ue_checking ? 'Закончить проверку' : 'Проверить' }}</span>
            </div>
            <div id="ue-views" class="ue-views row" title="Экран игрока: как экран выглядит в игре на таком мониторе">
                <div data-for="v : ue_views" class="ue-view" data-attr-id="'ue-view-' + it_index" data-class-selected="ue_view == it_index" data-attr-title="v.title" data-event-click="ue_view(it_index)">{{ v.label }}</div>
            </div>
            <div class="grow"/>
            <div class="ue-zoom row">
                <div class="ue-tool" title="Мельче (−)" data-event-click="ue_zoom('out')"><icon name="zoom_out"/></div>
                <div id="ue-zoom-text" class="ue-zoom-text" title="100% (Shift+0)" data-event-click="ue_zoom('100')">{{ ue_zoom }}</div>
                <div class="ue-tool" title="Крупнее (+)" data-event-click="ue_zoom('in')"><icon name="zoom_in"/></div>
                <div class="ue-tool" title="Весь экран (Shift+1)" data-event-click="ue_zoom('fit')"><icon name="fit_screen"/></div>
            </div>
        </div>
        <div class="ue-body row grow">
            <!-- Screens and layers -->
            <div class="ue-left ue-panel column">
                <div class="lg-nav-title">Экраны</div>
                <div id="ue-library" class="ue-row row" data-class-selected="ue_library_open" title="Кнопки, полоски, окошки: сделаны один раз, стоят на любых экранах" data-event-click="ue_library"><icon class="s ue-comp-icon" name="widgets"/><span class="grow name">Компоненты</span><span class="count">{{ ue_components.size }}</span></div>
                <div data-for="s : ue_screens" class="ue-row row" data-attr-id="'ue-screen-' + s.name" data-class-selected="s.selected" data-event-click="ue_screen(s.name)" data-event-dblclick="ue_rename('screen')">
                    <icon class="s" name="web_asset"/>
                    <span class="grow name" data-if="!(s.selected && ue_renaming == 'screen')">{{ s.title }}</span>
                    <input type="text" class="ue-rename grow" data-if="s.selected && ue_renaming == 'screen'" data-attr-value="ue_rename_text" data-event-change="ue_rename_text(ev.value, ev.linebreak)" data-event-blur="ue_rename_done"/>
                    <span class="count">{{ s.size }}</span>
                </div>
                <div id="ue-new-screen" class="ue-row row add" data-event-click="ue_new_screen"><icon class="s" name="add"/><span>Новый экран</span></div>
                <div class="lg-nav-title">Слои</div>
                <div class="ue-layers grow">
                    <div data-for="l : ue_layers" class="ue-layer row" data-attr-id="'ue-layer-' + l.id" data-class-selected="l.selected" data-class-comp="l.component" data-class-off="!l.visible || l.hidden_by_parent" data-style-padding-left="(6 + l.depth * 16) + 'px'" data-event-click="ue_layer(l.id)" data-event-dblclick="ue_rename(l.id)">
                        <div class="ue-fold" data-if="l.container" data-event-click="ue_layer_fold(l.id)"><icon class="xs" data-attr-name="l.open ? 'expand_more' : 'chevron_right'"/></div>
                        <div class="ue-fold" data-if="!l.container"/>
                        <icon class="s ue-type" data-attr-name="l.icon"/>
                        <span class="grow name" data-if="ue_renaming != ('' + l.id)">{{ l.name }}</span>
                        <input type="text" class="ue-rename grow" data-if="ue_renaming == ('' + l.id)" data-attr-value="ue_rename_text" data-event-change="ue_rename_text(ev.value, ev.linebreak)" data-event-blur="ue_rename_done"/>
                        <div class="ue-eye" data-class-on="l.locked" title="Закрепить: не выбирается на холсте" data-event-click="ue_layer_lock(l.id)"><icon class="xs" data-attr-name="l.locked ? 'lock' : 'lock_open'"/></div>
                        <div class="ue-eye" data-class-on="!l.visible" title="Показать или скрыть" data-event-click="ue_layer_eye(l.id)"><icon class="xs" data-attr-name="l.visible ? 'visibility' : 'visibility_off'"/></div>
                    </div>
                    <div class="ue-empty" data-if="ue_layers.size == 0">Пока пусто: выберите инструмент сверху и нарисуйте на экране.</div>
                </div>
                <div class="lg-nav-title" title="Щелчок по компоненту ставит его копию на экран">Компоненты</div>
                <div class="ue-comps">
                    <div data-for="c : ue_components" class="ue-row row" data-attr-id="'ue-comp-' + it_index" title="Поставить на экран" data-event-click="ue_place(c.name)"><icon class="s ue-comp-icon" data-attr-name="c.icon"/><span class="grow name">{{ c.name }}</span><span class="count" data-if="c.variants > 1">{{ c.variants }}</span></div>
                    <div class="ue-empty" data-if="ue_components.size == 0">Выделите слой и нажмите «Сделать компонентом» справа: его можно будет ставить на любые экраны.</div>
                </div>
            </div>

            <!-- The canvas with its rulers -->
            <div id="ue-stage" class="ue-stage grow">
                <div class="ue-corner"/>
                <div id="ue-ruler-x" class="ue-ruler ue-ruler-x" title="Тяните вниз: направляющая">
                    <div class="ue-ruler-sel" data-if="ue_handles" data-style-left="ue_sel_box.x + 'px'" data-style-width="ue_sel_box.w + 'px'"/>
                    <lines class="ue-ruler-lines" source="ue-ruler-x"/>
                    <div data-for="t : ue_ticks_x" class="ue-tick-x" data-style-left="(t.at + 3) + 'px'">{{ t.label }}</div>
                </div>
                <div id="ue-ruler-y" class="ue-ruler ue-ruler-y" title="Тяните вправо: направляющая">
                    <div class="ue-ruler-sel" data-if="ue_handles" data-style-top="ue_sel_box.y + 'px'" data-style-height="ue_sel_box.h + 'px'"/>
                    <lines class="ue-ruler-lines" source="ue-ruler-y"/>
                    <div data-for="t : ue_ticks_y" class="ue-tick-y" data-style-top="(t.at - 3) + 'px'">{{ t.label }}</div>
                </div>
                <div id="ue-canvas" class="ue-canvas" data-class-drawing="ue_tool != 'select'">
                    <div id="ue-view-note" class="ue-view-note" data-if="ue_view_note != ''">{{ ue_view_note }}</div>
                    <div class="ue-frame-label" data-style-left="ue_frame_label.x + 'px'" data-style-top="ue_frame_label.y + 'px'" data-event-click="ue_select_screen">{{ ue_frame_label.text }}</div>
                    <div class="ue-frame-shadow" data-style-left="ue_frame.x + 'px'" data-style-top="ue_frame.y + 'px'" data-style-width="ue_frame.w + 'px'" data-style-height="ue_frame.h + 'px'"/>
                    <img id="ue-screen" class="ue-screen" src="/gpu/ui-screen" data-style-left="ue_frame.x + 'px'" data-style-top="ue_frame.y + 'px'" data-style-width="ue_frame.w + 'px'" data-style-height="ue_frame.h + 'px'"/>
                    <div data-for="g : ue_guides_x" class="ue-guide-x" data-style-left="g.x + 'px'"><span/></div>
                    <div data-for="g : ue_guides_y" class="ue-guide-y" data-style-top="g.y + 'px'"><span/></div>
                    <div class="ue-hover" data-if="ue_hovering" data-style-left="ue_hover.x + 'px'" data-style-top="ue_hover.y + 'px'" data-style-width="ue_hover.w + 'px'" data-style-height="ue_hover.h + 'px'"/>
                    <div id="ue-safe" class="ue-safe" data-if="ue_has_safe" data-style-left="ue_safe.x + 'px'" data-style-top="ue_safe.y + 'px'" data-style-width="ue_safe.w + 'px'" data-style-height="ue_safe.h + 'px'"/>
                    <div data-for="b : ue_selected" class="ue-picked" data-style-left="b.x + 'px'" data-style-top="b.y + 'px'" data-style-width="b.w + 'px'" data-style-height="b.h + 'px'"><span/></div>
                    <div id="ue-selection" class="ue-selection" data-if="ue_handles" data-style-left="ue_sel_box.x + 'px'" data-style-top="ue_sel_box.y + 'px'" data-style-width="ue_sel_box.w + 'px'" data-style-height="ue_sel_box.h + 'px'">
                        <div class="ue-handle tl"/><div class="ue-handle t" data-if="ue_sel_box.w >= 24"/><div class="ue-handle tr"/><div class="ue-handle r" data-if="ue_sel_box.h >= 24"/>
                        <div class="ue-handle br"/><div class="ue-handle b" data-if="ue_sel_box.w >= 24"/><div class="ue-handle bl"/><div class="ue-handle l" data-if="ue_sel_box.h >= 24"/>
                        <div class="ue-size">{{ ue_size_label }}</div>
                    </div>
                    <div class="ue-marquee" data-if="ue_marqueeing" data-style-left="ue_marquee.x + 'px'" data-style-top="ue_marquee.y + 'px'" data-style-width="ue_marquee.w + 'px'" data-style-height="ue_marquee.h + 'px'"/>
                    <lines class="ue-overlay" source="ue-overlay"/>
                    <div data-for="m : ue_measures" class="ue-measure" data-style-left="m.x + 'px'" data-style-top="m.y + 'px'">{{ m.text }}</div>
                </div>
            </div>

            <!-- The selected layer's design -->
            <div id="ue-design" class="ue-right ue-panel column">
                <div class="ue-props column" data-if="ue_checking">
                    <div class="ue-head row"><icon class="s" name="play_circle"/><span class="grow name">Проверка</span><span class="muted">{{ ue_title }}</span></div>
                    <div class="ue-sec"><div class="ue-note">Наводите мышь и нажимайте кнопки на холсте, как в игре: кнопка, которая открывает экран, откроет его здесь. Esc — закончить.</div></div>
                    <div class="ue-sec">
                        <div class="ue-sec-title">Данные игры <span class="muted">меняйте и смотрите</span></div>
                        <div data-for="v : ue_check_vars" class="ue-line row" data-attr-title="v.name">
                            <span class="ue-key grow ue-ellipsis">{{ v.label }}</span>
                            <div class="ue-num ue-short"><input type="text" data-attr-id="'ue-check-var-' + it_index" data-attr-value="v.value" data-event-change="ue_check_var(v.name, ev.value, ev.linebreak)"/></div>
                        </div>
                        <div class="ue-note" data-if="ue_check_vars.size == 0">Этот экран не показывает данных игры. Их добавляют во вкладке «В игре»: значение в тексте, полоска, условие показа.</div>
                    </div>
                    <div class="ue-sec" data-if="ue_check_log.size > 0">
                        <div class="ue-sec-title">Что сделали кнопки</div>
                        <div data-for="l : ue_check_log" class="ue-note ue-log">{{ l }}</div>
                    </div>
                </div>
                <div class="ue-empty" data-if="!ue_p.any && !ue_checking">Выберите слой на холсте или в списке слева. Щелчок по названию экрана над ним — фон и размер экрана.</div>
                <!-- «Простой»: the selected block in plain words. C++: UiEditor::refresh_simple, set_simple_property. -->
                <div id="ue-simple" data-if="ue_p.any && !ue_checking && ue_simple" class="ue-props column">
                    <div class="ue-head row"><icon class="s" data-attr-name="ue_s.icon"/><span class="grow name">{{ ue_s.name }}</span><span id="ue-s-block" class="muted">{{ ue_s.word }}</span></div>
                    <div class="ue-sec" data-if="ue_s.many"><div class="ue-note">Выбрано несколько слоёв. В простом режиме они правятся по одному: выберите один.</div></div>
                    <div class="column" data-if="!ue_s.many">
                    <div class="ue-sec">
                        <div class="ue-line row"><span class="ue-key">Название</span><input id="ue-s-name" type="text" class="ue-field grow" data-attr-value="ue_s.name" data-event-change="ue_stext('name', ev.value, ev.linebreak)" data-event-blur="ue_scommit('name')"/></div>
                        <div class="ue-line row" data-if="ue_s.has_text"><span class="ue-key">{{ ue_s.block == 'button' ? 'Надпись' : 'Текст' }}</span><input id="ue-s-text" type="text" class="ue-field grow" data-attr-value="ue_s.text" data-event-change="ue_stext('text', ev.value, ev.linebreak)" data-event-blur="ue_scommit('text')"/></div>
                        <div class="ue-line row" data-if="ue_s.has_text"><span class="ue-key">Размер букв</span><input id="ue-s-size" type="text" class="ue-field grow" data-attr-value="ue_s.size" data-event-change="ue_stext('size', ev.value, ev.linebreak)" data-event-blur="ue_scommit('size')"/></div>
                        <div class="ue-line row" data-if="ue_s.has_color"><span class="ue-key">{{ ue_s.root ? 'Фон' : (ue_s.block == 'text' ? 'Цвет букв' : 'Цвет') }}</span>
                            <div class="ue-swatch ue-checker" id="ue-s-swatch" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('simple.color')"><div class="ue-swatch-fill" data-style-background-color="ue_s.swatch"/></div>
                            <input id="ue-s-color" type="text" class="ue-hex grow" placeholder="нет" data-attr-value="ue_s.hex" data-event-change="ue_stext('color', ev.value, ev.linebreak)" data-event-blur="ue_scommit('color')"/></div>
                        <div class="ue-s-theme row" data-if="ue_s.has_color &amp;&amp; ue_s.block != 'text' &amp;&amp; ue_game_colors.size > 0" title="Цвета игры: поменяете цвет в компонентах, и он поменяется везде">
                            <span class="ue-key">Тема игры</span>
                            <div data-for="c : ue_game_colors" class="ue-s-chip" data-attr-id="'ue-s-theme-' + it_index" data-attr-title="c.name" data-class-selected="ue_s.style == c.key" data-style-background-color="c.swatch" data-event-click="ue_sset('color', '@' + c.key)"/>
                        </div>
                        <div class="ue-line row" data-if="ue_s.has_text_color"><span class="ue-key">Цвет надписи</span>
                            <div class="ue-swatch ue-checker" id="ue-s-text-swatch" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('simple.text_color')"><div class="ue-swatch-fill" data-style-background-color="ue_s.text_swatch"/></div>
                            <input id="ue-s-text-color" type="text" class="ue-hex grow" data-attr-value="ue_s.text_hex" data-event-change="ue_stext('text_color', ev.value, ev.linebreak)" data-event-blur="ue_scommit('text_color')"/></div>
                        <div class="ue-line row" data-if="ue_s.picture"><span class="ue-key">Картинка</span>
                            <select id="ue-s-picture" class="ue-select grow" data-value="ue_s.image" data-event-change="ue_spick('picture')">
                                <option value="">Нет</option><option data-for="pic : ue_pictures" data-attr-value="pic.path">{{ pic.name }}</option>
                            </select></div>
                        <div class="ue-check row" data-if="ue_s.in_list" id="ue-s-picture-from" data-event-click="ue_sset('picture_from', ue_s.picture_from == '' ? 'item.icon' : '')"><icon class="xs" data-attr-name="ue_s.picture_from != '' ? 'check_box' : 'check_box_outline_blank'"/><span>Показывать картинку предмета</span></div>
                    </div>

                    <div class="ue-sec" data-if="ue_s.root">
                        <div class="ue-sec-title">Когда видно</div>
                        <select id="ue-s-show" class="ue-select" data-value="ue_s.show" data-event-change="ue_spick('show')">
                            <option value="playing">Всегда, поверх игры</option><option value="command">Окно: открывает кнопка</option><option value="menu">Главное меню игры</option>
                        </select>
                    </div>

                    <div class="ue-sec" data-if="ue_s.bar">
                        <div class="ue-sec-title">Полоска <span class="muted">длина по данным игры</span></div>
                        <div class="ue-line row"><span class="ue-key">Сколько</span>
                            <select id="ue-s-bar" class="ue-select grow" data-value="ue_s.bar_value" data-event-change="ue_spick('bar_value')">
                                <option data-for="v : ue_values" data-attr-value="v.name">{{ v.label }}</option>
                            </select></div>
                        <div class="ue-line row"><span class="ue-key">Из скольких</span>
                            <select id="ue-s-bar-max" class="ue-select grow" data-value="ue_s.bar_max" data-event-change="ue_spick('bar_max')">
                                <option data-for="v : ue_values" data-attr-value="v.name">{{ v.label }}</option>
                            </select></div>
                    </div>

                    <div class="ue-sec" data-if="ue_s.list">
                        <div class="ue-sec-title">Список <span class="muted">ячейка на каждый предмет</span></div>
                        <select id="ue-s-list" class="ue-select" data-value="ue_s.list_source" data-event-change="ue_spick('list')">
                            <option value="items">Вещи героя</option><option value="quests">Задания из журнала</option>
                        </select>
                        <div class="ue-note">Первый слой внутри — ячейка: в игре она повторится для каждого предмета, список прокручивается.</div>
                    </div>
                    <div class="ue-sec" data-if="ue_s.inside != ''"><div class="ue-note">{{ ue_s.inside }}</div></div>

                    <div class="ue-sec" data-if="ue_s.can_act">
                        <div class="ue-sec-title">При нажатии <span class="muted">в игре</span></div>
                        <select id="ue-s-action" class="ue-select" data-if="ue_s.act_editable" data-value="ue_s.action" data-event-change="ue_spick('action')">
                            <option value="none">Ничего</option><option value="show">Открыть экран</option><option value="close">Закрыть этот экран</option>
                            <option value="new">Новая игра</option><option value="continue">Продолжить игру</option><option value="load">Загрузить</option><option value="save">Сохранить</option>
                            <option value="settings">Настройки</option><option value="pause">Пауза</option><option value="resume">Вернуться в игру</option>
                            <option value="menu">В главное меню</option><option value="quit">Выйти из игры</option><option value="message">Сообщение «Логике»</option>
                        </select>
                        <div class="ue-line row" data-if="ue_s.act_editable &amp;&amp; ue_s.needs == 'screen'"><span class="ue-key">Какой</span>
                            <select id="ue-s-target" class="ue-select grow" data-value="ue_s.target" data-event-change="ue_spick('target')">
                                <option data-for="n : ue_screen_names" data-attr-value="n">{{ n }}</option>
                            </select></div>
                        <div class="ue-line row" data-if="ue_s.act_editable &amp;&amp; ue_s.needs == 'text'"><span class="ue-key">Какое</span>
                            <input id="ue-s-message" type="text" class="ue-field grow" placeholder="открыть_дверь" data-attr-value="ue_s.target" data-event-change="ue_stext('target', ev.value, ev.linebreak)" data-event-blur="ue_scommit('target')"/></div>
                        <div class="ue-note" data-if="!ue_s.act_editable">Здесь несколько действий или особые. Они работают; посмотреть и поменять их можно в «Полном».</div>
                    </div>

                    <div class="ue-sec" data-if="!ue_s.root">
                        <div class="ue-sec-title">Место и размер</div>
                        <div class="ue-grid2">
                            <div class="ue-num"><span>X</span><input id="ue-s-x" type="text" data-attr-value="ue_s.x" data-event-change="ue_stext('x', ev.value, ev.linebreak)" data-event-blur="ue_scommit('x')"/></div>
                            <div class="ue-num"><span>Y</span><input id="ue-s-y" type="text" data-attr-value="ue_s.y" data-event-change="ue_stext('y', ev.value, ev.linebreak)" data-event-blur="ue_scommit('y')"/></div>
                            <div class="ue-num"><span>Ш</span><input id="ue-s-w" type="text" data-attr-value="ue_s.w" data-event-change="ue_stext('w', ev.value, ev.linebreak)" data-event-blur="ue_scommit('w')"/></div>
                            <div class="ue-num"><span>В</span><input id="ue-s-h" type="text" data-attr-value="ue_s.h" data-event-change="ue_stext('h', ev.value, ev.linebreak)" data-event-blur="ue_scommit('h')"/></div>
                        </div>
                        <div class="ue-line row" title="На экране игрока другого размера"><span class="ue-key">Держится</span>
                            <select id="ue-s-anchor-h" class="ue-select grow" data-value="ue_s.anchor_h" data-event-change="ue_spick('anchor_h')">
                                <option value="start">Слева</option><option value="center">По центру</option><option value="end">Справа</option><option value="both">Тянется</option><option value="scale">Масштаб</option>
                            </select>
                            <select id="ue-s-anchor-v" class="ue-select grow" data-value="ue_s.anchor_v" data-event-change="ue_spick('anchor_v')">
                                <option value="start">Сверху</option><option value="center">По центру</option><option value="end">Снизу</option><option value="both">Тянется</option><option value="scale">Масштаб</option>
                            </select></div>
                    </div>

                    <div id="ue-s-hidden" class="ue-sec" data-if="ue_s.has_hidden">
                        <div class="ue-note ue-warn">{{ ue_s.hidden }}</div>
                        <div id="ue-s-to-full" class="ue-s-link row" data-event-click="ue_mode('full')"><icon class="xs" name="tune"/><span>Открыть в «Полном»</span></div>
                    </div>
                    </div>
                </div>
                <div data-if="ue_p.any && !ue_checking && !ue_simple" class="ue-props column">
                    <div class="ue-head row"><icon class="s" data-attr-name="ue_p.root ? 'web_asset' : ue_p.icon"/><span class="grow name">{{ ue_p.name }}</span><span class="muted">{{ ue_p.type_name }}</span></div>
                    <div class="ue-tabs row">
                        <div id="ue-tab-design" class="ue-tab" data-class-on="ue_panel == 'design'" data-event-click="ue_panel_tab('design')">Дизайн</div>
                        <div id="ue-tab-game" class="ue-tab" data-if="!ue_library_open" data-class-on="ue_panel == 'game'" data-event-click="ue_panel_tab('game')">В игре</div>
                        <div id="ue-tab-motion" class="ue-tab" data-class-on="ue_panel == 'motion'" data-event-click="ue_panel_tab('motion')">Движение</div>
                    </div>
                    <div class="column" data-if="ue_panel == 'game' &amp;&amp; !ue_library_open">
                    <!-- When the game shows the screen -->
                    <div class="ue-sec ue-game" data-if="ue_p.root">
                        <div class="ue-sec-title">В игре</div>
                        <div class="ue-line row">
                            <select id="ue-screen-show" class="ue-select grow" data-value="ue_p.screen_show" data-event-change="ue_pick('screen.show')">
                                <option value="playing">Всегда поверх игры</option><option value="command">Окно: по кнопке или из «Логики»</option><option value="menu">Главное меню игры</option>
                            </select>
                        </div>
                        <div data-if="ue_p.screen_show == 'command'" class="column">
                            <div id="ue-screen-pauses" class="ue-check row" data-event-click="ue_set('screen.pauses', '')"><icon class="xs" data-attr-name="ue_p.pauses ? 'check_box' : 'check_box_outline_blank'"/><span>Пока открыто, игра стоит</span></div>
                            <div id="ue-screen-esc" class="ue-check row" data-event-click="ue_set('screen.esc', '')"><icon class="xs" data-attr-name="ue_p.esc_closes ? 'check_box' : 'check_box_outline_blank'"/><span>Закрывается по Esc</span></div>
                        </div>
                        <div id="ue-covers-game" class="ue-note ue-warn" data-if="ue_p.covers_game">Фон экрана сплошной и закроет весь мир. Сделайте его прозрачнее на вкладке «Дизайн» или выберите «Окно».</div>
                        <div class="ue-note" data-if="ue_p.screen_show == 'playing'">Как полоска здоровья и монеты: виден, пока игрок играет. Пустые места пропускают щелчки в мир.</div>
                        <div class="ue-note" data-if="ue_p.screen_show == 'command'">Откройте его кнопкой с действием «Показать экран» или блоком «Показать экран» в «Логике».</div>
                        <div class="ue-note" data-if="ue_p.screen_show == 'menu'">Игра покажет этот экран вместо своего главного меню. Кнопкам дайте действия «Новая игра», «Продолжить», «Загрузить», «Настройки», «Выйти».</div>
                    </div>

                    <!-- The layer in the game: what a click does, a bar, when it shows -->
                    <div class="ue-sec ue-game" data-if="!ue_p.root">
                        <div class="ue-sec-title row"><span class="grow">При нажатии <span class="muted">в игре</span></span><div id="ue-click-add" class="ue-mini" title="Добавить действие" data-event-click="ue_set('click.add', '')"><icon class="xs" name="add"/></div></div>
                        <div data-for="c : ue_clicks" class="ue-fill column">
                            <div class="ue-paint row">
                                <icon class="xs" name="touch_app"/>
                                <select class="ue-select grow" data-attr-id="'ue-click-kind-' + c.index" data-value="c.kind" data-event-change="ue_pick('click.' + c.index + '.kind')">
                                    <option value="show">Показать экран</option><option value="hide">Скрыть экран</option><option value="toggle">Показать или скрыть</option><option value="close">Закрыть этот экран</option>
                                    <option value="message">Сообщение «Логике»</option><option value="change">Изменить данные</option><option value="talk">Начать разговор</option>
                                    <option value="new">Новая игра</option><option value="continue">Продолжить</option><option value="load">Загрузить</option><option value="save">Сохранить</option><option value="settings">Настройки</option>
                                    <option value="pause">Пауза</option><option value="resume">Вернуться в игру</option><option value="menu">В главное меню</option><option value="quit">Выйти из игры</option>
                                </select>
                                <div class="ue-mini" data-attr-id="'ue-click-remove-' + c.index" title="Убрать" data-event-click="ue_set('click.' + c.index + '.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-line row" data-if="c.needs == 'screen'">
                                <select class="ue-select grow" data-attr-id="'ue-click-screen-' + c.index" data-value="c.target" data-event-change="ue_pick('click.' + c.index + '.target')">
                                    <option data-for="n : ue_screen_names" data-attr-value="n">{{ n }}</option>
                                </select>
                            </div>
                            <div class="ue-line row" data-if="c.needs == 'text'">
                                <input type="text" class="ue-field grow" data-attr-id="'ue-click-target-' + c.index" data-attr-placeholder="c.hint" data-attr-value="c.target" data-event-change="ue_text('click.' + c.index + '.target', ev.value, ev.linebreak)" data-event-blur="ue_commit('click.' + c.index + '.target')"/>
                            </div>
                        </div>
                        <div class="ue-note" data-if="ue_clicks.size == 0">Кнопка может открыть окно, сказать «Логике», изменить монеты, начать разговор или новую игру.</div>
                    </div>
                    <div class="ue-sec ue-game" data-if="!ue_p.root">
                        <div class="ue-sec-title row"><span class="grow">Полоска <span class="muted">длина по данным игры</span></span>
                            <div id="ue-bar-add" class="ue-mini" data-if="!ue_p.has_bar" title="Сделать полоской" data-event-click="ue_set('bar.add', '')"><icon class="xs" name="add"/></div>
                            <div id="ue-bar-remove" class="ue-mini" data-if="ue_p.has_bar" title="Не полоска" data-event-click="ue_set('bar.remove', '')"><icon class="xs" name="remove"/></div></div>
                        <div data-if="ue_p.has_bar" class="column">
                            <div class="ue-line row"><span class="ue-key">Сколько</span><input id="ue-bar-value" type="text" class="ue-field grow" data-attr-value="ue_p.bar_value" data-event-change="ue_text('bar.value', ev.value, ev.linebreak)" data-event-blur="ue_commit('bar.value')"/></div>
                            <div class="ue-line row"><span class="ue-key">Из</span><input id="ue-bar-max" type="text" class="ue-field grow" data-attr-value="ue_p.bar_max" data-event-change="ue_text('bar.max', ev.value, ev.linebreak)" data-event-blur="ue_commit('bar.max')"/></div>
                            <div class="ue-line row"><span class="ue-key">Растёт</span>
                                <select id="ue-bar-from" class="ue-select grow" data-value="ue_p.bar_from" data-event-change="ue_pick('bar.from')">
                                    <option value="left">Слева направо</option><option value="right">Справа налево</option><option value="bottom">Снизу вверх</option><option value="top">Сверху вниз</option>
                                </select></div>
                            <div class="ue-line row"><span class="ue-key">Данные</span>
                                <select id="ue-bar-pick" class="ue-select grow" data-value="ue_p.bar_value" data-event-change="ue_pick('bar.value')">
                                    <option data-for="v : ue_values" data-attr-value="v.name">{{ v.label }}</option>
                                </select></div>
                        </div>
                    </div>
                    <div class="ue-sec ue-game" data-if="!ue_p.root &amp;&amp; ue_p.in_list == ''">
                        <div class="ue-sec-title">Список <span class="muted">ячейка на каждый элемент</span></div>
                        <div class="ue-line row">
                            <select id="ue-list" class="ue-select grow" data-value="ue_p.list" data-event-change="ue_pick('list')">
                                <option value="none">Не список</option><option value="items">Вещи героя</option><option value="quests">Задания из журнала</option>
                            </select>
                        </div>
                        <div class="ue-note" data-if="ue_p.list == 'none' &amp;&amp; (!ue_p.container || ue_p.instance)">Выберите список, и этот слой станет ячейкой: вокруг появится прокручиваемый список.</div>
                        <div data-if="ue_p.list != 'none'" class="column">
                            <div class="ue-line row"><span class="ue-key">Между ячейками</span><input id="ue-list-gap" type="text" class="ue-field grow" data-attr-value="ue_p.list_gap" data-event-change="ue_text('list_gap', ev.value, ev.linebreak)" data-event-blur="ue_commit('list_gap')"/></div>
                            <div class="ue-note ue-warn" data-if="ue_p.list_no_cell">Положите в рамку ячейку, например копию компонента: первый слой повторится для каждого элемента.</div>
                            <div class="ue-note" data-if="!ue_p.list_no_cell">Первый слой внутри — ячейка: в игре она повторится для каждого элемента, рядами, и список прокручивается. Остальные слои видны, только пока список пуст. В тексты ячейки вставьте «Элемент списка» из данных.</div>
                        </div>
                    </div>
                    <div class="ue-sec ue-game" data-if="!ue_p.root &amp;&amp; ue_p.in_list != ''">
                        <div class="ue-sec-title">Картинка из данных</div>
                        <div class="ue-line row">
                            <select id="ue-picture-from" class="ue-select grow" data-value="ue_p.picture_from" data-event-change="ue_pick('picture_from')">
                                <option value="">Своя</option><option value="item.icon">Картинка предмета</option>
                            </select>
                        </div>
                    </div>
                    <div class="ue-sec ue-game" data-if="!ue_p.root">
                        <div class="ue-sec-title">Показывать, если <span class="muted">пусто — всегда</span></div>
                        <input id="ue-show-if" type="text" class="ue-field" placeholder="inv.key &gt; 0" data-attr-value="ue_p.show_if" data-event-change="ue_text('show_if', ev.value, ev.linebreak)" data-event-blur="ue_commit('show_if')"/>
                    </div>

                    </div>
                    <!-- Movement -->
                    <div class="column" data-if="ue_panel == 'motion'">
                    <div class="ue-sec" data-if="ue_p.root &amp;&amp; !ue_library_open">
                        <div class="ue-sec-title">Появление окна <span class="muted">как оно приходит и уходит</span></div>
                        <div class="ue-line row">
                            <select id="ue-appear" class="ue-select grow" data-value="ue_p.appear" data-event-change="ue_pick('screen.appear')">
                                <option value="none">Сразу</option><option value="fade">Проявляется</option><option value="rise">Поднимается снизу</option><option value="drop">Опускается сверху</option><option value="zoom">Приближается</option><option value="left">Выезжает слева</option><option value="right">Выезжает справа</option>
                            </select>
                        </div>
                        <div class="ue-line row" data-if="ue_p.appear != 'none'"><span class="ue-key">Время, с</span><input id="ue-appear-time" type="text" class="ue-field grow" data-attr-value="ue_p.appear_time" data-event-change="ue_text('screen.appear_time', ev.value, ev.linebreak)" data-event-blur="ue_commit('screen.appear_time')"/></div>
                        <div class="ue-note" data-if="ue_p.screen_show == 'playing' &amp;&amp; ue_p.appear != 'none'">Экран «Всегда поверх игры» появляется так при начале игры.</div>
                    </div>
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title">Своё движение <span class="muted">в игре и в «Проверить»</span></div>
                        <div class="ue-line row">
                            <select id="ue-motion-kind" class="ue-select grow" data-value="ue_p.motion_kind" data-event-change="ue_pick('motion.kind')">
                                <option value="none">Нет</option><option value="pulse">Пульсирует</option><option value="float">Парит</option><option value="swing">Качается</option><option value="spin">Вращается</option><option value="shake">Дрожит</option><option value="blink">Мигает</option><option value="custom">Своё, по ключам</option>
                            </select>
                        </div>
                        <div data-if="ue_p.motion_kind != 'none'" class="column">
                            <div class="ue-line row"><span class="ue-key">Длится, с</span><input id="ue-motion-duration" type="text" class="ue-field grow" data-attr-value="ue_p.motion_duration" data-event-change="ue_text('motion.duration', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.duration')"/></div>
                            <div class="ue-line row"><span class="ue-key">Через, с</span><input id="ue-motion-delay" type="text" class="ue-field grow" data-attr-value="ue_p.motion_delay" data-event-change="ue_text('motion.delay', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.delay')"/></div>
                            <div class="ue-line row" data-if="ue_p.motion_kind != 'custom'"><span class="ue-key">Сила</span><input id="ue-motion-strength" type="text" class="ue-field grow" data-attr-value="ue_p.motion_strength" data-event-change="ue_text('motion.strength', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.strength')"/></div>
                            <div class="ue-line row"><span class="ue-key">Ход</span>
                                <select id="ue-motion-easing" class="ue-select grow" data-value="ue_p.motion_easing" data-event-change="ue_pick('motion.easing')"><option value="smooth">Плавно</option><option value="linear">Ровно</option><option value="in">Разгон</option><option value="out">Торможение</option><option value="back">С отскоком назад</option><option value="bounce">Подпрыгивает</option><option value="elastic">Пружинит</option></select></div>
                            <div id="ue-motion-loop" class="ue-check row" data-event-click="ue_set('motion.loop', '')"><icon class="xs" data-attr-name="ue_p.motion_loop ? 'check_box' : 'check_box_outline_blank'"/><span>Повторять</span></div>
                            <div id="ue-motion-back" class="ue-check row" data-event-click="ue_set('motion.back', '')"><icon class="xs" data-attr-name="ue_p.motion_back ? 'check_box' : 'check_box_outline_blank'"/><span>Туда и обратно</span></div>
                        </div>
                        <div id="ue-tl-note" class="ue-note" data-if="ue_tl.note != '' &amp;&amp; ue_p.motion_kind != 'custom'">{{ ue_tl.note }}</div>
                    </div>
                    <div class="ue-sec" data-if="!ue_p.root &amp;&amp; ue_p.motion_kind == 'custom'">
                        <div class="ue-sec-title row"><span class="grow">Ключи <span class="muted">где слой в этот момент</span></span>
                            <div id="ue-key-add" class="ue-mini" title="Ещё ключ" data-event-click="ue_set('motion.key.add', '')"><icon class="xs" name="add"/></div></div>
                        <!-- The timeline: the keys over time (drag one to move it), the moment shown on the canvas -->
                        <div id="ue-tl" class="ue-tl column" data-if="ue_tl.show">
                            <div id="ue-tl-track" class="ue-tl-track" title="Щелчок или протяжка: экран на холсте в этот момент">
                                <div class="ue-tl-delay" data-if="ue_tl.delay_w > 0" data-style-width="ue_tl.delay_w + '%'"/>
                                <div class="ue-tl-pass" data-style-left="ue_tl.delay_w + '%'" data-style-width="ue_tl.pass_w + '%'"/>
                                <div data-for="g : ue_tl.ghosts" class="ue-tl-ghost" data-attr-title="g.title" data-style-left="g.x + '%'"/>
                                <div data-for="m : ue_tl.keys" class="ue-tl-key" data-attr-id="'ue-tl-key-' + m.index" data-class-selected="m.selected" data-attr-title="m.title" data-style-left="m.x + '%'"><div class="ue-tl-dot"/><div class="ue-tl-tint" data-if="m.tint" data-style-background-color="m.swatch"/></div>
                                <div id="ue-tl-head" class="ue-tl-head" data-if="ue_tl.preview" data-style-left="ue_tl.head_x + '%'"/>
                            </div>
                            <div class="ue-tl-scale row"><span>0 с</span><div class="grow"/><span>{{ ue_tl.span }}</span></div>
                            <div class="ue-line row">
                                <div id="ue-tl-play" class="ue-btn row" data-event-click="ue_tl_play" data-attr-title="ue_tl.playing ? 'Пауза (пробел)' : 'Проиграть на холсте (пробел)'"><icon class="xs" data-attr-name="ue_tl.playing ? 'pause' : 'play_arrow'"/><span>{{ ue_tl.playing ? 'Пауза' : 'Проиграть' }}</span></div>
                                <span id="ue-tl-time" class="grow muted" data-if="ue_tl.preview">{{ ue_tl.time }}</span>
                                <div class="grow" data-if="!ue_tl.preview"/>
                                <div id="ue-tl-stop" class="ue-btn row" data-if="ue_tl.preview" title="Холст снова неподвижен (Esc)" data-event-click="ue_tl_stop"><icon class="xs" name="edit"/><span>К редактированию</span></div>
                            </div>
                            <div class="ue-note" data-if="ue_tl.preview">Холст показывает экран, как его видит игрок в этот момент. В проект и историю это не идёт.</div>
                            <div class="ue-note" data-if="!ue_tl.preview">Ромб — ключ: щелчок выбирает, перетаскивание двигает во времени (шаг 1%). Серые метки — место слоя без ключа и второй проход.</div>
                        </div>
                        <div class="ue-note" data-if="ue_tl.note != ''">{{ ue_tl.note }}</div>
                        <div data-for="k : ue_keys" class="ue-key-row column" data-attr-id="'ue-key-row-' + k.index" data-class-selected="k.selected" data-event-click="ue_tl_pick(k.index)">
                            <div class="ue-line row"><span class="ue-key">Момент</span>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-at-' + k.index" data-attr-value="k.at" data-event-change="ue_text('motion.key.' + k.index + '.at', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.at')"/>
                                <div class="ue-mini" data-attr-id="'ue-key-remove-' + k.index" title="Убрать ключ" data-event-click="ue_set('motion.key.' + k.index + '.remove', '')"><icon class="xs" name="remove"/></div></div>
                            <div class="ue-line row"><span class="ue-key">Сдвиг X / Y</span>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-x-' + k.index" data-attr-value="k.x" data-event-change="ue_text('motion.key.' + k.index + '.x', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.x')"/>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-y-' + k.index" data-attr-value="k.y" data-event-change="ue_text('motion.key.' + k.index + '.y', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.y')"/></div>
                            <div class="ue-line row"><span class="ue-key">Размер / поворот</span>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-scale-' + k.index" data-attr-value="k.scale" data-event-change="ue_text('motion.key.' + k.index + '.scale', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.scale')"/>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-rotation-' + k.index" data-attr-value="k.rotation" data-event-change="ue_text('motion.key.' + k.index + '.rotation', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.rotation')"/></div>
                            <div class="ue-line row"><span class="ue-key">Видимость</span>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-opacity-' + k.index" data-attr-value="k.opacity" data-event-change="ue_text('motion.key.' + k.index + '.opacity', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.opacity')"/></div>
                            <div class="ue-line row"><span class="ue-key">Цвет</span>
                                <div data-if="!k.tint" class="ue-btn row grow" data-attr-id="'ue-key-color-add-' + k.index" data-event-click="ue_set('motion.key.' + k.index + '.color.add', '')"><icon class="xs" name="add"/><span>Менять цвет</span></div>
                                <div class="ue-swatch ue-checker" data-if="k.tint" data-attr-id="'ue-sw-key-' + k.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('motion.key.' + k.index + '.color')"><div class="ue-swatch-fill" data-style-background-color="k.swatch"/></div>
                                <input data-if="k.tint" type="text" class="ue-field grow ue-hex" data-attr-id="'ue-key-color-' + k.index" data-attr-value="k.hex" data-event-change="ue_text('motion.key.' + k.index + '.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.color')"/>
                                <div data-if="k.tint" class="ue-mini" title="Не менять цвет" data-event-click="ue_set('motion.key.' + k.index + '.color', '')"><icon class="xs" name="remove"/></div></div>
                            <div class="ue-line row"><span class="ue-key">Скругление</span>
                                <input type="text" class="ue-field grow" placeholder="как у слоя" data-attr-id="'ue-key-radius-' + k.index" data-attr-value="k.radius" data-event-change="ue_text('motion.key.' + k.index + '.radius', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.radius')"/></div>
                            <div class="ue-line row"><span class="ue-key">Размытие / яркость</span>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-blur-' + k.index" data-attr-value="k.blur" data-event-change="ue_text('motion.key.' + k.index + '.blur', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.blur')"/>
                                <input type="text" class="ue-field grow" data-attr-id="'ue-key-brightness-' + k.index" data-attr-value="k.brightness" data-event-change="ue_text('motion.key.' + k.index + '.brightness', ev.value, ev.linebreak)" data-event-blur="ue_commit('motion.key.' + k.index + '.brightness')"/></div>
                        </div>
                    </div>
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title">Плавная смена вида <span class="muted">наведение, нажатие, данные</span></div>
                        <div class="ue-line row"><span class="ue-key">Время, с</span><input id="ue-smooth" type="text" class="ue-field grow" placeholder="0 — сразу" data-attr-value="ue_p.smooth" data-event-change="ue_text('smooth', ev.value, ev.linebreak)" data-event-blur="ue_commit('smooth')"/></div>
                        <div class="ue-line row"><span class="ue-key">Ход</span>
                            <select id="ue-smooth-easing" class="ue-select grow" data-value="ue_p.smooth_easing" data-event-change="ue_pick('smooth.easing')"><option value="smooth">Плавно</option><option value="linear">Ровно</option><option value="in">Разгон</option><option value="out">Торможение</option><option value="back">С отскоком назад</option><option value="bounce">Подпрыгивает</option><option value="elastic">Пружинит</option></select></div>
                    </div>
                    <div class="ue-note" data-if="!ue_tl.preview">На холсте всё стоит на месте. Движение видно в «Проверить», в игре и в просмотре на шкале ключей.</div>
                    </div>
                    <div class="column" data-if="ue_panel == 'design' || (ue_library_open &amp;&amp; ue_panel != 'motion')">

                    <!-- Components -->
                    <div class="ue-sec" data-if="ue_p.can_make_component && !ue_p.many">
                        <div id="ue-make-component" class="ue-btn row" title="Сделать один раз, ставить на любые экраны" data-event-click="ue_component('make')"><icon class="xs" name="widgets"/><span>Сделать компонентом</span></div>
                    </div>
                    <div class="ue-sec ue-comp" data-if="ue_p.lib_variant">
                        <div class="ue-sec-title">Компонент</div>
                        <input id="ue-comp-name" type="text" class="ue-field" data-attr-value="ue_p.component" data-event-change="ue_text('component.name', ev.value, ev.linebreak)" data-event-blur="ue_commit('component.name')"/>
                        <div data-for="v : ue_variants" class="ue-line row">
                            <span class="ue-key">{{ v.property }}</span>
                            <input type="text" class="ue-field grow" data-attr-id="'ue-variant-' + it_index" data-attr-value="v.value" data-event-change="ue_text('variant.' + v.property, ev.value, ev.linebreak)" data-event-blur="ue_commit('variant.' + v.property)"/>
                        </div>
                        <div class="ue-line row">
                            <div id="ue-add-variant" class="ue-btn row grow" title="Копия рядом с другим значением" data-event-click="ue_component('variant')"><icon class="xs" name="add"/><span>Вариант</span></div>
                            <div id="ue-add-states" class="ue-btn row grow" title="Наведение, Нажата, Выключена" data-event-click="ue_component('states')"><icon class="xs" name="touch_app"/><span>Состояния</span></div>
                        </div>
                        <div class="ue-note">Варианты «Наведение», «Нажата» и «Выключена» — это вид кнопки в игре под мышью, при нажатии и когда она недоступна. Нарисуйте их, как хотите: другие картинки, цвета, тени.</div>
                    </div>
                    <div class="ue-sec ue-comp" data-if="ue_p.instance">
                        <div class="ue-sec-title row"><span class="grow">Копия компонента</span><div id="ue-edit-component" class="ue-mini" title="Изменить сам компонент" data-event-click="ue_component('edit')"><icon class="xs" name="edit"/></div></div>
                        <div class="ue-line row"><icon class="xs ue-comp-icon" name="widgets"/><span class="grow">{{ ue_p.component }}</span></div>
                        <div data-for="v : ue_variants" class="ue-line row">
                            <span class="ue-key">{{ v.property }}</span>
                            <select class="ue-select grow" data-attr-id="'ue-instance-' + it_index" data-value="v.value" data-event-change="ue_pick('instance.' + v.property)">
                                <option data-for="x : v.values" data-attr-value="x">{{ x }}</option>
                            </select>
                        </div>
                        <div class="ue-line row">
                            <div id="ue-reset-instance" class="ue-btn row grow" data-class-off="!ue_p.changed_here" title="Вернуть всё как у компонента" data-event-click="ue_component('reset')"><icon class="xs" name="restart_alt"/><span>Сбросить</span></div>
                            <div id="ue-detach-instance" class="ue-btn row grow" title="Сделать обычными слоями: компонент перестанет её менять" data-event-click="ue_component('detach')"><icon class="xs" name="link_off"/><span>Отвязать</span></div>
                        </div>
                    </div>
                    <div class="ue-sec ue-comp" data-if="ue_p.in_instance">
                        <div class="ue-note">Часть копии «{{ ue_p.component }}». То, что вы здесь поменяете, останется только у этой копии, остальное будет меняться вместе с компонентом.</div>
                    </div>

                    <div class="ue-sec">
                        <div class="ue-grid2">
                            <div class="ue-num" data-if="!ue_p.root"><span>X</span><input id="ue-x" type="text" data-attr-value="ue_p.x" data-event-change="ue_text('x', ev.value, ev.linebreak)" data-event-blur="ue_commit('x')"/></div>
                            <div class="ue-num" data-if="!ue_p.root"><span>Y</span><input id="ue-y" type="text" data-attr-value="ue_p.y" data-event-change="ue_text('y', ev.value, ev.linebreak)" data-event-blur="ue_commit('y')"/></div>
                            <div class="ue-num"><span>Ш</span><input id="ue-w" type="text" data-attr-value="ue_p.w" data-event-change="ue_text('w', ev.value, ev.linebreak)" data-event-blur="ue_commit('w')"/></div>
                            <div class="ue-num"><span>В</span><input id="ue-h" type="text" data-attr-value="ue_p.h" data-event-change="ue_text('h', ev.value, ev.linebreak)" data-event-blur="ue_commit('h')"/></div>
                            <div class="ue-num" data-if="!ue_p.root"><icon class="xs" name="rotate_right"/><input id="ue-rot" type="text" data-attr-value="ue_p.rotation" data-event-change="ue_text('rotation', ev.value, ev.linebreak)" data-event-blur="ue_commit('rotation')"/></div>
                            <div class="ue-num" data-if="!ue_p.root && !ue_p.text"><icon class="xs" name="rounded_corner"/><input id="ue-radius" type="text" data-attr-value="ue_p.radius" data-event-change="ue_text('radius', ev.value, ev.linebreak)" data-event-blur="ue_commit('radius')"/></div>
                        </div>
                    </div>

                    <!-- The game's styles (the library's page, nothing selected) -->
                    <div class="ue-sec" data-if="ue_p.root && ue_library_open">
                        <div class="ue-sec-title row"><span class="grow">Цвета игры <span class="muted">меняются везде сразу</span></span><div id="ue-color-add" class="ue-mini" title="Добавить цвет" data-event-click="ue_set('color.add', '')"><icon class="xs" name="add"/></div></div>
                        <div data-for="c : ue_game_colors" class="ue-paint row">
                            <div class="ue-swatch ue-checker" data-attr-id="'ue-sw-color-' + c.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('color.' + c.index + '.color')"><div class="ue-swatch-fill" data-style-background-color="c.swatch"/></div>
                            <input type="text" class="ue-hex ue-sans grow" data-attr-id="'ue-color-name-' + c.index" data-attr-value="c.name" data-event-change="ue_text('color.' + c.index + '.name', ev.value, ev.linebreak)" data-event-blur="ue_commit('color.' + c.index + '.name')"/>
                            <input type="text" class="ue-hex ue-short" data-attr-value="c.hex" data-event-change="ue_text('color.' + c.index + '.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('color.' + c.index + '.color')"/>
                            <div class="ue-mini" title="Убрать" data-event-click="ue_set('color.' + c.index + '.remove', '')"><icon class="xs" name="remove"/></div>
                        </div>
                        <div class="ue-note" data-if="ue_game_colors.size == 0">Главные цвета игры: выберите их в заливке слоя вместо своего цвета, и смена цвета здесь перекрасит все экраны.</div>
                    </div>
                    <div class="ue-sec" data-if="ue_p.root && ue_library_open">
                        <div class="ue-sec-title row"><span class="grow">Стили текста</span><div id="ue-textstyle-add" class="ue-mini" title="Добавить стиль текста" data-event-click="ue_set('textstyle.add', '')"><icon class="xs" name="add"/></div></div>
                        <div data-for="t : ue_game_texts" class="ue-fill column">
                            <div class="ue-paint row">
                                <icon class="xs" name="title"/>
                                <input type="text" class="ue-hex ue-sans grow" data-attr-value="t.name" data-event-change="ue_text('textstyle.' + t.index + '.name', ev.value, ev.linebreak)" data-event-blur="ue_commit('textstyle.' + t.index + '.name')"/>
                                <div class="ue-mini" title="Убрать" data-event-click="ue_set('textstyle.' + t.index + '.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-line row">
                                <select class="ue-select grow" data-value="t.family" data-event-change="ue_pick('textstyle.' + t.index + '.family')">
                                    <option data-for="f : ue_families" data-attr-value="f">{{ f }}</option>
                                </select>
                                <div class="ue-num ue-short" title="Размер"><icon class="xs" name="format_size"/><input type="text" data-attr-value="t.size" data-event-change="ue_text('textstyle.' + t.index + '.size', ev.value, ev.linebreak)" data-event-blur="ue_commit('textstyle.' + t.index + '.size')"/></div>
                            </div>
                            <div class="ue-paint row">
                                <div class="ue-swatch ue-checker" data-attr-id="'ue-sw-textstyle-' + t.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('textstyle.' + t.index + '.color')"><div class="ue-swatch-fill" data-style-background-color="t.swatch"/></div>
                                <input type="text" class="ue-hex grow" data-attr-value="t.hex" data-event-change="ue_text('textstyle.' + t.index + '.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('textstyle.' + t.index + '.color')"/>
                                <div class="ue-num ue-short" title="Жирность (100–900)"><icon class="xs" name="format_bold"/><input type="text" data-attr-value="t.weight" data-event-change="ue_text('textstyle.' + t.index + '.weight', ev.value, ev.linebreak)" data-event-blur="ue_commit('textstyle.' + t.index + '.weight')"/></div>
                            </div>
                        </div>
                        <div class="ue-note" data-if="ue_game_texts.size == 0">Заголовки, кнопки, подсказки: шрифт, размер и цвет в одном месте для всей игры.</div>
                    </div>

                    <!-- The screen's own settings (nothing selected, or the screen) -->
                    <div class="ue-sec" data-if="ue_p.root && !ue_library_open">
                        <div class="ue-sec-title">Текст экрана <span class="muted">для текстов без своего шрифта</span></div>
                        <div class="ue-line row">
                            <select id="ue-screen-font" class="ue-select grow" data-value="ue_p.screen_font" data-event-change="ue_pick('screen.font')">
                                <option data-for="f : ue_families" data-attr-value="f">{{ f }}</option>
                            </select>
                            <div class="ue-num ue-short" title="Размер"><icon class="xs" name="format_size"/><input id="ue-screen-size" type="text" data-attr-value="ue_p.screen_size" data-event-change="ue_text('screen.font_size', ev.value, ev.linebreak)" data-event-blur="ue_commit('screen.font_size')"/></div>
                        </div>
                        <div class="ue-paint row">
                            <div class="ue-swatch ue-checker" id="ue-sw-screen-text" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('screen.text_color')"><div class="ue-swatch-fill" data-style-background-color="ue_p.screen_text_swatch"/></div>
                            <input id="ue-screen-color" type="text" class="ue-hex grow" data-attr-value="ue_p.screen_text_hex" data-event-change="ue_text('screen.text_color', ev.value, ev.linebreak)" data-event-blur="ue_commit('screen.text_color')"/>
                        </div>
                    </div>
                    <div class="ue-sec" data-if="ue_p.root && !ue_library_open">
                        <div class="ue-sec-title">На экране игрока <span class="muted">другого размера</span></div>
                        <div class="ue-line row">
                            <select id="ue-screen-fit" class="ue-select grow" data-value="ue_p.screen_fit" data-event-change="ue_pick('screen.fit')">
                                <option value="expand">Подстроить: края раздвигаются</option><option value="fit">Вписать целиком, с полосами</option><option value="stretch">Растянуть</option>
                            </select>
                        </div>
                        <div class="ue-paint row" data-if="ue_p.screen_fit == 'fit'">
                            <span class="ue-key">Полосы</span>
                            <div class="ue-swatch ue-checker" id="ue-sw-bars" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('screen.bars')"><div class="ue-swatch-fill" data-style-background-color="ue_p.bars_swatch"/></div>
                            <input type="text" class="ue-hex grow" data-attr-value="ue_p.bars_hex" data-event-change="ue_text('screen.bars', ev.value, ev.linebreak)" data-event-blur="ue_commit('screen.bars')"/>
                        </div>
                        <div class="ue-line row" title="Отступ от краёв, за который не стоит выносить важное: на телевизорах и телефонах края могут быть не видны">
                            <span class="ue-key">Безопасная зона</span>
                            <div class="ue-num grow"><icon class="xs" name="crop_free"/><input id="ue-screen-safe" type="text" data-attr-value="ue_p.safe" data-event-change="ue_text('screen.safe', ev.value, ev.linebreak)" data-event-blur="ue_commit('screen.safe')"/></div>
                        </div>
                    </div>

                    <!-- Constraints: what the layer does on a bigger or smaller player's screen -->
                    <div class="ue-sec" data-if="!ue_p.root && (!ue_p.in_layout || ue_p.absolute)">
                        <div class="ue-sec-title">Прилипание <span class="muted">на другом экране игрока</span></div>
                        <div class="ue-line row"><span class="ue-key">По горизонтали</span>
                            <select class="ue-select grow" data-value="ue_p.horizontal" data-event-change="ue_pick('horizontal')">
                                <option value="start">Слева</option><option value="end">Справа</option><option value="both">Слева и справа</option><option value="center">По центру</option><option value="scale">Масштаб</option>
                            </select></div>
                        <div class="ue-line row"><span class="ue-key">По вертикали</span>
                            <select class="ue-select grow" data-value="ue_p.vertical" data-event-change="ue_pick('vertical')">
                                <option value="start">Сверху</option><option value="end">Снизу</option><option value="both">Сверху и снизу</option><option value="center">По центру</option><option value="scale">Масштаб</option>
                            </select></div>
                    </div>

                    <!-- Size inside an auto layout -->
                    <div class="ue-sec" data-if="!ue_p.root && (ue_p.in_layout || ue_p.has_layout || ue_p.text)">
                        <div class="ue-sec-title">Размер</div>
                        <div class="ue-line row"><span class="ue-key">Ширина</span>
                            <select class="ue-select grow" data-value="ue_p.width_sizing" data-event-change="ue_pick('width_sizing')">
                                <option value="fixed">Своя</option><option value="hug">По содержимому</option><option value="fill">Заполнить</option>
                            </select></div>
                        <div class="ue-line row"><span class="ue-key">Высота</span>
                            <select class="ue-select grow" data-value="ue_p.height_sizing" data-event-change="ue_pick('height_sizing')">
                                <option value="fixed">Своя</option><option value="hug">По содержимому</option><option value="fill">Заполнить</option>
                            </select></div>
                        <div class="ue-check row" data-if="ue_p.in_layout" data-event-click="ue_set('absolute', '')"><icon class="xs" data-attr-name="ue_p.absolute ? 'check_box' : 'check_box_outline_blank'"/><span>Вне раскладки: на своём месте</span></div>
                    </div>

                    <!-- Auto layout -->
                    <div class="ue-sec" data-if="ue_p.container">
                        <div class="ue-sec-title row"><span class="grow">Автораскладка</span>
                            <div class="ue-mini" data-if="!ue_p.has_layout" title="Добавить (Shift+A)" data-event-click="ue_set('layout.mode', 'row')"><icon class="xs" name="add"/></div>
                            <div class="ue-mini" data-if="ue_p.has_layout" title="Убрать" data-event-click="ue_set('layout.mode', 'none')"><icon class="xs" name="remove"/></div>
                        </div>
                        <div data-if="ue_p.has_layout" class="column ue-gap">
                            <div class="ue-line row">
                                <div class="ue-seg row">
                                    <div class="ue-seg-btn" data-class-selected="ue_p.layout_mode == 'row'" title="В строку" data-event-click="ue_set('layout.mode', 'row')"><icon class="xs" name="arrow_forward"/></div>
                                    <div class="ue-seg-btn" data-class-selected="ue_p.layout_mode == 'column'" title="В столбец" data-event-click="ue_set('layout.mode', 'column')"><icon class="xs" name="arrow_downward"/></div>
                                    <div class="ue-seg-btn" data-class-selected="ue_p.layout_mode == 'wrap'" title="С переносом" data-event-click="ue_set('layout.mode', 'wrap')"><icon class="xs" name="keyboard_return"/></div>
                                </div>
                                <div class="ue-num grow" title="Промежуток"><icon class="xs" name="space_bar"/><input id="ue-gap" type="text" data-attr-value="ue_p.gap" data-event-change="ue_text('layout.gap', ev.value, ev.linebreak)" data-event-blur="ue_commit('layout.gap')"/></div>
                            </div>
                            <div class="ue-line row">
                                <div class="ue-align9">
                                    <div data-for="a : ue_nine" class="ue-a9" data-class-selected="ue_p.align == it_index" data-event-click="ue_set('layout.align', '' + it_index)"><i/></div>
                                </div>
                                <div class="ue-grid2 grow">
                                    <div class="ue-num" title="Отступ сверху"><span>↑</span><input type="text" data-attr-value="ue_p.pad_t" data-event-change="ue_text('layout.pad_t', ev.value, ev.linebreak)" data-event-blur="ue_commit('layout.pad_t')"/></div>
                                    <div class="ue-num" title="Отступ справа"><span>→</span><input type="text" data-attr-value="ue_p.pad_r" data-event-change="ue_text('layout.pad_r', ev.value, ev.linebreak)" data-event-blur="ue_commit('layout.pad_r')"/></div>
                                    <div class="ue-num" title="Отступ снизу"><span>↓</span><input type="text" data-attr-value="ue_p.pad_b" data-event-change="ue_text('layout.pad_b', ev.value, ev.linebreak)" data-event-blur="ue_commit('layout.pad_b')"/></div>
                                    <div class="ue-num" title="Отступ слева"><span>←</span><input type="text" data-attr-value="ue_p.pad_l" data-event-change="ue_text('layout.pad_l', ev.value, ev.linebreak)" data-event-blur="ue_commit('layout.pad_l')"/></div>
                                </div>
                            </div>
                            <div class="ue-check row" data-event-click="ue_set('layout.space_between', '')"><icon class="xs" data-attr-name="ue_p.space_between ? 'check_box' : 'check_box_outline_blank'"/><span>Раздвинуть по краям</span></div>
                        </div>
                        <div class="ue-check row" data-event-click="ue_set('clip', '')"><icon class="xs" data-attr-name="ue_p.clip ? 'check_box' : 'check_box_outline_blank'"/><span>Обрезать то, что выходит за рамку</span></div>
                    </div>

                    <!-- Layer -->
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title">Слой</div>
                        <div class="ue-line row">
                            <select class="ue-select grow" data-value="ue_p.blend" data-event-change="ue_pick('blend')">
                                <option value="normal">Обычный</option><option value="multiply">Умножение</option><option value="screen">Экран</option><option value="overlay">Перекрытие</option>
                                <option value="darken">Затемнение</option><option value="lighten">Осветление</option><option value="color-dodge">Осветление основы</option><option value="color-burn">Затемнение основы</option>
                                <option value="hard-light">Жёсткий свет</option><option value="soft-light">Мягкий свет</option><option value="difference">Разница</option><option value="exclusion">Исключение</option>
                                <option value="hue">Тон</option><option value="saturation">Насыщенность</option><option value="color">Цветность</option><option value="luminosity">Яркость</option><option value="plus-lighter">Сложение</option>
                            </select>
                            <div class="ue-num ue-short" title="Непрозрачность"><icon class="xs" name="opacity"/><input id="ue-opacity" type="text" data-attr-value="ue_p.opacity" data-event-change="ue_text('opacity', ev.value, ev.linebreak)" data-event-blur="ue_commit('opacity')"/></div>
                        </div>
                    </div>

                    <!-- Text -->
                    <div class="ue-sec" data-if="ue_p.text">
                        <div class="ue-sec-title">Текст</div>
                        <input id="ue-content" type="text" class="ue-field" data-attr-value="ue_p.content" data-event-change="ue_text('text', ev.value, ev.linebreak)" data-event-blur="ue_commit('text')"/>
                        <div class="ue-line row" data-if="!ue_library_open" title="В игре на месте {имени} будет значение">
                            <span class="ue-key">Вставить</span>
                            <select id="ue-text-insert" class="ue-select grow" value="" data-event-change="ue_pick('text.insert')">
                                <option value="">данные игры…</option>
                                <option data-for="v : ue_values" data-attr-value="v.name">{{ v.label }}</option>
                            </select>
                        </div>
                        <div class="ue-line row" data-if="ue_game_texts.size > 0">
                            <span class="ue-key">Стиль текста</span>
                            <select id="ue-text-style" class="ue-select grow" title="Стиль текста игры: меняется везде сразу" data-value="ue_p.text_style" data-event-change="ue_pick('text_style')">
                                <option value="">Свой</option>
                                <option data-for="t : ue_game_texts" data-attr-value="t.key">{{ t.name }}</option>
                            </select>
                        </div>
                        <div class="ue-line row">
                            <select class="ue-select grow" data-value="ue_p.family" data-event-change="ue_pick('family')">
                                <option value="">Как у экрана</option>
                                <option data-for="f : ue_families" data-attr-value="f">{{ f }}</option>
                            </select>
                        </div>
                        <div class="ue-line row">
                            <select class="ue-select grow" data-value="ue_p.weight" data-event-change="ue_pick('weight')">
                                <option value="300">Тонкий</option><option value="400">Обычный</option><option value="500">Средний</option><option value="600">Полужирный</option><option value="700">Жирный</option><option value="800">Очень жирный</option><option value="900">Чёрный</option>
                            </select>
                            <div class="ue-num ue-short" title="Размер"><icon class="xs" name="format_size"/><input id="ue-font-size" type="text" data-attr-value="ue_p.size" data-event-change="ue_text('size', ev.value, ev.linebreak)" data-event-blur="ue_commit('size')"/></div>
                        </div>
                        <div class="ue-grid2">
                            <div class="ue-num" title="Высота строки"><icon class="xs" name="format_line_spacing"/><input type="text" data-attr-value="ue_p.line_height" data-event-change="ue_text('line_height', ev.value, ev.linebreak)" data-event-blur="ue_commit('line_height')"/></div>
                            <div class="ue-num" title="Расстояние между буквами"><span>А|А</span><input type="text" data-attr-value="ue_p.letter_spacing" data-event-change="ue_text('letter_spacing', ev.value, ev.linebreak)" data-event-blur="ue_commit('letter_spacing')"/></div>
                        </div>
                        <div class="ue-line row">
                            <div class="ue-seg row">
                                <div class="ue-seg-btn" data-class-selected="ue_p.text_align == 'left'" data-event-click="ue_set('text_align', 'left')"><icon class="xs" name="format_align_left"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.text_align == 'center'" data-event-click="ue_set('text_align', 'center')"><icon class="xs" name="format_align_center"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.text_align == 'right'" data-event-click="ue_set('text_align', 'right')"><icon class="xs" name="format_align_right"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.text_align == 'justify'" data-event-click="ue_set('text_align', 'justify')"><icon class="xs" name="format_align_justify"/></div>
                            </div>
                            <div class="ue-seg row">
                                <div class="ue-seg-btn" data-class-selected="ue_p.italic" title="Курсив" data-event-click="ue_set('italic', '')"><icon class="xs" name="format_italic"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.decoration == 'underline'" title="Подчёркнутый" data-event-click="ue_set('decoration', ue_p.decoration == 'underline' ? 'none' : 'underline')"><icon class="xs" name="format_underlined"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.decoration == 'strike'" title="Зачёркнутый" data-event-click="ue_set('decoration', ue_p.decoration == 'strike' ? 'none' : 'strike')"><icon class="xs" name="format_strikethrough"/></div>
                                <div class="ue-seg-btn" data-class-selected="ue_p.text_case == 'upper'" title="ПРОПИСНЫЕ" data-event-click="ue_set('text_case', ue_p.text_case == 'upper' ? 'none' : 'upper')"><icon class="xs" name="match_case"/></div>
                            </div>
                        </div>
                        <div class="ue-paint row">
                            <div class="ue-swatch ue-checker" id="ue-sw-text" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('text_color')"><div class="ue-swatch-fill" data-style-background-color="ue_p.text_swatch"/></div>
                            <input id="ue-text-color" type="text" class="ue-hex grow" data-attr-value="ue_p.text_hex" data-event-change="ue_text('text_color', ev.value, ev.linebreak)" data-event-blur="ue_commit('text_color')"/>
                        </div>
                    </div>

                    <!-- Fills -->
                    <div class="ue-sec" data-if="!ue_p.text">
                        <div class="ue-sec-title row"><span class="grow">{{ ue_p.root ? 'Фон экрана' : 'Заливка' }}</span><div id="ue-fill-add" class="ue-mini" title="Добавить заливку" data-event-click="ue_set('fill.add', '')"><icon class="xs" name="add"/></div></div>
                        <div data-for="f : ue_fills" class="ue-fill column" data-class-off="!f.visible">
                            <div class="ue-paint row">
                                <div class="ue-swatch ue-checker" data-if="f.kind == 'solid' || f.kind == 'linear' || f.kind == 'radial'" data-attr-id="'ue-sw-fill-' + f.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('fill.' + f.index + '.color')"><div class="ue-swatch-fill" data-style-background-color="f.swatch"/></div>
                                <div class="ue-swatch grad" data-if="f.kind == 'image'"><icon class="xs" name="image"/></div>
                                <input type="text" class="ue-hex grow" data-if="f.kind != 'image'" data-attr-id="'ue-fill-hex-' + f.index" data-attr-value="f.hex" data-event-change="ue_text('fill.' + f.index + '.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.color')"/>
                                <select class="ue-select grow" data-if="f.kind == 'image'" data-value="f.image" title="Картинка из папки игры pictures" data-event-change="ue_pick('fill.' + f.index + '.image')">
                                    <option value="">Выберите картинку</option>
                                    <option data-for="pic : ue_pictures" data-attr-value="pic.path">{{ pic.name }}</option>
                                </select>
                                <input type="text" class="ue-pct" data-attr-value="f.opacity" data-event-change="ue_text('fill.' + f.index + '.opacity', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.opacity')"/>
                                <div class="ue-mini" title="Показать или скрыть" data-event-click="ue_set('fill.' + f.index + '.visible', '')"><icon class="xs" data-attr-name="f.visible ? 'visibility' : 'visibility_off'"/></div>
                                <div class="ue-mini" title="Убрать" data-event-click="ue_set('fill.' + f.index + '.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-line row">
                                <select class="ue-select grow" data-value="f.kind" data-event-change="ue_pick('fill.' + f.index + '.kind')">
                                    <option value="solid">Цвет</option><option value="linear">Линейный градиент</option><option value="radial">Радиальный градиент</option><option value="image">Картинка</option>
                                </select>
                                <select class="ue-select grow" data-if="f.kind == 'solid' && ue_game_colors.size > 0" data-attr-id="'ue-fill-style-' + f.index" title="Цвет игры: меняется везде сразу" data-value="f.style" data-event-change="ue_pick('fill.' + f.index + '.style')">
                                    <option value="">Свой цвет</option>
                                    <option data-for="c : ue_game_colors" data-attr-value="c.key">{{ c.name }}</option>
                                </select>
                                <div class="ue-num ue-short" data-if="f.kind == 'linear'" title="Угол"><icon class="xs" name="rotate_right"/><input type="text" data-attr-value="f.angle" data-event-change="ue_text('fill.' + f.index + '.angle', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.angle')"/></div>
                                <select class="ue-select ue-short" data-if="f.kind == 'image'" data-value="f.fit" data-event-change="ue_pick('fill.' + f.index + '.fit')">
                                    <option value="fill">Заполнить</option><option value="fit">Вписать</option><option value="tile">Плиткой</option><option value="stretch">Растянуть</option>
                                </select>
                            </div>
                            <div class="ue-grid3" data-if="f.kind == 'image' && f.fit == 'tile'">
                                <div class="ue-num" title="Ширина плитки (пусто: как у картинки)"><icon class="xs" name="grid_view"/><input type="text" data-attr-value="f.tile" data-event-change="ue_text('fill.' + f.index + '.tile', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.tile')"/></div>
                                <div class="ue-num" title="Сдвиг плиток по горизонтали"><span>X</span><input type="text" data-attr-value="f.offset_x" data-event-change="ue_text('fill.' + f.index + '.offset_x', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.offset_x')"/></div>
                                <div class="ue-num" title="Сдвиг плиток по вертикали"><span>Y</span><input type="text" data-attr-value="f.offset_y" data-event-change="ue_text('fill.' + f.index + '.offset_y', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.offset_y')"/></div>
                            </div>
                            <div class="ue-paint row" data-if="f.kind == 'linear' || f.kind == 'radial'">
                                <span class="ue-key">до</span>
                                <div class="ue-swatch ue-checker" data-attr-id="'ue-sw-fill2-' + f.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('fill.' + f.index + '.color2')"><div class="ue-swatch-fill" data-style-background-color="f.swatch2"/></div>
                                <input type="text" class="ue-hex grow" data-attr-value="f.hex2" data-event-change="ue_text('fill.' + f.index + '.color2', ev.value, ev.linebreak)" data-event-blur="ue_commit('fill.' + f.index + '.color2')"/>
                            </div>
                        </div>
                    </div>

                    <!-- The frame picture, cut into nine parts -->
                    <div class="ue-sec" data-if="!ue_p.root && !ue_p.text">
                        <div class="ue-sec-title row"><span class="grow">Рамка-картинка <span class="muted">углы не тянутся</span></span>
                            <div id="ue-frame-add" class="ue-mini" data-if="!ue_p.has_frame" title="Обрамить слой нарисованной рамкой" data-event-click="ue_set('frame.add', '')"><icon class="xs" name="add"/></div>
                        </div>
                        <div data-if="ue_p.has_frame" class="column" data-class-off="!ue_p.frame_visible">
                            <div class="ue-paint row">
                                <div class="ue-swatch grad"><icon class="xs" name="crop_square"/></div>
                                <select id="ue-frame-image" class="ue-select grow" data-value="ue_p.frame_image" data-event-change="ue_pick('frame.image')">
                                    <option data-for="pic : ue_pictures" data-attr-value="pic.path">{{ pic.name }}</option>
                                </select>
                                <div class="ue-mini" title="Показать или скрыть" data-event-click="ue_set('frame.visible', '')"><icon class="xs" data-attr-name="ue_p.frame_visible ? 'visibility' : 'visibility_off'"/></div>
                                <div class="ue-mini" title="Убрать" data-event-click="ue_set('frame.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-line row"><span class="ue-key">Углы картинки</span><span class="muted">сверху, справа, снизу, слева</span></div>
                            <div class="ue-grid4">
                                <div class="ue-num" title="Сверху"><icon class="xs" name="border_top"/><input id="ue-frame-t" type="text" data-attr-value="ue_p.frame_t" data-event-change="ue_text('frame.slice.0', ev.value, ev.linebreak)" data-event-blur="ue_commit('frame.slice.0')"/></div>
                                <div class="ue-num" title="Справа"><icon class="xs" name="border_right"/><input type="text" data-attr-value="ue_p.frame_r" data-event-change="ue_text('frame.slice.1', ev.value, ev.linebreak)" data-event-blur="ue_commit('frame.slice.1')"/></div>
                                <div class="ue-num" title="Снизу"><icon class="xs" name="border_bottom"/><input type="text" data-attr-value="ue_p.frame_b" data-event-change="ue_text('frame.slice.2', ev.value, ev.linebreak)" data-event-blur="ue_commit('frame.slice.2')"/></div>
                                <div class="ue-num" title="Слева"><icon class="xs" name="border_left"/><input type="text" data-attr-value="ue_p.frame_l" data-event-change="ue_text('frame.slice.3', ev.value, ev.linebreak)" data-event-blur="ue_commit('frame.slice.3')"/></div>
                            </div>
                            <div class="ue-line row">
                                <select id="ue-frame-repeat" class="ue-select grow" data-value="ue_p.frame_repeat" data-event-change="ue_pick('frame.repeat')">
                                    <option value="stretch">Края тянутся</option><option value="repeat">Края повторяются</option><option value="round">Повторяются целыми</option><option value="space">С промежутками</option>
                                </select>
                                <div class="ue-num ue-short" title="Масштаб рамки"><icon class="xs" name="zoom_in"/><input id="ue-frame-scale" type="text" data-attr-value="ue_p.frame_scale" data-event-change="ue_text('frame.scale', ev.value, ev.linebreak)" data-event-blur="ue_commit('frame.scale')"/></div>
                            </div>
                            <div class="ue-check row" data-event-click="ue_set('frame.fill', '')"><icon class="xs" data-attr-name="ue_p.frame_fill ? 'check_box' : 'check_box_outline_blank'"/><span>Рисовать середину картинки</span></div>
                        </div>
                    </div>

                    <!-- The mask: a picture cuts the layer's shape -->
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title row"><span class="grow">Маска <span class="muted">форма по картинке</span></span>
                            <div id="ue-mask-add" class="ue-mini" data-if="!ue_p.has_mask" title="Обрезать слой по форме картинки" data-event-click="ue_set('mask.add', '')"><icon class="xs" name="add"/></div>
                        </div>
                        <div data-if="ue_p.has_mask" class="column" data-class-off="!ue_p.mask_visible">
                            <div class="ue-paint row">
                                <div class="ue-swatch grad"><icon class="xs" name="texture"/></div>
                                <select id="ue-mask-image" class="ue-select grow" data-value="ue_p.mask_image" data-event-change="ue_pick('mask.image')">
                                    <option data-for="pic : ue_pictures" data-attr-value="pic.path">{{ pic.name }}</option>
                                </select>
                                <div class="ue-mini" title="Показать или скрыть" data-event-click="ue_set('mask.visible', '')"><icon class="xs" data-attr-name="ue_p.mask_visible ? 'visibility' : 'visibility_off'"/></div>
                                <div class="ue-mini" title="Убрать" data-event-click="ue_set('mask.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-line row">
                                <select class="ue-select grow" data-value="ue_p.mask_fit" data-event-change="ue_pick('mask.fit')">
                                    <option value="stretch">Растянуть по слою</option><option value="fill">Заполнить</option><option value="fit">Вписать</option><option value="tile">Плиткой</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Stroke -->
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title row"><span class="grow">Обводка</span>
                            <div id="ue-stroke-add" class="ue-mini" data-if="!ue_p.has_stroke" title="Добавить обводку" data-event-click="ue_set('stroke.add', '')"><icon class="xs" name="add"/></div>
                            <div class="ue-mini" data-if="ue_p.has_stroke" title="Убрать" data-event-click="ue_set('stroke.remove', '')"><icon class="xs" name="remove"/></div>
                        </div>
                        <div data-if="ue_p.has_stroke" class="column ue-gap">
                            <div class="ue-paint row">
                                <div class="ue-swatch ue-checker" id="ue-sw-stroke" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('stroke.color')"><div class="ue-swatch-fill" data-style-background-color="ue_p.stroke_swatch"/></div>
                                <input type="text" class="ue-hex grow" data-attr-value="ue_p.stroke_hex" data-event-change="ue_text('stroke.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('stroke.color')"/>
                                <div class="ue-num ue-short" title="Толщина"><icon class="xs" name="line_weight"/><input type="text" data-attr-value="ue_p.stroke_width" data-event-change="ue_text('stroke.width', ev.value, ev.linebreak)" data-event-blur="ue_commit('stroke.width')"/></div>
                            </div>
                            <div class="ue-line row">
                                <select class="ue-select grow" data-value="ue_p.stroke_align" data-event-change="ue_pick('stroke.align')">
                                    <option value="inside">Внутри</option><option value="center">По центру</option><option value="outside">Снаружи</option>
                                </select>
                                <select class="ue-select grow" data-value="ue_p.stroke_style" data-event-change="ue_pick('stroke.style')">
                                    <option value="solid">Сплошная</option><option value="dashed">Штрихи</option><option value="dotted">Точки</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Effects -->
                    <div class="ue-sec" data-if="!ue_p.root">
                        <div class="ue-sec-title row"><span class="grow">Эффекты</span><div id="ue-effect-add" class="ue-mini" title="Добавить тень или размытие" data-event-click="ue_set('effect.add', '')"><icon class="xs" name="add"/></div></div>
                        <div data-for="e : ue_effects" class="ue-fill column" data-class-off="!e.visible">
                            <div class="ue-line row">
                                <select class="ue-select grow" data-value="e.kind" data-event-change="ue_pick('effect.' + e.index + '.kind')">
                                    <option value="drop-shadow">Тень</option><option value="inner-shadow">Внутренняя тень</option><option value="layer-blur">Размытие слоя</option><option value="background-blur">Размытие фона</option>
                                </select>
                                <div class="ue-mini" data-event-click="ue_set('effect.' + e.index + '.visible', '')"><icon class="xs" data-attr-name="e.visible ? 'visibility' : 'visibility_off'"/></div>
                                <div class="ue-mini" data-event-click="ue_set('effect.' + e.index + '.remove', '')"><icon class="xs" name="remove"/></div>
                            </div>
                            <div class="ue-grid2" data-if="e.shadow">
                                <div class="ue-num"><span>X</span><input type="text" data-attr-value="e.x" data-event-change="ue_text('effect.' + e.index + '.x', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.x')"/></div>
                                <div class="ue-num"><span>Y</span><input type="text" data-attr-value="e.y" data-event-change="ue_text('effect.' + e.index + '.y', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.y')"/></div>
                                <div class="ue-num" title="Размытие"><icon class="xs" name="blur_on"/><input type="text" data-attr-value="e.blur" data-event-change="ue_text('effect.' + e.index + '.blur', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.blur')"/></div>
                                <div class="ue-num" title="Разрастание"><icon class="xs" name="open_in_full"/><input type="text" data-attr-value="e.spread" data-event-change="ue_text('effect.' + e.index + '.spread', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.spread')"/></div>
                            </div>
                            <div class="ue-paint row" data-if="e.shadow">
                                <div class="ue-swatch ue-checker" data-attr-id="'ue-sw-effect-' + e.index" title="Палитра: щёлкните, чтобы выбрать цвет" data-event-click="ue_color('effect.' + e.index + '.color')"><div class="ue-swatch-fill" data-style-background-color="e.swatch"/></div>
                                <input type="text" class="ue-hex grow" data-attr-value="e.hex" data-event-change="ue_text('effect.' + e.index + '.color', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.color')"/>
                            </div>
                            <div class="ue-num" data-if="!e.shadow" title="Размытие"><icon class="xs" name="blur_on"/><input type="text" data-attr-value="e.blur" data-event-change="ue_text('effect.' + e.index + '.blur', ev.value, ev.linebreak)" data-event-blur="ue_commit('effect.' + e.index + '.blur')"/></div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="assets" class="column" data-if="tab == 'assets'">
        <!-- Like the explorer: back, forward, up, the address, the search. -->
        <div class="as-nav row">
            <div id="as-back" class="icon-button small" title="Назад (Alt+←)" data-class-disabled="!as_can_back" data-event-click="as_back"><icon name="arrow_back"/></div>
            <div id="as-forward" class="icon-button small" title="Вперёд (Alt+→)" data-class-disabled="!as_can_forward" data-event-click="as_forward"><icon name="arrow_forward"/></div>
            <div id="as-up" class="icon-button small" title="Наверх (Alt+↑, Backspace)" data-class-disabled="!as_can_up" data-event-click="as_up"><icon name="arrow_upward"/></div>
            <div class="icon-button small" title="Обновить (F5)" data-class-busy="as_busy" data-event-click="as_refresh"><icon name="refresh"/></div>
            <div class="address row">
                <icon data-attr-class="'s ft-' + (as_filter == '' ? 'folder' : (as_filter == 'image' ? 'image' : (as_filter == 'audio' ? 'audio' : 'recent')))" data-attr-name="as_place_icon"/>
                <div data-for="c : as_crumbs" class="crumb row" data-attr-id="'crumb-' + it_index" data-event-click="as_go(c.path)">
                    <icon class="s chevron" name="chevron_right"/><span>{{ c.name }}</span>
                </div>
            </div>
            <div class="search-box row">
                <input id="as-search" type="text" class="grow" placeholder="Поиск в проекте" data-attr-value="as_search" data-event-change="as_search(ev.value)"/>
                <div class="icon-button small" data-if="as_searching" title="Очистить" data-event-click="as_search_clear"><icon class="s" name="close"/></div>
                <icon class="s" name="search" data-if="!as_searching"/>
            </div>
        </div>

        <!-- Commands -->
        <div class="as-commands row">
            <div class="menu-anchor">
                <div id="as-new" class="command" data-event-click="as_menu('new')"><icon name="add_circle"/><span>Создать</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'new'">
                    <div id="as-new-folder" class="menu-item" data-event-click="as_new_folder"><icon class="ft-folder" name="create_new_folder"/><span class="label">Папку</span><span class="trailing">Ctrl+Shift+N</span></div>
                    <div class="menu-item" data-event-click="as_import('files')"><icon name="upload_file"/><span class="label">Импорт файлов…</span></div>
                    <div class="menu-item" data-event-click="as_import('folder')"><icon name="drive_folder_upload"/><span class="label">Импорт папки…</span></div>
                </div>
            </div>
            <div class="divider vertical"/>
            <div class="icon-button" title="Вырезать (Ctrl+X)" data-class-disabled="as_sel_count == 0" data-event-click="as_cut"><icon name="content_cut"/></div>
            <div id="as-copy" class="icon-button" title="Копировать (Ctrl+C)" data-class-disabled="as_sel_count == 0" data-event-click="as_copy"><icon name="content_copy"/></div>
            <div class="icon-button" title="Вставить (Ctrl+V)" data-class-disabled="!as_has_cut" data-event-click="as_paste"><icon name="content_paste"/></div>
            <div class="icon-button" title="Переименовать (F2)" data-class-disabled="as_sel_count != 1" data-event-click="as_rename_start"><icon name="drive_file_rename_outline"/></div>
            <div class="icon-button" title="Удалить (Del)" data-class-disabled="as_sel_count == 0" data-event-click="as_delete"><icon name="delete"/></div>
            <div class="divider vertical"/>
            <div class="menu-anchor">
                <div id="as-sort-menu" class="command" data-event-click="as_menu('sort')"><icon name="swap_vert"/><span>Сортировка</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'sort'">
                    <div id="sort-name" class="menu-item" data-event-click="as_sort('name')"><icon data-attr-name="as_sort == 'name' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Имя</span></div>
                    <div id="sort-date" class="menu-item" data-event-click="as_sort('date')"><icon data-attr-name="as_sort == 'date' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Дата изменения</span></div>
                    <div id="sort-type" class="menu-item" data-event-click="as_sort('type')"><icon data-attr-name="as_sort == 'type' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Тип</span></div>
                    <div id="sort-size" class="menu-item" data-event-click="as_sort('size')"><icon data-attr-name="as_sort == 'size' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Размер</span></div>
                    <div class="divider"/>
                    <div class="menu-item" data-event-click="as_sort_order(false)"><icon data-attr-name="!as_sort_desc ? 'check' : ''"/><span class="label">По возрастанию</span></div>
                    <div class="menu-item" data-event-click="as_sort_order(true)"><icon data-attr-name="as_sort_desc ? 'check' : ''"/><span class="label">По убыванию</span></div>
                </div>
            </div>
            <div class="menu-anchor">
                <div id="as-view-menu" class="command" data-event-click="as_menu('view')"><icon data-attr-name="as_view == 'icons' ? 'grid_view' : (as_view == 'large' ? 'view_agenda' : 'view_list')"/><span>Вид</span><icon class="s" name="expand_more"/></div>
                <div class="as-menu menu-list" data-if="as_menu == 'view'">
                    <div class="menu-item" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon name="grid_view"/><span class="label">Значки</span></div>
                    <div class="menu-item" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon name="view_agenda"/><span class="label">Список с превью</span></div>
                    <div class="menu-item" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon name="view_list"/><span class="label">Таблица</span></div>
                    <div class="divider"/>
                    <div class="menu-item" data-event-click="as_layout_reset"><icon name="dashboard"/><span class="label">Вернуть панели на место</span></div>
                </div>
            </div>
            <div class="grow"/>
            <div id="as-import" class="button filled small" data-event-click="as_import('files')"><icon name="upload_file"/>Импорт</div>
        </div>

        <div id="as-dock">
            <div data-for="f : as_dock_frames" class="dock-frame" data-class-view="f.view" data-if="f.used"
                 data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'">
                <div class="dock-header row" data-if="!f.view">
                    <div data-for="t : f.tabs" class="dock-tab" data-if="t.used" data-class-active="t.active" data-attr-id="'as-dock-tab-' + t.id"
                         data-event-mousedown="as_dock_grab(t.id)"><icon class="s" data-attr-name="t.icon"/><span>{{ t.title }}</span></div>
                </div>
            </div>
            <div data-for="g : as_dock_gaps" class="dock-gap" data-class-column="g.column" data-if="g.used"
                 data-style-left="g.x + 'px'" data-style-top="g.y + 'px'" data-style-width="g.w + 'px'" data-style-height="g.h + 'px'"
                 data-event-mousedown="as_dock_split(it_index)"><div class="grip"/></div>

            <div id="as-view" class="dock-pane column" data-class-large="as_view == 'large'" data-class-icons="as_view == 'icons'">
                <div class="as-head row" data-if="as_view != 'icons'">
                    <div class="col col-name" data-class-sorted="as_sort == 'name'" data-event-click="as_sort('name')"><span>Имя</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-where" data-if="as_listing"><span>Папка</span></div>
                    <div class="col col-date" data-class-sorted="as_sort == 'date'" data-event-click="as_sort('date')"><span>Дата изменения</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-kind" data-class-sorted="as_sort == 'type'" data-event-click="as_sort('type')"><span>Тип</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                    <div class="col col-size" data-class-sorted="as_sort == 'size'" data-event-click="as_sort('size')"><span>Размер</span><icon class="s" data-attr-name="as_sort_desc ? 'arrow_downward' : 'arrow_upward'"/></div>
                </div>
                <virtual-list id="as-list" source="assets" data-attr-row-height="as_view == 'icons' ? 136 : (as_view == 'large' ? 60 : 30)" data-attr-cell-width="as_view == 'icons' ? 128 : 0" class="grow">
                    <div class="asset-row" vl-class-selected="selected" vl-class-cut="cut">
                        <div class="thumb">
                            <img vl-attr-src="thumb" vl-class-hidden="noimg"/>
                            <div class="glyph" vl-class-hidden="img"><icon vl-attr-name="icon" vl-attr-class="tint"/></div>
                        </div>
                        <span class="name" vl-text="name"/>
                        <span class="where" vl-text="where"/>
                        <span class="date" vl-text="date"/>
                        <span class="kind" vl-text="kind"/>
                        <span class="size" vl-text="size"/>
                    </div>
                </virtual-list>
                <div class="as-empty column" data-if="as_empty">
                    <icon name="upload_file" class="l"/>
                    <span data-if="!as_searching">Папка пуста. Перетащите сюда файлы или папки из проводника, или нажмите «Импорт».</span>
                    <span data-if="as_searching">Ничего не найдено.</span>
                </div>
            </div>

            <div id="as-pane-folders" class="dock-pane column">
                <div class="pane-scroll nav">
                    <div id="nav-recent" class="tree-row nav-row" data-class-selected="as_filter == 'recent'" data-event-click="as_filter('recent')"><icon class="s ft-recent" name="schedule"/><span class="name">Недавние</span></div>
                    <div id="nav-images" class="tree-row nav-row" data-class-selected="as_filter == 'image'" data-event-click="as_filter('image')"><icon class="s ft-image" name="photo_library"/><span class="name">Все картинки</span></div>
                    <div id="nav-audio" class="tree-row nav-row" data-class-selected="as_filter == 'audio'" data-event-click="as_filter('audio')"><icon class="s ft-audio" name="library_music"/><span class="name">Все звуки</span></div>
                    <div class="divider"/>
                    <div data-for="t : as_tree" class="tree-row folder-row" data-class-selected="t.selected && as_filter == ''" data-attr-id="'folder-' + it_index"
                         data-style-padding-left="(4 + t.depth * 14) + 'px'" data-event-click="as_go(t.path)">
                        <div class="arrow" data-event-click="as_tree_toggle(t.path)"><icon class="s" name="chevron_right" data-if="t.kids && t.depth > 0" data-class-open="t.open"/></div>
                        <icon class="s ft-folder" data-attr-name="t.depth == 0 ? 'inventory_2' : (t.selected ? 'folder_open' : 'folder')"/>
                        <span class="name">{{ t.name }}</span>
                    </div>
                </div>
            </div>

            <div id="as-pane-preview" class="dock-pane column">
                <div class="pane-scroll props details">
                    <div class="preview-box">
                        <img id="as-preview" data-if="as_sel_preview != ''" data-attr-src="as_sel_preview"/>
                        <icon class="xl" data-if="as_sel_preview == ''" data-attr-name="as_sel_icon" data-attr-class="'xl ' + as_sel_tint"/>
                    </div>
                    <div class="name-row row" data-if="as_sel_count == 1">
                        <input id="as-name" type="text" class="small grow" title="Имя (F2)" data-attr-value="as_sel_name" data-event-change="as_rename(ev.value, ev.linebreak)" data-event-blur="as_rename_commit"/>
                        <span class="muted ext">{{ as_sel_ext }}</span>
                    </div>
                    <div class="title-row" data-if="as_sel_count != 1"><span>{{ as_sel_name }}</span></div>

                    <div class="section-title">Сведения</div>
                    <div class="info row"><span class="key">Тип</span><span class="value">{{ as_sel_kind }}</span></div>
                    <div class="info row"><span class="key">Размер</span><span class="value">{{ as_sel_size }}</span></div>
                    <div class="info row" data-if="as_sel_dims != ''"><span class="key">Картинка</span><span class="value">{{ as_sel_dims }}</span></div>
                    <div class="info row" data-if="as_sel_extra != ''"><span class="key">Звук</span><span class="value">{{ as_sel_extra }}</span></div>
                    <div class="info row" data-if="as_sel_date != ''"><span class="key">Изменён</span><span class="value">{{ as_sel_date }}</span></div>
                    <div class="info row" data-if="as_sel_path != ''"><span class="key">Где</span><span class="value path">{{ as_sel_path }}</span></div>
                    <div class="prop row gap-2" data-if="as_sel_count == 1 && !as_sel_dir">
                        <span class="key">Метки</span>
                        <input id="as-tags" type="text" class="small grow" placeholder="через пробел" data-attr-value="as_sel_tags" data-event-change="as_tags(ev.value, ev.linebreak)" data-event-blur="as_tags_commit"/>
                    </div>

                    <div data-if="as_sel_count == 1 && as_sel_image">
                        <div class="section-title">Правка</div>
                        <div class="row gap-1" data-if="as_sel_editable">
                            <div id="img-ccw" class="icon-button" title="Повернуть влево" data-event-click="as_image('ccw')"><icon name="rotate_left"/></div>
                            <div id="img-cw" class="icon-button" title="Повернуть вправо" data-event-click="as_image('cw')"><icon name="rotate_right"/></div>
                            <div id="img-fliph" class="icon-button" title="Отразить по горизонтали" data-event-click="as_image('fliph')"><icon name="swap_horiz"/></div>
                            <div id="img-flipv" class="icon-button" title="Отразить по вертикали" data-event-click="as_image('flipv')"><icon name="swap_vert"/></div>
                            <div id="img-half" class="icon-button" title="Уменьшить вдвое" data-event-click="as_image('half')"><icon name="zoom_out"/></div>
                            <div id="img-double" class="icon-button" title="Увеличить вдвое" data-event-click="as_image('double')"><icon name="zoom_in"/></div>
                        </div>
                        <div class="muted body-small" data-if="!as_sel_editable">Этот формат только читается; сделайте копию в PNG, чтобы править.</div>
                        <div class="section-title">Копия в другом формате</div>
                        <div class="row gap-1">
                            <div class="button outlined small" data-if="as_sel_ext != '.png'" data-event-click="as_convert('.png')">PNG</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.jpg' && as_sel_ext != '.jpeg'" data-event-click="as_convert('.jpg')">JPG</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.bmp'" data-event-click="as_convert('.bmp')">BMP</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.tga'" data-event-click="as_convert('.tga')">TGA</div>
                            <div class="button outlined small" data-if="as_sel_ext != '.webp'" data-event-click="as_convert('.webp')">WEBP</div>
                        </div>
                    </div>
                    <div data-if="as_sel_count == 1 && as_sel_wav">
                        <div class="section-title">Звук</div>
                        <div class="button outlined small" data-event-click="as_play"><icon name="play_arrow"/>Слушать</div>
                    </div>

                    <div class="section-title" data-if="as_sel_count &lt;= 1">Открыть</div>
                    <div class="links column" data-if="as_sel_count &lt;= 1">
                        <div class="link row" data-if="as_sel_count == 1 && as_sel_image" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'позже: рисование и нарезка спрайтов', 'image')"><icon class="s" name="open_in_new"/><span>В редакторе изображений</span></div>
                        <div class="link row" data-if="as_sel_count == 1 && as_sel_image" data-event-click="open_tab('animation', 'Анимация', 'Кадры, ключи и состояния анимаций', 'шаг 10: библиотека объектов', 'movie')"><icon class="s" name="open_in_new"/><span>Сделать анимацию</span></div>
                        <div class="link row" data-if="as_sel_count == 1 && as_sel_audio" data-event-click="open_tab('audio', 'Аудио', 'Звуки и музыка проекта', 'позже: обрезка и громкость', 'volume_up')"><icon class="s" name="open_in_new"/><span>В редакторе звука</span></div>
                        <div class="link row" data-event-click="as_show"><icon class="s" name="folder_open"/><span>Показать в проводнике Windows</span></div>
                    </div>
                </div>
            </div>

            <div id="as-pane-history" class="dock-pane column">
                <div class="pane-scroll bottom-body">
                    <div class="history-line" data-class-current="as_history_cursor == 0" data-event-click="as_history_jump(-1)">Начало</div>
                    <div data-for="label : as_history" class="history-line" data-class-current="it_index + 1 == as_history_cursor" data-class-future="it_index >= as_history_cursor" data-event-click="as_history_jump(it_index)">{{ label }}</div>
                </div>
            </div>

            <div id="as-pane-log" class="dock-pane column">
                <div id="as-log" class="pane-scroll bottom-body">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
            </div>

            <div id="as-dock-drop" data-if="as_dock_drop"
                 data-style-left="as_dock_drop_x + 'px'" data-style-top="as_dock_drop_y + 'px'" data-style-width="as_dock_drop_w + 'px'" data-style-height="as_dock_drop_h + 'px'"/>
        </div>

        <div class="as-foot row">
            <span>{{ as_count_text }}</span>
            <span class="sep" data-if="as_sel_text != ''"/>
            <span>{{ as_sel_text }}</span>
            <div class="grow"/>
            <span class="muted" data-if="as_busy">Обновляю…</span>
            <span id="as-conv-status" class="muted row as-conv-status" data-if="as_conv_busy"><span>{{ as_conv_status }}</span><span id="as-conv-stop" class="link" title="Остановить конвертацию" data-event-click="as_conv_stop">остановить</span></span>
            <span class="muted">{{ as_status }}</span>
            <div id="as-view-table" class="icon-button small" title="Таблица" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon class="s" name="view_list"/></div>
            <div id="as-view-large" class="icon-button small" title="Список с превью" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon class="s" name="view_agenda"/></div>
            <div id="as-view-icons" class="icon-button small" title="Значки" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon class="s" name="grid_view"/></div>
        </div>
        <div class="as-backdrop" data-if="as_menu != ''" data-event-mousedown="as_menu('')"/>

        <!-- «Конвертировать…»: which converter, its settings in plain words. -->
        <div class="as-backdrop" data-if="as_conv_open" data-event-mousedown="as_conv_close"/>
        <div id="as-conv" class="as-conv column" data-if="as_conv_open">
            <div class="row as-conv-head">
                <icon name="transform"/>
                <span class="as-conv-title grow">{{ as_conv_title }}</span>
                <div id="as-conv-close" class="icon-button" title="Закрыть (Esc)" data-event-click="as_conv_close"><icon name="close"/></div>
            </div>
            <div class="row as-conv-body grow">
                <div class="as-conv-list column">
                    <div data-for="c : as_conv_list" class="as-conv-item row" data-attr-id="'as-conv-' + c.id" data-class-selected="c.selected" data-event-click="as_conv_pick(c.id)">
                        <icon data-attr-name="c.icon"/>
                        <div class="column grow"><span class="name">{{ c.name }}</span><span class="muted body-small">{{ c.about }}</span></div>
                    </div>
                </div>
                <div class="as-conv-settings column grow">
                    <div data-if="as_conv_settings.size == 0" class="muted body-small">У этого конвертера нет настроек.</div>
                    <div data-for="s : as_conv_settings" class="as-conv-setting column" data-attr-id="'as-conv-set-' + s.id">
                        <div class="row as-conv-setting-head">
                            <span class="grow">{{ s.name }}</span>
                            <div data-if="s.type == 'bool'" class="switch" data-attr-id="'as-conv-bool-' + s.id" data-class-on="s.value == 'true'" data-event-click="as_conv_toggle(s.id)"><div class="thumb"/></div>
                        </div>
                        <div data-if="s.type == 'choice'" class="column">
                            <div data-for="ch : s.choices" class="as-conv-choice row" data-attr-id="'as-conv-' + s.id + '-' + ch.id" data-class-selected="ch.selected" data-event-click="as_conv_choice(s.id, ch.id)">
                                <icon class="s" data-attr-name="ch.selected ? 'radio_button_checked' : 'radio_button_unchecked'"/><span>{{ ch.name }}</span>
                            </div>
                        </div>
                        <div data-if="s.type == 'number'" class="row as-conv-number">
                            <input type="range" class="grow" data-attr-min="s.min" data-attr-max="s.max" data-attr-step="s.step" data-attr-value="s.value" data-event-change="as_conv_number(s.id, ev.value)"/>
                            <span class="as-conv-value">{{ s.value }}</span>
                        </div>
                        <input data-if="s.type == 'text'" type="text" class="small" data-attr-value="s.value" data-event-change="as_conv_text(s.id)"/>
                        <span class="muted body-small" data-if="s.hint != ''">{{ s.hint }}</span>
                    </div>
                </div>
            </div>
            <div class="row as-conv-foot">
                <span class="muted body-small grow">{{ as_conv_note }}</span>
                <div class="command" data-event-click="as_conv_close"><span>Отмена</span></div>
                <div id="as-conv-run" class="button filled small" data-event-click="as_conv_run"><icon name="play_arrow"/>Конвертировать</div>
            </div>
        </div>

        <!-- The right-click menu: for the chosen files, or (nothing chosen) for the open folder. -->
        <div id="as-ctx" class="as-menu ctx menu-list" data-if="as_menu == 'ctx'" data-style-left="as_ctx_x + 'px'" data-style-top="as_ctx_y + 'px'">
            <div data-if="as_sel_count > 0">
                <div id="ctx-open" class="menu-item strong" data-if="as_sel_count == 1 && as_sel_dir" data-event-click="as_open_selected"><icon name="folder_open"/><span class="label">Открыть</span><span class="trailing">Enter</span></div>
                <div class="menu-item strong" data-if="as_sel_count == 1 && as_sel_wav" data-event-click="as_open_selected"><icon name="play_arrow"/><span class="label">Слушать</span></div>
                <div class="menu-item" data-if="as_sel_count == 1 && as_sel_image" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'позже: рисование и нарезка спрайтов', 'image')"><icon name="open_in_new"/><span class="label">Открыть в редакторе изображений</span></div>
                <div class="divider" data-if="as_sel_count == 1 && (as_sel_dir || as_sel_wav || as_sel_image)"/>
                <div id="ctx-cut" class="menu-item" data-event-click="as_cut"><icon name="content_cut"/><span class="label">Вырезать</span><span class="trailing">Ctrl+X</span></div>
                <div id="ctx-copy" class="menu-item" data-event-click="as_copy"><icon name="content_copy"/><span class="label">Копировать</span><span class="trailing">Ctrl+C</span></div>
                <div id="ctx-rename" class="menu-item" data-if="as_sel_count == 1" data-event-click="as_rename_start"><icon name="drive_file_rename_outline"/><span class="label">Переименовать</span><span class="trailing">F2</span></div>
                <div id="ctx-delete" class="menu-item" data-event-click="as_delete"><icon name="delete"/><span class="label">Удалить</span><span class="trailing">Del</span></div>
                <div data-if="as_sel_count == 1 && as_sel_image && as_sel_editable">
                    <div class="divider"/>
                    <div id="ctx-rotate" class="menu-item" data-event-click="as_image('cw')"><icon name="rotate_right"/><span class="label">Повернуть вправо</span></div>
                    <div class="menu-item" data-event-click="as_image('ccw')"><icon name="rotate_left"/><span class="label">Повернуть влево</span></div>
                    <div class="menu-item" data-if="as_sel_ext != '.png'" data-event-click="as_convert('.png')"><icon name="image"/><span class="label">Копия в PNG</span></div>
                </div>
                <div data-if="as_can_convert">
                    <div class="divider"/>
                    <div id="ctx-convert" class="menu-item" data-event-click="as_conv_open"><icon name="transform"/><span class="label">Конвертировать…</span></div>
                </div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_show"><icon name="folder_open"/><span class="label">Показать в проводнике Windows</span></div>
            </div>
            <div data-if="as_sel_count == 0">
                <div class="menu-item" data-class-selected="as_view == 'icons'" data-event-click="as_view('icons')"><icon name="grid_view"/><span class="label">Значки</span></div>
                <div class="menu-item" data-class-selected="as_view == 'large'" data-event-click="as_view('large')"><icon name="view_agenda"/><span class="label">Список с превью</span></div>
                <div class="menu-item" data-class-selected="as_view == 'table'" data-event-click="as_view('table')"><icon name="view_list"/><span class="label">Таблица</span></div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_sort('name')"><icon data-attr-name="as_sort == 'name' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">Сортировать по имени</span></div>
                <div class="menu-item" data-event-click="as_sort('date')"><icon data-attr-name="as_sort == 'date' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По дате изменения</span></div>
                <div class="menu-item" data-event-click="as_sort('type')"><icon data-attr-name="as_sort == 'type' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По типу</span></div>
                <div class="menu-item" data-event-click="as_sort('size')"><icon data-attr-name="as_sort == 'size' ? 'radio_button_checked' : 'radio_button_unchecked'"/><span class="label">По размеру</span></div>
                <div class="divider"/>
                <div id="ctx-paste" class="menu-item" data-class-disabled="!as_has_cut" data-event-click="as_paste"><icon name="content_paste"/><span class="label">Вставить</span><span class="trailing">Ctrl+V</span></div>
                <div id="ctx-new-folder" class="menu-item" data-event-click="as_new_folder"><icon class="ft-folder" name="create_new_folder"/><span class="label">Создать папку</span><span class="trailing">Ctrl+Shift+N</span></div>
                <div class="menu-item" data-event-click="as_import('files')"><icon name="upload_file"/><span class="label">Импорт файлов…</span></div>
                <div class="menu-item" data-event-click="as_refresh"><icon name="refresh"/><span class="label">Обновить</span><span class="trailing">F5</span></div>
                <div class="divider"/>
                <div class="menu-item" data-event-click="as_show"><icon name="folder_open"/><span class="label">Показать в проводнике Windows</span></div>
            </div>
        </div>
    </div>


    <!-- «Интерфейс»: the colour picker (opened by a colour's swatch). The cover under it takes the click
         outside it (that click keeps the colour and goes no further: the canvas under it is not clicked). -->
    <div id="ue-cp-cover" class="ue-cp-cover" data-if="ue_cp.open" data-class-dropper="ue_cp.dropper" data-event-mousedown="ue_cp_outside"/>
    <div id="ue-picker" class="ue-picker column" data-if="ue_cp.open" data-class-dropper="ue_cp.dropper">
        <div class="ue-cp-head row">
            <span class="grow ue-ellipsis">{{ ue_cp.title }}</span>
            <div id="ue-cp-dropper" class="ue-mini" data-class-selected="ue_cp.dropper" title="Пипетка: щёлкните по экрану на холсте, возьмётся цвет, который там виден" data-event-click="ue_cp_dropper"><icon class="xs" name="colorize"/></div>
            <div id="ue-cp-live" class="ue-mini" data-if="ue_cp.can_live" data-class-selected="ue_cp.live" title="Пипетка на экране «Проверить»: экран оживает, как в игре; щелчок берёт цвет, кнопки не нажимаются" data-event-click="ue_cp_live"><icon class="xs" name="play_circle"/></div>
        </div>
        <div id="ue-cp-sv" class="ue-cp-sv" data-style-background-color="ue_cp.hue_swatch" title="Насыщенность (вправо) и яркость (вверх)">
            <div class="ue-cp-white"/><div class="ue-cp-black"/>
            <div class="ue-cp-dot" data-style-left="ue_cp.sv_x + '%'" data-style-top="ue_cp.sv_y + '%'"/>
        </div>
        <div id="ue-cp-hue" class="ue-cp-bar ue-cp-hue" title="Оттенок"><div class="ue-cp-knob" data-style-left="ue_cp.hue_x + '%'"/></div>
        <div id="ue-cp-alpha" class="ue-cp-bar ue-checker" title="Прозрачность: в клетку видно, где цвет прозрачный">
            <div class="ue-cp-fill" data-style-decorator="ue_cp.alpha_bar"/>
            <div class="ue-cp-knob" data-style-left="ue_cp.alpha_x + '%'"/>
        </div>
        <div class="ue-cp-fields row">
            <div class="ue-cp-compare ue-checker row" title="Было и стало">
                <div id="ue-cp-old" class="grow" data-style-background-color="ue_cp.old_swatch"/>
                <div id="ue-cp-new" class="grow" data-style-background-color="ue_cp.new_swatch"/>
            </div>
            <input id="ue-cp-hex" type="text" class="ue-hex grow" title="HEX: 3, 4, 6 или 8 знаков 0–9 A–F" data-attr-value="ue_cp.hex" data-event-change="ue_cp_hex(ev.value, ev.linebreak)" data-event-blur="ue_cp_hex_done"/>
            <input id="ue-cp-alpha-field" type="text" class="ue-pct" title="Непрозрачность в процентах: 100 — сплошной, 0 — невидимый" data-attr-value="ue_cp.alpha" data-event-change="ue_cp_alpha(ev.value, ev.linebreak)" data-event-blur="ue_cp_alpha_done"/>
        </div>
        <div id="ue-cp-hex-note" class="ue-note ue-warn" data-if="ue_cp.hex_note != ''">{{ ue_cp.hex_note }}</div>
        <div class="ue-note" data-if="ue_cp.hex_note == ''">HEX: FF8800 или F80; с прозрачностью FF880080. Enter применяет.</div>
        <div class="column" data-if="ue_game_colors.size > 0">
            <div class="ue-key">Цвета игры</div>
            <div class="ue-s-theme row">
                <div data-for="c : ue_game_colors" class="ue-s-chip ue-checker" data-attr-id="'ue-cp-theme-' + it_index" data-attr-title="c.name" data-class-selected="ue_cp.link == c.key" data-event-click="ue_cp_theme(c.key)"><div class="ue-swatch-fill" data-style-background-color="c.swatch"/></div>
            </div>
        </div>
        <div id="ue-cp-note" class="ue-note" data-if="ue_cp.note != ''">{{ ue_cp.note }}</div>
        <div id="ue-cp-hint" class="ue-note ue-cp-hint" data-if="ue_cp.hint != ''">{{ ue_cp.hint }}</div>
        <div class="ue-cp-buttons row">
            <div id="ue-cp-cancel" class="ue-btn grow" title="Esc: всё как было" data-event-click="ue_cp_close(false)">Отмена</div>
            <div id="ue-cp-done" class="ue-btn ue-btn-primary grow" title="Enter или щелчок мимо палитры" data-event-click="ue_cp_close(true)">Готово</div>
        </div>
    </div>

    <div id="statusbar" class="row gap-4">
        <span>{{ status }}</span>
        <div class="grow"/>
        <span class="muted" data-if="tab == 'level'">Ctrl+Z / Ctrl+Y отмена и повтор · Ctrl+S сохранить · F5 играть отсюда · B L R G E I инструменты · [ ] размер · колесо и правая кнопка: камера</span>
        <span class="muted" data-if="tab == 'assets'">Ctrl+Z / Ctrl+Y отмена и повтор · Alt+← / Alt+→ назад и вперёд · F2 имя · Ctrl+C / X / V · Del удалить · перетащите файлы в окно для импорта</span>
        <span class="muted" data-if="tab == 'logic' && lg_mode == 'links'">Ctrl+Z / Ctrl+Y отмена и повтор · щелчок по вещи, потом по другой: связать · Del удалить · Esc отмена · перетаскивание: двигать вещи и доску</span>
        <span class="muted" data-if="tab == 'logic' && lg_mode == 'ideas'">Ctrl+Z / Ctrl+Y отмена и повтор · щелчок по вещи в идее: выбрать другую · «Раскрыть в шаги» показывает подробности · Esc отмена</span>
        <span class="muted" data-if="tab == 'logic' && lg_mode == 'steps'">Ctrl+Z / Ctrl+Y отмена и повтор · × убирает шаг · «Добавить шаг» уточняет связь · Del удаляет выбранную связь</span>
        <span class="muted" data-if="tab == 'logic' && lg_mode == 'scheme'">Ctrl+Z / Ctrl+Y отмена и повтор · тяните от точки к точке, чтобы соединить · правый щелчок по рамке — новая нода · Alt+щелчок по точке убирает провода · Delete убирает выбранное</span>
        <span class="muted" data-if="tab == 'logic' && lg_mode == 'code'">Код собран из связей · щелчок по строке: её связь · Ctrl+Z / Ctrl+Y отмена и повтор</span>
        <span class="muted" data-if="tab == 'story'">Ctrl+Z / Ctrl+Y отмена и повтор · щелчок по реплике: править · Enter сохранить · Esc отмена · щелчок по пометке: выбрать из списка</span>
        <span class="muted" data-if="tab == 'ui'">V F R O T инструменты · Ctrl+колесо: масштаб · пробел или средняя кнопка: двигать холст · Shift+A автораскладка · Ctrl+G в рамку · Ctrl+D копия · Ctrl: без прилипания</span>
        <span class="muted" data-if="tab != 'level' && tab != 'assets' && tab != 'logic' && tab != 'story' && tab != 'ui'">Ctrl+Z / Ctrl+Y отмена и повтор · F5 играть · Del удалить · Ctrl+D копия · F фокус · колесо и правая кнопка: камера</span>
    </div>
</body>
</rml>
