<rml>
<head>
    <title>Forge — редактор</title>
    <link type="text/rcss" href="../forge-ui/base.rcss"/>
    <link type="text/rcss" href="../forge-ui/typography.rcss"/>
    <link type="text/rcss" href="../forge-ui/actions.rcss"/>
    <link type="text/rcss" href="../forge-ui/containers.rcss"/>
    <link type="text/rcss" href="../forge-ui/menus.rcss"/>
    <link type="text/rcss" href="editor.rcss"/>
    <link type="text/rcss" href="level.rcss"/>
</head>
<!-- The editor window. C++ fills the "editor" data model and draws the world
     under the #viewport element; everything you see here can be changed in
     this file and editor.rcss while the editor runs. -->
<body data-model="editor">
    <div id="topbar" class="row gap-1">
        <div class="brand row gap-2"><icon name="hardware"/><span>Forge</span></div>
        <div class="divider vertical"/>
        <div class="icon-button" data-class-disabled="!can_undo" data-event-click="undo"><icon name="undo"/></div>
        <div class="icon-button" data-class-disabled="!can_redo" data-event-click="redo"><icon name="redo"/></div>
        <div class="icon-button" data-event-click="save"><icon name="save"/></div>
        <span class="scene-name">{{ scene_name }}</span><div class="dirty-dot" data-if="dirty"/>
        <span class="hint muted" data-if="can_undo">Ctrl+Z: {{ undo_label }}</span>
        <div class="grow"/>
        <div class="play row gap-2">
            <div class="button filled small" data-if="!playing" data-event-click="play"><icon name="play_arrow"/>Играть</div>
            <div class="button danger small" data-if="playing" data-event-click="stop"><icon name="stop"/>Стоп</div>
            <div class="icon-button" data-class-selected="paused" data-class-disabled="!playing" data-event-click="pause"><icon name="pause"/></div>
        </div>
        <div class="grow"/>
        <div class="icon-button" data-class-selected="theme == 'dark'" data-event-click="set_theme('dark')"><icon name="dark_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'light'" data-event-click="set_theme('light')"><icon name="light_mode"/></div>
        <div class="icon-button" data-class-selected="theme == 'fantasy'" data-event-click="set_theme('fantasy')"><icon name="castle"/></div>
        <div class="icon-button" data-class-selected="theme == 'parchment'" data-event-click="set_theme('parchment')"><icon name="history_edu"/></div>
    </div>

    <!-- Editors. Each tab: open_tab(key, title, what it is for, roadmap step, icon).
         "level" and "world" work; the others show what will be there. -->
    <div id="editor-tabs" class="row">
        <div class="editor-tab" data-class-selected="tab == 'level'" data-event-click="open_tab('level', 'Уровень', '', '', 'landscape')"><icon name="landscape"/><span>Уровень</span></div>
        <div class="editor-tab" data-class-selected="tab == 'world'" data-event-click="open_tab('world', 'Сцена', '', '', 'public')"><icon name="public"/><span>Сцена</span></div>
        <div class="editor-tab" data-class-selected="tab == 'objects'" data-event-click="open_tab('objects', 'Объекты', 'Библиотека объектов: персонажи, предметы, декор из ассетов', 'шаг 10: библиотека объектов', 'deployed_code')"><icon name="deployed_code"/><span>Объекты</span></div>
        <div class="editor-tab" data-class-selected="tab == 'animation'" data-event-click="open_tab('animation', 'Анимация', 'Кадры, ключи и состояния анимаций', 'шаг 10: библиотека объектов', 'movie')"><icon name="movie"/><span>Анимация</span></div>
        <div class="editor-tab" data-class-selected="tab == 'images'" data-event-click="open_tab('images', 'Изображения', 'Просмотр, правка и преобразование картинок', 'шаг 9: библиотека ассетов', 'image')"><icon name="image"/><span>Изображения</span></div>
        <div class="editor-tab" data-class-selected="tab == 'audio'" data-event-click="open_tab('audio', 'Аудио', 'Звуки и музыка проекта', 'шаг 9: библиотека ассетов', 'volume_up')"><icon name="volume_up"/><span>Аудио</span></div>
        <div class="editor-tab" data-class-selected="tab == 'logic'" data-event-click="open_tab('logic', 'Логика', 'Скрипты на нодах', 'шаг 11: редактор скриптов', 'account_tree')"><icon name="account_tree"/><span>Логика</span></div>
        <div class="editor-tab" data-class-selected="tab == 'story'" data-event-click="open_tab('story', 'Сюжет', 'Диалоги и квесты, проверка без запуска игры', 'шаг 12: редактор сюжета', 'forum')"><icon name="forum"/><span>Сюжет</span></div>
        <div class="editor-tab" data-class-selected="tab == 'ui'" data-event-click="open_tab('ui', 'Интерфейс', 'Меню и экраны игры, как в Figma', 'шаг 13: редактор интерфейсов', 'dashboard')"><icon name="dashboard"/><span>Интерфейс</span></div>
        <div class="editor-tab" data-class-selected="tab == 'input'" data-event-click="open_tab('input', 'Ввод', 'Клавиши, мышь и геймпад для действий игры', 'шаг 13: редактор интерфейсов', 'sports_esports')"><icon name="sports_esports"/><span>Ввод</span></div>
        <div class="editor-tab" data-class-selected="tab == 'assets'" data-event-click="open_tab('assets', 'Ресурсы', 'Все файлы проекта: поиск, импорт, преобразование', 'шаг 9: библиотека ассетов', 'folder')"><icon name="folder"/><span>Ресурсы</span></div>
    </div>

    <div id="placeholder" class="column" data-if="!(tab == 'world' || tab == 'level')">
        <icon class="big" data-attr-name="tab_icon"/>
        <div class="headline-small">{{ tab_title }}</div>
        <div class="muted">{{ tab_description }}</div>
        <div class="chip">Появится: {{ tab_step }}</div>
    </div>

    <div id="main" class="row" data-if="tab == 'world'">
        <div id="hierarchy-panel" class="panel column">
            <div class="panel-header">
                <icon name="account_tree" class="s"/><span class="title">Иерархия</span>
                <div class="icon-button small" data-event-click="add_object"><icon name="add" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(true)"><icon name="unfold_more" class="s"/></div>
                <div class="icon-button small" data-event-click="expand_all(false)"><icon name="unfold_less" class="s"/></div>
                <div class="icon-button small" data-class-disabled="!has_selection" data-event-click="delete_selection"><icon name="delete" class="s"/></div>
            </div>
            <virtual-list id="hierarchy" source="hierarchy" class="grow">
                <div class="tree-row" vl-class-selected="selected" vl-style-padding-left="indent">
                    <icon class="s arrow" vl-attr-name="arrow"/>
                    <icon class="s" vl-attr-name="icon"/>
                    <span class="name" vl-text="name"/>
                    <span class="kind" vl-text="kind"/>
                </div>
            </virtual-list>
            <div class="panel-footer muted">{{ object_count }}</div>
        </div>

        <div id="center" class="column grow">
            <div id="viewport" data-class-playing="playing">
                <div class="viewport-label row gap-2" data-if="!playing"><icon name="map" class="s"/><span>Мир · {{ zoom }}</span></div>
                <div class="viewport-label playing row gap-2" data-if="playing"><icon name="sports_esports" class="s"/><span>Игра идёт</span><span data-if="paused">· пауза</span></div>
            </div>
            <div id="bottom-panel" class="panel column">
                <div class="tabs">
                    <div class="tab" data-class-selected="bottom_tab == 0" data-event-click="bottom_tab = 0"><icon name="terminal"/>Журнал</div>
                    <div class="tab" data-class-selected="bottom_tab == 1" data-event-click="bottom_tab = 1"><icon name="history"/>История</div>
                </div>
                <div id="log" class="bottom-body grow" data-if="bottom_tab == 0">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
                <div id="history" class="bottom-body grow" data-if="bottom_tab == 1">
                    <div class="history-line" data-class-current="history_cursor == 0" data-event-click="history_jump(-1)">Начало</div>
                    <div data-for="label : history" class="history-line" data-class-current="it_index + 1 == history_cursor" data-class-future="it_index >= history_cursor" data-event-click="history_jump(it_index)">{{ label }}</div>
                </div>
            </div>
        </div>

        <div id="inspector-panel" class="panel column">
            <div class="panel-header"><icon name="tune" class="s"/><span class="title">Инспектор</span></div>
            <div id="inspector" class="grow">
                <div class="empty muted" data-if="!has_selection">Выберите объект в иерархии или в окне мира.</div>
                <div data-if="has_selection">
                    <div class="name-row row gap-2">
                        <icon name="deployed_code"/>
                        <input type="text" class="small grow" data-attr-value="selected_name" data-event-change="rename(ev.value, ev.linebreak)" data-event-blur="rename_commit"/>
                    </div>
                    <div class="muted body-small selection-note" data-if="selection_count > 1">Выбрано объектов: {{ selection_count }}; показан первый.</div>
                    <div data-for="f : fields">
                        <div class="component-header row gap-2" data-if="f.kind == 'header'">
                            <icon name="widgets" class="s"/><span class="grow">{{ f.label }}</span>
                            <div class="icon-button small" data-event-click="remove_component(it_index)"><icon name="close" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="f.kind != 'header'" data-style-padding-left="(12 + f.depth * 14) + 'px'">
                            <span class="prop-label">{{ f.label }}</span>
                            <div class="prop-value row gap-2">
                                <input data-if="f.kind == 'text'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <input data-if="f.kind == 'slider'" type="range" class="grow" data-attr-min="f.min" data-attr-max="f.max" data-attr-step="f.step" data-attr-value="f.value" data-event-change="field_slide(it_index, ev.value)"/>
                                <input data-if="f.kind == 'slider'" type="text" class="small number" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <div data-if="f.kind == 'bool'" class="switch" data-class-on="f.value == 'true'" data-event-click="field_toggle(it_index)"><div class="thumb"/></div>
                                <div data-if="f.kind == 'enum'" class="cycler grow">
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, -1)"><icon name="chevron_left"/></div>
                                    <span class="value">{{ f.value }}</span>
                                    <div class="icon-button small" data-event-click="field_cycle(it_index, 1)"><icon name="chevron_right"/></div>
                                </div>
                                <div data-if="f.kind == 'color'" class="swatch" data-style-background-color="f.color"/>
                                <input data-if="f.kind == 'color'" type="text" class="small grow" data-attr-value="f.value" data-event-change="field_text(it_index, ev.value, ev.linebreak)" data-event-blur="field_commit(it_index)"/>
                                <span data-if="f.kind == 'group' || f.kind == 'readonly'" class="muted">{{ f.value }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="add-component" data-if="addable.size > 0">
                        <div class="label-small muted">Добавить компонент</div>
                        <div class="row gap-2">
                            <div data-for="c : addable" class="chip" data-event-click="add_component(it_index)"><icon name="add"/>{{ c }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- The level editor: modes over the level, the tools of the mode, then
         panels docked around the world view. C++ places the panes and the
         view (ids pane-<panel> and level-view) where the layout says; the
         frames behind them carry the headers you drag. -->
    <div id="level" class="column" data-if="tab == 'level'">
        <div id="level-bar" class="row">
            <div class="modes row">
                <div class="mode" data-class-selected="lv_mode == 'select'" data-event-click="lv_mode('select')"><icon name="near_me"/><span>Выбор</span></div>
                <div class="mode" data-class-selected="lv_mode == 'tiles'" data-event-click="lv_mode('tiles')"><icon name="grid_on"/><span>Тайлы</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'objects'" data-event-click="lv_mode('objects')"><icon name="deployed_code"/><span>Объекты</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'physics'" data-event-click="lv_mode('physics')"><icon name="water_drop"/><span>Физика</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'light'" data-event-click="lv_mode('light')"><icon name="lightbulb"/><span>Свет</span></div>
                <div class="mode soon" data-class-selected="lv_mode == 'zones'" data-event-click="lv_mode('zones')"><icon name="flag"/><span>Зоны</span></div>
            </div>
            <div class="divider vertical"/>
            <div class="tools row" data-if="lv_mode == 'tiles'">
                <div id="tool-brush" class="icon-button" data-class-selected="lv_tool == 'brush'" data-event-click="lv_tool('brush')"><icon name="brush"/></div>
                <div id="tool-line" class="icon-button" data-class-selected="lv_tool == 'line'" data-event-click="lv_tool('line')"><icon name="timeline"/></div>
                <div id="tool-rect" class="icon-button" data-class-selected="lv_tool == 'rect'" data-event-click="lv_tool('rect')"><icon name="crop_square"/></div>
                <div id="tool-fill" class="icon-button" data-class-selected="lv_tool == 'fill'" data-event-click="lv_tool('fill')"><icon name="format_color_fill"/></div>
                <div id="tool-eraser" class="icon-button" data-class-selected="lv_tool == 'eraser'" data-event-click="lv_tool('eraser')"><icon name="ink_eraser"/></div>
                <div id="tool-picker" class="icon-button" data-class-selected="lv_tool == 'picker'" data-event-click="lv_tool('picker')"><icon name="colorize"/></div>
                <div class="divider vertical"/>
                <icon name="layers" class="s muted label"/>
                <div data-for="l : lv_layers" class="layer-chip" data-class-selected="it_index == lv_layer" data-event-click="lv_layer(it_index)">{{ l }}</div>
                <div class="divider vertical"/>
                <icon name="brush" class="s muted label"/>
                <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                <span class="size">{{ lv_radius }}</span>
                <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
            </div>
            <span class="muted mode-hint" data-if="lv_mode != 'tiles'">{{ lv_mode_help }}</span>
            <div class="grow"/>
            <div class="icon-button" data-class-selected="lv_light" data-event-click="lv_toggle('light')"><icon name="dark_mode"/></div>
            <div class="icon-button" data-class-selected="lv_grid" data-event-click="lv_toggle('grid')"><icon name="grid_4x4"/></div>
            <div class="icon-button" data-class-selected="lv_chunks" data-event-click="lv_toggle('chunks')"><icon name="border_outer"/></div>
            <div class="icon-button" data-event-click="dock_reset"><icon name="dashboard"/></div>
            <div class="divider vertical"/>
            <div class="button outlined small" data-event-click="lv_save"><icon name="save"/>Сохранить<div class="dirty-dot" data-if="lv_dirty"/></div>
            <div id="play-here" class="button filled small" data-event-click="lv_play"><icon name="play_arrow"/>Играть отсюда</div>
        </div>

        <div id="dock">
            <div data-for="f : dock_frames" class="dock-frame" data-class-view="f.view" data-if="f.used"
                 data-style-left="f.x + 'px'" data-style-top="f.y + 'px'" data-style-width="f.w + 'px'" data-style-height="f.h + 'px'">
                <div class="dock-header row" data-if="!f.view">
                    <div data-for="t : f.tabs" class="dock-tab" data-class-active="t.active" data-attr-id="'dock-tab-' + t.id"
                         data-event-mousedown="dock_grab(t.id)"><icon class="s" data-attr-name="t.icon"/><span>{{ t.title }}</span></div>
                </div>
            </div>
            <div data-for="g : dock_gaps" class="dock-gap" data-class-column="g.column" data-if="g.used"
                 data-style-left="g.x + 'px'" data-style-top="g.y + 'px'" data-style-width="g.w + 'px'" data-style-height="g.h + 'px'"
                 data-event-mousedown="dock_split(it_index)"><div class="grip"/></div>

            <div id="level-view" class="dock-pane">
                <div class="viewport-label row gap-2"><icon name="landscape" class="s"/><span>{{ lv_mode_name }} · {{ lv_place }}</span></div>
            </div>

            <div id="pane-palette" class="dock-pane column">
                <div class="pane-scroll">
                    <div data-for="g : lv_palette" class="pal-group">
                        <div class="label-small muted pal-title">{{ g.name }}</div>
                        <div data-for="t : g.tiles" class="pal-tile row" data-class-selected="t.index == lv_tile"
                             data-attr-id="'pal-' + t.index" data-event-click="lv_tile(t.index)">
                            <img data-attr-src="t.icon"/>
                            <span class="name">{{ t.name }}</span>
                            <span class="key" data-if="t.key != ''">{{ t.key }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="pane-minimap" class="dock-pane column">
                <div class="minimap-box"><img id="minimap" data-attr-src="lv_minimap" data-event-mousedown="lv_minimap_click"/></div>
                <div class="muted body-small minimap-place">{{ lv_place }}</div>
            </div>

            <div id="pane-props" class="dock-pane column">
                <div class="pane-scroll props">
                    <div class="section-title">{{ lv_mode_name }}</div>
                    <div class="muted body-small">{{ lv_mode_help }}</div>
                    <div class="chip soon-chip" data-if="lv_mode_when != ''">Появится: {{ lv_mode_when }}</div>
                    <div data-if="lv_mode == 'tiles'">
                        <div class="section-title">Плитка</div>
                        <div class="tile-card row gap-3">
                            <img data-attr-src="lv_tile_icon"/>
                            <div class="column">
                                <span>{{ lv_tile_name }}</span>
                                <span class="muted body-small">Слой: {{ lv_tile_layer }}</span>
                                <span class="muted body-small">{{ lv_tile_hint }}</span>
                            </div>
                        </div>
                        <div class="section-title">{{ lv_tool_name }}</div>
                        <div class="muted body-small">{{ lv_tool_help }}</div>
                        <div class="prop row gap-2" data-if="lv_tool == 'brush' || lv_tool == 'eraser'">
                            <span class="prop-label">Размер</span>
                            <div class="icon-button small" data-event-click="lv_radius(-1)"><icon name="remove" class="s"/></div>
                            <span class="size">{{ lv_radius }}</span>
                            <div class="icon-button small" data-event-click="lv_radius(1)"><icon name="add" class="s"/></div>
                        </div>
                        <div class="prop row gap-2" data-if="lv_tool == 'rect'">
                            <span class="prop-label">Только контур</span>
                            <div class="switch" data-class-on="lv_outline" data-event-click="lv_toggle('outline')"><div class="thumb"/></div>
                        </div>
                    </div>
                    <div class="section-title">Вид</div>
                    <div class="prop row gap-2"><span class="prop-label grow">Свет как в игре</span>
                        <div class="switch" data-class-on="lv_light" data-event-click="lv_toggle('light')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Сетка</span>
                        <div class="switch" data-class-on="lv_grid" data-event-click="lv_toggle('grid')"><div class="thumb"/></div></div>
                    <div class="prop row gap-2"><span class="prop-label grow">Границы участков</span>
                        <div class="switch" data-class-on="lv_chunks" data-event-click="lv_toggle('chunks')"><div class="thumb"/></div></div>
                    <div class="section-title">Уровень</div>
                    <div class="muted body-small">{{ lv_info }}</div>
                    <div class="muted body-small" data-if="lv_dirty">Есть несохранённые изменения (Ctrl+S)</div>
                </div>
            </div>

            <div id="pane-history" class="dock-pane column">
                <div class="pane-scroll bottom-body">
                    <div class="history-line" data-class-current="lv_history_cursor == 0" data-event-click="lv_history_jump(-1)">Начало</div>
                    <div data-for="label : lv_history" class="history-line" data-class-current="it_index + 1 == lv_history_cursor" data-class-future="it_index >= lv_history_cursor" data-event-click="lv_history_jump(it_index)">{{ label }}</div>
                </div>
            </div>

            <div id="pane-log" class="dock-pane column">
                <div id="lv-log" class="pane-scroll bottom-body">
                    <div data-for="line : log" class="log-line" data-class-warn="line.level == 1" data-class-error="line.level == 2">{{ line.text }}</div>
                </div>
            </div>

            <div id="dock-drop" data-if="dock_drop"
                 data-style-left="dock_drop_x + 'px'" data-style-top="dock_drop_y + 'px'" data-style-width="dock_drop_w + 'px'" data-style-height="dock_drop_h + 'px'"/>
        </div>
    </div>

    <div id="statusbar" class="row gap-4">
        <span>{{ status }}</span>
        <div class="grow"/>
        <span class="muted" data-if="tab == 'level'">Ctrl+Z / Ctrl+Y отмена и повтор · Ctrl+S сохранить · F5 играть отсюда · B L R G E I инструменты · [ ] размер · колесо и правая кнопка: камера</span>
        <span class="muted" data-if="tab != 'level'">Ctrl+Z / Ctrl+Y отмена и повтор · F5 играть · Del удалить · Ctrl+D копия · F фокус · колесо и правая кнопка: камера</span>
    </div>
</body>
</rml>
