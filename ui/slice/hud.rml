<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="../forge-ui/base.rcss"/>
    <link type="text/rcss" href="../forge-ui/typography.rcss"/>
    <link type="text/rcss" href="../forge-ui/actions.rcss"/>
    <link type="text/rcss" href="../forge-ui/inventory.rcss"/>
    <link type="text/rcss" href="../forge-ui/hud.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<!-- The slice's HUD over the world while playing: the hotbar, money and
     copper, where the hero is, and a hint when someone is near to talk to.
     Data model "hud" (apps/slice/slice_game.cpp). With F2, when the editor
     started the game, «Связи» lie over the world: the names of the things on
     screen, arrows for the links between them, and a click on one thing, then
     on another, to link them (apps/slice/slice_links.cpp, the ln_ names). -->
<body data-model="hud">
    <div class="hud" data-if="visible">
        <div id="ln-tag" class="ln-tag row" data-if="ln_allowed && !ln_on"><span class="key-hint">F2</span><span>Связи</span></div>
        <div id="ln" class="ln" data-if="ln_on">
            <div data-for="l : ln_arrows">
                <div class="ln-line" data-class-lit="l.lit"
                     data-style-left="l.lx + 'px'" data-style-top="l.ly + 'px'" data-style-width="l.len + 'px'" data-style-transform="'rotate(' + l.angle + 'deg)'"/>
                <icon class="ln-head" name="play_arrow" data-class-lit="l.lit"
                      data-style-left="(l.hx - 12) + 'px'" data-style-top="(l.hy - 12) + 'px'" data-style-transform="'rotate(' + l.angle + 'deg)'"/>
                <div class="ln-chip row" data-attr-id="'ln-chip-' + l.id" data-class-lit="l.lit" data-attr-title="l.phrase"
                     data-style-left="l.cx + 'px'" data-style-top="l.cy + 'px'">
                    <icon class="s" data-attr-name="l.icon"/><span>{{ l.verb }}</span>
                </div>
            </div>
            <!-- A ring around each thing, its name above it. -->
            <div data-for="m : ln_marks" class="ln-ring" data-attr-id="'ln-ring-' + m.id" data-class-picked="m.picked" data-class-hero="m.hero" data-class-linked="m.linked"
                 data-style-left="(m.x - m.w * 0.5) + 'px'" data-style-top="(m.y - m.h * 0.5) + 'px'" data-style-width="m.w + 'px'" data-style-height="m.h + 'px'"
                 data-event-mousedown="ln_mark(m.id)">
                <div class="ln-name" data-attr-id="'ln-mark-' + m.id" data-class-picked="m.picked" data-class-hero="m.hero"><span>{{ m.name }}</span></div>
            </div>
            <div id="ln-panel" class="ln-panel column">
                <div class="ln-panel-head row"><icon name="hub"/><span class="grow">Связи игры</span>
                    <div id="ln-close" class="icon-button small" data-event-click="ln_close"><icon name="close"/></div></div>
                <div class="ln-rows column">
                    <div data-for="r : ln_rows" class="ln-row row" data-attr-id="'ln-row-' + r.id" data-class-lit="r.lit" data-class-away="!r.here">
                        <icon class="s" data-attr-name="r.icon"/><span class="grow">{{ r.phrase }}</span>
                        <div class="icon-button small" data-attr-id="'ln-remove-' + r.id" title="Убрать связь" data-event-click="ln_remove(r.id)"><icon name="delete"/></div>
                    </div>
                    <div class="ln-empty" data-if="ln_rows.size == 0">Связей пока нет.</div>
                </div>
                <div class="ln-panel-foot"><span class="key-hint">F2</span> — вернуться к игре. Изменения сразу попадают в редактор, там их можно отменить.</div>
            </div>
            <div class="ln-tip" data-class-first="ln_first"><span>{{ ln_tip }}</span></div>
            <div id="ln-picker" class="ln-picker column" data-if="ln_picking" data-style-left="ln_pick_x + 'px'" data-style-top="ln_pick_y + 'px'">
                <div class="ln-picker-head row"><span class="grow">{{ ln_title }}</span>
                    <div id="ln-pick-cancel" class="icon-button small" data-event-click="ln_cancel"><icon name="close"/></div></div>
                <div data-for="c : ln_choices" class="ln-option column" data-attr-id="'ln-choice-' + it_index" data-event-click="ln_choose(it_index)">
                    <div class="row gap-2"><icon class="s" data-attr-name="c.icon"/><span class="phrase">{{ c.phrase }}</span></div>
                    <span class="about">{{ c.about }}</span>
                </div>
                <div class="ln-empty" data-if="ln_choices.size == 0">Этим двум вещам игра пока ничего не умеет делать друг с другом.</div>
            </div>
        </div>
        <div class="hint" data-if="has_hint"><span>{{ hint }}</span></div>
        <div class="bottom">
            <div class="place"><icon name="location_on"/><span>{{ location }}</span></div>
            <div id="hotbar" class="hotbar">
                <div class="item-slot" data-for="s : slots" data-class-selected="s.selected" data-class-empty="s.empty"
                     data-event-click="select(it_index)">
                    <icon data-attr-name="s.icon" data-attr-class="s.tone"/>
                    <span class="count">{{ s.count }}</span>
                    <span class="key">{{ s.key }}</span>
                </div>
            </div>
            <div class="purse">
                <div class="money"><icon name="paid"/><span id="hud-coins" class="hud-numeral">{{ coins }}</span></div>
                <div class="money copper"><icon name="hexagon"/><span id="hud-copper" class="hud-numeral">{{ copper }}</span></div>
            </div>
        </div>
        <div class="stress mono body-small" data-if="stress_on"><span>{{ stress }}</span></div>
    </div>
</body>
</rml>
