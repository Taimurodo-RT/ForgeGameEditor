/* Layout of the component gallery (ui/demo/gallery.rml). */

body {
    width: 100%;
    height: 100%;
    background-color: var(--surface);
    padding: var(--space-4) var(--space-6);
    box-sizing: border-box;
}
.topbar { height: 48px; margin-bottom: var(--space-4); }
/* A long description shortens with "…" instead of pushing the theme chips off screen. */
.topbar .grow { min-width: 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.topbar .headline-small, .topbar .row { flex-shrink: 0; }
.columns { align-items: stretch; gap: var(--space-4); height: 780px; }
.col { flex: 1 1 0px; }
.list-panel { flex: 0.8 1 0px; }
.setting { width: 96px; }
.menu { width: 200px; }
.inventory { width: 296px; }
.small-numeral { font-size: 14px; width: 32px; text-align: right; }
.health-icon { color: var(--resource-health); }
.mana-icon { color: var(--resource-mana); }
.stamina-icon { color: var(--resource-stamina); }

#rows { margin: var(--space-1); }
.list-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    height: 28px;
    padding-right: var(--space-3);
    border-radius: var(--radius-xs);
    color: var(--on-surface);
    cursor: pointer;
}
.list-row icon { color: var(--on-surface-variant); }
.list-row .name { flex: 1 1 0px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.list-row .kind { color: var(--on-surface-variant); font-family: var(--font-mono); font-size: 11px; }
.list-row:hover { background-color: var(--state-hover-layer); }
.list-row.selected { background-color: var(--secondary-container); color: var(--on-secondary-container); }
