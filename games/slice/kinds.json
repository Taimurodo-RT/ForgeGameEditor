// Объекты «Старой шахты» собираются из блоков: блок добавляет объекту
// компоненты и свойства, которые автор задаёт словами (свойство привязано к
// полю компонента: "bind": "Компонент.поле"). Вид — готовый набор блоков со
// своими начальными значениями; заготовки (presets) — готовые ответы для жанров.
{
  // Жанры, по которым удобно искать объекты в библиотеке (объект из любого
  // жанра доступен в любой игре).
  "genres": ["Платформер", "RPG", "Песочница", "Головоломка", "Три в ряд", "Стратегия", "Новелла"],
  "blocks": [
    {
      "id": "body",
      "name": "Тело",
      "icon": "accessibility_new",
      "about": "Стоит на земле, падает, упирается в стены и плавает в воде.",
      "components": { "Body": { "half_w": 0.35, "half_h": 0.4 } },
      "excludes": ["rigid"]
    },
    {
      "id": "rigid",
      "name": "Физика",
      "icon": "deployed_code",
      "about": "Настоящая физика: падает, катится, толкается, плавает и складывается в кучи.",
      "components": { "RigidBody": { "half_w": 0.48, "half_h": 0.48, "density": 0.6 } },
      "props": [
        { "id": "density", "name": "Тяжесть", "bind": "RigidBody.density", "hint": "меньше 1 — плавает в воде", "min": 0.1, "max": 5 },
        { "id": "bounce", "name": "Прыгучесть", "bind": "RigidBody.bounce", "min": 0, "max": 1, "advanced": true },
        { "id": "friction", "name": "Трение", "bind": "RigidBody.friction", "min": 0, "max": 2, "advanced": true }
      ],
      "excludes": ["body"]
    },
    {
      "id": "pickup",
      "name": "Подбирается",
      "icon": "paid",
      "about": "Герой подбирает его, просто касаясь, и оно попадает в инвентарь.",
      "components": { "Item": { "count": 1 } },
      "props": [
        { "id": "what", "name": "Что это", "bind": "Item.kind",
          "choices": [
            { "id": "pickaxe", "name": "Кирка", "value": 0 },
            { "id": "coins", "name": "Монеты", "value": 1 },
            { "id": "copper", "name": "Медь", "value": 2 },
            { "id": "wood", "name": "Дерево", "value": 3 },
            { "id": "torch", "name": "Факел", "value": 4 },
            { "id": "key", "name": "Ключ", "value": 5 }
          ] },
        { "id": "count", "name": "Сколько", "bind": "Item.count", "hint": "столько попадёт в инвентарь", "min": 1, "max": 999 },
        { "id": "score", "name": "Очки", "bind": "Item.score", "hint": "столько прибавится к счёту игры (hero.score)", "min": 0, "max": 10000 }
      ],
      "needs": ["body"]
    },
    {
      "id": "villager",
      "name": "Житель",
      "icon": "person",
      "about": "Прогуливается у своего дома и разговаривает с героем.",
      "components": { "Npc": { "timer": 1 } },
      "props": [
        { "id": "who", "name": "Кто это", "bind": "Npc.who", "hint": "от этого зависят вид и разговор",
          "choices": [ { "id": "miner", "name": "Шахтёр Борис", "value": 0 }, { "id": "smith", "name": "Кузнец", "value": 1 } ] },
        { "id": "facing", "name": "Смотрит", "bind": "Npc.facing",
          "choices": [ { "id": "left", "name": "Влево", "value": -1 }, { "id": "right", "name": "Вправо", "value": 1 } ] }
      ],
      "needs": ["body"],
      "excludes": ["control"]
    },
    {
      // Схемы управления: со временем их станет больше (стратегия, непрямое
      // управление…). Новая схема — ещё один вариант в "choices" и её
      // поведение в игре.
      "id": "control",
      "name": "Управление",
      "icon": "sports_esports",
      "about": "Как объект двигается: им управляет игрок или он ходит сам по выбранной схеме.",
      "components": { "Critter": { "speed": 2, "scheme": 2 } },
      "props": [
        { "id": "scheme", "name": "Схема", "bind": "Critter.scheme", "hint": "кто и как его двигает",
          "choices": [
            { "id": "player", "name": "Игрок (стрелки и прыжок)", "value": 0 },
            { "id": "stand", "name": "Стоит на месте", "value": 1 },
            { "id": "wander", "name": "Бродит туда-сюда", "value": 2 },
            { "id": "follow", "name": "Идёт за героем", "value": 3 },
            { "id": "flee", "name": "Убегает от героя", "value": 4 }
          ] },
        { "id": "speed", "name": "Скорость", "bind": "Critter.speed", "hint": "клеток в секунду", "min": 0.2, "max": 6 }
      ],
      "needs": ["body"],
      "excludes": ["villager"],
      "was": ["critter"]
    },
    {
      // Враг платформера: с какой стороны его коснулся герой, игра судит по
      // тому, где оба были до последнего шага. Сбоку и снизу он ранит, прыжок
      // сверху его побеждает (если «Побеждается прыжком сверху»).
      "id": "enemy",
      "name": "Враг",
      "icon": "pest_control",
      "about": "Ранит героя, когда касается его сбоку или снизу. Прыжок сверху его побеждает: герой отскакивает, враг пропадает, его очки идут в счёт.",
      "components": { "Enemy": { "hearts": 1, "score": 100, "stomp": true, "bounce": 11 } },
      "props": [
        { "id": "damage", "name": "Урон", "bind": "Enemy.hearts", "hint": "сколько сердец снимает касание", "min": 0, "max": 3 },
        { "id": "enemy_score", "name": "Очки", "bind": "Enemy.score", "hint": "столько прибавится к счёту за победу", "min": 0, "max": 10000 },
        { "id": "stomp", "name": "Побеждается прыжком сверху", "bind": "Enemy.stomp", "hint": "нет — колючий: прыжок сверху тоже ранит" },
        { "id": "bounce", "name": "Отскок", "bind": "Enemy.bounce", "hint": "как высоко подбрасывает героя победа, клеток в секунду", "min": 2, "max": 30, "advanced": true }
      ],
      "needs": ["body"]
    },
    {
      // Дверь не пускает героя, пока закрыта. Открывают её связи: «Ключ
      // открывает Дверь», «Рычаг включает Дверь».
      "id": "door",
      "name": "Дверь",
      "icon": "door_front",
      "about": "Закрытая не пускает героя дальше. Открыть её можно связью: «Ключ открывает дверь».",
      "components": { "Door": { "height": 3 } },
      "props": [
        { "id": "height", "name": "Высота", "bind": "Door.height", "hint": "клеток, снизу вверх", "min": 2, "max": 6 },
        { "id": "open", "name": "Открыта", "bind": "Door.open", "hint": "открыта с самого начала" }
      ],
      "excludes": ["body", "rigid"]
    },
    {
      // Картинка уровня стоит там, где её поставили: так на уровень попадают
      // объекты-картинки карт Tiled. Размер — у шаблона: половина высоты
      // тела, ширина по картинке.
      "id": "still",
      "name": "Неподвижный",
      "icon": "push_pin",
      "about": "Стоит там, где его поставили: не падает, ни во что не упирается, герой проходит сквозь него.",
      "components": { "Body": { "half_w": 0.5, "half_h": 0.5, "gravity": 0, "collide": false } },
      "props": [
        { "id": "half_height", "name": "Полвысоты", "bind": "Body.half_h", "hint": "в клетках: 0.5 — картинка в одну клетку высотой, 1 — в две; ширина по картинке", "min": 0.25, "max": 16 }
      ],
      "excludes": ["body", "rigid", "door"]
    },
    {
      // Опасность ранит коробкой, а не кругом касания связей: шипы шириной в
      // три клетки ранят по всей ширине и ни клеткой дальше.
      "id": "hazard",
      "name": "Опасность",
      "icon": "warning",
      "about": "Шипы, лава, колючки: касание снимает сердце и возвращает героя туда, где он вошёл на уровень.",
      "components": { "Hazard": { "hearts": 1 } },
      "props": [
        { "id": "hazard_damage", "name": "Урон", "bind": "Hazard.hearts", "hint": "сколько сердец снимает касание", "min": 0, "max": 3 },
        { "id": "half_width", "name": "Полширины", "bind": "Body.half_w", "hint": "в клетках: 0.5 — одна клетка, 1.5 — три", "min": 0.25, "max": 16 }
      ]
    },
    {
      // Звук — файл из папки sounds игры (WAV или OGG); позже здесь будут и
      // звуки из редактора звука. Пустое значение: обычный звук игры или
      // никакого (что именно — "empty").
      "id": "sound",
      "name": "Звук",
      "icon": "volume_up",
      "about": "Как объект звучит: когда его подбирают или бьют, его шаги и что слышно рядом с ним.",
      "components": { "Sounds": {} },
      "props": [
        { "id": "sound_pickup", "name": "Подбирают", "bind": "Sounds.pickup", "asset": "sound", "empty": "обычный", "hint": "когда герой его подбирает" },
        { "id": "sound_hit", "name": "Удар", "bind": "Sounds.hit", "asset": "sound", "empty": "обычный", "hint": "когда герой его бьёт или разбивает" },
        { "id": "sound_step", "name": "Шаги", "bind": "Sounds.step", "asset": "sound", "empty": "нет", "hint": "пока он ходит" },
        { "id": "sound_near", "name": "Рядом", "bind": "Sounds.near", "asset": "sound", "empty": "нет", "hint": "звучит всё время, слышно рядом с ним: костёр, ручей, мурлыканье" },
        { "id": "sound_volume", "name": "Громкость", "bind": "Sounds.volume", "min": 0, "max": 2 },
        { "id": "sound_range", "name": "Слышно на", "bind": "Sounds.range", "hint": "клеток: дальше его не слышно", "min": 2, "max": 64, "advanced": true }
      ]
    }
  ],
  "kinds": [
    {
      "id": "person",
      "name": "Житель",
      "group": "Персонажи",
      "icon": "person",
      "about": "Человек, который прогуливается у своего дома и разговаривает с героем.",
      "foot": 0.92,
      "blocks": ["body", "villager"],
      "components": { "Body": { "half_w": 0.38, "half_h": 0.92 } },
      "presets": [
        { "name": "Житель деревни", "genre": "RPG", "about": "гуляет у дома, говорит с героем", "values": { "who": "miner" } }
      ]
    },
    {
      "id": "critter",
      "name": "Животное",
      "group": "Животные",
      "icon": "pets",
      "about": "Бегает само по себе и прыгает через препятствия.",
      "foot": 0.4,
      "blocks": ["body", "control"],
      "presets": [
        { "name": "Зверёк", "about": "бегает по поверхности", "values": { "speed": 2 } },
        { "name": "Питомец", "genre": "RPG", "about": "ходит за героем", "values": { "scheme": "follow", "speed": 3 } },
        { "name": "Пугливый зверёк", "about": "убегает, если подойти", "values": { "scheme": "flee", "speed": 3 } }
      ]
    },
    {
      "id": "enemy",
      "name": "Враг",
      "group": "Животные",
      "icon": "pest_control",
      "about": "Бродит сам по себе и ранит героя касанием. Прыжок сверху его побеждает.",
      "foot": 0.4,
      "blocks": ["body", "control", "enemy"],
      "components": { "Critter": { "speed": 1.5, "scheme": 2 } },
      "presets": [
        { "name": "Жук", "genre": "Платформер", "about": "бродит, побеждается прыжком сверху, 100 очков", "values": { "speed": 1.5 } },
        { "name": "Ёж", "genre": "Платформер", "about": "колючий: прыжком не победить, только обойти", "values": { "stomp": false, "speed": 1 } },
        { "name": "Страж", "genre": "Платформер", "about": "стоит на месте, 200 очков", "values": { "scheme": "stand", "enemy_score": 200 } }
      ]
    },
    {
      "id": "pickup",
      "name": "Подбираемое",
      "group": "Предметы",
      "icon": "paid",
      "about": "Лежит в мире. Герой подбирает его, просто касаясь, и оно попадает в инвентарь.",
      "foot": 0.3,
      "blocks": ["body", "pickup"],
      "components": { "Body": { "half_w": 0.3, "half_h": 0.3 } },
      "presets": [
        { "name": "Монетка", "genre": "Платформер", "about": "одна монетка и 10 очков в счёт", "values": { "what": "coins", "count": 1, "score": 10 } },
        { "name": "Кошелёк", "genre": "RPG", "about": "горсть монет", "values": { "what": "coins", "count": 25 } },
        { "name": "Ресурс", "genre": "Песочница", "about": "руда или дерево для крафта", "values": { "what": "copper", "count": 1 } }
      ]
    },
    {
      "id": "door",
      "name": "Дверь",
      "group": "Разное",
      "icon": "door_front",
      "about": "Стоит на месте и не пускает героя, пока закрыта.",
      "foot": 0.5,
      "blocks": ["door"],
      "presets": [
        { "name": "Дверь", "about": "в проходе высотой 3 клетки", "values": { "height": 3 } },
        { "name": "Ворота", "genre": "RPG", "about": "высокие, в 5 клеток", "values": { "height": 5 } }
      ]
    },
    {
      "id": "picture",
      "name": "Картинка",
      "group": "Разное",
      "icon": "image",
      "about": "Картинка на уровне: стоит, где её поставили, не падает и ни во что не упирается. «Логика» видит её, как любой объект.",
      "foot": 0.5,
      "blocks": ["still"],
      "presets": [
        { "name": "Картинка", "about": "висит на месте, рисуется своей картинкой" }
      ]
    },
    {
      "id": "trap",
      "name": "Ловушка",
      "group": "Разное",
      "icon": "warning",
      "about": "Стоит на месте; касание снимает сердце и возвращает героя туда, где он вошёл на уровень.",
      "foot": 0.5,
      "blocks": ["still", "hazard"],
      "presets": [
        { "name": "Шипы", "genre": "Платформер", "about": "шипы в одну клетку", "values": { "half_height": 0.5 } },
        { "name": "Ряд шипов", "genre": "Платформер", "about": "шипы в три клетки шириной", "values": { "half_height": 0.5, "half_width": 1.5 } }
      ]
    },
    {
      "id": "crate",
      "name": "Физический предмет",
      "group": "Разное",
      "icon": "inventory_2",
      "about": "Падает, катится, плавает в воде и складывается в кучи.",
      "foot": 0.48,
      "blocks": ["rigid"],
      "presets": [
        { "name": "Ящик", "about": "деревянный, плавает", "values": { "density": 0.6 } },
        { "name": "Тяжёлый ящик", "genre": "Головоломка", "about": "тонет, его можно толкать", "values": { "density": 3 } }
      ]
    }
  ]
}
