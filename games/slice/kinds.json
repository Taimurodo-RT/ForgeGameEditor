// Объекты «Старой шахты» собираются из блоков: блок добавляет объекту
// компоненты и свойства, которые автор задаёт словами (свойство привязано к
// полю компонента: "bind": "Компонент.поле"). Вид — готовый набор блоков со
// своими начальными значениями; заготовки (presets) — готовые ответы для жанров.
{
  // Жанры, по которым удобно искать объекты в библиотеке (объект из любого
  // жанра доступен в любой игре).
  "genres": ["Платформер", "RPG", "Песочница", "Головоломка", "Три в ряд", "Стратегия", "Новелла"],
  "blocks": [
    {
      "id": "body",
      "name": "Тело",
      "icon": "accessibility_new",
      "about": "Стоит на земле, падает, упирается в стены и плавает в воде.",
      "components": { "Body": { "half_w": 0.35, "half_h": 0.4 } },
      "excludes": ["rigid"]
    },
    {
      "id": "rigid",
      "name": "Физика",
      "icon": "deployed_code",
      "about": "Настоящая физика: падает, катится, толкается, плавает и складывается в кучи.",
      "components": { "RigidBody": { "half_w": 0.48, "half_h": 0.48, "density": 0.6 } },
      "props": [
        { "id": "density", "name": "Тяжесть", "bind": "RigidBody.density", "hint": "меньше 1 — плавает в воде", "min": 0.1, "max": 5 },
        { "id": "bounce", "name": "Прыгучесть", "bind": "RigidBody.bounce", "min": 0, "max": 1, "advanced": true },
        { "id": "friction", "name": "Трение", "bind": "RigidBody.friction", "min": 0, "max": 2, "advanced": true }
      ],
      "excludes": ["body"]
    },
    {
      "id": "pickup",
      "name": "Подбирается",
      "icon": "paid",
      "about": "Герой подбирает его, просто касаясь, и оно попадает в инвентарь.",
      "components": { "Item": { "count": 1 } },
      "props": [
        { "id": "what", "name": "Что это", "bind": "Item.kind",
          "choices": [
            { "id": "pickaxe", "name": "Кирка", "value": 0 },
            { "id": "coins", "name": "Монеты", "value": 1 },
            { "id": "copper", "name": "Медь", "value": 2 },
            { "id": "wood", "name": "Дерево", "value": 3 },
            { "id": "torch", "name": "Факел", "value": 4 }
          ] },
        { "id": "count", "name": "Сколько", "bind": "Item.count", "hint": "столько попадёт в инвентарь", "min": 1, "max": 999 }
      ],
      "needs": ["body"]
    },
    {
      "id": "villager",
      "name": "Житель",
      "icon": "person",
      "about": "Прогуливается у своего дома и разговаривает с героем.",
      "components": { "Npc": { "timer": 1 } },
      "props": [
        { "id": "who", "name": "Кто это", "bind": "Npc.who", "hint": "от этого зависят вид и разговор",
          "choices": [ { "id": "miner", "name": "Шахтёр Борис", "value": 0 }, { "id": "smith", "name": "Кузнец", "value": 1 } ] },
        { "id": "facing", "name": "Смотрит", "bind": "Npc.facing",
          "choices": [ { "id": "left", "name": "Влево", "value": -1 }, { "id": "right", "name": "Вправо", "value": 1 } ] }
      ],
      "needs": ["body"],
      "excludes": ["control"]
    },
    {
      // Схемы управления: со временем их станет больше (стратегия, непрямое
      // управление…). Новая схема — ещё один вариант в "choices" и её
      // поведение в игре.
      "id": "control",
      "name": "Управление",
      "icon": "sports_esports",
      "about": "Как объект двигается: им управляет игрок или он ходит сам по выбранной схеме.",
      "components": { "Critter": { "speed": 2, "scheme": 2 } },
      "props": [
        { "id": "scheme", "name": "Схема", "bind": "Critter.scheme", "hint": "кто и как его двигает",
          "choices": [
            { "id": "player", "name": "Игрок (стрелки и прыжок)", "value": 0 },
            { "id": "stand", "name": "Стоит на месте", "value": 1 },
            { "id": "wander", "name": "Бродит туда-сюда", "value": 2 },
            { "id": "follow", "name": "Идёт за героем", "value": 3 },
            { "id": "flee", "name": "Убегает от героя", "value": 4 }
          ] },
        { "id": "speed", "name": "Скорость", "bind": "Critter.speed", "hint": "клеток в секунду", "min": 0.2, "max": 6 }
      ],
      "needs": ["body"],
      "excludes": ["villager"],
      "was": ["critter"]
    },
    {
      // Звук — файл из папки sounds игры (WAV или OGG); позже здесь будут и
      // звуки из редактора звука. Пустое значение: обычный звук игры или
      // никакого (что именно — "empty").
      "id": "sound",
      "name": "Звук",
      "icon": "volume_up",
      "about": "Как объект звучит: когда его подбирают или бьют, его шаги и что слышно рядом с ним.",
      "components": { "Sounds": {} },
      "props": [
        { "id": "sound_pickup", "name": "Подбирают", "bind": "Sounds.pickup", "asset": "sound", "empty": "обычный", "hint": "когда герой его подбирает" },
        { "id": "sound_hit", "name": "Удар", "bind": "Sounds.hit", "asset": "sound", "empty": "обычный", "hint": "когда герой его бьёт или разбивает" },
        { "id": "sound_step", "name": "Шаги", "bind": "Sounds.step", "asset": "sound", "empty": "нет", "hint": "пока он ходит" },
        { "id": "sound_near", "name": "Рядом", "bind": "Sounds.near", "asset": "sound", "empty": "нет", "hint": "звучит всё время, слышно рядом с ним: костёр, ручей, мурлыканье" },
        { "id": "sound_volume", "name": "Громкость", "bind": "Sounds.volume", "min": 0, "max": 2 },
        { "id": "sound_range", "name": "Слышно на", "bind": "Sounds.range", "hint": "клеток: дальше его не слышно", "min": 2, "max": 64, "advanced": true }
      ]
    }
  ],
  "kinds": [
    {
      "id": "person",
      "name": "Житель",
      "group": "Персонажи",
      "icon": "person",
      "about": "Человек, который прогуливается у своего дома и разговаривает с героем.",
      "foot": 0.92,
      "blocks": ["body", "villager"],
      "components": { "Body": { "half_w": 0.38, "half_h": 0.92 } },
      "presets": [
        { "name": "Житель деревни", "genre": "RPG", "about": "гуляет у дома, говорит с героем", "values": { "who": "miner" } }
      ]
    },
    {
      "id": "critter",
      "name": "Животное",
      "group": "Животные",
      "icon": "pets",
      "about": "Бегает само по себе и прыгает через препятствия.",
      "foot": 0.4,
      "blocks": ["body", "control"],
      "presets": [
        { "name": "Зверёк", "about": "бегает по поверхности", "values": { "speed": 2 } },
        { "name": "Питомец", "genre": "RPG", "about": "ходит за героем", "values": { "scheme": "follow", "speed": 3 } },
        { "name": "Пугливый зверёк", "about": "убегает, если подойти", "values": { "scheme": "flee", "speed": 3 } }
      ]
    },
    {
      "id": "pickup",
      "name": "Подбираемое",
      "group": "Предметы",
      "icon": "paid",
      "about": "Лежит в мире. Герой подбирает его, просто касаясь, и оно попадает в инвентарь.",
      "foot": 0.3,
      "blocks": ["body", "pickup"],
      "components": { "Body": { "half_w": 0.3, "half_h": 0.3 } },
      "presets": [
        { "name": "Монетка", "genre": "Платформер", "about": "одна монетка, +1 к счёту", "values": { "what": "coins", "count": 1 } },
        { "name": "Кошелёк", "genre": "RPG", "about": "горсть монет", "values": { "what": "coins", "count": 25 } },
        { "name": "Ресурс", "genre": "Песочница", "about": "руда или дерево для крафта", "values": { "what": "copper", "count": 1 } }
      ]
    },
    {
      "id": "crate",
      "name": "Физический предмет",
      "group": "Разное",
      "icon": "inventory_2",
      "about": "Падает, катится, плавает в воде и складывается в кучи.",
      "foot": 0.48,
      "blocks": ["rigid"],
      "presets": [
        { "name": "Ящик", "about": "деревянный, плавает", "values": { "density": 0.6 } },
        { "name": "Тяжёлый ящик", "genre": "Головоломка", "about": "тонет, его можно толкать", "values": { "density": 3 } }
      ]
    }
  ]
}
