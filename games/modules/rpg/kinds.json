// Объекты модуля «RPG сверху» (шаг 14.4a, 14.4-rpg-модель.md, «Объекты»): герой, жители, предметы, места.
// Место копии — её ступни внизу клетки. Картинка шаблона — полоса кадров: у героя кадр 0 стоит, кадры 1… идут;
// у остальных все кадры играются по кругу («Анимация» может задать свои). Без картинки вещь рисуется фигурой.
// «pickup» и его «what» — имена, по которым ядро узнаёт, что даёт предмет (Library::item_of): inv.<what>.
{
  "genres": ["RPG"],
  "blocks": [
    {
      "id": "hero",
      "name": "Герой",
      "icon": "person",
      "about": "Тот, кем ходит игрок. Копия на карте — где он начинает; на карте она одна.",
      "components": { "Hero": { "speed": 4 } },
      "props": [
        { "id": "speed", "name": "Скорость", "bind": "Hero.speed", "hint": "клеток в секунду, по диагонали так же", "min": 1, "max": 20 }
      ]
    },
    {
      "id": "villager",
      "name": "Житель",
      "icon": "record_voice_over",
      "about": "Стоит на месте; герой рядом с ним говорит с ним действием «Поговорить» (E).",
      "components": { "Villager": { "talk": "" } },
      "props": [
        { "id": "talk", "name": "Разговор", "bind": "Villager.talk", "asset": "talk", "empty": "молчит", "hint": "разговор из «Сюжета»; без него житель молчит" }
      ]
    },
    {
      "id": "pickup",
      "name": "Предмет",
      "icon": "key",
      "about": "Лежит на карте; герой наступает на него — предмет у героя в инвентаре, на карте его больше нет.",
      "components": { "Pickup": { "what": "key", "count": 1, "sound": "" } },
      "props": [
        { "id": "what", "name": "Что даёт", "bind": "Pickup.what", "hint": "имя в инвентаре: key — переменная inv.key, в разговорах has(\"key\")" },
        { "id": "count", "name": "Сколько", "bind": "Pickup.count", "min": 1, "max": 999 },
        { "id": "sound", "name": "Звук", "bind": "Pickup.sound", "asset": "sound", "empty": "нет", "hint": "звучит, когда герой его подбирает" }
      ]
    },
    {
      "id": "place",
      "name": "Место",
      "icon": "flag",
      "about": "Клетка карты: герой входит в неё — событие «доходит до» для «Логики».",
      "components": { "Place": { "shown": false } },
      "props": [
        { "id": "shown", "name": "Видно в игре", "bind": "Place.shown", "hint": "нет — в игре его не видно, только в «Уровне»" }
      ]
    }
  ],
  "kinds": [
    { "id": "hero", "name": "Герой", "group": "Персонажи", "icon": "person", "foot": 0.5, "hero": true, "blocks": ["hero"],
      "about": "Тот, кем ходит игрок, в 8 сторон. Одна копия на карте: где он начинает." },
    { "id": "villager", "name": "Житель", "group": "Персонажи", "icon": "record_voice_over", "foot": 0.5, "blocks": ["villager"],
      "about": "Стоит на месте, сквозь него не пройти. Рядом с ним «Поговорить» (E) начинает его разговор." },
    { "id": "pickup", "name": "Предмет", "group": "Предметы", "icon": "key", "foot": 0.5, "blocks": ["pickup"],
      "about": "Лежит на карте, герой подбирает его шагом: в инвентаре прибавляется «Сколько»." },
    { "id": "place", "name": "Место", "group": "Места", "icon": "flag", "foot": 0.5, "blocks": ["place"],
      "about": "Клетка, до которой герой доходит: ворота, выход, цель пути." }
  ]
}
